@startuml
[*] --> Register

state Register {
  Register --> Login : registration successful
  Login --> Register : registration unsuccessful
}

state Login {
  Login --> CheckLocation : login successful
  CheckLocation --> Login : invalid location
}

state CheckLocation {
  CheckLocation --> CheckInfo : location valid
  CheckLocation --> Login : invalid location
}

state CheckInfo {
  CheckInfo --> ChooseInfo : valid selection
  ChooseInfo --> CheckInfo : invalid selection
}

state ChooseInfo {
  ChooseInfo --> ShowInfo : valid selection
  ShowInfo --> ChooseInfo : invalid selection
}

state ShowInfo {
  ShowInfo --> ViewDetails : view additional details
  ViewDetails --> ShowInfo : additional details viewed
}

state ShowInfo {
  ShowInfo --> [*] : logout
}

@enduml
