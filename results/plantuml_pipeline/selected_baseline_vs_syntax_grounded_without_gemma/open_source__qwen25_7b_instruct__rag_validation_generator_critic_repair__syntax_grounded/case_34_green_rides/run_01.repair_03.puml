@startuml
[*] --> LoggedIn

state LoggedIn {
  LoggedIn --> JourneyDetails : view journey details
}

state JourneyDetails {
  JourneyDetails --> DrivingMode : activate driving mode or choose other options
  JourneyDetails --> EatPlace : select place to eat, view menu, and order
  JourneyDetails --> AccidentNotification : accident occurs
}

state DrivingMode {
  DrivingMode --> JourneyDetails : back to journey details
}

state EatPlace {
  EatPlace --> JourneyDetails : finish eating and go back
}

state AccidentNotification {
  AccidentNotification --> Notifications : inform relevant authorities
  AccidentNotification --> Feedback : provide feedback after accident notification
}

state Notifications {
  Notifications --> Feedback : provide feedback after sending notifications
}

state Feedback {
  Feedback --> JourneyComplete : complete journey
}

JourneyComplete --> [*] : completion

@enduml
