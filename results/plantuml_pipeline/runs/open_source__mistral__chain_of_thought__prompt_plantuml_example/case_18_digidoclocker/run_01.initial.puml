@startuml
title Digidoclocker State Machine

state "UnregisteredState" as Unregistered
state "RegisteredState" as Registered
state "LoginState" as Login
state "LoggedInState" as LoggedIn
state "DocumentUploadState" as DocumentUpload
state "ProfileViewState" as ProfileView
state "CertificateApplicationState" as CertificateApplication
state "MultipleCertificateApplicationState" as MultipleCertificates
state "RegistrarRequestState" as RegistrarRequest
state "CertificateVerificationState" as CertificateVerification
state "SessionEndState" as SessionEnd

Unregistered --> Registered : UserRegistrationEvent
Registered --> Login : LoginEvent
Login --> LoggedIn : CorrectLoginEvent
LoggedIn --> DocumentUpload : DocumentUploadEvent
LoggedIn --> ProfileView : ProfileViewEvent
LoggedIn --> CertificateApplication : CertificateApplicationEvent
RegistrarRequestState *-- RegistrarRequest : RegistrarRequestEvent
CertificateVerificationState *-- CertificateVerification : CertificateVerificationEvent
DocumentUpload --> DocumentUpload : DocumentUploadEvent
ProfileView --> ProfileView : ProfileViewEvent
CertificateApplication --> MultipleCertificates : MultipleCertificateApplicationEvent
MultipleCertificates --> SessionEnd : SessionEndEvent
LoggedIn --> RegistrarRequest : RegistrarRequestEvent
SessionEnd --> Unregistered : SessionEndEvent
@enduml
