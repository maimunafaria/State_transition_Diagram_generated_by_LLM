@startuml
title State machine for Farm Management System

state Login
state MainMenu
state MarketConditions
state MarketReport
state PestControlHelp
state SoilInformation
state WeatherInsights
state LabourAvailability
state ContinueService
state Logout

[*] --> Login : userLoginEvent

Login --> MainMenu : successfulLogin

MainMenu --> MarketConditions : marketConditionSelected
MainMenu --> PestControlHelp : pestControlHelpSelected

MarketConditions --> MarketReport : showMarketReport
MarketReport --> ContinueService : backToMainMenu

PestControlHelp --> SoilInformation : photoProvided
SoilInformation --> ContinueService : suitableCropSuggestions

WeatherInsights --> LabourAvailability : locationProvided
LabourAvailability --> ContinueService : displayLabourAvailabilityDetails

ContinueService --> MainMenu : continueUsingService

Logout --> [*] : logoutEvent
@enduml
