@startuml
title UML State Machine Diagram

[*] --> Arrival

state "arrival" as Arrival
Arrival : entry / greet user

state "PIN input" as PINInput
PINInput : entry / card inserted
PINInput : do / enter PIN
PINInput : exit / incorrect PIN or correct PIN

state "incorrect PIN" as IncorrectPIN
IncorrectPIN : entry / incorrect PIN entered
IncorrectPIN : do / allow tries or keep card for security
IncorrectPIN : exit / incorrect PIN or Card Security

state "Card Security" as CardSecurity
CardSecurity : entry / card kept for security
CardSecurity : do / return card after certain period or manual intervention
CardSecurity : exit / Arrival

state "correct PIN" as CorrectPIN
CorrectPIN : entry / correct PIN entered
CorrectPIN : do / allow user to choose options
CorrectPIN : exit / Option Selection

state "option selection" as OptionSelection
OptionSelection : entry / user chooses option
OptionSelection : do / process selected request
OptionSelection : exit / Request Processing or Final State

state "request processing" as RequestProcessing
RequestProcessing : entry / process request
RequestProcessing : do / complete request or error
RequestProcessing : exit / Final State

Arrival --> PINInput
PINInput --> IncorrectPIN
PINInput --> CorrectPIN
IncorrectPIN --> IncorrectPIN
IncorrectPIN --> CardSecurity
CardSecurity --> Arrival
CorrectPIN --> OptionSelection
OptionSelection --> RequestProcessing
RequestProcessing --> FinalState
FinalState --> [*]
@enduml
