@startuml

[*] --> Homepage
state Homepage
state ProjectPage : Project Selected
    state PhotoView : Photo View/Video View Selection
    state VideoView : Photo View/Video View Selection
state CareerOpportunitiesPage : Career Opportunities Selected
    state Updates : Updates/Application Form Selection
    state ApplicationForm : Updates/Application Form Selection
state SubmittedJobApplication : Job Application Submitted

Homepage --> ProjectPage : Project Selected
ProjectPage --> PhotoView : Photo View/Video View Selection
ProjectPage --> VideoView : Photo View/Video View Selection
ProjectPage --> [*] : User navigation away from project
CareerOpportunitiesPage --> Updates : Updates/Application Form Selection
CareerOpportunitiesPage --> ApplicationForm : Updates/Application Form Selection
ApplicationForm --> [*] : User navigation away from application form
ProjectPage --> Homepage : User navigation away from project
CareerOpportunitiesPage --> Homepage : User navigation away from career opportunities
SubmittedJobApplication --> [*] : No valid transitions as it is a final state

@enduml
