@startuml
title State Diagram - Inventory Management System

[*] --> Inventory : Initial state

state Inventory
state OrderPlacement
state InvoiceGeneration
state Purchase
state DiscountCalculation
state TaxCalculation
state ReceiptGeneration
state BillingProcess : Final state
state RequestLog
state ReportView : Final state

Inventory --> Purchase : ItemSelectionEvent
Purchase --> DiscountCalculation : DiscountCalculationEvent
DiscountCalculation --> TaxCalculation : TaxCalculationEvent
TaxCalculation --> ReceiptGeneration : ReceiptGenerationEvent
ReceiptGeneration --> BillingProcess : ReplaceItemOrCancelReceiptEvent
BillingProcess --> Inventory : (transition condition unspecified)
Inventory --> RequestLog : RecordCustomerRequestEvent
Inventory --> ReportView : TransactionSummaryViewEvent
Inventory --> OrderPlacement : OrderPlacementEvent
OrderPlacement --> InvoiceGeneration : InvoiceGeneratedEvent

@enduml
