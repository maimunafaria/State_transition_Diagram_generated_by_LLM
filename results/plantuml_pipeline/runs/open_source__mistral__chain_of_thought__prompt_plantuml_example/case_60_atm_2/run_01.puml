@startuml
title UML State Chart Diagram - ATM Scenario 2

[*] --> Selection

state Idle <<initial>>
Idle : user initiates interaction
Idle --> Selection

state Selection
Selection : user selects an amount from list
Selection --> Verification

state CustomInput
CustomInput : user enters custom value
CustomInput --> Verification

state Verification
Verification : system verifies transaction
Verification --> Rejection : [Transaction rejected]
Verification --> Success : [Transaction successful]

state Rejection
Rejection : user re-enters amount after rejection
Rejection --> Retry

state Retry
Retry : user re-enters amount
Retry --> Verification

state Success
Success : transaction is successful
Success --> End

state End <<final>>
End : ATM returns to Idle state
End --> [*]
@enduml
