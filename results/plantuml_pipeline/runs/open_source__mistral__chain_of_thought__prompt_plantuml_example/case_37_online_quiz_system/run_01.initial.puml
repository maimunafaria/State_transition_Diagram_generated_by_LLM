@startuml
title UML State Machine Diagram - Online Quiz System

[*] --> Login

state "Login" as Login
state "Teacher Dashboard" as TeacherDashboard
state "Student Dashboard" as StudentDashboard
state "Quiz Creation" as QuizCreation
state "Quiz Saving" as QuizSaving
state "Quiz Selection" as QuizSelection
state "Quiz Answer" as QuizAnswer
state "Quiz Submission" as QuizSubmission
state "Quiz Result Viewing (Teacher)" as QuizResultViewingTeacher
state "Quiz Result Viewing (Student)" as QuizResultViewingStudent
state "Notification" as Notification

Login --> TeacherDashboard; Login --> StudentDashboard;
TeacherDashboard --> QuizCreation; TeacherDashboard --> QuizSaving; TeacherDashboard --> QuizResultViewingTeacher;
StudentDashboard --> QuizSelection;
QuizSelection --> QuizAnswer;
QuizAnswer --> QuizSubmission;
QuizSubmission --> QuizResultViewingStudent;
QuizCreation --> QuizSaving;
QuizSaving --> [*];
@enduml
