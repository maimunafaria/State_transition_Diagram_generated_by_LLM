@startuml
title UML State Chart Diagram - E Ticketing For Bus

[*] --> Registration

state Registration
Registration : entry / User initiates registration
Registration --> Validation : User provides details

state Validation
Validation : do / Validate user details
Validation --> Login : Validation successful
Validation --> Registration : Validation failed

state Login
Login : entry / User enters credentials
Login --> TicketStatus : Login successful
Login --> Registration : Login failed

state TicketStatus
TicketStatus : do / Check ticket status
TicketStatus --> Booking : User chooses to book
TicketStatus --> Logout : User chooses to log out

state Booking
Booking : entry / User initiates booking
Booking --> Confirmation : User selects route and seats
Booking --> TicketStatus : User cancels booking

state Confirmation
Confirmation : do / Confirm booking details
Confirmation --> Payment : User confirms details

state Payment
Payment : do / Process payment
Payment --> TicketStatus : Payment successful
Payment --> Booking : Payment failed

state AccountManagement
AccountManagement : entry / User accesses account management
AccountManagement --> TicketStatus : User returns to ticket status
AccountManagement --> Logout : User exits account management

state Logout
Logout : entry / User initiates logout
Logout --> [*]

Registration --> AccountManagement : User chooses to manage account
Login --> AccountManagement : User chooses to manage account
TicketStatus --> AccountManagement : User chooses to manage account
TicketStatus --> Logout : User chooses to log out
Confirmation --> AccountManagement : User chooses to manage account

@enduml
