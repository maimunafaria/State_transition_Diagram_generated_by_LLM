@startuml
[*] --> WaitingForNewSale

state WaitingForNewSale {
    [*] --> EnteringItems
}

EnteringItems --> AddingItems : customer selects item
AddingItems --> Payment : all items added

Payment --> CashPayment : customer pays with cash
Payment --> CardOrCheckPayment : customer pays by card or check

CashPayment --> SaleComplete : payment verified

CardOrCheckPayment --> PaymentVerification : payment initiated
PaymentVerification --> SaleComplete : payment approved
PaymentVerification --> WaitingForNewSale : payment declined

SaleComplete --> WaitingForNewSale : sale finished

@enduml
