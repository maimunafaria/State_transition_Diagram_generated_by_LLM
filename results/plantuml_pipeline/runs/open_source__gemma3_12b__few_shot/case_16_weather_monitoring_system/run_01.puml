@startuml
title UML State Chart Diagram - Weather Monitoring System

[*] --> CreateAccount

state CreateAccount {
    [*] --> EnterDetails
    state EnterDetails
    state RegistrationSuccess
    state RegistrationFailure

    EnterDetails --> RegistrationSuccess : [Valid Details]
    EnterDetails --> RegistrationFailure : [Invalid Details]
}

RegistrationFailure --> [*]

CreateAccount --> Login

state Login {
    [*] --> EnterLoginDetails
    state EnterLoginDetails
    state LoginSuccess
    state LoginFailure

    EnterLoginDetails --> LoginSuccess : [Valid Credentials]
    EnterLoginDetails --> LoginFailure : [Invalid Credentials]
}

LoginFailure --> [*]

LoginSuccess --> CheckWeather

state CheckWeather {
    [*] --> EnterLocation
    state EnterLocation
    state SelectWeatherInfo
    state DisplayWeatherInfo
    state ViewAdditionalDetails

    EnterLocation --> SelectWeatherInfo : [Valid Location]
    EnterLocation --> [*] : [Invalid Location]
    SelectWeatherInfo --> DisplayWeatherInfo
    DisplayWeatherInfo --> ViewAdditionalDetails
}

ViewAdditionalDetails --> CheckWeather

LoginSuccess --> Logout

state Logout {
    [*] --> EndSession
}

EndSession --> [*]

@enduml
