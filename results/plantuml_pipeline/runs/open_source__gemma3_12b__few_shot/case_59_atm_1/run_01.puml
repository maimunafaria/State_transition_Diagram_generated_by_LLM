@startuml
title UML State Chart Diagram - ATM Withdrawal

[*] --> Idle

state Idle
Idle : entry / Display welcome message

Idle --> SelectAmount : User interaction

state SelectAmount
SelectAmount : entry / Display predefined amounts
SelectAmount : do / User selects predefined amount or enters custom amount
SelectAmount --> InputAmount : User selects predefined amount
SelectAmount --> CustomAmount : User enters custom amount
SelectAmount --> Cancel : User chooses to cancel

state InputAmount
InputAmount : entry / Validate amount
InputAmount --> Idle : Amount invalid
InputAmount --> ProcessWithdrawal : Amount valid

state CustomAmount
CustomAmount : entry / Validate amount
CustomAmount --> Idle : Amount invalid
CustomAmount --> ProcessWithdrawal : Amount valid

state ProcessWithdrawal
ProcessWithdrawal : entry / Check account balance
ProcessWithdrawal : do / Dispense cash
ProcessWithdrawal --> Idle : Insufficient funds
ProcessWithdrawal --> Idle : Transaction successful

state Cancel
Cancel : entry / Stop transaction
Cancel --> Idle : Return card

@enduml
