@startuml
title UML State Machine Diagram (Weather Monitoring System)

[*] --> AccountCreation
AccountCreation --> RegistrationSuccess : [successful registration]
AccountCreation --> RegistrationFailed : [failed registration]
RegistrationFailed --> [*]

RegistrationSuccess --> Login
Login --> LoginSuccess : [valid credentials]
Login --> LoginFailed : [invalid credentials]
LoginFailed --> [*]

LoginSuccess --> WeatherCheck
WeatherCheck --> LocationInput
LocationInput --> ValidLocation : [valid location]
LocationInput --> InvalidLocation : [invalid location]
InvalidLocation --> [*]

ValidLocation --> WeatherSelection
WeatherSelection --> TemperatureCheck : [temperature selected]
WeatherSelection --> HumidityCheck : [humidity selected]
WeatherSelection --> RainfallCheck : [rainfall selected]
WeatherSelection --> PressureCheck : [pressure selected]
WeatherSelection --> DewPointCheck : [dew point selected]

TemperatureCheck --> DisplayWeather : [temperature data]
HumidityCheck --> DisplayWeather : [humidity data]
RainfallCheck --> DisplayWeather : [rainfall data]
PressureCheck --> DisplayWeather : [pressure data]
DewPointCheck --> DisplayWeather : [dew point data]

DisplayWeather --> AdditionalDetails : [additional details requested]
DisplayWeather --> Logout : [logout requested]
AdditionalDetails --> Alerts : [alerts selected]
AdditionalDetails --> WeeklyAnalysis : [weekly analysis selected]
AdditionalDetails --> FuturePrediction : [future prediction selected]
AdditionalDetails --> Graph : [graph selected]
Alerts --> [*]
WeeklyAnalysis --> [*]
FuturePrediction --> [*]
Graph --> [*]
Logout --> [*]

@enduml
