@startuml
state "Inactive" {
    [*] -> Inactive
}
state "Waiting for Input" {
    --> Waiting for Input
}
state "Cooking" {
}

Inactive:
- on User input -> Waiting for Input

Waiting for Input:
- on Set Time or Choose Power -> Cooking
- on Door Open -> Inactive

Cooking:
- on Door Open -> Waiting for Input
- on Cancel -> Waiting for Input
- on Time Elapsed -> Waiting for Input

@enduml
