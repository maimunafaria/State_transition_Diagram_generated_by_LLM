@startuml
state Idle {
  [*] -> Idle
}
state Ordering {
}
state "Invoice Generated" {
}
state Billing {
  "generate receipt" --> [*]
}
Idle --> Ordering : "add new goods"
Idle --> Ordering : "update price"
Idle --> Ordering : "remove goods"
