@startuml
[*] -> UserInput

UserInput:
  when selectPredefined =>
    +-> PredefinedSelection
  when enterCustom =>
    +-> CustomEntry
  when cancel =>
    +-> CardReturned

PredefinedSelection:
  when confirm =>
    +-> TransactionProcessing
  when cancel =>
    +-> CardReturned

CustomEntry:
  when confirm =>
    +-> TransactionProcessing
  when cancel =>
    +-> CardReturned

TransactionProcessing:
  when complete =>
    +-> TransactionCompleted

TransactionCompleted:
  +-> [*]

@enduml
