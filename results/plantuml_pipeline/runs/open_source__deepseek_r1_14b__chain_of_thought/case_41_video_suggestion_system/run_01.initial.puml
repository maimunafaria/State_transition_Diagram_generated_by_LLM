@startuml
state Idle {
  [*] --> Idle : wait for request
}
state ProcessingRequest {
  transition VideoSuggestionRequest --> ProcessingRequest
}
state GatheringVideos {
  transition ProcessingRequest --> GatheringVideos
}
state AddingDetails {
  transition GatheringComplete --> AddingDetails
}
state SendingSuggestions {
  transition ReadyToSend --> SendingSuggestions
}
state SuccessfulCompletion {
  transition SendSuccess --> SuccessfulCompletion
}
state ErrorHandling {
  transition SendFailure --> ErrorHandling
}

Idle -> ProcessingRequest : VideoSuggestionRequest
ProcessingRequest -> GatheringVideos
GatheringVideos -> AddingDetails
AddingDetails -> SendingSuggestions
SendingSuggestions -> SuccessfulCompletion : SendSuccess
SendingSuggestions -> ErrorHandling : SendFailure
@enduml
