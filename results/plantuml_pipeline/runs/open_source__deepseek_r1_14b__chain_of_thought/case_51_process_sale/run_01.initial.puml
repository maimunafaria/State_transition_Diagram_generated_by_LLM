@startuml
state Waiting {
  initial [*] -> Waiting
}
state Adding Items
state Payment
state Verifying Payment
state Sale Completed {
  final [*] <- Sale Completed
}

Waiting -> Adding Items : New sale detected
Adding Items -> Payment : All items added
Payment -> Sale Completed : Cash payment chosen
Payment -> Verifying Payment : Card or check payment chosen
Verifying Payment -> Sale Completed : Payment approved
Sale Completed -> Waiting : Payment finished
@enduml
