@startuml
state Order {
  [*] -> Order
}
state Arrival {
  transition from Order on "Arrival" to Arrival
}
state Preparation {
  transition from Arrival on "" to Preparation
}
state Operations {
  transition from Preparation on "Condition and Schedule" to Operations
}
state Maintenance {
  transition from Preparation on "" to Maintenance
  transition from Operations on "No Flights/Maintenance Needed" to Maintenance
  transition from Maintenance on "Completion of Servicing" to Preparation
}
state Retired {
  transition from Operations on "Permanent Withdrawal" to Retired
  Retired --> [*]
}
@enduml
