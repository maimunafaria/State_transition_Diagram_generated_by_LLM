@startuml
state Initial {
  [*] -> Registration : CreateAccount
}
state Registration {
  Registration --> End : (registration unsuccessful)
  Registration --> LoggedIn : (registration successful)
}
state LoggedIn {
  LoggedIn --> LocationCheck : CheckLocation
  LoggedIn --> End : Logout
}
state LocationCheck {
  LocationCheck --> WeatherData : ValidLocation
  LocationCheck --> End : InvalidLocation
}
state WeatherData {
  WeatherData --> DataSelection : SelectParameters
}
state DataSelection {
  DataSelection --> AdditionalDetails : ViewDetails
}
state AdditionalDetails {
  AdditionalDetails --> End : Logout
}
@enduml
