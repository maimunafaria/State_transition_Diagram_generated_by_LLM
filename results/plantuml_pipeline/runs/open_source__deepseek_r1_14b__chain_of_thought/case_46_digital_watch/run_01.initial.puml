@startuml
start
[*] --> Normal_Mode

Normal_Mode
    when Adjust_Button -> Adjustment_Mode
    when Alarm_Toggle -> Alarm_Off

Adjustment_Mode
    when Cycle_Button -> Adjust_Hour
    when Adjust_Button -> Normal_Mode

Adjust_Hour
    when button_press -> (current value + 1) [loop]
    when Cycle_Button -> Adjust_Minute

Adjust_Minute
    when button_press -> (current value + 1) [loop]
    when Cycle_Button -> Adjust_Alarm_Hour

Adjust_Alarm_Hour
    when button_press -> (current value + 1) [loop]
    when Cycle_Button -> Adjust_Alarm_Minute

Adjust_Alarm_Minute
    when button_press -> (current value + 1) [loop]
    when Cycle_Button -> Adjustment_Mode

Alarm_Off
    when Alarm_Toggle -> Alarm_On

Alarm_On
    when Alarm_Toggle -> Alarm_Off
    when time_matches_alarm -> Alarm_Ringing

Alarm_Ringing
    when Stop_Button -> Normal_Mode

Light_Off
    when Light_Button -> Light_On

Light_On
    when Light_Button -> Light_Off

end
@enduml
