@startuml
state Initial State {
  [*] -> Select Amount from Options : select amount
  [*] -> Enter Custom Amount : enter custom value
}
state Select Amount from Options {
  --> Transaction Verification
}
state Enter Custom Amount {
  --> Transaction Verification
}
state Transaction Verification {
  --> Final State (Transaction Completed) : transaction approved
  --> Re-enter Amount : transaction rejected
}
state Re-enter Amount {
  --> Transaction Verification
}
state Final State (Transaction Completed) {
  [*] <- [*]
}
@enduml
