@startuml
[*] --> Idle : Initial State
Idle -->|User selects predefined amount|> SelectingAmount
SelectingAmount -->|User inputs custom amount option|> InputtingCustomAmount
SelectingAmount -->|User cancels transaction|> Cancelled
InputtingCustomAmount -->|User cancels transaction|> Cancelled
InputtingCustomAmount -->|Invalid custom withdrawal amount|> Idle : Error Handling (Not Specified)
Idle -->|User initiates transaction|> SelectingAmount

state Idle {
  description: Initial State
}

state SelectingAmount {
  description: User selects predefined amount
}

state InputtingCustomAmount {
  description: User inputs custom withdrawal amount
}

state Cancelled {
  description: Transaction cancelled
}

@enduml
