@startuml
[*] --> Idle : Initial State
Idle --> FilterCategorySelected : User selects filter category
FilterCategorySelected --> PriceRangeSelected : User selects price range as filter
PriceRangeSelected --> MatchingUsersDisplayed : Display matching users based on chosen criteria
Idle --> PriceRangeSelected : User selects price range as filter
PriceRangeSelected --> MatchingUsersDisplayed : Display matching users based on chosen criteria
FilterCategorySelected --> MatchingUsersDisplayed : Display matching users based on chosen criteria
[*] --> Idle : New search initiated or user logs out

state "Idle" {
  [*] --> Idle : Initial State
}

state "FilterCategorySelected" {
  Idle --> FilterCategorySelected : User selects filter category
}

state "PriceRangeSelected" {
  Idle --> PriceRangeSelected : User selects price range as filter
}

state "MatchingUsersDisplayed" {
  FilterCategorySelected --> MatchingUsersDisplayed : Display matching users based on chosen criteria
  PriceRangeSelected --> MatchingUsersDisplayed : Display matching users based on chosen criteria
}
@enduml
