@startuml
[*] --> Unregistered : Initial State
Unregistered --> Registered : User creates account successfully
Registered --> Logged In : User logs in successfully
Logged In --> Viewing Weather Details : Location is valid and user chooses what to check
Viewing Weather Details --> Logged In : User views additional weather details
Logged In --> Ending Session : User logs out
Unregistered --> Ending Session : Registration is not successful
Registered --> Ending Session : User logs out

state Unregistered {
  [*] --> Unregistered : Initial State
}

state Registered {
  Unregistered --> Registered : User creates account successfully
}

state Logged In {
  Registered --> Logged In : User logs in successfully
  Viewing Weather Details --> Logged In : Location is valid and user chooses what to check
  Logged In --> Ending Session : User logs out
}

state Viewing Weather Details {
  Logged In --> Viewing Weather Details : Location is valid and user chooses what to check
}

state Ending Session {
  Unregistered --> Ending Session : Registration is not successful
  Registered --> Ending Session : User logs out
}

@enduml
