@startuml
[*] --> Order : Newly Acquired
Order --> Arrival : Upon Arrival
Arrival --> Preparation : Upon Arrival
alt Scheduled Flights Available
  Preparation --> Operations : Based on Condition and Schedule
else
  Preparation --> Maintenance : Based on Condition and Schedule
endif
Operations --> Maintenance : No Scheduled Flights or Maintenance Required
Maintenance --> Preparation : After Checking and Servicing
alt Plane is No Longer Available for Use
  Operations --> * : Permanently Withdrawn from Service
  Maintenance --> * : Permanently Withdrawn from Service
else
  Operations --> Maintenance : No Scheduled Flights or Maintenance Required
endif
@enduml
