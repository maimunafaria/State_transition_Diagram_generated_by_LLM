@startuml
title Staff Member State Diagram

[*] --> Unassigned

state "Unassigned" as Unassigned
state "Assigned to Client" as AssignedClient
state "Assigned to Campaign" as AssignedCampaign
state "Unemployed" as Unemployed
state "Archived" as Archived

Unassigned --> AssignedClient : Assign to Client
Unassigned --> AssignedCampaign : Assign to Campaign

AssignedClient --> Unassigned : Remove Assignment
AssignedCampaign --> Unassigned : Remove Assignment
AssignedClient --> AssignedCampaign : Switch Assignment
AssignedCampaign --> AssignedClient : Switch Assignment

AssignedClient --> Unemployed : Leave Job
AssignedCampaign --> Unemployed : Leave Job

Unemployed --> Archived : Time Passed
Archived --> [*] : End

@enduml
