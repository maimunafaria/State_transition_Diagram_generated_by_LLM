@startuml
title UML State Machine Diagram - Campaign

[*] --> CampaignStart
CampaignStart --> CampaignActivation : Manager & Staff Assigned
CampaignActivation --> AdvertsPreparation : Approved & Contract Signed
AdvertsPreparation --> AdvertsApprovalScheduling : Adverts Prepared
AdvertsApprovalScheduling --> AdvertsRunning : Adverts Approved & Scheduled
AdvertsRunning --> CampaignExtensionAdjustment : Campaign Running
AdvertsRunning --> CampaignCompletionFinalStatement : All Adverts Finished
CampaignExtensionAdjustment --> AdvertsRunning
CampaignCompletionFinalStatement --> PaymentHandling : Campaign Completed
PaymentHandling --> BalanceSettlement : Payment Received
BalanceSettlement --> CampaignPaid : Correct Balance Settled
BalanceSettlement --> PaymentHandling : Amount Paid Exceeds Required
CampaignPaid --> CampaignArchived : Full Amount Paid
CampaignArchived --> [*]
CampaignStart --> AdvertsPreparation
CampaignStart --> AdvertsApprovalScheduling
CampaignStart --> AdvertsRunning
CampaignStart --> CampaignExtensionAdjustment
CampaignStart --> CampaignCompletionFinalStatement
CampaignStart --> PaymentHandling
CampaignStart --> BalanceSettlement
CampaignStart --> CampaignPaid
CampaignStart --> CampaignArchived

@enduml
