@startuml
title Graderate Component States

[*] --> Waiting

state "Waiting\nfor Start Date" as Waiting
state "Active" as Active
state "Expired" as Expired
state "Archived" as Archived

Waiting : entry / checkStartDate

Active : entry / maintainRate

Expired : entry / checkExpirationDate

Archived : entry / checkArchiveDate

Waiting --> Active : [currentDate >= startDate]
Active --> Expired : [currentDate >= finishDate]
Expired --> Archived : [currentTime >= expirationDate + 1 year]
Archived --> [*]
Waiting --> [*]
Active --> [*]
Expired --> [*]
@enduml
