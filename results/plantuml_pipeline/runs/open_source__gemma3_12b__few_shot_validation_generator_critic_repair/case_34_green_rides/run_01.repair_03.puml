@startuml
title Green Rides State Diagram

[*] --> JourneyDetails : Login & Destination Selection
[*] --> DrivingMode : Activate Driving Mode
[*] --> EatingOptions : Hungry
[*] --> Accident : Accident Occurs
[*] --> Notifications : System Notification
[*] --> Feedback : Submit Feedback

state "Journey Details" as JourneyDetails
state "Driving Mode" as DrivingMode
state "Eating Options" as EatingOptions
state "Accident" as Accident
state "Notifications" as Notifications
state "Feedback" as Feedback

JourneyDetails --> DrivingMode : Activate Driving Mode
JourneyDetails --> EatingOptions : Hungry
JourneyDetails --> Accident : Accident Occurs

DrivingMode --> Notifications : During Driving
DrivingMode --> Accident : Accident Occurs
DrivingMode --> Feedback : Journey Completion

EatingOptions --> Notifications : Order Placed
EatingOptions --> DrivingMode : Back to Driving

Accident --> Notifications : Accident Reported
Accident --> [*] : After Reporting

Notifications --> DrivingMode : Acknowledge Notification
Notifications --> [*] : System Notification

Feedback --> [*] : Submit Feedback

@enduml
