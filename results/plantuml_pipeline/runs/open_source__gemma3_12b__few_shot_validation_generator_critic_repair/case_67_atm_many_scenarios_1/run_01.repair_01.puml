@startuml
title ATM Transaction

[*] --> Idle

state Idle
state "Enter PIN" as EnterPin
state "Verify PIN" as VerifyPin
state "Provide Options" as ProvideOptions
state "Process Withdrawal" as ProcessWithdrawal
state "Print Receipt" as PrintReceipt
state "Return Card" as ReturnCard
state Reset

Idle --> EnterPin : Card Inserted

EnterPin --> VerifyPin : PIN Entered

VerifyPin --> Idle : Invalid PIN

VerifyPin --> ProvideOptions : Valid PIN

ProvideOptions --> ProcessWithdrawal : Withdrawal Selected

ProcessWithdrawal --> PrintReceipt : Cash Dispensed

PrintReceipt --> ReturnCard : Receipt Printed

ReturnCard --> Reset : Transaction Complete

Reset --> Idle : Idle

Reset --> [*]

@enduml
