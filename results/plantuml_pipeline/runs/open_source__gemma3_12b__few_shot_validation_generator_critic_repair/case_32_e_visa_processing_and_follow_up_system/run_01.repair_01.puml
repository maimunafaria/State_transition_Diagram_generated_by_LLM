@startuml
title E-Visa Processing and Follow-Up System

[*] --> CreateAccount
CreateAccount --> LoggedOut : Account Created

state CreateAccount {
    entry / Display Registration Form
    exit / Validate and Save User Details
}

state LoggedOut {
    entry / Display Login Form
}

LoggedOut --> LoggedIn : Valid Credentials

state LoggedIn {
    entry / Display User Dashboard
    exit / Display Options
}

state ApplyForVisa {
    entry / Initiate Visa Application
    exit / Collect Application Details, Payment
}

state ViewVisaStatus {
    entry / Display Visa Application Status
    exit / Show Current Status
}

state CancelApplication {
    entry / Initiate Cancellation Process
    exit / Confirm Cancellation
}

state ModifyDetails {
    entry / Update User Information
    exit / Save Changes
}

state ViewDetails {
    entry / Display User Profile
    exit / Show User Information
}

state ViewPurpose {
    entry / Display Application Purpose
    exit / Show Application Purpose
}

state GiveFeedback {
    entry / Provide Feedback on Service
    exit / Submit Feedback
}

ApplyForVisa --> PaymentReceived : Application Accepted

PaymentReceived --> VisaProcessing : Payment Confirmed

VisaProcessing --> Approved : Document Check Passed
VisaProcessing --> Rejected : Document Check Failed

Approved --> ViewVisaStatus : Visa Approved
Rejected --> ViewVisaStatus : Visa Rejected

ViewVisaStatus --> GiveFeedback : Status Checked
ViewVisaStatus --> LoggedIn : Status Displayed

CancelApplication --> LoggedIn : Application Cancelled
ModifyDetails --> LoggedIn : Details Modified
ViewDetails --> LoggedIn : Details Viewed
ViewPurpose --> LoggedIn : Purpose Viewed
GiveFeedback --> LoggedIn : Feedback Submitted

LoggedIn --> ApplyForVisa : Apply for Visa
LoggedIn --> ViewVisaStatus : View Status
LoggedIn --> CancelApplication : Cancel Application
LoggedIn --> ModifyDetails : Modify Details
LoggedIn --> ViewDetails : View Details
LoggedIn --> ViewPurpose : View Purpose
LoggedIn --> GiveFeedback : Give Feedback
LoggedIn --> LoggedOut : Logout
LoggedOut --> [*]

@enduml
