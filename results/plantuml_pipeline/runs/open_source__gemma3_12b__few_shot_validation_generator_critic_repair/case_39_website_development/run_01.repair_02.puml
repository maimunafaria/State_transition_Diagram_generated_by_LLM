@startuml
title Website State Diagram

[*] --> Homepage

state Homepage {
    state NavigationBar
    state Projects
    state CareerOpportunities

    NavigationBar --> Projects : selectProject
    NavigationBar --> CareerOpportunities : selectCareer

    Projects --> Projects : selectPhotoOrVideo
    Projects : PhotoOrVideoChoice
    Projects --> PhotoOrVideoChoice : selectPhoto
    Projects --> PhotoOrVideoChoice : selectVideo

    CareerOpportunities --> CareerOpportunities : selectUpdatesOrForm
    CareerOpportunities : UpdatesOrFormChoice
    CareerOpportunities --> UpdatesOrFormChoice : selectUpdates
    CareerOpportunities --> UpdatesOrFormChoice : selectForm
}

state PhotoOrVideoChoice
state UpdatesOrFormChoice

PhotoOrVideoChoice --> Homepage : returnToHomepage
UpdatesOrFormChoice --> Homepage : returnToHomepage

state ApplicationReview {
    Homepage --> SubmittedApplication : applicationSubmitted
    SubmittedApplication --> ReviewingApplication : applicationSubmitted
    ReviewingApplication --> [*] : reviewComplete
}

@enduml
