@startuml
state [*] {
  -->Logged Out: initial transition
}

state Logged Out {
  -->Login: login attempt
}

state Login {
  -->Teacher: teacher role
  -->Student: student role
}

state Teacher {
  -->Draft Quiz: create quiz
}

state Draft Quiz {
  -->Editing Quiz: edit quiz
}

state Editing Quiz {
  -->Draft Quiz: save as draft
  -->Posted Quiz: post quiz
}

state Student {
  -->Quiz Selection: select quiz
}

state Quiz Selection {
  -->Answering Quiz: start answering
}

state Answering Quiz {
  -->Submitted Quiz: submit answers
}

state Submitted Quiz {
  -->Results View: view results
}

state Results View {
  -->[*]: exit system
}
@enduml
