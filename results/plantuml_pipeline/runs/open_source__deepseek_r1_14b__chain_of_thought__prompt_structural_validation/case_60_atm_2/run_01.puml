@startuml
state Initial
state SelectAmount
state EnterCustom
state Verify
state Rejected_reenter
state Approved

[*] --> Initial: User selects withdrawal

Initial --> SelectAmount: Access options

SelectAmount --> Verify: Select option
SelectAmount --> EnterCustom: Enter custom value

EnterCustom --> Verify: Submit amount

Verify --> Approved: Transaction approved
Verify --> Rejected_reenter: Transaction rejected

Rejected_reenter --> EnterCustom: Re-enter amount

Approved --> [*]: Exit
Rejected_reenter --> [*]: Final rejection
@enduml
