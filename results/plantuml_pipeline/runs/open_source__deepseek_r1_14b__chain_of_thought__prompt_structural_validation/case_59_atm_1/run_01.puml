@startuml
[*] --> InsertCard
InsertCard:
    transition "Insert Card" -> SelectAmount
    transition "Cancel" -> [*]

SelectAmount:
    transition "Choose Predefined Amount" [predefined] -> ConfirmTransaction
    transition "Enter Custom Amount" [custom] -> EnterCustomAmount
    transition "Cancel" -> [*]

EnterCustomAmount:
    transition "Enter Amount" -> ConfirmTransaction
    transition "Cancel" -> [*]

ConfirmTransaction:
    transition "Confirm" -> DispenseCash
    transition "Cancel" -> ReturnCard

DispenseCash:
    transition "Dispense Cash" -> ReturnCard

ReturnCard:
    transition "Return Card" -> [*]

@enduml
