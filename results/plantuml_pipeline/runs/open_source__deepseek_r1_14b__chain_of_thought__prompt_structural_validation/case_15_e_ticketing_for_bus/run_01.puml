@startuml
state Unauthenticated {
  [*] --> Unauthenticated: initial state
}
state Registered
state Authenticated
state Checking_Ticket_Status
state Booking_Process
state Payment_Processing
state Ticket_Confirmed

Unauthenticated --> Registered : Register (successful registration)
Unauthenticated --> Authenticated : Login (successful login)

Authenticated --> Checking_Ticket_Status : CheckStatus
Checking_Ticket_Status --> Authenticated

Authenticated --> Booking_Process : BookTicket
Booking_Process --> Payment_Processing : Pay
Payment_Processing --> Ticket_Confirmed
Ticket_Confirmed --> [*] : final state transition

Authenticated --> Authenticated : ManageAccount

Authenticated --> Unauthenticated : Logout

@enduml
