@startuml
[*] --> Off

Off -> AlarmSet : Set alarm time

AlarmSet -> AlarmRinging : Current time matches alarm time

AlarmRinging -> Off : Stop alarm (back to off)
AlarmRinging -> Active : Stop alarm (remain active)

Active --> AlarmSet : Next scheduled alarm time arrives
AlarmSet --> [*] : System shutdown

note right of Off: Initial state
note right of AlarmSet: Final state
note right of Active: Final state
@enduml
