@startuml
state [*] {
  initial: [*]
}

state Card_Inserted {
  --> PIN_Entered : card inserted
}

state PIN_Entered {
  --> PIN_Verified : PIN entered
  loop : invalid PIN
}

state PIN_Verified {
  --> Transaction_Options : valid PIN
}

state Transaction_Options {
  --> Processing_Withdrawal : withdrawal selected
}

state Processing_Withdrawal {
  --> Cash_Dispensed : approved
}

state Cash_Dispensed {
  --> Printing_Receipt : cash dispensed
}

state Printing_Receipt {
  --> Returning_Card : receipt printed
}

state Returning_Card {
  --> System_Reset_Readiness : card returned
}

state System_Reset_Readiness {
  --> [*] : system reset
}
@enduml
