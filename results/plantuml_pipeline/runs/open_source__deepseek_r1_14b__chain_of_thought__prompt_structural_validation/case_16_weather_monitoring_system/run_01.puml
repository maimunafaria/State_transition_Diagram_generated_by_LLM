@startuml
state [*] {
}
state Initial
state Registration
state Authenticated
state LocationInput
state WeatherSelection
state AdditionalDetails

[*] --> Initial

Initial:
    on CreateAccount --> Registration

Registration:
    on UnsuccessfulRegistration --> Initial
    on SuccessfulRegistration/Login --> Authenticated

Authenticated:
    on CheckWeather --> LocationInput
    on ViewAdditionalInfo --> AdditionalDetails

LocationInput:
    on InvalidLocation --> Initial
    on ValidLocation --> WeatherSelection

WeatherSelection:
    on SelectAdditionalDetails --> AdditionalDetails

AdditionalDetails:
    on Logout --> Initial

@enduml
