@startuml
[*] --> Register

state Register {
  [*] --> Login : registration successful
  Login --> [*] : registration unsuccessful
}

Login --> CheckLocation
CheckLocation --> [*] : location invalid
CheckLocation --> ChooseInfo : location valid

ChooseInfo --> ShowWeather : choose to check weather
ShowWeather --> [*] : end process

state ShowWeather {
  [*] --> AdditionalDetails : view additional details
  AdditionalDetails --> [*] : logout
}

[*] --> Logout : logout user
@enduml
