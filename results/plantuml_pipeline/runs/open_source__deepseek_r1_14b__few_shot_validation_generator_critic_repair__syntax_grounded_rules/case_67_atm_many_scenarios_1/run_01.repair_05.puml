@startuml
title ATM State Transition Diagram

state InitialState {
  [*] --> CardInserted : Insert card
}

state CardInserted {
  entry / Display "Please Insert PIN"
  --> EnterPIN : Card inserted
}

state EnterPIN {
  entry / Waiting for PIN input
  --> PINVerified : [valid PIN]
  --> CardInserted : [invalid PIN]
}

state PINVerified {
  entry / PIN verified successfully
  --> ProcessTransaction : Process transaction
}

state ProcessTransaction {
  entry / Processing transaction
  --> DispenseCash : Withdrawal approved
}

state DispenseCash {
  entry / Dispensing cash
  --> PrintReceipt : Cash dispensed
}

state PrintReceipt {
  entry / Printing receipt
  --> ReturnCard : Receipt printed
}

state ReturnCard {
  entry / Returning card
  --> Reset : Card returned
}

state Reset {
  entry / Resetting system
  --> InitialState : System reset
}

@enduml
