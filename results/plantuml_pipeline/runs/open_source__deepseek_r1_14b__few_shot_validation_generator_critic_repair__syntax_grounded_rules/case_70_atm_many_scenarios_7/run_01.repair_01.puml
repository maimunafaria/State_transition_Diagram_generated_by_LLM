@startuml
[*] --> GREETING
GREETING -> PIN_CHECK : Insert Card
PIN_CHECK -> CORRECT_PIN : Correct
PIN_CHECK -> INCORRECT_PIN : Incorrect
INCORRECT_PIN -> PIN_RETRY : Try Again
INCORRECT_PIN -> CARD_CAPTURE : Invalid Card/PIN
CORRECT_PIN -> OPTIONS_DISPLAY : Display Options
OPTIONS_DISPLAY -> WITHDRAW_MONEY : Withdraw Money
WITHDRAW_MONEY --> PROCESS_REQUEST : Process Request
OPTIONS_DISPLAY -> CHECK_INFORMATION : Check Information
CHECK_INFORMATION --> PROCESS_REQUEST : Process Request
OPTIONS_DISPLAY -> MAKE_TRANSFER : Make Transfer
MAKE_TRANSFER --> PROCESS_REQUEST : Process Request
PROCESS_REQUEST --> [*] : Complete Transaction
CORRECT_PIN -> CANCEL_OPERATION : Cancel
CANCEL_OPERATION --> CARD_RETURN : Return Card
CARD_CAPTURE --> CARD_RETURN : User Cancels
CARD_RETURN --> [*] : Card Returned
@enduml
