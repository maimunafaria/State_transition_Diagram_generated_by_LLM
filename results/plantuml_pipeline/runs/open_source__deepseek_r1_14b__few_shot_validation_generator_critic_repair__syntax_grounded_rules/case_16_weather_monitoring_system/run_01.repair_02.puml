@startuml
[*] --> Registering : start registration
Registering -> LoggingIn : successful registration [valid]
Registering -> End : registration failed [invalid]

LoggingIn -> CheckingWeather : successful login [valid]
LoggingIn -> End : invalid credentials [invalid]

CheckingWeather -> ViewingDetails : location valid [valid]
CheckingWeather -> End : location invalid [invalid]

ViewingDetails -> LoggedOut : logout command [logout]
LoggedOut --> [*] : session ended
@enduml
