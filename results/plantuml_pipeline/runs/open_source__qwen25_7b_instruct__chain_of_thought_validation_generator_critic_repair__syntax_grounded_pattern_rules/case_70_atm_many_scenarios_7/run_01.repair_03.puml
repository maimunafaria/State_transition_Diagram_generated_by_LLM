@startuml
[*] --> Idle : UserArrives
Idle --> CardInserted : CardInserted
CardInserted --> PINIncorrect : IncorrectPIN
*:TryAgainSelected
PINIncorrect --> PINIncorrect : TryAgainSelected
PINIncorrect --> Cancelled : OperationCancelled
PINIncorrect --> PINCorrect : CorrectPIN
PINCorrect --> TransactionProcessing : ChoiceMade
TransactionProcessing --> FinalState : RequestProcessed
FinalState --> [*] : *
Idle --> [*] : CardNotInserted
CardInserted --> Idle : CardRemoved
PINCorrect --> OptionsDisplay : PINCorrect
OptionsDisplay --> WithdrawMoney : WithdrawSelected
OptionsDisplay --> CheckInfo : InfoSelected
OptionsDisplay --> Transfer : TransferSelected
WithdrawMoney, CheckInfo, Transfer --> TransactionProcessing : RequestProcessed
@enduml
