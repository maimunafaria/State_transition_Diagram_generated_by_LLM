@startuml
[*] --> Idle : UserArrives
Idle --> CardInserted : CardInserted
CardInserted --> PINIncorrect : IncorrectPIN
*:TryAgainSelected
PINIncorrect --> PINIncorrect : TryAgainSelected
PINIncorrect --> Cancelled : OperationCancelled
PINIncorrect --> PINCorrect : CorrectPIN
PINCorrect --> TransactionProcessing : ChoiceMade
TransactionProcessing --> FinalState : RequestProcessed
FinalState --> [*] : *
Idle --> CardInserted : CardInserted
CardInserted --> PINCorrect : CorrectPIN
PINCorrect --> AvailableOptions : DisplayOptions
AvailableOptions --> WithdrawMoney : WithdrawSelected
WithdrawMoney --> TransactionProcessing : ProcessRequest
AvailableOptions --> CheckInfo : CheckSelected
CheckInfo --> TransactionProcessing : ProcessRequest
AvailableOptions --> Transfer : TransferSelected
Transfer --> TransactionProcessing : ProcessRequest
TransactionProcessing --> FinalState : RequestProcessed
FinalState --> Idle : *
@enduml
