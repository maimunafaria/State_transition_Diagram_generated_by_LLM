@startuml
[*] --> Idle : CardInserted
Idle --> WaitingForPIN : CardInserted
WaitingForPIN --> PINVerified : PINEntered
PINVerified --> WithdrawalOptions : PINVerificationSuccess
WithdrawalOptions --> CashDispensed : UserApproval
CashDispensed --> ReceiptPrinted : ReceiptPrinted
ReceiptPrinted --> CardReturned : CardReturned
CardReturned --> Reset : TimeElapsed
Reset --> [*] : Idle
@enduml
