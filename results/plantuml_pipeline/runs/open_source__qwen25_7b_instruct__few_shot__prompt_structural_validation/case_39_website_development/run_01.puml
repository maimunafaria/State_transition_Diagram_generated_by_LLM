@startuml
title State diagram for Website Development

[*] --> Home : Initial State

state "Home" as Home {
    state "Navigate to Projects" as NavigateProjects
    state "View Photos" as ViewPhotos
    state "Watch Videos" as WatchVideos
    state "Navigate to Career Opportunities" as NavigateCareerOpportunities
    state "View Updates" as ViewUpdates
    state "Open Application Form" as OpenApplicationForm

    Home --> NavigateProjects : Select Projects
    Home --> NavigateCareerOpportunities : Select Career Opportunities

    NavigateProjects --> ViewPhotos : Choose Photos
    NavigateProjects --> WatchVideos : Choose Videos

    NavigateCareerOpportunities --> ViewUpdates : View Updates
    NavigateCareerOpportunities --> OpenApplicationForm : Apply for Job
}

state "Check Application" as CheckApplication {
    CheckApplication : entry/Check Submitted Applications
    CheckApplication : exit/Application Checked
}

OpenApplicationForm --> CheckApplication : Submit Application

Home --> [*] : Logout

@enduml
