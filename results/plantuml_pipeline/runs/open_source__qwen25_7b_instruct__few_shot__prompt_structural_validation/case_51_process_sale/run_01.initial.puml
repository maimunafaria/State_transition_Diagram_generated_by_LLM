@startuml
title Process Sale State Diagram

[*] --> WaitingForSale

state WaitingForSale
state AddingItems
state PaymentVerification
state PaymentCompleted
state CompletedSale
state ReturningToWait

WaitingForSale --> AddingItems : item selected

AddingItems --> PaymentVerification : all items added
PaymentVerification --> PaymentCompleted : payment verified [card/check]
PaymentVerification --> CompletedSale : payment verified [cash]

PaymentCompleted --> CompletedSale : sale completed
CompletedSale --> ReturningToWait : next customer

ReturningToWait --> WaitingForSale : new sale

@enduml
