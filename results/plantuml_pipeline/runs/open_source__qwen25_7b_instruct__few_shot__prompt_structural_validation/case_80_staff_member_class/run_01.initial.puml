@startuml
title Staff Member Class State Machine

[*] --> Unassigned

state Unassigned {
  [*] --> AssigningToClient : [assign]
}

state "Assigning to Client" as AssignedToClient {
  state "Available for Campaigns" as AvailableForCampaigns
  state "Assigned to Campaign" as AssignedToCampaign
}

AssignedToClient --> AvailableForCampaigns : [campaign]
AvailableForCampaigns --> AssignedToCampaign : [accept campaign]

AssignedToClient --> Unassigned : [unassign]

state Unassigned {
  state "Unemployed" as Unemployed
  Unassigned --> Unemployed : [leave job]
}

Unemployed --> Archiving : [archive after some time]

state Archiving

@enduml
