@startuml
title UML State Chart Diagram for Campaign Lifecycle

state "Initial" as Initial {
  [*] --> AssignStaffAndManager : [Campaign Assigned]
}

state "Preparation" as Preparation {
  Initial --> Preparation : [Everything Approved, Contract Signed]
}

state "Active" as Active {
  Preparation --> Active : [Campaign Activated]
}

state "Running" as Running {
  Active --> Running : [Adverts Scheduled and Run]
}

state "Extension/Adjustment" as ExtensionAdjustment {
  Running --> ExtensionAdjustment : [Extension or Adjustment Needed]
}

state "Completion" as Completion {
  Running --> Completion : [All Adverts Finished]
}

state "Post-Campaign" as PostCampaign {
  Completion --> PostCampaign : [Final Statement Prepared]
}

state "PaymentHandling" as PaymentHandling {
  PostCampaign --> PaymentHandling : [Amount Paid]
}

state "Paid" as Paid {
  PaymentHandling --> Paid : [Full Amount Paid]
}

state "Archived" as Archived {
  Paid --> Archived : [Campaign Completed, Staff and Managers Released]
}

Initial --> Preparation
Preparation --> Active
Active --> Running
Running --> ExtensionAdjustment
ExtensionAdjustment --> Running
Running --> Completion
Completion --> PostCampaign
PostCampaign --> PaymentHandling
PaymentHandling --> Paid
Paid --> Archived

Archived --> [*]

@enduml
