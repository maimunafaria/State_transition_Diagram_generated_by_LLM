@startuml
title Graderate State Transition Diagram

[*] --> waiting

state waiting {
  state "Start Date Waiting" as start_date_waiting
}

state active {
  state "Valid Period Active" as valid_period_active
}

state expired {
  state "Expired" as expired_state
  expired_state --> [*]
}

start_date_waiting --> valid_period_active : Start Date Reached

valid_period_active --> expired_state : Finish Date Reached

@enduml
