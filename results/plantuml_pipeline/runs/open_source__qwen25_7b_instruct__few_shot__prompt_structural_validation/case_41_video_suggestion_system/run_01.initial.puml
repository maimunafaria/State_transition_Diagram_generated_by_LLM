@startuml
title Video Suggestion System State Machine

[*] --> ReceiveRequest

state "ReceiveRequest" as ReceiveRequest {
  state IdentifyUser
}

state GatherVideos {
  state "GatherProfileBased"
  state "GatherTrending"
  state "GatherTagSimilar"
  state "GatherGenreSimilar"
  state "GatherPromoted"
}

state AddDetails <<final>> as AddDetails

state SendSuggestions <<final>> as SendSuggestions

ReceiveRequest --> IdentifyUser : User Requested Video Suggestion
IdentifyUser --> GatherVideos : User Identified
GatherVideos --> AddDetails : Videos Gathered and Details Added
AddDetails --> SendSuggestions : Suggestions Prepared
SendSuggestions --> [*] : Suggestions Sent to User

@enduml
