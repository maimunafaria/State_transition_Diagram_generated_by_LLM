@startuml
title ATM Withdrawal Transaction State Machine

state "Initial" as Initial {
  [*] --> ChooseAmount : Insert Card
}

state "Choose Amount" as ChooseAmount
state "Select Predefined Amount" as SelectPredefined
state "Enter Custom Amount" as EnterCustom
state "Transaction Cancelled" as Cancelled
state "Transaction Completed" as Completed

Initial --> ChooseAmount : [user selects option]

ChooseAmount --> SelectPredefined : [select predefined amount]
ChooseAmount --> EnterCustom : [enter custom amount]

SelectPredefined --> Completed : [confirm withdrawal]
EnterCustom --> Completed : [confirm withdrawal]

Completed --> [*] : [transaction completed]

Cancelled --> [*] : [card returned to user]

@enduml
