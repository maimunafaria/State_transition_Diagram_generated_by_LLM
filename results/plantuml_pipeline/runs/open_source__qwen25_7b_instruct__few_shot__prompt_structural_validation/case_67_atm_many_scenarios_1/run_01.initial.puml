@startuml
title ATM State Transition Diagram

[*] --> InsertCard : [Card Inserted]

state InsertCard {
    state EnterPIN {
        state PINVerified {
            state Options {
                state WithdrawalRequest {
                    state CashDispensed {
                        state ReceiptPrinted {
                            state CardReturned {
                                state Reset
                            }
                        }
                    }
                }
            }
        }
    }
}

InsertCard --> EnterPIN : [Enter PIN]
EnterPIN --> PINVerified : [PIN Verified]
PINVerified --> Options : [Options Presented]

Options --> WithdrawalRequest : [Withdraw Request Approved]
WithdrawalRequest --> CashDispensed : [Cash Dispensed]
CashDispensed --> ReceiptPrinted : [Receipt Printed]
ReceiptPrinted --> CardReturned : [Card Returned]
CardReturned --> Reset : [Reset System]

Reset --> [*] : [System Ready for Next User]

@enduml
