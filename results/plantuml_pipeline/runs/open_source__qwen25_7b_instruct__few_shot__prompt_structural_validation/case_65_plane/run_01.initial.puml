@startuml
title Plane State Transition Diagram

[*] --> Order

state Order {
    state "Order"
    "Order" --> Arrival : delivery received
}

state Arrival {
    state "Arrival"
    "Arrival" --> Preparation : plane arrives
}

state Preparation {
    state "Preparation"
    "Preparation" --> Operations : assigned to operations
    "Preparation" --> Maintenance : requires maintenance
}

state Operations {
    state "Operations"
    "Operations" : do/Continue in operation
    "Operations" --> Maintenance : no more scheduled flights or maintenance required
}

state Maintenance {
    state "Maintenance"
    "Maintenance" --> Preparation : serviced and ready for operations
}

state "Out of Service" as OutOfService {
    state "Out of Service"
    "Out of Service" --> [*] : permanently withdrawn from service
}

state "Removed from Operations" as RemovedFromOperations {
    state "Removed from Operations"
    "Removed from Operations" --> OutOfService : plane is no longer available for use
}

Order --> Arrival

@enduml
