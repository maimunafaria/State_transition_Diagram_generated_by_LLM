@startuml
[*] --> State

state State {
  state Registration <<choice>>
  state Login <<choice>>
  state Dashboard <<choice>>
  state Facilities <<choice>>
  state NewsAndExpertContent <<choice>>
  state HealthInformation <<choice>>
  state PaymentProcess <<choice>>
  state InsuranceValidation <<choice>>
  state Logout <<choice>>

  state Registration {
    [*] --> Register
    Register --> Login : [successful registration]
  }

  state Login {
    [*] --> SignIn
    SignIn --> Dashboard : [successful login]
  }

  state Dashboard {
    [*] --> Facilities : [view facilities]
    Facilities --> NewsAndExpertContent : [view news and expert content]
    NewsAndExpertContent --> HealthInformation : [check symptoms or fitness checking options]
    HealthInformation --> PaymentProcess : [make payment for services]
    PaymentProcess --> InsuranceValidation : [validate insurance for available finance-related services]
  }

  state Facilities {
    [*] --> Facility1
    Facility1 --> Facility2 : [view facility details]
  }

  state NewsAndExpertContent {
    [*] --> News
    News --> ExpertContent : [read news and expert content]
  }

  state HealthInformation {
    [*] --> SymptomChecker
    SymptomChecker --> FitnessChecker : [check symptoms or fitness checking options]
  }

  state PaymentProcess {
    [*] --> MakePayment
    MakePayment --> InsuranceValidation : [validate insurance for available finance-related services]
  }

  state InsuranceValidation {
    [*] --> ValidateInsurance
    ValidateInsurance --> CompletePayment : [complete payment process]
  }

  state Logout {
    [*] --> EndSession
    EndSession --> [*] : [end session]
  }
}

State --> Registration : [new user registration]
Registration --> Login : [successful registration]
Login --> Dashboard : [successful login]
Dashboard --> Facilities : [view facilities]
Facilities --> NewsAndExpertContent : [view news and expert content]
NewsAndExpertContent --> HealthInformation : [check symptoms or fitness checking options]
HealthInformation --> PaymentProcess : [make payment for services]
PaymentProcess --> InsuranceValidation : [validate insurance for available finance-related services]
InsuranceValidation --> CompletePayment : [complete payment process]
CompletePayment --> Logout : [end session]

Logout --> [*] : [end session]

@enduml
