@startuml
title ATM Control - Withdraw Funds

[*] --> SelectAmount

state "Select Amount" as SelectAmount
state "Enter Custom Value" as EnterCustomValue
state "Verify Transaction" as VerifyTransaction
state "Re-enter Amount" as ReenterAmount
state "Dispense Cash" as DispenseCash
state "Eject Card" as EjectCard

SelectAmount --> EnterCustomValue : custom value selected
SelectAmount --> VerifyTransaction : amount selected
EnterCustomValue --> SelectAmount : invalid input
VerifyTransaction --> ReenterAmount : transaction rejected
ReenterAmount --> SelectAmount : re-enter amount
VerifyTransaction --> DispenseCash : transaction approved
DispenseCash --> EjectCard : cash dispensed

@enduml
