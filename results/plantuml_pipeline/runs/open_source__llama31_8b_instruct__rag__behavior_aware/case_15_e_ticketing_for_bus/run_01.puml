@startuml
[*] --> State

state "State" as State {
  [*] --> Registration
  Registration --> Login : [successful registration]
  Login --> Dashboard : [logged in]
  Dashboard --> Profile : [view profile]
  Profile --> Logout : [logout]

  state "Registration" as Registration {
    [*] --> GettingDetails
    GettingDetails --> Validation : [valid details]
    Validation --> UpdateDB : [update database]
    UpdateDB --> Login : [login successful]
  }

  state "Login" as Login {
    [*] --> Verification
    Verification --> Dashboard : [logged in]
  }

  state "Dashboard" as Dashboard {
    [*] --> Profile
    Profile --> Logout : [logout]
  }

  state "Profile" as Profile {
    [*] --> EditProfile
    EditProfile --> Dashboard : [edit profile]
  }
}

State --> [*]

@enduml
