@startuml
title UML State Machine Diagram (Search Users)

[*] --> SearchCriteria

state "Search criteria" as SearchCriteria {
    [*] --> SelectFilterCategory

    state SelectFilterCategory <<choice>>
    SelectFilterCategory --> SelectPriceRange : [filter by price]

    state "Select filter category" as SelectFilterCategory
    state "Select price range" as SelectPriceRange

    SelectFilterCategory --> DisplayMatchingUsers : [display matching users]
}

SearchCriteria : entry / Search criteria
SearchCriteria : do / Select filter category
SearchCriteria : exit / After displaying results

state "Display matching users" as DisplayMatchingUsers {
    [*] --> EndSearch

    state EndSearch <<choice>>
    EndSearch --> [*]

    state "End search" as EndSearch
}

@enduml
