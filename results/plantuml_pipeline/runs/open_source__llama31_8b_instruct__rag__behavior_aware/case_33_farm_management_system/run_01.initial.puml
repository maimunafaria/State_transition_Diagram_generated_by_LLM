@startuml
[*] --> Login
state Login {
  [*] --> Verified
  Verified --> Dashboard
}
state Dashboard {
  [*] --> MarketConditions
  MarketConditions --> MarketReport : select market report
}
state MarketReport {
  [*] --> PestControlHelp : select pest control help
}
state PestControlHelp {
  [*] --> PhotoRequired : require photo
  PhotoRequired --> Techniques : show techniques
}
state Techniques {
  [*] --> SoilSuggestions : provide soil suggestions
}
state SoilSuggestions {
  [*] --> WeatherInsights : offer weather insights
}
state WeatherInsights {
  [*] --> LabourAvailability : display labour availability details
}
state LabourAvailability {
  [*] --> ContinueService : allow users to continue using the service
}
ContinueService --> Logout : log out
Logout --> [*]
@enduml
