@startuml
[*] --> State

state State {
  [*] --> DisplayJourneyDetails
  DisplayJourneyDetails --> ActivateDrivingMode : activate driving mode
  DisplayJourneyDetails --> SelectPlaceToEat : select place to eat
  SelectPlaceToEat --> ViewMenu : view menu
  SelectPlaceToEat --> PlaceOrder : place order

  state "Display Journey Details" as DisplayJourneyDetails {
    [*] --> LoginAndSelectDestination
    LoginAndSelectDestination --> DisplayJourneyDetails
  }

  state "Activate Driving Mode" as ActivateDrivingMode {
    [*] --> StartNavigation
    StartNavigation --> EndNavigation
  }

  state "Select Place To Eat" as SelectPlaceToEat {
    [*] --> ViewPlacesToEat
    ViewPlacesToEat --> SelectPlaceToEat
  }

  state "View Menu" as ViewMenu {
    [*] --> OrderFood
    OrderFood --> PayForOrder
  }

  state "Place Order" as PlaceOrder {
    [*] --> ConfirmOrder
    ConfirmOrder --> ReceiveOrderConfirmation
  }
}

state Logout {
  [*] --> EndSession
  EndSession --> [*]
}

State --> LoginAndSelectDestination
LoginAndSelectDestination --> DisplayJourneyDetails

ActivateDrivingMode --> StartNavigation
StartNavigation --> EndNavigation

SelectPlaceToEat --> ViewPlacesToEat
ViewPlacesToEat --> SelectPlaceToEat

ViewMenu --> OrderFood
OrderFood --> PayForOrder

PlaceOrder --> ConfirmOrder
ConfirmOrder --> ReceiveOrderConfirmation

Logout --> EndSession
EndSession --> [*]

@enduml
