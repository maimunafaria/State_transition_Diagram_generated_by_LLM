@startuml
title UML State Chart Diagram

[*] --> CreateAccount : User initiates registration

state CreateAccount {
    CreateAccount : entry / collect user details
}

CreateAccount --> ValidateRegistration : User submits form

state ValidateRegistration {
    ValidateRegistration : do / validate user data
}

ValidateRegistration --> Login : Registration successful
ValidateRegistration --> CreateAccount : Registration failed

Login : entry / enter login credentials
Login --> TicketStatus : Authentication successful
Login --> CreateAccount : Authentication failed

state TicketStatus {
    TicketStatus : entry / check ticket status
}

TicketStatus --> BookTicket : User chooses to book a ticket
TicketStatus --> Logout : User chooses to log out

BookTicket : entry / initiate booking process
BookTicket --> ConfirmPayment : Booking confirmed

ConfirmPayment : do / make payment
ConfirmPayment --> ManageAccount : Payment successful
ConfirmPayment --> BookTicket : Payment failed

state ManageAccount {
    ManageAccount : entry / manage account details
}

ManageAccount --> Logout : User completes action

Logout : entry / end session
Logout --> [*]

@enduml
