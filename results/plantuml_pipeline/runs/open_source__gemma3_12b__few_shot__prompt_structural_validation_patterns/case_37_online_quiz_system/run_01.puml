@startuml
title UML State Chart Diagram - Online Quiz System

[*] --> Login

state Login {
    [*] --> EnterDetails
    EnterDetails --> TeacherStudentChoice : [Login Successful]
}

state TeacherStudentChoice <<choice>>
TeacherStudentChoice --> CreateQuiz : [Teacher]
TeacherStudentChoice --> SelectQuiz : [Student]

state CreateQuiz {
    [*] --> EditQuiz
    EditQuiz --> SaveDraft : [Save as Draft]
    EditQuiz --> PostQuiz : [Post for Students]
}

state EditQuiz {
    [*] --> EnterDetails
    EnterDetails --> SaveDraft : [Save Changes]
    EnterDetails --> PostQuiz : [Publish Quiz]
}

state SaveDraft {
    --> EditQuiz : [Continue Editing]
}

state PostQuiz {
    --> ViewResults : [Quiz Posted]
}

state ViewResults {
    --> [*] : [End Session]
}

state SelectQuiz {
    --> AnswerQuiz : [Select Quiz]
}

state AnswerQuiz {
    --> SubmitQuiz : [Answer All Questions]
}

state SubmitQuiz {
    --> ViewResult : [Submit Quiz]
}

state ViewResult {
    --> [*] : [End Session]
}

TeacherStudentChoice --> [*] : [Logout]
@enduml
