@startuml
title Website Development State Diagram

[*] --> Homepage

state Homepage {
  Homepage : entry / Initial state
  Homepage --> Projects : navigateNavigationBar
}

state Projects {
  Projects : entry / Display project information
  Projects --> PhotosVideosChoice : selectProject
}

state PhotosVideosChoice <<choice>> {
  PhotosVideosChoice --> Photos : viewPhotos
  PhotosVideosChoice --> Videos : viewVideos
}

state CareerOpportunities {
  CareerOpportunities : entry / Display career opportunities
  CareerOpportunities --> UpdatesOrApplication : navigateToCareerPage
}

state UpdatesOrApplication <<choice>> {
  UpdatesOrApplication --> Updates : viewUpdates
  UpdatesOrApplication --> ApplicationForm : openApplicationForm
}

state ApplicationReview {
    ApplicationReview : entry / Check submitted job applications
}


Homepage --> CareerOpportunities : navigateNavigationBar
Projects --> Homepage : navigateNavigationBar
Photos --> Projects : navigateBack
Videos --> Projects : navigateBack
Updates --> CareerOpportunities : navigateBack
ApplicationForm --> CareerOpportunities : navigateBack

ApplicationForm --> ApplicationReview : submitApplication

[*] --> Homepage : initialNavigation
@enduml
