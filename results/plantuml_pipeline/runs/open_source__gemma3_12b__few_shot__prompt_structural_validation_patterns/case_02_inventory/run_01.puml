@startuml
title UML state machine diagram

[*] --> InventoryManagement

state InventoryManagement {
  state AddNewGoods : entry / Add new goods
  state UpdatePrice : entry / Update price of existing items
  state RemoveGoods : entry / Remove goods from inventory
  state IdentifyExpiredGoods : entry / Identify expired goods
  state PlaceOrder : entry / Place order to supplier
  state GenerateInvoice : entry / Generate invoice for the order
  state SearchAndSelectItems : entry / Search and select items
  state CalculateDiscountTax : entry / Calculate discount and tax
  state GenerateReceipt : entry / Generate receipt for customer
  state ReplaceCancelReceipt : entry / Replace or cancel receipt
  state RecordCustomerRequests : entry / Record customer requests
  state ViewSummaryReport : entry / View summary report

  AddNewGoods --> InventoryManagement : after adding goods
  UpdatePrice --> InventoryManagement : after updating price
  RemoveGoods --> InventoryManagement : after removing goods
  IdentifyExpiredGoods --> RemoveGoods : expired goods found
  PlaceOrder --> GenerateInvoice : order placed
  GenerateInvoice --> InventoryManagement : invoice generated
  SearchAndSelectItems --> CalculateDiscountTax : items selected
  CalculateDiscountTax --> GenerateReceipt : discount and tax calculated
  GenerateReceipt --> InventoryManagement : receipt generated
  ReplaceCancelReceipt --> GenerateReceipt : replacement or cancellation requested
  RecordCustomerRequests --> InventoryManagement : request recorded
  ViewSummaryReport --> InventoryManagement : report viewed

}

InventoryManagement --> [*]
@enduml
