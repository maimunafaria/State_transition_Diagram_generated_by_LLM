@startuml
title UML State Machine Diagram (Plane Management)

[*] --> OrderState

state "Order" as OrderState {
    --> ArrivalState : Delivered
}

state "Arrival" as ArrivalState {
    --> PreparationState : Arrived
}

state "Preparation" as PreparationState {
    --> OperationsState : Ready for operations
    --> MaintenanceState : Requires maintenance
}

state "Operations" as OperationsState {
    --> MaintenanceState : No scheduled flights or maintenance required
}

state "Maintenance" as MaintenanceState {
    --> PreparationState : Serviced and checked
}

state "Out of Service" as OutOfServiceState {
    --> [*] : Withdrawn from service
}

OperationsState --> [*] : Permanent withdrawal
ArrivalState --> [*] : Unreachable state
MaintenanceState --> [*] : Unreachable state
PreparationState --> [*] : Unreachable state
OrderState --> [*] : Unreachable state


@enduml
