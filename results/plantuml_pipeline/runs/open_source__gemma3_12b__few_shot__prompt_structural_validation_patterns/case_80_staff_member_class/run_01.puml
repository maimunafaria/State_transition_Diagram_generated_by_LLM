@startuml
title Staff Member State Diagram

[*] --> Unassigned

state "Unassigned" as Unassigned
state "Assigned to Client" as AssignedToClient
state "Assigned to Campaign" as AssignedToCampaign
state "Unemployed" as Unemployed
state "Archived" as Archived

Unassigned --> AssignedToClient : Assign to Client
Unassigned --> AssignedToCampaign : Assign to Campaign

AssignedToClient --> Unassigned : Remove Assignment
AssignedToCampaign --> Unassigned : Remove Assignment

AssignedToClient --> AssignedToCampaign : Switch Assignments
AssignedToCampaign --> AssignedToClient : Switch Assignments

AssignedToClient --> Unemployed : Leave Job
AssignedToCampaign --> Unemployed : Leave Job

Unemployed --> Archived : Time Passed

@enduml
