@startuml
title ATM Transaction

[*] --> Idle

state Idle {
    Idle : do / Ready for Card Insertion
}

state PinEntry {
    PinEntry : do / Prompt User for PIN
}

state PinVerification {
    PinVerification : do / Verify PIN against stored information
}

state OptionsAvailable {
    OptionsAvailable : do / Provide options to user
}

state WithdrawalProcessing {
    WithdrawalProcessing : do / Process withdrawal request
}

state ReceiptPrinting {
    ReceiptPrinting : do / Print receipt for transaction
}

state CardReturn {
    CardReturn : do / Return user's card
}

state Reset {
    Reset : do / Reset system for next user
}


Idle --> PinEntry : Card Inserted
PinEntry --> PinVerification : PIN Entered
PinVerification --> OptionsAvailable : PIN Verified Successfully
PinVerification --> Idle : Incorrect PIN

OptionsAvailable --> WithdrawalProcessing : User Approval
WithdrawalProcessing --> ReceiptPrinting : Cash Dispensed
ReceiptPrinting --> CardReturn : Printing Complete
CardReturn --> Reset : Transaction Completed
Reset --> Idle : Ready for Next User

@enduml
