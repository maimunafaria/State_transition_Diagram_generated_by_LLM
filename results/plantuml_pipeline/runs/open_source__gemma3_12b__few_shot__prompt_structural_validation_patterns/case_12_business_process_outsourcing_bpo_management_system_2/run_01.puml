@startuml
title BPO Management System - User Search State Diagram

[*] --> Searching

state Searching {
  state FilterCategorySelection
  state PriceRangeSelection
  state DisplayingResults

  FilterCategorySelection --> PriceRangeSelection : selectPriceRange
  PriceRangeSelection --> DisplayingResults : applyFilters

  DisplayingResults --> FilterCategorySelection : changeCategory
  DisplayingResults --> PriceRangeSelection : adjustPrice
}

Searching --> [*] : exit
@enduml
