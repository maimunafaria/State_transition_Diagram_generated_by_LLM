@startuml
title UML State Machine Diagram (Digidoclocker)

[*] --> Registration

state Registration {
  [*] --> CitizenLogin
  CitizenLogin : entry / Get Citizen Login Details
  CitizenLogin : do / Validate Login Details
  CitizenLogin : exit / Valid or Invalid Login
}

Registration --> [*] : [Invalid Registration]

Registration --> CitizenDashboard : [Valid Registration]

state CitizenDashboard <<choice>>

Choice1 --> UploadDocuments : [Upload Documents]
Choice1 --> ViewProfile : [View Profile]
Choice1 --> ApplyForCertificate : [Apply for Certificate]

state "Upload Documents" as UploadDocuments
UploadDocuments : entry / Get Document Details
UploadDocuments : do / Validate Document Details
UploadDocuments : exit / Document Uploaded

UploadDocuments --> CitizenDashboard : [Document Uploaded Successfully]

state ViewProfile {
  [*] --> ViewProfileDetails : [View Profile]
  ViewProfileDetails : entry / Display Profile
  ViewProfileDetails : do / Show Profile Information
  ViewProfileDetails : exit / Exit from Profile Viewing
}

ViewProfile --> CitizenDashboard

state ApplyForCertificate <<choice>>

Choice1 --> RequestCertificate : [Request Certificate]
Choice2 --> ReapplyForCertificate : [Reapply for Certificate]

state "Request Certificate" as RequestCertificate
RequestCertificate : entry / Get Certificate Details
RequestCertificate : do / Validate Certificate Details
RequestCertificate : exit / Certificate Requested

RequestCertificate --> CitizenDashboard : [Certificate Requested Successfully]

state "Reapply for Certificate" as ReapplyForCertificate
ReapplyForCertificate : entry / Send Request to Issuer
ReapplyForCertificate : do / Wait for Response
ReapplyForCertificate : exit / Continue Requesting Certificates

CitizenDashboard --> [*] : [Logout]
@enduml
