@startuml
title UML State Chart Diagram

[*] --> Login

state Login {
  [*] --> ValidLogin
  ValidLogin : entry / verifyData
  ValidLogin : do / allow Access to system
  ValidLogin : exit / mainArea
}

state MainArea <<choice>> {
  MainArea --> MarketConditions [valid]
  MainArea --> PestControlHelp [invalid]
  MainArea --> SoilSuggestions [invalid]
  MainArea --> WeatherInsights [invalid]
  MainArea --> LabourAvailability [invalid]
}

state MarketConditions {
  [*] --> [*]
}

state PestControlHelp {
  [*] --> Techniques : provideTechniques
  Techniques : entry / provideTechniques
  Techniques : do / showTechniques
  Techniques : exit / mainArea
}

state SoilSuggestions {
  [*] --> Suggestions : provideSuggestions
  Suggestions : entry / receiveSoilInfo
  Suggestions : do / suggestCrops
  Suggestions : exit / mainArea
}

state WeatherInsights {
  [*] --> Insights : provideInsights
  Insights : entry / receiveLocation
  Insights : do / showWeather
  Insights : exit / mainArea
}

state LabourAvailability {
  [*] --> Availability : provideAvailability
  Availability : entry / receiveLocation
  Availability : do / showLabour
  Availability : exit / mainArea
}

Login --> ValidLogin

ValidLogin --> MainArea

MainArea --> MarketConditions [valid]
MainArea --> PestControlHelp [invalid]
MainArea --> SoilSuggestions [invalid]
MainArea --> WeatherInsights [invalid]
MainArea --> LabourAvailability [invalid]

PestControlHelp --> Techniques

SoilSuggestions --> Suggestions

WeatherInsights --> Insights

LabourAvailability --> Availability

Techniques --> [*]

Suggestions --> [*]

Insights --> [*]

Availability --> [*]

Logout : entry / endSession
[*] --> Logout

@enduml
