@startuml
[*] --> CreateAccount : [create account]
state CreateAccount {
  [*] --> Login : [login]
}
state Login {
  [*] --> ViewWeather : [view weather]
  ViewWeather --> [*] : [end session]
}

state ViewWeather {
  [*] --> ChooseWeatherInfo : [choose weather info]
  ChooseWeatherInfo --> DisplayWeatherInfo : [display weather info]
  DisplayWeatherInfo --> [*] : [end session]
}
@enduml
