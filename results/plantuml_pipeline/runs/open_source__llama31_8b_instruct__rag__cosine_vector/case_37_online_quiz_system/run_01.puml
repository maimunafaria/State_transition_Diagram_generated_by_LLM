@startuml
title Online Quiz System — Polished Requirement Specification

state "Register" as Register
state "Login" as Login
state "Teacher" as Teacher
state "Student" as Student
state "Create Quiz" as CreateQuiz
state "Edit Quiz" as EditQuiz
state "Save Draft" as SaveDraft
state "Post for Students" as PostForStudents
state "View Results" as ViewResults
state "Select Quiz" as SelectQuiz
state "Answer Quiz" as AnswerQuiz
state "Submit Quiz" as SubmitQuiz
state "View Result" as ViewResult

[*] --> Register
Register --> Login : [*]
Login --> Teacher : [Teacher]
Login --> Student : [Student]

Teacher --> CreateQuiz
CreateQuiz --> EditQuiz : [Edit]
CreateQuiz --> SaveDraft : [Save Draft]
CreateQuiz --> PostForStudents : [Post for Students]

Student --> SelectQuiz
SelectQuiz --> AnswerQuiz : [Answer Quiz]
AnswerQuiz --> SubmitQuiz : [Submit Quiz]
SubmitQuiz --> ViewResult

ViewResults --> [*]
ViewResult --> [*]

@enduml
