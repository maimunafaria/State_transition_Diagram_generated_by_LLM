@startuml
[*] --> Login
state Login {
  [*] --> VerifyLogin
  VerifyLogin --> Verified : valid login
  Verified --> Dashboard : successful login
}
state Dashboard {
  [*] --> ViewMarketConditions : view market conditions
  ViewMarketConditions --> ShowMarketReport : show market report
  Dashboard --> PestControlHelp : pest control help
  PestControlHelp --> ShowPestControlTechniques : show pest control techniques
  Dashboard --> SoilSuggestions : soil suggestions
  SoilSuggestions --> ProvideSoilInformation : provide soil information
  Dashboard --> WeatherInsights : weather insights
  WeatherInsights --> ProvideLocation : provide location
  Dashboard --> LabourAvailability : labour availability
  LabourAvailability --> ProvideLocation : provide location
}
state PestControlHelp {
  [*] --> RequirePhoto : require photo
  RequirePhoto --> UploadPhoto : upload photo
  UploadPhoto --> ShowPestControlTechniques : show pest control techniques
}
state SoilSuggestions {
  [*] --> ProvideSoilInformation : provide soil information
  ProvideSoilInformation --> ShowCropSuggestions : show crop suggestions
}
state WeatherInsights {
  [*] --> ProvideLocation : provide location
  ProvideLocation --> ShowWeatherForecast : show weather forecast
}
state LabourAvailability {
  [*] --> ProvideLocation : provide location
  ProvideLocation --> ShowLabourDetails : show labour details
}
Dashboard --> Logout : logout

@enduml
