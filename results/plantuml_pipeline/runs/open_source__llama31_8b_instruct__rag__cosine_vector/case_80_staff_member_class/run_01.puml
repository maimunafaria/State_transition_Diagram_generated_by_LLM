@startuml
[*] --> StaffMemberAssigned

state StaffMemberAssigned {
  [*] --> AssignedToClient
  AssignedToClient --> RemovedFromAssignment : remove assignment
  RemovedFromAssignment --> Unassigned : back to unassigned state

  AssignedToClient --> SwitchedAssignments : switch assignments
  SwitchedAssignments --> AssignedToClient : continue working on new assignment

  StaffMemberAssigned --> MarkAsUnemployed : mark staff member as unemployed
}

MarkAsUnemployed --> ArchiveRecord : archive record of former employee

@enduml
