@startuml
title State diagram for inventory management

[*] --> Idle

state "Idle" as Idle
state "Added" as Added
state "Updated" as Updated
state "Removed" as Removed
state "Expired" as Expired
state "Ordered" as Ordered
state "Purchased" as Purchased
state "Billing" as Billing
state "Completed" as Completed

' user adds new goods to inventory
Idle --> Added : User adds new goods

' update price of existing item
Added --> Updated : User updates price of existing item

' remove goods from inventory
Added --> Removed : Goods removed from inventory

' expired goods identified and notified
Added --> Expired : Goods expire

' place order for additional goods
Added --> Ordered : User places order for additional goods

' select items for purchase
Ordered --> Purchased : User selects items for purchase

' billing process initiated
Purchased --> Billing : Billing process initiated

' transaction completed
Billing --> Completed : Transaction completed

' user requests unavailable item
Idle --> Added : Customer requests unavailable item

' view summary report of transactions
Completed --> [*] : User views summary report

@enduml
