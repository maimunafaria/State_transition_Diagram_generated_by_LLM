@startuml
title UML State Chart Diagram

[*] --> LoggedOut

state "Logged Out" as LoggedOut
LoggedOut : entry / User not signed in
LoggedOut : do / Sign in required
LoggedOut : exit / NIL

state "Logged In" as LoggedIn
LoggedIn : entry / User signed in
LoggedIn : do / Main Area displayed
LoggedIn : exit / NIL

state MainArea <<choice>>
MainArea : entry / Displayed after sign-in
MainArea : do / Select what to check
MainArea : exit / NIL

state MarketConditions <<choice>>
MarketConditions : entry / Selected from main area
MarketConditions : do / Show market conditions
MarketConditions : exit / NIL

state PestControlHelp <<choice>>
PestControlHelp : entry / Selected from main area
PestControlHelp : do / Require photo for pest control help
PestControlHelp : exit / NIL

state SoilInformation <<choice>>
SoilInformation : entry / User provides soil information
SoilInformation : do / Provide soil-related suggestions
SoilInformation : exit / NIL

state WeatherInsights <<choice>>
WeatherInsights : entry / User requests weather insights
WeatherInsights : do / Offer weather insights based on location
WeatherInsights : exit / NIL

state LabourAvailabilityDetails <<choice>>
LabourAvailabilityDetails : entry / User requests labour availability details
LabourAvailabilityDetails : do / Display labour availability details
LabourAvailabilityDetails : exit / NIL

MainArea --> LoggedIn
LoggedIn --> MainArea
LoggedOut --> LoggedIn

MarketConditions --> PestControlHelp
PestControlHelp --> MarketConditions

LoggedIn --> SoilInformation
SoilInformation --> LoggedIn

LoggedIn --> WeatherInsights
WeatherInsights --> LoggedIn

LoggedIn --> LabourAvailabilityDetails
LabourAvailabilityDetails --> LoggedIn

state SessionEnded <<choice>>
SessionEnded : entry / User logs out
SessionEnded : do / End session
SessionEnded : exit / NIL

MainArea --> SessionEnded
MarketConditions --> SessionEnded
PestControlHelp --> SessionEnded
SoilInformation --> SessionEnded
WeatherInsights --> SessionEnded
LabourAvailabilityDetails --> SessionEnded

[*] --> SessionEnded

@enduml
