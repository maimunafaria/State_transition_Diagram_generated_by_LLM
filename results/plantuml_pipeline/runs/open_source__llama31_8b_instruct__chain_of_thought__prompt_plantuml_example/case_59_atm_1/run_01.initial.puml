@startuml
title ATM State Diagram

[*] --> Idle

state Idle
state SelectingAmount
state InputtingCustomAmount
state Cancelled
state Completed

Idle --> SelectingAmount : user initiates transaction
SelectingAmount --> InputtingCustomAmount : select custom amount option
InputtingCustomAmount --> Completed : confirm custom amount
SelectingAmount --> Cancelled : cancel transaction
InputtingCustomAmount --> Cancelled : cancel transaction
Completed --> [*] : transaction complete
Cancelled --> [*] : transaction cancelled

@enduml
