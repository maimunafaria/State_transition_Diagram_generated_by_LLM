@startuml
[*] --> Idle : Initialization
Idle --> Cooking : Power Selection & Time Entry
Cooking --> [*] : Cancel
Cooking --> [*] : Door Open
Cooking --> [*] : Cooking Complete

state Idle {
    [*] --> Idle : Display Time
}

state Cooking {
    state DoorOpen {
        DoorOpen --> [*] : Stop
    }
}
@enduml
