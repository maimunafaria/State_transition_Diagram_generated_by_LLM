@startuml
[*] --> Unauthenticated
Unauthenticated --> Authenticating: UserLoginAttempt
Authenticating --> LoggedIn(Citizen): AuthenticationSuccess
Authenticating --> Unauthenticated: AuthenticationFailure
LoggedIn(Citizen) --> LoggedIn(Citizen): DocumentUpload
LoggedIn(Citizen) --> LoggedIn(Citizen): ProfileView
LoggedIn(Citizen) --> LoggedIn(Citizen): CertificateApplication
LoggedIn(Citizen) --> SessionEnded: LogoutRequest
SessionEnded --> [*]
@enduml
