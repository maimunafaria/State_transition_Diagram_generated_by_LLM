@startuml
[*] --> NormalTimeDisplay
NormalTimeDisplay --> TimeAdjustmentHour : ButtonPress(ModeSelect)
NormalTimeDisplay --> TimeAdjustmentMinute : ButtonPress(ModeSelect)
NormalTimeDisplay --> AlarmAdjustmentHour : ButtonPress(ModeSelect)
NormalTimeDisplay --> AlarmAdjustmentMinute : ButtonPress(ModeSelect)
NormalTimeDisplay --> AlarmRinging : AlarmTriggered
NormalTimeDisplay --> LightOn : ButtonPress(Light)

TimeAdjustmentHour --> TimeAdjustmentMinute : ButtonPress(ModeSelect)
TimeAdjustmentMinute --> AlarmAdjustmentHour : ButtonPress(ModeSelect)
AlarmAdjustmentHour --> AlarmAdjustmentMinute : ButtonPress(ModeSelect)
AlarmAdjustmentMinute --> NormalTimeDisplay : ButtonPress(ModeSelect)

AlarmRinging --> NormalTimeDisplay : ButtonPress(AlarmStop)
LightOn --> NormalTimeDisplay : ButtonRelease(Light)

AlarmAdjustmentMinute --> [*] : COMPLETION_EVENT
@enduml
