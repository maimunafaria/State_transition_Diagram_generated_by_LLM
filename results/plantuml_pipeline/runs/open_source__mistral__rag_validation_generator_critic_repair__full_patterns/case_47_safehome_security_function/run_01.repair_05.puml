@startuml
title Safehome Security Function State Diagram

@as diagram
skinparam backgroundColor #f2f2f2
skinparam arrowColor black
skinparam stateHighlightColor #d6eaf8
skinparam transitionHighlightColor #ff6347

state Startup {
  [*] --> INITIAL_STATE
  INITIAL_STATE --> Checking
}

state Checking {
  Checking : do / check everything during startup
  Checking --> ReadyToUse : no problems found
  Checking --> Resetting : problem during startup
}

state ReadyToUse {
  ReadyToUse : do / become ready to use if no problems found
  ReadyToUse --> StartMonitoring : user activates system
  ReadyToUse --> TurningOff : user turns off system
}

state Resetting {
  Resetting : do / allow user to reset
  Resetting --> [*] : user resets system
}

state Activating {
  Activating : do / allow user to activate
  ReadyToUse --> Activating : user activates system
  Activating --> StartMonitoring : user activates system
}

state TurningOff {
  TurningOff : do / allow user to turn off
  TurningOff --> [*] : user turns off system
}

state Monitoring {
  state Normal
  Normal : do / continue monitoring if no alarms
  Normal --> AlarmActive : sensor triggered
  Normal --> TimeEnded : time ends

  state AlarmActive {
    AlarmActive : do / start alarm and send alerts if sensor triggered
    AlarmActive --> FalseAlarm : false alarm
    AlarmActive --> Password : user enters the correct password
  }

  state FalseAlarm {
    FalseAlarm : do / continue monitoring if false alarm
    FalseAlarm --> Normal
  }

  state TimeEnded {
    TimeEnded : do / continue monitoring if time ends
    TimeEnded --> Normal
  }

  state Password {
    state WaitingForPassword
    WaitingForPassword : do / wait for user input at any time
    WaitingForPassword --> PasswordEntered : password entered
    PasswordEntered : do / check entered password
    PasswordEntered --> WaitingForPassword : incorrect password
    PasswordEntered --> Normal : correct password
  }
}

Startup --> Monitoring : no problems during startup and system activated
Monitoring --> Password : alarm triggered or system turned off
@enduml
