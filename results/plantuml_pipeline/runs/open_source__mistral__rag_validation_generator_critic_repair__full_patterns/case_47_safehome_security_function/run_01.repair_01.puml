@startuml
title Safehome Security Function State Diagram

@import "patterns/initial-transition.puml"
@import "patterns/final-transition.puml"
@import "patterns/connect-orphan-states.puml"
@import "patterns/unreachable-state-connection.puml"
@import "patterns/single-transition.puml"
@import "patterns/choice-node-guards.puml"
@import "patterns/fork-join-nodes.puml"
@import "patterns/composite-state.puml"
@import "patterns/no-history-inside-composite.puml"
@import "patterns/no-initial-transition-inside-composite.puml"

state Startup {
  [*] --> INITIAL_STARTUP
  INITIAL_STARTUP --> Checking
}

state Checking {
  state Checking
  Checking : do / check everything during startup

  state ReadyToUse
  ReadyToUse : do / become ready to use if no problems found

  state Resetting
  Resetting : do / allow user to reset

  Checking --> ReadyToUse : no problems found
  Checking --> Resetting : problem during startup
}

state ReadyToUse {
  state Activating
  Activating : do / allow user to activate

  state TurningOff
  TurningOff : do / allow user to turn off

  state Monitoring
  ReadyToUse --> Monitoring : user activates system or turns off system
}

state Monitoring {
  state Normal
  Normal : do / continue monitoring if no alarms

  state AlarmActive
  AlarmActive : do / start alarm and send alerts if sensor triggered

  state FalseAlarm
  FalseAlarm : do / continue monitoring if false alarm

  state TimeEnded
  TimeEnded : do / continue monitoring if time ends

  Normal --> AlarmActive : sensor triggered
  AlarmActive --> FalseAlarm : false alarm or time ended
  FalseAlarm --> Normal
  TimeEnded --> Normal
}

state Password {
  state WaitingForPassword
  WaitingForPassword : do / wait for user input at any time

  state PasswordEntered
  PasswordEntered : do / check entered password

  WaitingForPassword --> PasswordEntered : password entered
  PasswordEntered --> WaitingForPassword : incorrect password or password correct and system returning to normal
}

Startup --> Monitoring : no problems during startup and system activated
Monitoring --> Password : alarm triggered or system turned off
Password --> Monitoring : user enters the correct password
@enduml
