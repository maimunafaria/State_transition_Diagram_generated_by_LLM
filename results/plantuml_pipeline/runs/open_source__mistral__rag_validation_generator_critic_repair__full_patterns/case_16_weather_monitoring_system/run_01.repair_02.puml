@startuml
title UML state machine diagram

@import "patterns.puml"

state Idle
Idle --> INITIAL_STATE
INITIAL_STATE --> Register
Register --> Login
Login --> InvalidLogin
InvalidLogin --> Idle
Login --> CheckWeather
CheckWeather --> ViewLocation
ViewLocation --> ValidateLocation
ValidateLocation --> ChooseWeatherInfo
ChooseWeatherInfo --> UpdateWeatherInfo
UpdateWeatherInfo --> ViewAdditionalDetails
ViewAdditionalDetails --> Logout
Logout --> [*] : COMPLETION_EVENT

state Register
Register --> Login : ValidRegistration
Register --> InvalidRegistration : InvalidRegistration

state InvalidRegistration
InvalidRegistration --> Idle : CannotRegister

state Login
Login --> InvalidLogin : InvalidCredentials

state CheckWeather
CheckWeather --> ViewLocation : EnterLocation

state ValidateLocation
ValidateLocation --> ValidateLocation : ValidLocation
ValidateLocation --> InvalidLocation : InvalidLocation

state ChooseWeatherInfo
ChooseWeatherInfo --> TemperatureInfo
ChooseWeatherInfo --> HumidityInfo
ChooseWeatherInfo --> RainfallInfo
ChooseWeatherInfo --> PressureInfo
ChooseWeatherInfo --> DewPointInfo

state ViewAdditionalDetails
ViewAdditionalDetails --> WeatherAlerts
ViewAdditionalDetails --> WeeklyAnalysis
ViewAdditionalDetails --> FuturePrediction
ViewAdditionalDetails --> Graph

state ValidLocation
ValidLocation --> ChooseWeatherInfo

state InvalidLocation
InvalidLocation --> Idle : InvalidLocationEntered
@enduml
