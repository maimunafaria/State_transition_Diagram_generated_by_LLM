@startuml
@startstate
[*] --> INITIAL_STATE
INITIAL_STATE --> Homepage
Homepage --> NavigationBar
NavigationBar --> Projects
Projects : displayInfo
Projects : photosVideosChoice

Photos : viewPhotos
Videos : viewVideos
ApplicationForm : openForm
Updates : viewUpdates

Projects --> CareerOpportunities
CareerOpportunities : updateApplicationFormChoice

state DECISION_NODE <<choice>>
Projects --> DECISION_NODE : userSelection
DECISION_NODE --> Photos : [userChosePhotos]
DECISION_NODE --> Videos : [userChoseVideos]

CareerOpportunities --> JobApplications
JobApplications : submitApplication
JobApplications : checkSubmittedApplications

state DECISION_NODE2 <<choice>>
CareerOpportunities --> DECISION_NODE2 : userChoice
DECISION_NODE2 --> Updates : [userChoseUpdates]
DECISION_NODE2 --> ApplicationForm : [userChoseApplicationForm]

JobApplications --> TERMINAL_STATE : applicationProcessed
TERMINAL_STATE --> [*] : COMPLETION_EVENT
@endstate
@enduml
