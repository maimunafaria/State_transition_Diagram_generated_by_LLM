@startuml
[*] --> INITIAL_STATE
INITIAL_STATE --> Homepage
Homepage --> NavigationBar
NavigationBar --> Projects
Projects : displayInfo
Projects : photosVideosChoice

Projects --> CareerOpportunities
CareerOpportunities : updateApplicationFormChoice

state PhotosChoice <<choice>>
Projects : photosVideosChoice --> Photos
Photos : viewPhotos

state VideosChoice <<choice>>
Projects : photosVideosChoice --> Videos
Videos : viewVideos

CareerOpportunities --> Updates
Updates : viewUpdates

CareerOpportunities --> JobApplications
JobApplications : submitApplication
JobApplications : checkSubmittedApplications

state EmploymentChoice <<choice>>
CareerOpportunities : updateApplicationFormChoice --> Employment
Employment : openForm

state InternshipChoice <<choice>>
CareerOpportunities : updateApplicationFormChoice --> Internship
Internship : openForm

JobApplications --> TERMINAL_STATE : COMPLETION_EVENT
TERMINAL_STATE --> [*] : SUPPORTED_EVENT
@enduml
