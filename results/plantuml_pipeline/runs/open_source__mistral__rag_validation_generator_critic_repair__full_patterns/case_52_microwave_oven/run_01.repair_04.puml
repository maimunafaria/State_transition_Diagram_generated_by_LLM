@startuml
title Microwave Oven State Machine Diagram

[*] --> INITIAL_STATE
INITIAL_STATE --> Idle
Idle --> TimeDisplay
TimeDisplay --> PowerLevelSelection
PowerLevelSelection --> CookingTimeInput
CookingTimeInput --> DoorOpen : doorOpenDuringOperation()
DoorOpen --> Inactive : doorOpenedDuringCooking()
Inactive --> Idle : doorClosed()
Idle --> Cancel : cancelButtonClicked()
Cancel --> Idle
CookingTimeInput --> Idle : enterCookingTime()
Idle --> Stop : stopButtonClicked()
Stop --> Cancel : cancelButtonClicked()
CookingTimeInput --> Cooking : cookingStarted()
Cooking --> Inactive : doorOpenedDuringCooking()
@enduml
