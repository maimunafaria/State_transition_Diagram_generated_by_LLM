@startuml
title Microwave Oven State Machine Diagram

[*] --> INITIAL_STATE
INITIAL_STATE --> Idle
Idle --> TimeDisplay
TimeDisplay --> PowerLevelSelection
PowerLevelSelection --> CookingTimeInput
CookingTimeInput --> DoorOpen
DoorOpen --> Inactive : doorOpenDuringOperation()
DoorOpen --> Stop : doorOpenedDuringCooking()
Inactive --> Idle : doorClosed()
Stop --> Cancel : cancelButtonClicked()
Cancel --> Idle
CookingTimeInput --> Idle : enterCookingTime()
Idle --> Inactive : openDoor()
@enduml
