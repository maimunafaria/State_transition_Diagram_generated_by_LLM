@startuml
title UML State Machine Diagram

@valid
[*] --> Registration : SUPPORTED_EVENT
Registration --> ReEnterDetails : [Invalid]
ReEnterDetails --> RegEnterDetails
RegEnterDetails --> GetMemberID : [Valid]
GetMemberID --> SuccessfulRegistration

[*] --> Authentication : SUPPORTED_EVENT
Authentication --> AuthEnterMemberID
AuthEnterMemberID --> EnterPassword
EnterPassword --> SuccessfulLogin : [Valid]
EnterPassword --> InvalidCreds : [Invalid]

[*] --> SearchBooks : SUPPORTED_EVENT
SearchBooks --> EnterBookDetails : [Found]
EnterBookDetails --> DisplaySuggestion
DisplaySuggestion --> ChooseAlternate : [Not Found]

[*] --> GetBooksState : SUPPORTED_EVENT
GetBooksState --> GetEnterBookID
GetBooksState --> ObtainBooks : [Active Member]

[*] --> BuyBooks : SUPPORTED_EVENT
BuyBooks --> BuyEnterBookID
BuyBooks --> DisplayBookAmount : [Paid]
DisplayBookAmount --> BuyGetBooks
@invalid
BuyNotPaidEnd --> [*]
@enduml
