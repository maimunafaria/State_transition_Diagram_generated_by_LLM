@startuml
[*] --> Registered
[*] --> Unregistered

Unregistered --> Registration
Registration --> Registered : Successful Registration
Registration --> RegistrationFailed : Registration Failed

Registered --> NewsAndContent : Sign In
Registered --> HealthInfo : Access Available Facilities
Registered --> Logout : Sign Out

NewsAndContent --> Registered : Continue
HealthInfo --> Registered : Continue
HealthInfo --> ResultView : View Result
ResultView --> Registered : Continue
ResultView --> Logout : Finish Session

Registered --> InsuranceProcessing : Finance Services
InsuranceProcessing --> PaymentProcessing : Validate Insurance
PaymentProcessing --> Registered : Complete Payment
PaymentProcessing --> InsuranceProcessingFailed : Payment Failed

Registered --> DrugPurchase : Drug/Supplement Purchase
DrugPurchase --> PaymentSelection : Select Payment Method
PaymentSelection --> CashPayment : Cash
PaymentSelection --> InsurancePayment : Insurance

CashPayment --> DrugPurchaseComplete : Inform Cash Details
InsurancePayment --> DrugPurchaseComplete : Complete Insurance Payment
DrugPurchaseComplete --> Registered : Return to Main

[*] --> Logout : Timeout
Logout --> [*]

@enduml
