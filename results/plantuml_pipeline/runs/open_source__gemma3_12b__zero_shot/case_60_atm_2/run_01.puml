@startuml
state Idle {
  [*] --> SelectAmount
}

state SelectAmount {
  SelectAmount : displayAmountOptions()
  SelectAmount --> EnterCustomAmount : userSelectsCustomAmount()
  SelectAmount --> VerifyTransaction : userSelectsAmount()
}

state EnterCustomAmount {
  EnterCustomAmount : promptForCustomAmount()
  EnterCustomAmount --> VerifyTransaction : userEntersCustomAmount()
}

state VerifyTransaction {
  VerifyTransaction : verifyTransaction()
  VerifyTransaction --> SelectAmount : transactionRejected()
  VerifyTransaction --> DispenseCash {
    transactionApproved()
  }
}

state DispenseCash {
  DispenseCash : dispenseCash()
  DispenseCash --> [*]
}

@enduml
