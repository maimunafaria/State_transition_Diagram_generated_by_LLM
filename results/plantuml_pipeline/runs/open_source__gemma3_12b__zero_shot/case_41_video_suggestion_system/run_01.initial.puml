@startuml
state Idle {
  [*] --> RequestReceived
}

state RequestReceived {
  RequestReceived --> IdentifyingUser : receive request
}

state IdentifyingUser {
  IdentifyingUser --> GatheringVideos : user identified
}

state GatheringVideos {
  GatheringVideos --> AddingDetails : videos gathered
}

state AddingDetails {
  AddingDetails --> SendingVideos : details added
}

state SendingVideos {
  SendingVideos --> Completed : videos sent
}

state Completed {
  [*] --> Idle
  Completed --> [*]
}

@enduml
