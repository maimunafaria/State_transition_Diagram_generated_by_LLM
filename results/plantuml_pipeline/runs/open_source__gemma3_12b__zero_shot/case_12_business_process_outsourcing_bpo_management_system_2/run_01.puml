@startuml
state Initial {
  [*] --> Searching
}

state Searching {
  Searching --> DisplayingResults
  event FilterCategorySelected
  event PriceRangeSelected
}

state DisplayingResults {
  DisplayingResults --> [*]
}

Searching --> DisplayingResults : FilterCategorySelected
Searching --> DisplayingResults : PriceRangeSelected

@enduml
