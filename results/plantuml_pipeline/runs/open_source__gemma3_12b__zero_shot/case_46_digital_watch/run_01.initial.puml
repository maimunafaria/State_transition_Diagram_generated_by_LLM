@startuml
state Normal {
    [*] --> Normal : System Start
}

state AdjustingTime {
    AdjustingTime --> AdjustingTime : Increase
    AdjustingTime --> Normal : Confirm
}

state AdjustingAlarmTime {
    AdjustingAlarmTime --> AdjustingAlarmTime : Increase
    AdjustingAlarmTime --> Normal : Confirm
}

state AlarmRinging {
    AlarmRinging --> Normal : StopAlarm
}

state LightOn {
    LightOn --> LightOn : Keep Pressed
    LightOn --> Normal : Release
}

Normal --> AdjustingTime : Adjust Time
Normal --> AdjustingAlarmTime : Adjust Alarm Time
Normal --> AlarmRinging : Alarm Triggered
Normal --> LightOn : Toggle Light

AdjustingTime --> Normal : Confirm
AdjustingAlarmTime --> Normal : Confirm
AlarmRinging --> Normal : StopAlarm
LightOn --> Normal : Release

@enduml
