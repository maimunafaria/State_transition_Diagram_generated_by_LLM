@startuml
state Idle {
    [*] --> JourneyDetails
}

state JourneyDetails {
    JourneyDetails : Display journey details
    event ActivateDrivingMode
    event ChooseOtherOptions
    event SelectRestaurant
    JourneyDetails --> DrivingMode : ActivateDrivingMode
    JourneyDetails --> OtherOptions : ChooseOtherOptions
    JourneyDetails --> RestaurantSelection : SelectRestaurant
}

state DrivingMode {
    DrivingMode : Driving
    event Accident
    event JourneyComplete
    DrivingMode --> AccidentReport : Accident
    DrivingMode --> Feedback : JourneyComplete
}

state OtherOptions {
    OtherOptions : Other Options
    event ReturnToJourneyDetails
    OtherOptions --> JourneyDetails : ReturnToJourneyDetails
}

state RestaurantSelection {
    RestaurantSelection : View Menu, Place Order
    event ReturnToJourneyDetails
    RestaurantSelection --> JourneyDetails : ReturnToJourneyDetails
}

state AccidentReport {
    AccidentReport : Inform Authorities
    event NotificationSent
    AccidentReport --> Idle : NotificationSent
}

state Feedback {
    Feedback : Provide Feedback
    event NotificationSent
    Feedback --> Idle : NotificationSent
}

@enduml
