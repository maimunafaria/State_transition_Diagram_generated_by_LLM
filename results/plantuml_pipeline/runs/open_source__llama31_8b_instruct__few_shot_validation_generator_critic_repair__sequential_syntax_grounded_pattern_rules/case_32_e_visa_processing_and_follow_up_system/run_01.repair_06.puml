@startuml
[*] --> CreateUser
state Choice1 <<choice>>
state Choice2 <<choice>>
state Choice3 <<choice>>
state Choice4 <<choice>>
state Choice5 <<choice>>
state Choice6 <<choice>>
state Choice7 <<choice>>
state Choice8 <<choice>>
state Choice9 <<choice>>
state Choice10 <<choice>>
state Choice11 <<choice>>

CreateUser : entry / nil
CreateUser : do / Create account
CreateUser : exit / Login

CreateUser --> Login : user creates account

Login : entry / nil
Login : do / Login
Login : exit / Application

Login --> Application : user logs in

Application : entry / Login
Application : do / Apply for visa
Application : exit / Payment

Application --> Payment : user applies for visa

Payment : entry / Application
Payment : do / Make payment
Payment : exit / Accepted

Payment --> Accepted : payment made

Accepted : entry / Payment
Accepted : do / Accept application
Accepted : exit / Status

Accepted --> Status : application accepted

Status : entry / Accepted
Status : do / View status
Status : exit / Check status

Status --> Choice1 : [user views status]
Choice1 --> CheckStatus : user checks status
CheckStatus : entry / Status
CheckStatus : do / Check status
CheckStatus --> Cancel : user checks status

Cancel : entry / CheckStatus
Cancel : do / Cancel application
Cancel : exit / Logout

Cancel --> Logout : user cancels application

ModifyDetails : entry / Login
ModifyDetails : do / Modify details
ModifyDetails : exit / Logout

ModifyDetails --> Logout : user modifies details

ViewDetails : entry / Login
ViewDetails : do / View details
ViewDetails : exit / Logout

ViewDetails --> Logout : user views details

ViewPurpose : entry / Login
ViewPurpose : do / View purpose
ViewPurpose : exit / Update status

ViewPurpose --> Choice2 : [user views purpose]
Choice2 --> UpdateStatus : user updates status
UpdateStatus : entry / ViewPurpose
UpdateStatus : do / Update status
UpdateStatus --> Logout : user updates status

GiveFeedback : entry / CheckStatus
GiveFeedback : do / Give feedback
GiveFeedback : exit / Logout

GiveFeedback --> Choice3 : [user gives feedback]
Choice3 --> Logout : user logs out

Logout : entry / nil
Logout : do / Logout
Logout : exit / [*]

Login --> ModifyDetails : user logs in to modify details
Login --> ViewDetails : user logs in to view details
Login --> ViewPurpose : user logs in to view purpose
Login --> GiveFeedback : user logs in to give feedback

Status --> Choice4 : [user views status]
Choice4 --> CheckStatus : user checks status
CheckStatus --> Choice5 : [user checks status]
Choice5 --> Cancel : user cancels application
Cancel --> Logout : user logs out

ModifyDetails --> Choice6 : [user modifies details]
Choice6 --> Logout : user logs out

ViewDetails --> Choice7 : [user views details]
Choice7 --> Logout : user logs out

ViewPurpose --> Choice8 : [user views purpose]
Choice8 --> UpdateStatus : user updates status
UpdateStatus --> Logout : user logs out

GiveFeedback --> Choice9 : [user gives feedback]
Choice9 --> Logout : user logs out

Application --> Choice10 : [user applies for visa]
Choice10 --> Payment : user makes payment

Payment --> Choice11 : [payment made]
Choice11 --> Accepted : application accepted
Accepted --> Choice12 : [application accepted]
Choice12 --> Status : status updated
Status --> Choice13 : [status viewed]
Choice13 --> CheckStatus : user checks status
CheckStatus --> Logout : user logs out

Logout --> [*] : COMPLETION_EVENT
@enduml
