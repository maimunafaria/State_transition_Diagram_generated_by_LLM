@startuml
title Inventory State Machine

[*] --> InventoryMenu

state AddGoods {
  entry / start state
  do / add new goods
  exit / goods added
  AddGoods --> InventoryMenu
}

state UpdatePrice {
  entry / start state
  do / update price of existing items
  exit / price updated
  UpdatePrice --> InventoryMenu
}

state RemoveGoods {
  entry / start state
  do / remove goods from inventory
  exit / goods removed
  RemoveGoods --> InventoryMenu
}

state ExpireCheck {
  entry / start state
  do / check for expired goods
  exit / expired goods identified
  ExpireCheck --> RemoveGoods
}

state PlaceOrder {
  entry / start state
  do / place order with supplier
  exit / order placed
  PlaceOrder --> GenerateInvoice
}

state SearchItems {
  entry / start state
  do / search for items in inventory
  exit / items selected
  SearchItems --> PurchaseItems
}

state CalculateDiscount {
  entry / start state
  do / calculate applicable discount
  exit / discount calculated
  CalculateDiscount --> GenerateReceipt
}

state GenerateReceipt {
  entry / start state
  do / generate receipt for purchase
  exit / receipt generated
  GenerateReceipt --> InventoryMenu
}

state ReplaceItem {
  entry / start state
  do / replace an item or cancel receipt
  exit / item replaced or receipt cancelled
  ReplaceItem --> InventoryMenu
}

state RecordRequest {
  entry / start state
  do / record customer requests
  exit / request recorded
  RecordRequest --> InventoryMenu
}

state GenerateSummary {
  entry / start state
  do / generate summary report
  exit / report generated
  GenerateSummary --> InventoryMenu
}

state InventoryMenu {
  InventoryMenu --> [*
@enduml
