@startuml
title UML State Machine Diagram - Microwave Oven

[*] --> DisplayTime

state "Display Time" as DisplayTime
state "Choose Power Level" as ChoosePowerLevel
state "Set Cooking Time" as SetCookingTime
state "Cooking" as Cooking
state "Door Open" as DoorOpen
state "Stopped" as Stopped
state "Cancelled" as Cancelled

DisplayTime --> ChoosePowerLevel

ChoosePowerLevel -> SetCookingTime : Full Power
ChoosePowerLevel --> DisplayTime : Half Power

SetCookingTime --> Cooking

Cooking --> DoorOpen : Door Open
Cooking --> Stopped : User Cancels
Cooking --> Cancelled : Cancel

DoorOpen --> Stopped : Door Closed

Stopped --> DisplayTime
Cancelled --> DisplayTime

DisplayTime --> [*]
@enduml
