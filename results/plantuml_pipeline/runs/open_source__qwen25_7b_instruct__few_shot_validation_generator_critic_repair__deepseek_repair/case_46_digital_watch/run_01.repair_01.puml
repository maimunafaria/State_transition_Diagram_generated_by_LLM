@startuml
title UML State Machine Diagram - Digital Watch

[*] --> ViewTime

state "View Time" as ViewTime
state "Adjust Hour" as AdjustHour
state "Adjust Minute" as AdjustMinute
state "Adjust Alarm Hour" as AdjustAlarmHour
state "Adjust Alarm Minute" as AdjustAlarmMinute
state "Alarm On" as AlarmOn
state "Alarm Off" as AlarmOff
state "Alarm Triggered" as AlarmTriggered
state "Light On" as LightOn
state "Light Off" as LightOff

ViewTime --> AdjustHour : press button (Adjust Hour)
AdjustHour --> ViewTime : press button (Back to Time)
AdjustHour --> AdjustMinute : press button (Adjust Minute)

ViewTime --> AdjustAlarmHour : press button (Adjust Alarm Hour)
AdjustAlarmHour --> AdjustAlarmMinute : press button (Adjust Alarm Minute)
AdjustAlarmMinute --> ViewTime : press button (Back to Time)

ViewTime --> LightOn : press button (Light On)
LightOn --> LightOff : press button (Light Off)
LightOff --> LightOn : press button (Light On)

ViewTime --> AlarmOn : press button (Enable Alarm)
AlarmOn --> AlarmOff : press button (Disable Alarm)
AlarmOff --> AlarmOn : press button (Enable Alarm)
AlarmOff --> AlarmTriggered : alarm time matches current time

AlarmTriggered --> AlarmOff : press stop button
AlarmTriggered --> [*] : exit application

@enduml
