@startuml
[*] --> INITIAL_STATE
INITIAL_STATE --> LoggedIn : SIGN_IN_EVENT

state LoggedIn {
  [LoggedIn] --> Dashboard : SHOW_MAIN_AREA
  Dashboard --> MarketConditions : CHECK_MARKET_CONDITIONS
  MarketConditions --> MarketReport : SHOW_MARKET_REPORT

  Dashboard --> PestControlHelp : CHOOSE_PEST_CONTROL_HELP
  PestControlHelp --> PhotoRequired : REQUIRE_PHOTO
  PhotoRequired --> PestControlTechniques : SHOW_TECHNIQUES

  Dashboard --> SoilInfo : RECEIVE_SOIL_INFORMATION
  SoilInfo --> Suggestions : PROVIDE_SUGGESTIONS

  Dashboard --> WeatherInsights : OFFER_WEATHER_INSIGHTS
  Dashboard --> LabourAvailability : DISPLAY_LABOUR_AVAILABILITY_DETAILS

  Dashboard --> Results : SHOW_RESULTS
  Results --> Continue : ALLOW_TO_CONTINUE_USING_SERVICE

  LoggedIn --> [*] : LOGOUT
}
@enduml
