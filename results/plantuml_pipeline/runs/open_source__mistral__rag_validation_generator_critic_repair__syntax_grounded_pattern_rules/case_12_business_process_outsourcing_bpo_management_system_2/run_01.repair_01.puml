@startuml
title UML State Machine Diagram - Search Users

[*] --> INITIAL_STATE
INITIAL_STATE --> ChooseUserType

state ChooseUserType <<choice>>
ChooseUserType --> NewUser : [New user]
ChooseUserType --> RegisteredUser : [Registered user]

state "New User Registration" as NewUserRegistration {
    [*] --> EnterDetails

    state EnterDetails
    state ChoiceReg <<choice>>
    state "Update Database" as UpdateDB
    state EndInvalid <<choice>>

    EnterDetails --> ChoiceReg : [Registration verification]
    ChoiceReg --> UpdateDB : [valid]
    ChoiceReg --> EndInvalid : [invalid]

    EndInvalid --> [*]
}

NewUserRegistration : entry / New user registration
NewUserRegistration : do / Registration details
NewUserRegistration : exit / After updation

UpdateDB --> Login : [verified]

state Login
Login : do / Enter username and password
Login : exit / After verification

Login --> Profile : [valid uname & pwd]

state "Profile" as Profile {
    [*] --> ChoiceProfile

    state ChoiceProfile <<choice>>
    state "View or Edit profile" as EditProfile
    state "Search users" as SearchUsers
    state "View current deals" as ViewDeals
    state "Add to wishlist" as AddToWishlist
    state "Move from wishlist to cart" as MoveFromWishlistToCart

    ChoiceProfile --> EditProfile : [edit profile data]
    ChoiceProfile --> SearchUsers : [search user]
    ChoiceProfile --> ViewDeals : [current deals]
    ChoiceProfile --> AddToWishlist : [add product to wishlist]
    ChoiceProfile --> MoveFromWishlistToCart : [move from wishlist to cart]

    Profile : entry / View or Edit profile
    Profile : do / Search users
    Profile : do / View current deals
    Profile : do / Add to wishlist
    Profile : do / Move from wishlist to cart
    Profile : exit / Logout

    EditProfile --> [*] : [Logout]
    SearchUsers --> [*] : [Logout]
    ViewDeals --> [*] : [Logout]
    AddToWishlist --> [*] : [Logout]
    MoveFromWishlistToCart --> [*] : [Logout]
}

state "Search Users" as SearchUsers {
  state FilterSelection
  FilterSelection --> PriceRangeFilter : [Price range filter selection]
  FilterSelection --> CategoryFilter : [Category filter selection]
  state MatchedUsers
  MatchedUsers : entry / Display matching users
  MatchedUsers : do / Display user details
  MatchedUsers : exit / Back to profile
}
SearchUsers : entry / Search users
SearchUsers : do / Navigate to search users
Profile --> SearchUsers : [search users]
@enduml
