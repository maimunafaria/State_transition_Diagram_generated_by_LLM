@startuml
state Homepage
Homepage --> INITIAL_STATE

INITIAL_STATE --> NavigationBar
NavigationBar --> Projects
Projects : displayInfo
Projects : photosVideosChoice

state PhotosChoice <<choice>>
PhotosVideosChoice : choosePhotos
PhotosChoice --> Photos
PhotosChoice --> Videos

state Photos
Photos : viewPhotos

state Videos
Videos : viewVideos

Projects --> CareerOpportunities
CareerOpportunities : updateApplicationFormChoice

state CareerOpportunitiesChoice <<choice>>
CareerOpportunitiesChoice : chooseUpdatesOrForm
CareerOpportunitiesChoice --> Updates
CareerOpportunitiesChoice --> ApplicationForm

state Updates
Updates : viewUpdates

state ApplicationForm
ApplicationForm : openForm

CareerOpportunities --> JobApplications
JobApplications : submitApplication
JobApplications : checkSubmittedApplications

TERMINAL_STATE = CareerOpportunities
TERMINAL_STATE --> [*] : COMPLETION_EVENT
@enduml
