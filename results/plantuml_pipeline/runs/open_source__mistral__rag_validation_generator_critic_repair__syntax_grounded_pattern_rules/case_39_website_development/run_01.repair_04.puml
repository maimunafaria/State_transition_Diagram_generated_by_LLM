@startuml
state Homepage
Homepage --> INITIAL_STATE

INITIAL_STATE --> NavigationBar
NavigationBar --> Projects
Projects : displayInfo
Projects : photosVideosChoice

Projects --> CareerOpportunities
CareerOpportunities : updateApplicationFormChoice

state PhotosChoice <<choice>>
Photos : viewPhotos
Projects --> PhotosChoice
PhotosChoice --> Photos : [user chooses photos]
PhotosChoice --> Videos : [user chooses videos]

state VideosChoice <<choice>>
Videos : viewVideos
Projects --> VideosChoice
VideosChoice --> Photos : [user chooses photos]
VideosChoice --> Videos : [user chooses videos]

CareerOpportunities --> Updates
Updates : viewUpdates

CareerOpportunities --> ApplicationFormChoice <<choice>>
ApplicationFormChoice --> ApplicationForm : [user chooses application form]
ApplicationFormChoice --> JobApplications : [user chooses job application]

JobApplications : submitApplication
JobApplications --> CheckSubmittedApplications
CheckSubmittedApplications : checkSubmittedApplications

TERMINAL_STATE --> [*] : COMPLETION_EVENT
@enduml
