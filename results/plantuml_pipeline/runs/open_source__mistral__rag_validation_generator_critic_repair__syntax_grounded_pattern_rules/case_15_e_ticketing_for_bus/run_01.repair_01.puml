@startuml
[*] --> INITIAL_STATE
INITIAL_STATE --> LoggedIn : registration_success

state LoggedIn {
  [*] --> Dashboard
  Dashboard --> Settings : open settings
  Settings --> Dashboard : back
  Dashboard --> BookTicket : book_ticket
  BookTicket --> PaymentConfirmation : payment_confirmed
  PaymentConfirmation --> OrderCompleted : order_completed
  OrderCompleted --> LoggedIn : logout
}

LoggedIn --> [*] : logout
@enduml
