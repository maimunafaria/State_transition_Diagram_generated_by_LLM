@startuml
Digital Watch State Machine Diagram

state Idle
Idle --> INITIAL_STATE
INITIAL_STATE --> ChangeTime
ChangeTime --> HourAdjust
HourAdjust --> MinuteAdjust
MinuteAdjust --> AlarmHourAdjust
AlarmHourAdjust --> AlarmMinuteAdjust
AlarmMinuteAdjust --> LightOnOff
LightOnOff --> Idle : SUPPORTED_EVENT

state AlarmOn
AlarmOn --> AlarmRinging
AlarmRinging --> AlarmStopped
AlarmStopped --> Idle : COMPLETION_EVENT

state LightOn
LightOn --> LightOff : SUPPORTED_EVENT
LightOff --> Idle

state AlarmOff
AlarmOff --> Idle

TERMINAL_STATE --> [*] : COMPLETION_EVENT
@enduml
