@startuml
Digital Watch State Machine Diagram

[*] --> Idle
Idle --> ChangeTime
ChangeTime --> HourAdjust
HourAdjust --> MinuteAdjust
MinuteAdjust --> AlarmHourAdjust
AlarmHourAdjust --> AlarmMinuteAdjust
AlarmMinuteAdjust --> LightOnOff
LightOnOff --> Idle : COMPLETION_EVENT

state AlarmOn
AlarmOn --> AlarmRinging
AlarmRinging --> AlarmStopped : ALARM_TRIGGERED
AlarmStopped --> Idle : ALARM_STOPPED

state LightOn
LightOn --> LightOff : LIGHT_OFF_EVENT
LightOff --> Idle

Idle --> TERMINAL_STATE : USER_EXIT
TERMINIAL_STATE --> [*] : COMPLETION_EVENT
@enduml
