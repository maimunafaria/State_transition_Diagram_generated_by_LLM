@startuml
title Campaign State Machine Diagram

state "Idle" as Idle
[*] --> Idle : entry/No campaign assigned

state "Start Campaign" as StartCampaign
Idle --> StartCampaign : do/Assign manager and staff / Start campaign

state "Activate Campaign" as ActivateCampaign
StartCampaign --> ActivateCampaign : do/Campaign activated

state "Prepare Adverts" as PrepareAdverts
ActivateCampaign --> PrepareAdverts : do/Prepare adverts

state "Schedule Adverts" as ScheduleAdverts
PrepareAdverts --> ScheduleAdverts : do/Approve adverts

state "Adjust Campaign" as AdjustCampaign
ScheduleAdverts --> AdjustCampaign : exit/Run adverts

state "Complete Campaign" as CompleteCampaign
AdjustCampaign --> CompleteCampaign : do/Complete campaign

state "Pay Campaign" as PayCampaign
CompleteCampaign --> PayCampaign : do/Pay campaign

state "Archive Campaign" as ArchiveCampaign
PayCampaign --> ArchiveCampaign : do/Archive campaign

state "Refund Campaign" as RefundCampaign
Idle --> RefundCampaign : entry/Refund campaign

state "Wait for Balance" as WaitForBalance
RefundCampaign --> WaitForBalance : do/Generate refund

state "Mark Campaign as Paid" as MarkCampaignAsPaid
WaitForBalance --> MarkCampaignAsPaid : exit/Mark campaign as paid

state J1 <<choice>> --> StartCampaign : [Manager and staff assigned]
state J2 <<choice>> --> RefundCampaign : [Refund campaign]

state J3 <<choice>> --> PrepareAdverts : [Prepare adverts]
state J4 <<choice>> --> ScheduleAdverts : [Schedule adverts]

state J5 <<choice>> --> AdjustCampaign : [Adjust campaign]
state J6 <<choice>> --> CompleteCampaign : [Complete campaign]

state J7 <<choice>> --> PayCampaign : [Pay campaign]
state J8 <<choice>> --> ArchiveCampaign : [Archive campaign]

state J9 <<choice>> --> WaitForBalance : [Wait for balance]
state J10 <<choice>> --> MarkCampaignAsPaid : [Mark campaign as paid]

