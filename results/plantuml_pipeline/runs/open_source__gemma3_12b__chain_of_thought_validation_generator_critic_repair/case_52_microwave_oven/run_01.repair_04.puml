@startuml
[*] --> Idle : Initialization
Idle --> Cooking : Power Selection & Time Entry
Cooking --> Idle : Cancel
Cooking --> Idle : Door Open
Cooking --> Idle : Cooking Complete

state Idle {
    Idle --> Idle : Display Time
}

state Cooking {
    state DoorOpen {
        DoorOpen --> Idle : Stop
    }
}
Cooking --> [*]
@enduml
