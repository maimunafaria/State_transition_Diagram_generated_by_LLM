@startuml
title UML State Machine Diagram - Video Suggestion System

[*] --> ProcessingRequest : VideoSuggestionRequestReceived

state "Idle" as Idle
state "Processing Request" as ProcessingRequest
state "Gathering Videos" as GatheringVideos
state "Adding Details" as AddingDetails
state "Sending Suggestions" as SendingSuggestions

Idle --> ProcessingRequest : VideoSuggestionRequestReceived
ProcessingRequest --> GatheringVideos : UserIdentified
GatheringVideos --> AddingDetails : VideosGathered
AddingDetails --> SendingSuggestions : DetailsAdded
SendingSuggestions --> Idle : SuggestionsSent

SendingSuggestions --> [*] : SuggestionsSent

@enduml
