@startuml
title UML state machine diagram

state "LoggedOut" as LoggedOut
LoggedOut : entry/Login/Signin
LoggedOut : do/Login/Signin
LoggedOut : exit/MainArea

state "MainArea" as MainArea
MainArea : entry/MainArea
MainArea : do/Remain in same state
MainArea : exit/MainArea

state "MarketConditions" as MarketConditions
MarketConditions : entry/MarketConditions
MarketConditions : do/Display market conditions
MarketConditions : exit/MainArea

state "PestControlHelp" as PestControlHelp
PestControlHelp : entry/PestControlHelp
PestControlHelp : do/Show pest control techniques
PestControlHelp : exit/MainArea

state "SoilSuggestions" as SoilSuggestions
SoilSuggestions : entry/SoilSuggestions
SoilSuggestions : do/Provide soil-related suggestions
SoilSuggestions : exit/MainArea

state "WeatherInsights" as WeatherInsights
WeatherInsights : entry/WeatherInsights
WeatherInsights : do/Offer weather insights
WeatherInsights : exit/MainArea

state "LabourAvailability" as LabourAvailability
LabourAvailability : entry/LabourAvailability
LabourAvailability : do/Display labour availability details
LabourAvailability : exit/MainArea

[*] --> LoggedOut

LoggedOut --> MainArea
MainArea --> MarketConditions
MainArea --> PestControlHelp
MainArea --> SoilSuggestions
MainArea --> WeatherInsights
MainArea --> LabourAvailability
MainArea --> LoggedOut

@enduml
