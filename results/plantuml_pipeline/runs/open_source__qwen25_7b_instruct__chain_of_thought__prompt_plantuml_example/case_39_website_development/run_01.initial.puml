@startuml
title State diagram of the system operations for "Website Development"

[*] --> Homepage

state "Homepage" as Homepage
state "ProjectPage" as ProjectPage
state "CareerOpportunitiesPage" as CareerOpportunitiesPage
state "(Final state)" as FinalState

Homepage --> ProjectPage : SelectProjects
ProjectPage --> ProjectPage : ViewPhotosOrVideos
Homepage --> CareerOpportunitiesPage : SelectCareerOpportunities
CareerOpportunitiesPage --> CareerOpportunitiesPage : ViewUpdatesOrOpenForm
CareerOpportunitiesPage --> FinalState : SubmitJobApplication

@enduml
