@startuml
title UML State Chart Diagram

state "Registration" as Registration {
  [*] --> RegComplete : Registration Complete
  RegComplete --> Login : Registration Fail
}

state "Login" as Login {
  [*] --> LoginSuccess : Sign In Success
  LoginFail --> [*]
}

state "Main Menu" as MainMenu {
  [*] --> FacilityAccess : View Facilities
  [*] --> NewsContent : Read News/Content
  [*] --> SymptomChecker : Use Symptom Checker/Fitness Check
  [*] --> ContinueSession : Continue Session
  [*] --> PaymentInsurance : Process Insurance
  [*] --> FeedbackCollection : Service Completion
}

state "Facility Access" as FacilityAccess {
  [*] --> MainMenu
}

state "News and Content" as NewsContent {
  [*] --> MainMenu
}

state "Symptom Checker/Fitness Check" as SymptomChecker {
  [*] --> MainMenu
}

state "Session Continuation" as ContinueSession {
  [*] --> MainMenu
}

state "Payment Processing (Insurance)" as PaymentInsurance {
  [*] --> MainMenu : Payment Complete (Insurance)
}

state "Payment Processing (Cash)" as PaymentCash {
  [*] --> MainMenu : Payment Complete (Cash)
}

state "Feedback Collection" as FeedbackCollection {
  [*] --> Logout
}

state "Logout" as Logout {
  [*]
}

Registration --> Login : Registration Fail

LoginSuccess --> FacilityAccess
LoginSuccess --> NewsContent
LoginSuccess --> SymptomChecker
LoginSuccess --> ContinueSession
LoginSuccess --> PaymentInsurance
LoginSuccess --> FeedbackCollection

FacilityAccess --> MainMenu
NewsContent --> MainMenu
SymptomChecker --> MainMenu
ContinueSession --> MainMenu
PaymentInsurance --> MainMenu : Payment Complete (Insurance)
PaymentCash --> MainMenu : Payment Complete (Cash)

FeedbackCollection --> Logout

@enduml
