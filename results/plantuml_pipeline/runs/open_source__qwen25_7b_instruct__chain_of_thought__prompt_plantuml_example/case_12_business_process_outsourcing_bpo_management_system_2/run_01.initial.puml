@startuml
title UML State Machine Diagram (Search Screen)

state "Search Screen" as SearchScreen {

    [*] --> SearchScreen

    SearchScreen : entry / Initial state
    SearchScreen : do / Display search screen

    state Choice1 <<choice>>

    Choice1 --> SearchScreen : [Select Filter Category]
    Choice1 --> SearchScreen : [Select Price Range]

    SearchScreen --> SearchScreen : [Apply Filters]

    SearchScreen --> [*] : [Exit or No Further Action]

}

@enduml
