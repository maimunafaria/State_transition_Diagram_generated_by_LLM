@startuml
title UML State Machine Diagram (ATM Many Scenarios)

state "Idle" as Idle {
    [*] --> Greeting : UserArrives
}

state "Greeting" as Greeting {}

state "PinCheck" as PinCheck {
    Greeting --> PinCheck : CardInserted
    PinCheck --> Greeting : IncorrectPinEntered(3)
    PinCheck --> CardKept : IncorrectPinEntered(3)
    PinCheck --> OptionsAvailable : PinCorrect
}

state "CardKept" as CardKept {
    [*] --> [*]
}

state "OptionsAvailable" as OptionsAvailable {}

state "TransactionProcessing" as TransactionProcessing {
    OptionsAvailable --> TransactionProcessing : ChoiceMade
}

Greeting --> CardKept : CancelOperation

PinCheck --> Greeting : IncorrectPinEntered(3)

PinCheck --> CardKept : IncorrectPinEntered(3)

OptionsAvailable --> Greeting : CancelOperation

@enduml
