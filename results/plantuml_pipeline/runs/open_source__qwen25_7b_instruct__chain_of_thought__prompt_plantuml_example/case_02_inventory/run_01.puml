@startuml
title State diagram of the system operations of "Inventory Management"

[*] --> Inventory

state "Inventory" as Inventory
state "OrderPlaced" as OrderPlaced
state "ReceiptGenerated" as ReceiptGenerated
state "TransactionSummary" as TransactionSummary

Inventory --> OrderPlaced : PlaceOrder
OrderPlaced --> ReceiptGenerated : GenerateInvoice
ReceiptGenerated --> TransactionSummary : GenerateReceipt
Inventory --> ReceiptGenerated : SearchItems, CalculateDiscountAndTax
Inventory --> Inventory : AddGoods, UpdatePrice, RemoveGoods, IdentifyExpiredGoods, RecordCustomerRequest

TransactionSummary --> [*] : ViewSummary

@enduml
