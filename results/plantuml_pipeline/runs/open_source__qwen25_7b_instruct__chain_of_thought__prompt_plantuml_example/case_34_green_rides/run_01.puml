@startuml
title UML state machine diagram

state "UserLogin" as UserLogin
UserLogin : entry/Login
UserLogin : do/Remain in same state
UserLogin : exit/Login / Register

state "JourneyDetailsViewed" as JourneyDetailsViewed
JourneyDetailsViewed : entry/View journey details
JourneyDetailsViewed : do/View journey details after login and destination selection
JourneyDetailsViewed : exit/Select place to eat or activate driving mode

state "DrivingModeActive" as DrivingModeActive
DrivingModeActive : entry/Activate driving mode
DrivingModeActive : do/Drive safely
DrivingModeActive : exit/Provide feedback

state "OtherOptionsSelected" as OtherOptionsSelected
OtherOptionsSelected : entry/Choose other options
OtherOptionsSelected : do/Select and use other features
OtherOptionsSelected : exit/Provide feedback

state "Hungry" as Hungry
Hungry : entry/Select place to eat
Hungry : do/View menu and order food if hungry
Hungry : exit/Provide feedback or continue journey

state "AccidentOccurred" as AccidentOccurred
AccidentOccurred : entry/Accident detected
AccidentOccurred : do/Inform authorities
AccidentOccurred : exit/Provide feedback

state "FeedbackProvided" as FeedbackProvided
FeedbackProvided : entry/Provide feedback
FeedbackProvided : do/Give feedback on journey completion
FeedbackProvided : exit/End

[*] --> UserLogin

UserLogin --> JourneyDetailsViewed
JourneyDetailsViewed --> DrivingModeActive
JourneyDetailsViewed --> OtherOptionsSelected
Hungry --> FeedbackProvided
DrivingModeActive --> FeedbackProvided
OtherOptionsSelected --> FeedbackProvided
AccidentOccurred --> FeedbackProvided

@enduml
