@startuml
title Graderate State Machine

[*] --> Waiting

state "Waiting <<initial>>" as Waiting

state Active {
  Waiting --> Active : current date >= start date
  state Active
}

state Expired {
  Active --> Expired : finish date reached
  state Expired
}

state "Removed/Archived <<final>>" as Removed_Archived

Expired --> Removed_Archived : one year from expiration date / <<final>>

@enduml
