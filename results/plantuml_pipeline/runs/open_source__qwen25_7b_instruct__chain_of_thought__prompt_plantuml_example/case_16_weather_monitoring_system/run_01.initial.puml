@startuml
title Weather Monitoring System State Machine
[*] --> UserAccountCreation

state UserAccountCreation {
    state RegistrationSuccess
    state RegistrationFailure
}

UserAccountCreation --> UserLogin : CreateAccount
UserAccountCreation --> RegistrationFailure : CreateAccount

UserLogin {
    state Login
}

UserLogin --> WeatherCheck : Login

WeatherCheck {
    state LocationValidation
}

WeatherCheck --> LocationValidation : CheckWeather

LocationValidation {
    state ValidLocation
    state InvalidLocation
}

LocationValidation --> WeatherInformationSelection : ValidLocation
LocationValidation --> SessionEnd : InvalidLocation

WeatherInformationSelection {
    state SelectWeatherInfo
}

WeatherInformationSelection --> AdditionalWeatherDetails : SelectWeatherInfo

AdditionalWeatherDetails {
    state ViewAdditionalDetails
}

AdditionalWeatherDetails --> SessionEnd : Logout

state SessionEnd

UserLogin --> [*] : Logout

@enduml
