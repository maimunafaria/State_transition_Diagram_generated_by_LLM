@startuml
title UML State Chart Diagram

state "Initial State" as IS
IS : entry / Initial state
IS : exit / No action

state "Assigned Staff and Manager" as ASM
ASM : entry / Staff and manager assigned
ASM : do / Assign staff and manager
ASM : exit / Proceed to next step

state "Approved and Contract Signed" as ACS
ACS : entry / Everything approved and contract signed
ACS : do / Sign contract
ACS : exit / Prepare adverts

state "Adverts Preparing" as AP
AP : entry / Adverts preparing
AP : do / Prepare adverts
AP : exit / Approve and schedule adverts

state "Adverts Approved and Scheduled" as AAS
AAS : entry / Adverts approved and scheduled
AAS : do / Schedule adverts
AAS : exit / Run adverts

state "Adverts Running" as AR
AR : entry / Adverts running
AR : do / Run adverts
AR : exit / Campaign extending or adjusting

state "Campaign Extending or Adjusting" as CE
CE : entry / Extension or adjustment requested
CE : do / Extend or adjust campaign
CE : exit / Continue running or finish campaign

state "Adverts Finished" as AF
AF : entry / Adverts finished
AF : do / Finish adverts
AF : exit / Prepare final statement

state "Final Statement Prepared" as FSP
FSP : entry / Final statement prepared
FSP : do / Generate final statement
FSP : exit / Handle payment

state "Payment Handling" as PH
PH : entry / Payment due
PH : do / Handle payment
PH : exit / Wait for correct balance

state "Correct Balance Waited" as CBW
CBW : entry / Correct balance settled
CBW : do / Wait for correct balance
CBW : exit / Mark paid

state "Paid" as P
P : entry / Full amount paid
P : do / Mark campaign as paid
P : exit / Archive campaign

state "Archived" as A
A : entry / Campaign archived
A : do / Release staff and managers
A : exit / Final state

IS --> ASM : Staff and Manager Assigned
ASM --> ACS : Everything Approved and Contract Signed
ACS --> AP : Adverts Preparing
AP --> AAS : Adverts Approved and Scheduled
AAS --> AR : Adverts Running
AR --> CE : Extension or Adjustment Requested
AR --> AF : Adverts Finished
AF --> FSP : Final Statement Prepared
FSP --> PH : Payment Due
PH --> CBW : Correct Balance Settled
CBW --> P : Full Amount Paid
P --> A : Campaign Completed

@enduml
