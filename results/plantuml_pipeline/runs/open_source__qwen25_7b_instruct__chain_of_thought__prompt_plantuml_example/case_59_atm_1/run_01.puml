@startuml
title UML State Machine Diagram - ATM Withdrawal

[*] --> Idle

state "Idle" as Idle
state "WithdrawalAmountSelection" as AmountSelection
state "CustomWithdrawalInput" as CustomInput
state "TransactionInProgress" as TransactionInProcess
state "CancelTransaction" as Cancel

Idle --> AmountSelection : UserChoosesPredefinedAmount, UserEntersCustomAmount
AmountSelection --> CustomInput : UserEntersCustomAmount
AmountSelection --> TransactionInProcess : TransactionCompletedSuccessfully
CustomInput --> TransactionInProcess : TransactionCompletedSuccessfully
CustomInput --> Idle : UserRequestsCancel
TransactionInProcess --> Idle : UserRequestsCancel

@enduml
