@startuml
title Alarm Clock State Transition Diagram

[*] --> Off

state Off
state Active
state Ringing

Off --> Active : SetAlarmTime

Active --> Ringing : CurrentTimeMatchesAlarmTime

Ringing --> Active : StopRinging

Active --> Idle : NoCurrentTimeMatchesAlarmTime

Ringing --> Idle : StopRinging

Idle --> Active : SetAlarmTime

@enduml
