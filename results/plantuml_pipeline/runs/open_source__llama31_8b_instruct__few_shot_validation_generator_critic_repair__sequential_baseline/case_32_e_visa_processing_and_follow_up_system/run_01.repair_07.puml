@startuml
[*] --> CreateUser
state Choice1 <<choice>> : entry / nil
Choice1 : do / Create account
Choice1 : exit / Login

CreateUser : entry / nil
CreateUser : do / nil
CreateUser : exit / Login

CreateUser --> Login : user creates account

Login : entry / nil
Login : do / Login
Login : exit / Application

Login --> Application : user logs in

Application : entry / Login
Application : do / Apply for visa
Application : exit / Payment

Application --> Choice2 : user logs in to apply for a visa

Choice2 : entry / Login
Choice2 : do / Apply for visa
Choice2 : exit / Payment

Choice2 --> Payment : user applies for visa

Payment : entry / Application
Payment : do / Make payment
Payment : exit / Accepted

Payment --> Choice3 : payment made, application applied

Choice3 : entry / Application
Choice3 : do / Make payment
Choice3 : exit / Accepted

Choice3 --> Accepted : payment made

Accepted : entry / Payment
Accepted : do / Accept application
Accepted : exit / Status

Accepted --> Choice4 : application accepted

Choice4 : entry / Accepted
Choice4 : do / View status
Choice4 : exit / CheckStatus

Choice4 --> Status : application accepted, user views status

Status : entry / Accepted
Status : do / View status
Status : exit / CheckStatus

Status --> Choice5 : user views status

Choice5 : entry / Status
Choice5 : do / Cancel application
Choice5 : exit / Logout

Choice5 --> Logout : user cancels application and logs out

ModifyDetails : entry / Login
ModifyDetails : do / Modify details
ModifyDetails : exit / Logout

ModifyDetails --> Logout : user modifies details

ViewDetails : entry / Login
ViewDetails : do / View details
ViewDetails : exit / Logout

ViewDetails --> Logout : user views details

ViewPurpose : entry / Login
ViewPurpose : do / View purpose
ViewPurpose : exit / UpdateStatus

ViewPurpose --> Logout : user views purpose and logs out

UpdateStatus : entry / ViewPurpose
UpdateStatus : do / Update status
UpdateStatus : exit / Logout

UpdateStatus --> Logout : user updates status

GiveFeedback : entry / CheckStatus
GiveFeedback : do / Give feedback
GiveFeedback : exit / Logout

GiveFeedback --> Logout : user gives feedback

Logout : entry / nil
Logout : do / Logout
Logout : exit / [*]

Cancel : entry / Status
Cancel : do / Cancel application
Cancel : exit / Logout

Status --> Cancel : user views status and cancels application

Choice6 : entry / Login
Choice6 : do / Modify details
Choice6 : exit / Logout

Login --> Choice6 : user logs in to modify their details

Choice7 : entry / Login
Choice7 : do / View details
Choice7 : exit / Logout

Login --> Choice7 : user logs in to view their details

Choice8 : entry / Login
Choice8 : do / View purpose
Choice8 : exit / UpdateStatus

Login --> Choice8 : user logs in to view the purpose of the application

Choice9 : entry / CheckStatus
Choice9 : do / Give feedback
Choice9 : exit / Logout

CheckStatus --> Choice9 : user checks status and gives feedback

Choice10 : entry / Login
Choice10 : do / Update status
Choice10 : exit / Logout

Login --> Choice10 : user logs in to update the status

Logout --> [*] : user logs out
@enduml
