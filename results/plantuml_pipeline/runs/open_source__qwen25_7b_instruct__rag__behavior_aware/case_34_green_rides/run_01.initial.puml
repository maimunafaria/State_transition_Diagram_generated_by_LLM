@startuml
[*] --> State

state "Journey Details Viewed" as JourneyDetailsViewed
JourneyDetailsViewed --> DrivingMode as activateDrivingMode
JourneyDetailsViewed --> OtherOptions as chooseOtherOptions

state "Driving Mode Activated" as DrivingModeActivated
DrivingModeActivated --> EatPlaceSelection as selectEatPlace

state "Eat Place Selected" as EatPlaceSelected
EatPlaceSelected --> EatPlaceDetails as viewEatPlaceDetails

state "Eat Place Details Viewed" as EatPlaceDetailsViewed
EatPlaceDetailsViewed --> OrderFood as orderFood

state "Order Food Placed" as OrderFoodPlaced
OrderFoodPlaced --> Payment as makePayment

state "Payment Made" as PaymentMade
PaymentMade --> JourneyContinues as continueJourney

DrivingModeActivated --> EatPlaceSelection
EatPlaceSelected --> EatPlaceDetailsViewed
EatPlaceDetailsViewed --> OrderFoodPlaced
OrderFoodPlaced --> PaymentMade
PaymentMade --> JourneyContinues

JourneyDetailsViewed --> DrivingModeActivated
JourneyDetailsViewed --> OtherOptions

OtherOptions --> DrivingModeActivated
OtherOptions --> EatPlaceSelection

JourneyContinues --> [*]

@enduml
