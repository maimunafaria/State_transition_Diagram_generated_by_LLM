@startuml
[*] --> State

state State {
    --> WithdrawalAmountSelection
}

state WithdrawalAmountSelection {
    --> PredefinedAmountsSelected : Selected predefined amount
    --> CustomAmountEntered : Entered custom amount
    --> CancelTransaction : Canceled transaction
}

state PredefinedAmountsSelected {
    --> TransactionProcessed : Processed withdrawal
    --> CancelTransaction : Canceled transaction
}

state CustomAmountEntered {
    --> TransactionProcessed : Processed withdrawal
    --> CancelTransaction : Canceled transaction
}

state CancelTransaction {
    --> [*] : Stopped transaction and returned card
}

@enduml
