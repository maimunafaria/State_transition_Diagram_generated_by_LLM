@startuml
[*] --> WaitingForNewSale

state "Waiting for New Sale" as WaitingForNewSale
WaitingForNewSale --> AddingItems : new item selected

state "Adding Items" as AddingItems
AddingItems --> AddingItems : add another item
AddingItems --> PaymentRequired : all items added

state "Payment Required" as PaymentRequired
PaymentRequired --> CashPayment : pay with cash
PaymentRequired --> CardOrCheckVerification : verify payment method

state "Card or Check Verification" as CardOrCheckVerification
CardOrCheckVerification : do / verify payment
CardOrCheckVerification --> SaleCompleted : payment approved

state "Sale Completed" as SaleCompleted
SaleCompleted --> WaitingForNewSale : next customer

PaymentRequired --> SaleCompleted : payment confirmed

@enduml
