@startuml
title UML State Machine Diagram - BPO Management System Search

[*] --> SearchByCategory

state "Search by category" as SearchByCategory
state "Search by price range" as SearchByPriceRange
state DisplayResults

SearchByCategory --> DisplayResults : [category selected]
SearchByPriceRange --> DisplayResults : [price range selected]

DisplayResults --> [*] : [results displayed]

@enduml
