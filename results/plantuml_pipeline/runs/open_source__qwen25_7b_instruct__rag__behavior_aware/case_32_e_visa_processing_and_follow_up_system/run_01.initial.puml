@startuml
[*] --> LoggedIn

state LoggedIn {
  [*] --> Dashboard
  Dashboard --> ViewStatus : view status
  ViewStatus --> ViewStatus : check status
  ViewStatus --> CancelApp : cancel application
  ViewStatus --> ModifyDetails : modify details
  ViewStatus --> ViewDetails : view details
  ViewDetails --> ViewPurpose : view purpose of application
  ViewPurpose --> [*] : update status and view purpose
}

state CancelApp {
  CancelApp --> [*] : cancel application
}

state ModifyDetails {
  ModifyDetails --> [*] : modify details
}

state ViewDetails {
  ViewDetails --> [*] : view details
}

state ViewStatus {
  ViewStatus --> [*] : check status
}

state ViewPurpose {
  ViewPurpose --> [*] : update status and view purpose
}

LoggedIn --> [*] : logout

@enduml
