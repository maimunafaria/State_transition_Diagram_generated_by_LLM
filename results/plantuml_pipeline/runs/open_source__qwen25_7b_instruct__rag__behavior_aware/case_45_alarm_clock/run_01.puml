@startuml
[*] --> Off

state Off {
  Off --> AlarmSet : set alarm time
}

state AlarmSet {
  AlarmSet --> Activated : current time matches set alarm time
}

state Activated {
  Activated --> Stopped : stop alarm
}

Stopped --> Off : alarm stopped
Stopped --> AlarmSet : next scheduled alarm time

Activated --> [*] : alarm ringing
Stopped --> [*] : alarm stopped
@enduml
