@startuml
[*] --> PowerOnCheck

state PowerOnCheck {
  PowerOnCheck --> StartupProblem : Problem detected
  PowerOnCheck --> ReadyToUse : Everything fine
}

state ReadyToUse {
  [*] --> Reset : Reset system
  ReadyToUse --> Activate : Activate system
  ReadyToUse --> TurnOff : Turn off system
  Activate --> Monitoring : Start monitoring
  Monitoring --> Alarm : Sensor triggered
  Monitoring --> ContinueMonitoring : False alarm or time ends
}

state Alarm {
  [*] --> [*]
}

state ContinueMonitoring {
  [*] --> [*]
}

[*] --> Alarm : Sensor triggered
[*] --> ContinueMonitoring : Time ends

Activate --> Monitoring : Start monitoring
TurnOff --> [*]

@enduml
