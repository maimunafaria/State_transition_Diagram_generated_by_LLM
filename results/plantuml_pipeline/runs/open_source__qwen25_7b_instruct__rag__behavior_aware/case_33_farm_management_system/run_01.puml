@startuml
[*] --> Login

state Login {
  [*] --> Authenticated
  Authenticated --> MainArea : select option
}

state MainArea {
  [*] --> MarketConditions : show market conditions
  [*] --> PestControlHelp : provide pest control techniques
  [*] --> SoilSuggestions : provide soil-related suggestions
  [*] --> WeatherInsights : offer weather insights
  [*] --> LabourAvailability : display labour availability details
}

state MarketConditions {
  [*] --> MainArea
}

state PestControlHelp {
  [*] --> TechniquesProvided : show pest control techniques
  TechniquesProvided --> MainArea : provide photo
}

state SoilSuggestions {
  [*] --> MainArea : input soil information
}

state WeatherInsights {
  [*] --> MainArea : input location
}

state LabourAvailability {
  [*] --> MainArea : input location
}

state Authenticated {
  [*] --> MainArea
}

Authenticated --> [*] : logout
@enduml
