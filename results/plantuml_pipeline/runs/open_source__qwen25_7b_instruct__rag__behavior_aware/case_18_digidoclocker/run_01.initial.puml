@startuml
[*] --> Registration

state Registration {
  [*] --> CitizenRegistered
  CitizenRegistered --> Login : [Valid Details]
}

state Login {
  [*] --> LoggedIn
  LoggedIn --> UploadDocuments : [Upload Documents]
  LoggedIn --> ViewProfile : [View Profile]
  LoggedIn --> ApplyForCertificate : [Apply for Certificate]
  LoggedIn --> [*] : [End Session]
}

state UploadDocuments {
  [*] --> DocumentUploaded
  DocumentUploaded --> [*] : [Continue Uploading]
}

state ApplyForCertificate {
  [*] --> CertificateApplied
  CertificateApplied --> [*] : [Reapply After Request]
}

state "Registrar Requests" as RegistrarRequests {
  [*] --> CertificateRequested
  CertificateRequested --> [*] : [Request More Certificates]
}

LoggedIn --> [*] : [End Session]

@enduml
