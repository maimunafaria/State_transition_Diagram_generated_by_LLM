@startuml
[*] --> Idle

state Idle {
  Idle --> PowerSelection : doorClosed
}

state PowerSelection {
  PowerSelection --> TimeEntry : powerSelected
}

state TimeEntry {
  TimeEntry --> Cooking : timeSet
  TimeEntry --> Idle : doorOpened
}

state Cooking {
  Cooking --> DoorOpen : doorOpened
  Cooking --> Idle : cookingTimeExpired
}

state DoorOpen {
  DoorOpen --> Idle : doorClosed
}

[*] --> Idle

@enduml
