@startuml
[*] --> Idle

state Idle {
  [*] --> AdjustTime : view or adjust time
}

state AdjustTime {
  AdjustTime --> ChangeHour : press button to change hour
  ChangeHour --> ChangeMinute : press button to change minute
  ChangeMinute --> SetAlarm : press button to set alarm
  SetAlarm --> StopAlarm : press button to stop alarm
  StopAlarm --> LightOn : press button to turn on light
  LightOn --> LightOff : press button to turn off light
  LightOff --> [*] : button released
}

state SetAlarm {
  SetAlarm --> AlarmTriggered : current time matches set alarm time
  AlarmTriggered --> AlarmRinging : alarm rings
  AlarmRinging --> StopAlarm : press button to stop alarm
}

Idle --> AdjustTime : view or adjust time

AdjustTime --> Idle : finish adjusting time

SetAlarm --> Idle : finish setting alarm

AlarmRinging --> Idle : alarm stopped

LightOn --> Idle : light turned off

@enduml
