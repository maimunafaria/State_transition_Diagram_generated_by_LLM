@startuml

[*] --> AddNewGoods

state "Add New Goods" as AddNewGoods
state "Update Price" as UpdatePrice
state "Remove Goods" as RemoveGoods
state "Identify Expired Goods" as IdentifyExpiredGoods
state "Place Order" as PlaceOrder
state "Generate Invoice" as GenerateInvoice
state "Search Items" as SearchItems
state "Calculate Discount and Tax" as CalculateDiscountTax
state "Generate Receipt" as GenerateReceipt
state "Replace Item or Cancel Receipt" as ReplaceItemCancelReceipt
state "Record Customer Requests" as RecordCustomerRequests
state "View Summary Report" as ViewSummaryReport

AddNewGoods --> UpdatePrice : SUPPORTED_EVENT
UpdatePrice --> RemoveGoods : SUPPORTED_EVENT
RemoveGoods --> IdentifyExpiredGoods : SUPPORTED_EVENT
IdentifyExpiredGoods --> PlaceOrder : SUPPORTED_EVENT
PlaceOrder --> GenerateInvoice : SUPPORTED_EVENT
GenerateInvoice --> SearchItems : SUPPORTED_EVENT
SearchItems --> CalculateDiscountTax : SUPPORTED_EVENT
CalculateDiscountTax --> GenerateReceipt : SUPPORTED_EVENT
GenerateReceipt --> ReplaceItemCancelReceipt : SUPPORTED_EVENT
ReplaceItemCancelReceipt --> RecordCustomerRequests : SUPPORTED_EVENT
RecordCustomerRequests --> ViewSummaryReport : SUPPORTED_EVENT

AddNewGoods --> [*] : COMPLETION_EVENT

@enduml
