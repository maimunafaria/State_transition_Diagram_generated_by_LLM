@startuml

[*] --> AddNewGoods

state "Add New Goods" as AddNewGoods
state "Update Price" as UpdatePrice
state "Remove Goods" as RemoveGoods
state "Identify Expired Goods" as IdentifyExpiredGoods
state "Place Order" as PlaceOrder
state "Generate Invoice" as GenerateInvoice
state "Search Items" as SearchItems
state "Calculate Discount and Tax" as CalculateDiscountTax
state "Generate Receipt" as GenerateReceipt
state "Replace Item or Cancel Receipt" as ReplaceItemCancelReceipt
state "Record Customer Requests" as RecordCustomerRequests
state "View Summary Report" as ViewSummaryReport

AddNewGoods --> UpdatePrice : COMPLETION_EVENT
UpdatePrice --> RemoveGoods : COMPLETION_EVENT
RemoveGoods --> IdentifyExpiredGoods : COMPLETION_EVENT
IdentifyExpiredGoods --> PlaceOrder : COMPLETION_EVENT
PlaceOrder --> GenerateInvoice : COMPLETION_EVENT
GenerateInvoice --> SearchItems : COMPLETION_EVENT
SearchItems --> CalculateDiscountTax : COMPLETION_EVENT
CalculateDiscountTax --> GenerateReceipt : COMPLETION_EVENT
GenerateReceipt --> ReplaceItemCancelReceipt : COMPLETION_EVENT
ReplaceItemCancelReceipt --> RecordCustomerRequests : COMPLETION_EVENT
RecordCustomerRequests --> ViewSummaryReport : COMPLETION_EVENT

AddNewGoods --> [*] : COMPLETION_EVENT

@enduml
