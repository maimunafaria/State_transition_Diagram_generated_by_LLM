@startuml
[*] --> Off

state Off {
  Off --> Idle : turn off
}

state Idle {
  Idle --> SetAlarm : set alarm
  SetAlarm --> AlarmSet : alarm set
}

state AlarmSet {
  AlarmSet --> Ringing : alarm time reached
  Ringing --> Stopped : [current time matches alarm time]
  Stopped --> Idle : stop alarm
}

Ringing --> Ringing : keep ringing

Off --> [*] : system shutdown
@enduml
