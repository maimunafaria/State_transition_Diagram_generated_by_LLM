@startuml
[*] --> Running

state Running {
  INITIAL_STATE --> Configuring : configurationRequired
  Configuring --> Running : configurationCompleted
  INITIAL_STATE --> DataCollection : clockTriggered
  DataCollection --> Running : activityCompleted
  INITIAL_STATE --> SummaryPreparation : summaryRequest
  SummaryPreparation --> Running : activityCompleted
  INITIAL_STATE --> StatusChecking : statusRequest
  StatusChecking --> Running : activityCompleted
  INITIAL_STATE --> ControlledMode : remoteControl
  ControlledMode --> Running : modeExited
  INITIAL_STATE --> Shutdown : shutdownCommand
  Shutdown --> [*]
}

@enduml
