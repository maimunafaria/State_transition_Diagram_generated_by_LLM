@startuml
[*] --> INITIAL_STATE

state INITIAL_STATE {
  INITIAL_STATE --> Register
  INITIAL_STATE --> Login
}

state Register {
  Register --> Login : registration successful
  Register --> Register : registration unsuccessful
}

Login --> CheckLocation
CheckLocation --> InvalidLocation : location invalid
CheckLocation --> ChooseInfo : location valid

ChooseInfo --> ShowWeather : choose to check weather
ShowWeather --> EndProcess : end process

state ShowWeather {
  ShowWeather --> AdditionalDetails : view additional details
  AdditionalDetails --> Logout : logout user
}

Logout --> [*] : logout user
@enduml
