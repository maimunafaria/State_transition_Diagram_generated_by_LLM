@startuml
[*] --> Initial : login successful

state Initial
Initial --> JourneyDetails : select destination

state JourneyDetails
JourneyDetails --> DrivingMode : activate driving mode
JourneyDetails --> OtherOptions : choose other options

state DrivingMode
DrivingMode --> NotificationsSent : during driving
DrivingMode --> AccidentHandling : accident occurs

state OtherOptions
OtherOptions --> RestaurantSelection : select place to eat

state RestaurantSelection
RestaurantSelection --> MenuViewing : view menu

state MenuViewing
MenuViewing --> OrderPlaced : place order
MenuViewing --> JourneyDetails : cancel ordering

state OrderPlaced
OrderPlaced --> JourneyDetails : continue journey

state AccidentHandling
AccidentHandling --> AuthoritiesNotified : inform authorities

state NotificationsSent
NotificationsSent --> [*] : exit system

state AuthoritiesNotified
AuthoritiesNotified --> [*] : exit system

state FeedbackGiven
FeedbackGiven --> [*] : exit system

JourneyDetails --> JourneyComplete : journey completed
JourneyComplete --> FeedbackGiven : provide feedback
@enduml
