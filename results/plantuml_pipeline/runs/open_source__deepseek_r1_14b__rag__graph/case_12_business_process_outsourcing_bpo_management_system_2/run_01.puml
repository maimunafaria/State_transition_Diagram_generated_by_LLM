@startuml
[*] --> SelectFilter

state "Select filter" as SelectFilter
state "Process category filter" as ProcessCategoryFilter
state "Process price range filter" as ProcessPriceRange
state "Display results" as DisplayResults

SelectFilter <<choice>>
SelectFilter --> ProcessCategoryFilter : select category filter
SelectFilter --> ProcessPriceRange : select price range filter

ProcessCategoryFilter --> DisplayResults
ProcessPriceRange --> DisplayResults

DisplayResults --> [*]
@enduml
