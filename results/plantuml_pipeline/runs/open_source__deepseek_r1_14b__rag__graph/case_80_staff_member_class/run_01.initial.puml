@startuml
[*] --> Unassigned : initial state

state Unassigned {
  [*] --> AssignedToClient : +assignClient
  [*] --> AssignedToCampaign : +assignCampaign
}

state AssignedToClient {
  AssignedToClient --> Unassigned : -removeAssignment
  AssignedToClient --> AssignedToCampaign : switchAssignment
}

state AssignedToCampaign {
  AssignedToCampaign --> Unassigned : -removeAssignment
  AssignedToCampaign --> AssignedToClient : switchAssignment
}

AssignedToClient --> Unemployed : leaveJob
AssignedToCampaign --> Unemployed : leaveJob

Unemployed --> Archived : timePassed
Unemployed --> [*] : processComplete

@enduml
