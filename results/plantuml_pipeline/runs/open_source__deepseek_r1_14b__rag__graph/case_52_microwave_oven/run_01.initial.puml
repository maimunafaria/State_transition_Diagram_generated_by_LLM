@startuml
[*] --> Inactive

state Inactive {
  [*] --> CookingTimeSet : set time
}

state CookingTimeSet {
  CookingTimeSet --> FullPower : select full power
  CookingTimeSet --> HalfPower : select half power
}

state FullPower {
  FullPower --> ActiveCooking : start cooking
}

state HalfPower {
  HalfPower --> ActiveCooking : start cooking
}

state ActiveCooking {
  ActiveCooking --> Inactive : door opened
  ActiveCooking --> Inactive : time elapsed
  ActiveCooking --> Inactive : cancel
}

Inactive --> Inactive : door open during operation
@enduml
