@startuml
[*] --> TimeDisplay : initial state

state TimeDisplay {
  [*] --> AdjustTime : button pressed
  AdjustTime --> AdjustAlarm : switch to alarm
  AdjustTime --> AdjustLight : switch to light
  AdjustTime --> TimeDisplay : done adjusting
}

state AdjustTime {
  [*] --> AdjustHour : enter hour mode
  AdjustHour --> AdjustMinute : switch to minute
  AdjustMinute --> AdjustHour : switch back
  AdjustHour --> IncreaseValue : increment hour
  AdjustMinute --> IncreaseValue : increment minute
}

state AlarmStatus {
  [*] --> AlarmOff : initial state
  AlarmOff --> AlarmOn : enable alarm
  AlarmOn --> AlarmOff : disable alarm
  AlarmOn --> TimeDisplay : alarm triggered and stopped
}

state LightFeature {
  [*] --> LightOff : initial state
  LightOff --> LightOn : light button pressed
  LightOn --> LightOff : light button released
}

TimeDisplay --> AdjustAlarm : enter alarm mode
AdjustAlarm --> SetAlarmHour : set hour
SetAlarmHour --> SetAlarmMinute : set minute
SetAlarmMinute --> AlarmStatus : done setting

@enduml
