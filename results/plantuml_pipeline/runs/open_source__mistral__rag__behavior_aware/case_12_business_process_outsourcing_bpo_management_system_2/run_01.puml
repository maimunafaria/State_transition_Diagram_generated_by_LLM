@startuml
title UML State Machine Diagram - Search Users

[*] --> ChooseFilter

state "Choose filter category" as ChooseFilter {
    ChooseFilter : entry / Selecting a filter category
    ChooseFilter : do / Choosing a filter
    ChooseFilter : exit / Display matching users
}

state "Choose price range" as ChoosePriceRange {
    [*] --> ChooseFilter
}

ChooseFilter --> DisplayUsers
DisplayUsers --> [*]
@enduml
