@startuml
[*] --> LoggedIn

state LoggedIn {
  [*] --> Dashboard
  Dashboard --> Market : show market conditions
  Market --> MarketReport
  Dashboard --> PestControl : provide photo
  PestControl --> PestControlTechniques
  state SoilInfo {
    [*] --> Suggestions
    Suggestions --> WeatherInsights
    Suggestions --> LabourAvailability
  }
  SoilInfo --> [*]
}

LoggedIn --> Logout : end session
@enduml
