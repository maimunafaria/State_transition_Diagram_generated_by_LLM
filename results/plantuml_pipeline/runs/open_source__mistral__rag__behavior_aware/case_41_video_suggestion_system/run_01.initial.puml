@startuml
[*] --> UserRequest

state UserRequest {
  state IdentifyUser
  IdentifyUser --> GatherVideos

  state GatherVideos {
    state ProfileBased
    ProfileBased --> TrendingAreaBased
    TrendingAreaBased --> TagBased
    TagBased --> GenreBased
    GenreBased --> PromotedVideos

    state AdditionalDetails {
      [*] --> Thumbnails
      Thumbnails --> ViewCounts
      ViewCounts --> SuggestedVideos
    }

    ProfileBased --> AdditionalDetails
    TrendingAreaBased --> AdditionalDetails
    TagBased --> AdditionalDetails
    GenreBased --> AdditionalDetails
    PromotedVideos --> AdditionalDetails
  }

  state SendSuggestions {
    [*] --> User
  }

  GatherVideos --> SendSuggestions
}

UserRequest --> [*]
@enduml
