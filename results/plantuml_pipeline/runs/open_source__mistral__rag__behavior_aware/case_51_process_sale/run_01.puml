@startuml
title UML State Chart Diagram - Process Sale

[*] --> WaitingForSale

state WaitingForSale
WaitingForSale --> EnterItems : item selected
EnterItems --> EnterItems : next item
EnterItems --> Payment : all items entered
Payment --> CashPayment : cash payment
CashPayment --> CompletedSale : payment approved
CompletedSale --> WaitingForSale : sale completed

Payment --> CardPayment : card or check payment
CardPayment --> VerifyPayment : verify payment
VerifyPayment --> ApprovedPayment : payment approved
ApprovedPayment --> CompletedSale : payment approved
CompletedSale --> WaitingForSale : sale completed
@enduml
