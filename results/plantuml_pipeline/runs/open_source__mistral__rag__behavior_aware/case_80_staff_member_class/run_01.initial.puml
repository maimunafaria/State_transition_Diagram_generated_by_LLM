@startuml
state Unassigned
state AssignedToClient
state AssignedToCampaign
state Unemployed
state Archived

[*] --> Unassigned
Unassigned --> AssignedToClient : assignToClient
AssignedToClient --> Unemployed : leaveJob
Unemployed --> Archived : someTimePasses
Archived --> [*]

AssignedToClient --> AssignedToCampaign : joinCampaign
AssignedToCampaign --> Unemployed : leaveCampaign
AssignedToCampaign --> AssignedToClient : switchAssignments
@enduml
