@startuml
title Weather Station System State Machine Diagram

state Running {
  [*] --> Running : system starts

  state CollectingData {
    [*] --> CollectingData : clock triggers data collection
    CollectingData --> Running : data collected
  }

  state Configuring {
    [*] --> Configuring : changes or power-saving settings required
    Configuring --> Running : configuration completed
  }

  state SendingSummary {
    [*] --> SendingSummary : weather summary requested
    SendingSummary --> Running : summary sent out
  }

  state CheckingStatus {
    [*] --> CheckingStatus : status check requested
    CheckingStatus --> Running : status transmitted
  }

  state RemoteControlled {
    [*] --> RemoteControlled : controlled through remote control
    RemoteControlled --> Running : control ended
  }

  state ShuttingDown {
    [*] --> ShuttingDown : shutdown command given while running
    ShuttingDown --> [*] : system shuts down
  }
}
Running --> Running : activity completed
@enduml
