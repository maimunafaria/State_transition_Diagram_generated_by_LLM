@startuml
[*] --> LoggedIn

state LoggedIn {
  [*] --> Dashboard
  Dashboard --> Settings : open settings
  Settings --> Dashboard : back
  Dashboard --> ApplyForVisa : apply for visa
  Dashboard --> ViewStatus : view status
  Dashboard --> CancelApplication : cancel application
  Dashboard --> ModifyDetails : modify details
  Dashboard --> ViewDetails : view details
  Dashboard --> GiveFeedback : give feedback
  Dashboard --> Logout : logout
}

LoggedIn --> [*] : logout
@enduml
