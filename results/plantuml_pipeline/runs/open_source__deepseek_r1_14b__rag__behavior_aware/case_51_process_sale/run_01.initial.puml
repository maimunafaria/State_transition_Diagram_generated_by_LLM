@startuml
[*] --> WaitingSale

state "Waiting for sale" as WaitingSale
state "Recording items" as RecordingItems
state "Waiting for payment" as WaitingPayment
state Choice <<choice>>
state "Verifying payment" as VerifyPayment
state "Complete sale" as CompleteSale

WaitingSale --> RecordingItems : new sale
RecordingItems --> WaitingPayment : all items recorded
WaitingPayment --> Choice

Choice --> CompleteSale : cash payment
Choice --> VerifyPayment : card or check

VerifyPayment --> CompleteSale : payment approved

CompleteSale --> WaitingSale : sale complete
@enduml
