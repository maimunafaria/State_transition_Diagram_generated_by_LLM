@startuml
[*] --> Homepage
Homepage --> ProjectSelection : select projects
Homepage --> CareerSelection : select career

state ProjectSelection {
  [*] --> PhotosViewing
  PhotosViewing --> Homepage : back to homepage
  PhotosViewing --> VideoViewing : switch to video
}

state CareerSelection {
  [*] --> UpdatesViewing
  UpdatesViewing --> ApplicationForm : apply for job
  UpdatesViewing --> Homepage : back to homepage
}

ApplicationForm --> ApplicationSubmitted : submit application
ApplicationSubmitted --> [*]

VideoViewing --> Homepage : back to homepage
@enduml
