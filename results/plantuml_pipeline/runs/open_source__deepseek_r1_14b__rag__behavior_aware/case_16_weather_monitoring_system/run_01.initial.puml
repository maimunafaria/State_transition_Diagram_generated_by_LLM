@startuml
title Weather Monitoring System

state "Initial" as Initial
state "Registering" as Registering
state "Login" as Login
state "Weather Data" as WeatherData
state "Additional Details" as AdditionalDetails
state "Logout" as Logout

Initial -> Registering : [Start Registration]
Initial -> Login : [Proceed to Login]

Registering -> Login : [Registration Successful] (valid)
Registering -> Initial : [Registration Failed] (invalid)

Login -> WeatherData : [Valid Credentials] (success)
Login -> Initial : [Invalid Credentials] (failure)

WeatherData -> AdditionalDetails : [View Additional Details]
WeatherData -> Logout : [Logout]

AdditionalDetails -> WeatherData : [Back to Weather Data]
AdditionalDetails -> Logout : [Logout]

Logout -> Initial : [Session Ended]

@enduml
