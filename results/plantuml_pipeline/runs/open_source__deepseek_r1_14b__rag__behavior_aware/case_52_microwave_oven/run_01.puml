@startuml
[*] --> Idle

state Idle {
  [*] --> WaitingForInput : choose power level
  WaitingForInput --> Cooking : enter time
  WaitingForInput --> Idle : cancel
}

state Cooking {
  Cooking --> DoorOpen : door opened
  Cooking --> Canceled : cancel
  Cooking --> Idle : cooking completed
}

state DoorOpen {
  DoorOpen --> Idle : door closed
}

state Canceled {
  Canceled --> Idle
}
@enduml
