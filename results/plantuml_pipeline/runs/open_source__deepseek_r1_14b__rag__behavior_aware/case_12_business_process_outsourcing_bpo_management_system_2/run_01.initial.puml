@startuml
[*] --> StartSearching

state StartSearching
StartSearching --> SelectCategoryFilter : [Select Category]
StartSearching --> SelectPriceRange : [Select Price]

state SelectCategoryFilter <<choice>>
SelectCategoryFilter --> ProcessSearchCategory
SelectCategoryFilter --> BackToStart : [Cancel]

state ProcessSearchCategory
ProcessSearchCategory --> DisplayResultsCategory

state DisplayResultsCategory
DisplayResultsCategory --> [*] : [End Search]

state SelectPriceRange <<choice>>
SelectPriceRange --> ProcessSearchPrice
SelectPriceRange --> BackToStart : [Cancel]

state ProcessSearchPrice
ProcessSearchPrice --> DisplayResultsPrice

state DisplayResultsPrice
DisplayResultsPrice --> [*] : [End Search]
@enduml
