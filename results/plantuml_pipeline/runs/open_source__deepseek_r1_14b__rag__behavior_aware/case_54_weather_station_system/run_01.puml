@startuml
[*] --> Running : restart from shutdown

state Running {
  [*] --> Configuration : configChange
  Configuration --> Running : configDone
}

Running --> DataCollection : clockTriggered
DataCollection --> Running

Running --> SummaryPreparation : prepareSummary
SummaryPreparation --> Running

Running --> StatusCheck : checkStatus
StatusCheck --> Running

Running --> Controlled : remoteControl
Controlled --> Running : exitControlled

Running --> Shutdown : shutdownCommand
Shutdown --> [*]
@enduml
