@startuml
[*] --> Normal
Normal: Current state of watch

state TimeAdjustment {
  [*] --> AdjustingTime
}

state AlarmSetting {
  [*] --> SettingAlarm
}

state AlarmTriggered {
  [*] --> AlarmRinging
}

state LightOn {
  [*] --> LightIsOn
}

state LightOff {
  [*] --> LightIsOff
}

Normal --> TimeAdjustment : Press button to adjust time
TimeAdjustment --> Normal : Done adjusting
Normal --> AlarmSetting : Press button to set alarm
AlarmSetting --> Normal : Done setting alarm
Normal --> LightOn : Press button to turn light on
LightOn --> LightOff : Release button to turn off
LightOn --> TimeAdjustment : Adjusting time with light on
TimeAdjustment --> LightOn : Adjusting time with light on
AlarmSetting --> LightOn : Setting alarm with light on

@enduml
