@startuml
[*] --> Initial

state Initial {
  [*] --> CitizenRegistration : [Citizen]
  [*] --> RegistrarLogin : [Registrar]
}

state CitizenRegistration
CitizenRegistration --> CitizenLogin : [Registered]

state CitizenLogin
CitizenLogin --> MainMenu : [Logged In]

state MainMenu <<choice>>
MainMenu --> UploadDocuments : [Upload]
MainMenu --> ViewProfile : [View Profile]
MainMenu --> ApplyCertificate : [Apply for Certificate]
MainMenu --> Logout : [Logout]

state UploadDocuments
UploadDocuments --> ContinueUpload : [Continue]
UploadDocuments --> MainMenu : [Done]

state ContinueUpload
ContinueUpload --> UploadDocuments : [Uploaded More]
ContinueUpload --> MainMenu : [Done Uploading]

state ViewProfile
ViewProfile --> MainMenu : [Back to Menu]

state ApplyCertificate
ApplyCertificate --> IssueCertificate : [Applied]
ApplyCertificate --> MainMenu : [Cancel Application]

state IssueCertificate
IssueCertificate --> MainMenu : [Reapply]
IssueCertificate --> Logout : [Done]

state RegistrarLogin
RegistrarLogin --> RegistrarMainMenu : [Logged In]

state RegistrarMainMenu <<choice>>
RegistrarMainMenu --> RequestCertificate : [Request]
RegistrarMainMenu --> ViewRequests : [View Requests]
RegistrarMainMenu --> Logout : [Logout]

state RequestCertificate
RequestCertificate --> MainMenu : [Requested]
RequestCertificate --> RegistrarMainMenu : [Cancel]

state ViewRequests
ViewRequests --> RegistrarMainMenu : [Back to Menu]

state Logout <<choice>>
Logout --> [*] : [End Session]
Logout --> MainMenu : [Return Home]

@enduml
