@startuml
[*] --> Initial

state Initial {
  [*] --> SelectAmount : select amount
}

state SelectAmount {
  SelectAmount --> VerifyTransaction : amount
}

state VerifyTransaction {
  VerifyTransaction --> [*] : verified
  VerifyTransaction --> Rejected : rejected
}

state Rejected {
  Rejected --> SelectAmount : re-enter amount
}

@enduml
