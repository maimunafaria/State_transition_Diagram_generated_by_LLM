@startuml
[*] --> LoggedIn

state LoggedIn {
  [*] --> Dashboard
  Dashboard --> ApplicationSubmitted : apply for visa and pay
  Dashboard --> StatusCheck : view status
  Dashboard --> ModifyProfile : modify details
}

ApplicationSubmitted --> StatusCheck : payment confirmed

StatusCheck --> StatusCheck : check again
StatusCheck --> FeedbackGiven : give feedback

FeedbackGiven --> Dashboard : back to dashboard
FeedbackGiven --> Logout : logout

ModifyProfile --> Dashboard : back to dashboard

Logout --> [*] : logged out

state ViewDetails {
  ViewDetails --> Dashboard : back to dashboard
}

state ApplicationSubmitted as "Application Submitted"

@enduml
