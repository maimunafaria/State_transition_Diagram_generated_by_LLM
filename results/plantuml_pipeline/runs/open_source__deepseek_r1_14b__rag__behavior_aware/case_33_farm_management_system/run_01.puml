@startuml
[*] --> InitialState

state InitialState {
  [*] --> Login
}

state Login {
  Login --> LoggedIn : successful login
  Login --> InitialState : failed login
}

state LoggedIn {
  LoggedIn --> Market : select market conditions
  LoggedIn --> PestControl : select pest control
  LoggedIn --> SoilInfo : select soil suggestions
  LoggedIn --> Weather : select weather insights
  LoggedIn --> Labour : select labor availability
  LoggedIn --> Logout : log out
}

state Market {
  Market --> MarketReport : show report
  Market --> LoggedIn : back to menu
}

state PestControl {
  PestControl --> PhotoCapture : provide photo
  PestControl --> LoggedIn : back to menu
}

state SoilInfo {
  SoilInfo --> SoilInput : provide soil info
  SoilInfo --> SoilSuggestions : show suggestions
}

state Weather {
  Weather --> Location : provide location
  Weather --> WeatherInsights : show insights
}

state Labour {
  Labour --> Location : provide location
  Labour --> LabourAvailability : show availability
}

state MarketReport {
  MarketReport --> LoggedIn : continue
}

state PhotoCapture {
  PhotoCapture --> PestTechniques : show techniques
}

state SoilSuggestions {
  SoilSuggestions --> LoggedIn : continue
}

state WeatherInsights {
  WeatherInsights --> LoggedIn : continue
}

state LabourAvailability {
  LabourAvailability --> LoggedIn : continue
}

state PestTechniques {
  PestTechniques --> LoggedIn : continue
}

state Logout {
  Logout --> [*] : end session
}
@enduml
