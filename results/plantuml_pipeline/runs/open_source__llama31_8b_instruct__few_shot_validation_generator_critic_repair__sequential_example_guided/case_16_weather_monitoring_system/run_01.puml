@startuml
title Weather Monitoring System State Diagram

state "Idle" as Idle
Idle : entry/To action
Idle : do/Remain in same state
Idle : exit/Create account / Login

state "Create Account" as CreateAccount
CreateAccount : entry/Enter username and password
CreateAccount : do/Create new user account
CreateAccount : exit/Success / Failure

state "Login" as Login
Login : entry/Enter username and password
Login : do/Verify credentials
Login : exit/Success / Failure

state "Home Page" as HomePage
HomePage : entry/User logged in successfully
HomePage : do/Display home page content
HomePage : exit/Logout requested

state "Settings" as Settings
Settings : entry/User wants to change settings
Settings : do/Change user settings
Settings : exit/Changes saved / Cancel

state "Help" as Help
Help : entry/User needs help
Help : do/Provide help information
Help : exit/Help provided / Cancel

state "Logout" as Logout
Logout : entry/User logs out
Logout : do/Delete session data
Logout : exit/User logged out successfully

[*] --> Idle : [Initial state]

Idle --> CreateAccount : [Create new account]
CreateAccount --> Login : [Successful creation]
Login --> HomePage : [Successful login]
HomePage --> Settings : [User wants to change settings]
Settings --> HomePage : [Changes saved or cancel]
HomePage --> Help : [User needs help]
Help --> HomePage : [Help provided or cancel]
HomePage --> Logout : [Logout requested]

Logout --> [*] : [Final state]
@enduml
