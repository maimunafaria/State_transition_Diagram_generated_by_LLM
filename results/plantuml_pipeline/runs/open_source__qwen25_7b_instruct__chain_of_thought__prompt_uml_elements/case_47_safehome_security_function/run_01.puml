@startuml

[*] : Initial state

state Powering On {
    -> Startup Check on Power-On
}

state Startup Check {
    [Startup Success] --> Ready To Use
    [Startup Problem] --> [*]
}

state Ready To Use {
    [User Activation] --> Monitoring
    [User Reset] --> Ready To Use
    [User Deactivation] --> Ready To Use
    [Password Entered] --> Ready To Use
}

state Monitoring {
    [Sensor Triggered] --> Alarm Activated
}

state Alarm Activated {
    [False Alarm Resolved] --> False Alarm
    [Time Ends] --> Time Ended
}

state False Alarm {
    [User Reset] --> Ready To Use
}

state Time Ended {
    [User Reset] --> Ready To Use
}

[*] : Final state

@enduml
