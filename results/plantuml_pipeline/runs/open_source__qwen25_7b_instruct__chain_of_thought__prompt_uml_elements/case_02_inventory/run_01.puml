@startuml

[*] : Initial State

state "Inventory Management" as IM {
    initial true

    state "Add Goods"

    state "Update Price"

    state "Remove Goods"

    state "Expired Goods Notification"

    state "Order Placement"

    state "Generate Invoice"
}

state "Purchase Process" as PP {
    state "Calculate Discount and Tax"

    state "Generate Receipt"

    state "Replace Item/Cancel Receipt"
}

state "Reporting" as R {
    final true
}

IM --> IM : Add Goods Event
IM --> IM : Update Price Event
IM --> IM : Remove Goods Event
IM --> IM : Expired Goods Notification Event
IM --> PP : Place Order Event
PP --> R : Generate Invoice Event
PP --> PP : Calculate Discount and Tax Event
PP --> PP : Generate Receipt Event
PP --> PP : Replace Item/Cancel Receipt Event
IM --> R : Record Customer Request Event

@enduml
