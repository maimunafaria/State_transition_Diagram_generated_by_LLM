@startuml

[*] : Initial State

state Citizen {
    -> Registered : Register
}

state Registered {
    -> LoggedIn : Login [login details correct]
}

state LoggedIn {
    : SessionActive
    -> DocumentUploading : UploadDocuments
    -> ProfileViewing : ViewProfile
    -> CertificateApplying : ApplyForCertificate
}

state CertificateApplying {
    -> ReapplyForCertificate : ReapplyForCertificate
}

state Registrar {
    -> Registered : Register
}

state LoggedIn (Registrar) {
    : SessionActive
}

finalstate [*] : Final State

@enduml
