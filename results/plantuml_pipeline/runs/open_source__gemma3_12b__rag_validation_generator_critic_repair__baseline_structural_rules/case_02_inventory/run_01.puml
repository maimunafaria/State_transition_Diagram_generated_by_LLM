@startuml
title Inventory System State Machine

[*] --> Idle

state Idle {
}

state AddGoods {
    entry / User initiates adding goods
    exit / Goods added to inventory
}

state UpdatePrice {
    entry / User initiates price update
    exit / Price updated for existing item
}

state RemoveGoods {
    entry / User initiates removal of goods
    exit / Goods removed from inventory
}

state IdentifyExpired {
    entry / System checks for expired goods
    exit / User notified about expired goods
}

state PlaceOrder {
    entry / User initiates order placement
    exit / Order placed with supplier
}

state GenerateInvoice {
    entry / System generates invoice for order
    exit / Invoice created
}

state SearchAndSelect {
    entry / User searches for items
    exit / Items selected for purchase
}

state CalculateDiscountTax {
    entry / System calculates discount and tax
    exit / Discount and tax calculated
}

state GenerateReceipt {
    entry / System generates receipt
    exit / Receipt created for customer
}

state ReplaceCancelReceipt {
    entry / User requests replacement or cancellation
    exit / Receipt replaced or cancelled
}

state RecordCustomerRequest {
    entry / System records customer requests
    exit / Request recorded
}

state ViewSummaryReport {
    entry / User requests summary report
    exit / Report displayed
}

Idle --> AddGoods : Add New Goods
Idle --> UpdatePrice : Update Price
Idle --> RemoveGoods : Remove Goods
Idle --> IdentifyExpired : Check for Expired Goods
Idle --> PlaceOrder : Place Order
Idle --> GenerateInvoice : Generate Invoice
Idle --> SearchAndSelect : Search for Items
Idle --> CalculateDiscountTax : Calculate Discount/Tax
Idle --> GenerateReceipt : Generate Receipt
Idle --> ReplaceCancelReceipt : Replace/Cancel Receipt
Idle --> RecordCustomerRequest : Record Customer Request
Idle --> ViewSummaryReport : View Summary Report

ViewSummaryReport --> [*] : End


@enduml
