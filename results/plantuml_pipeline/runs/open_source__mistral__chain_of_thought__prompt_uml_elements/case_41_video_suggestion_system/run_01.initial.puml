@startuml
state Idle
state RequestReceived
state UserIdentified
state GatheringVideos[Gathering Videos]
  state UserProfileBased[User Profile Based]
  state TrendingLocal[Trending Local]
  state SimilarTags[Similar Tags]
  state SimilarGenres[Similar Genres]
  state PromotedVideos[Promoted Videos]
state VideoDetailsAdded
state SendingSuggestions
state Sent[Sent (Final state)]

Idle:Idle -> RequestReceived:VideoSuggestionRequest
RequestReceived:RequestReceived -> UserIdentified:UserIdentified(condition)
UserIdentified:UserIdentified -> GatheringVideos:GatheringComplete(condition)
GatheringVideos:GatheringVideos -> VideoDetailsAdded:GatheringComplete(condition)
VideoDetailsAdded:VideoDetailsAdded -> SendingSuggestions:DetailsAdded(condition)
SendingSuggestions:SendingSuggestions -> Sent:SendingComplete(condition)
@enduml
