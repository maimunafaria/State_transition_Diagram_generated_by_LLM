@startuml
hide empty state

State Login {
    [*] -> Login: User login event
    Login:User logs in -> MainMenu: on successful login
}

State MainMenu {
    MainMenu:Main area displayed -> MarketConditions: when user selects this option
    MainMenu:Main area displayed -> PestControlHelp: when user chooses pest control help
}

State MarketConditions {
    MarketConditions:User selects market report -> MarketReport: when user selects market report
}

State PestControlHelp {
    PestControlHelp:User provides photo -> PestControlTechniques: after providing a photo
}

State SoilInformationInput {
    SoilInformationInput:Soil information input event -> CropSuggestions: after receiving soil information
}

State CropSuggestions {}
State WeatherInsights {}
State LabourAvailability {}

State PestControlTechniques {}

State ContinueService {}

State Logout {
    MainMenu:User chooses to log out -> Logout: User logs out
    Logout:User logs out -> SessionEnd: on user logout
}

State SessionEnd {}
@enduml
