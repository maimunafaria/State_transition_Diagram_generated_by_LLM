@startuml
hide empty state

State Unauthenticated {
    [*] -> Authentication: LoginEvent
}

State Authentication {
    Authentication -> InvalidLocation: InvalidLocationEvent
    Authentication -> WeatherCheck: WeatherCheckEvent
    Authentication -> AdditionalDetailsView: AdditionalDetailsViewEvent
    Authentication -> SessionEnd: SessionEndEvent
    WeatherCheck -> WeatherSelection: WeatherSelectionEvent
    InvalidLocation: LocationValidationEvent -> Authentication
}

State InvalidLocation {
    [*]
    InvalidLocation -> Authentication: LocationValidationEvent
}

State WeatherSelection {
    [*]
    WeatherSelection -> SessionEnd: SessionEndEvent
}

State SessionEnd {
    [*]
}

@enduml
