@startuml
hide empty state
state Unassigned {
    [*] -> Unassigned: AssignStaffMember
}

state Assigned {
    Unassigned -> Assigned: AssignStaffMember
    Assigned -> Unassigned: RemoveAssignment | LeaveJob
    Assigned: SwitchAssignment
    Assigned -> Unemployed: LeaveJob
}

state Unemployed {
    Assigned: LeaveJob
    Unemployed: ArchiveTimePassed -> Archived
}

state Archived {
    [*] -> Archived
}
@enduml
