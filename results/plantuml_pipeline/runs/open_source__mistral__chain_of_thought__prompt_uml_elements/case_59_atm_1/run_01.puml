@startuml
state Idle(Initial)
state AmountSelection
state PredefinedAmountSelection
state CustomAmountInput
state CancellationOption
state TransactionCancelled
state TransactionCompleted(Final)

Idle -> AmountSelection: User Interaction
AmountSelection -> PredefinedAmountSelection: Predefined Amount Selection
AmountSelection -> CustomAmountInput: Custom Amount Input
AmountSelection -> CancellationOption: Cancel Transaction Option
PredefinedAmountSelection -> TransactionCompleted: Successful Transaction Completion
CustomAmountInput -> TransactionCompleted: Successful Transaction Completion
CancellationOption -> TransactionCancelled: User Confirmation to Cancel
TransactionCancelled -> Idle: Card Returned
TransactionCompleted -> Idle: Timeout or Error (to be specified)
@enduml
