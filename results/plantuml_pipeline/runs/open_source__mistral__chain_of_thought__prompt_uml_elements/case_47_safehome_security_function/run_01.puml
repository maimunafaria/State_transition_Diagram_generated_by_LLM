@startuml
state Startup {
    [*] -> Startup: PowerOn
    Startup: ProblemDuringStartup --> Final: Alarm
    Startup: no ProblemDuringStartup --> ReadyToUse
}

state ReadyToUse {
    ReadyToUse: ActivationRequested --> Normal
    Normal: SensorTriggered --> Alarm
    Normal: FalseAlarm or TimeEnds --> Normal
    Normal: DeactivationRequested --> Final: Normal
    Normal: PasswordEntered --> Final: Normal
}

state Alarm {
    Alarm: FalseAlarm or TimeEnds --> Normal
}
@enduml
