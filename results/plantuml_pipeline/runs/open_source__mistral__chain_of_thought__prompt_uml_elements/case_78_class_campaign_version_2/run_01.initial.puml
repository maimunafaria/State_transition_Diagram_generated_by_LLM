@startuml
hide empty package

state Unassigned {
    [*] -> Assigned: Assignment of manager and staff
}

state Assigned {
    Assigned --> PendingApproval: Approval and contract signing
    Assigned --> #revoke#Unassigned: Revocation of assignment
}

state PendingApproval {
    PendingApproval --> Approved: Settlement of correct balance
}

state Approved {
    Approved --> Preparation: Start of advert preparation
}

state Preparation {
    Preparation --> Scheduled: Approval and scheduling of adverts
}

state Scheduled {
    Scheduled --> Running: Start of adverts
    Scheduled --> #adjustment#Running: Request for campaign extension or adjustment
}

state Running {
    Running --> Completed: When all adverts have finished
    Running --> PaymentPending: If the amount paid is less than required
}

state PaymentPending {
    PaymentPending --> Paid: When full amount properly paid
    PaymentPending --> Refund: If a refund is necessary
}

state Paid {
    Paid --> Archived: Upon campaign completion and release of staff and managers
}

state Completed {
    Completed --> #error#Unassigned: Error during lifecycle
}

@enduml
