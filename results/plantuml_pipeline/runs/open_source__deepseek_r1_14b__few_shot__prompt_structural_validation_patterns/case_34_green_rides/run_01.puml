@startuml
title Green Rides State Transition Diagram

state "Initial" as Initial
state "Logged In" as LoggedIn
state "Journey Details Displayed" as JourneyDetails
state "Choice Point" as J1
state "Driving Mode Activated" as DrivingMode
state "Notifications Sent During Drive" as DrivingNotifications
state "Accident Occurred" as AccidentReport
state "Authorities Notified" as AuthoritiesNotified
state "Eating Options Selected" as EatingOptions
state "Restaurant Order Placed" as RestaurantOrder
state "Feedback Provided" as Feedback
state "Final State" as Final

Initial --> LoggedIn : User Login and Destination Selection

LoggedIn --> JourneyDetails : View Journey Details

JourneyDetails --> J1 : Choose Option

J1 <<choice>>
J1 --> DrivingMode : Activate Driving Mode
J1 --> EatingOptions : Select Place to Eat

DrivingMode --> DrivingNotifications : Start Driving

DrivingNotifications --> AccidentReport : Detects Accident
DrivingNotifications --> DrivingMode : Continue Driving

AccidentReport --> AuthoritiesNotified : Notify Authorities
AuthoritiesNotified --> Feedback : Provide Feedback

EatingOptions --> RestaurantOrder : Order Placed
RestaurantOrder --> Feedback : Provide Feedback

Feedback --> Final : Journey Completion

JourneyDetails --> J1
DrivingMode --> J1
DrivingNotifications --> J1
AccidentReport --> J1
EatingOptions --> J1
RestaurantOrder --> J1

Final <-- [*]
@enduml
