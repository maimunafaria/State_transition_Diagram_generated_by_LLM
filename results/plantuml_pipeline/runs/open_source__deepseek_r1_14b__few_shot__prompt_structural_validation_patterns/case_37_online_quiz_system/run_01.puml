@startuml
title Online Quiz System State Diagram

[*] --> LoginState

state LoginState {
  [*] --> LoginState : initial state
}

LoginState --> TeacherMenu : select teacher
LoginState --> StudentMenu : select student

state TeacherMenu <<choice>> {
  TeacherMenu --> CreatingQuiz : create new quiz
  TeacherMenu --> EditingQuiz : edit existing quiz
  TeacherMenu --> ViewingResults : view results
}

state StudentMenu <<choice>> {
  StudentMenu --> SelectingQuiz : select quiz
}

CreatingQuiz --> SavingDraft : save as draft
CreatingQuiz --> PostingQuiz : post quiz

EditingQuiz --> CreatingQuiz : continue creating
EditingQuiz --> SavingDraft : save changes
EditingQuiz --> ViewingResults : view results

SavingDraft --> TeacherMenu : return to menu
PostingQuiz --> TeacherMenu : return to menu

SelectingQuiz --> AnsweringQuiz : select a quiz

AnsweringQuiz --> SubmittingQuiz : submit answers

SubmittingQuiz --> ViewingResults : view result

ViewingResults --> [*] : exit system

@enduml
