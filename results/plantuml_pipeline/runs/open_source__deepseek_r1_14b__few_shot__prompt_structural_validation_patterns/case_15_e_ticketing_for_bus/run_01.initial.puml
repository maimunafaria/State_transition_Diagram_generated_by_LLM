@startuml
title E-Ticketing System State Diagram

[*] --> CreateUser

state CreateUser
CreateUser --> ValidateRegistration : Register Account

state ValidateRegistration <<choice>>
ValidateRegistration --> Login : [Successful Registration]
ValidateRegistration --> CreateUser : [Failed Validation]

state Login
Login --> MainMenu : [Valid Credentials]

state MainMenu <<choice>>
MainMenu --> CheckTicketStatus : [Check Status]
MainMenu --> BookTicket : [Book Ticket]
MainMenu --> ManageAccount : [Manage Account]

state CheckTicketStatus
CheckTicketStatus --> MainMenu : [Back to Menu]

state BookTicket
BookTicket --> ConfirmPayment : [Confirm Booking]

state ConfirmPayment
ConfirmPayment --> MainMenu : [Payment Complete]

state ManageAccount
ManageAccount --> MainMenu : [Account Updated]

state Logout
MainMenu --> Logout : [Logout]
CheckTicketStatus --> Logout : [Logout]
BookTicket --> Logout : [Logout]
ConfirmPayment --> Logout : [Logout]
ManageAccount --> Logout : [Logout]

Logout --> [*] : [Logged Out]
@enduml
