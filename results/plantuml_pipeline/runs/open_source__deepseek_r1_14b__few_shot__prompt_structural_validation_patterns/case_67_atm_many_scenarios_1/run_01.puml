@startuml
title ATM Control - Scenario 1: PIN Verification and Transaction Processing

state InsertCard {
  [*] --> EnterPIN : Card Inserted
}

state EnterPIN {
  entry / Display "Enter PIN"
  do / User enters PIN
  exit / PIN Entered
}

state VerifyPIN {
  entry / Verify PIN
  do / Check stored information
  exit / Verified or Not Verified
}

state MainMenu <<choice>> {
  entry / Provide options: Withdrawal, Balance Inquiry, etc.
}

state ProcessWithdrawal {
  entry / Select Withdrawal
  do / Enter withdrawal details
  exit / Withdrawal Requested
}

state DispenseCash {
  entry / Dispense requested amount
}

state PrintReceipt {
  entry / Print transaction summary
}

state ReturnCard {
  entry / Eject card after transaction completion
}

state ResetSystem {
  entry / Prepare for next user
}

InsertCard --> EnterPIN : Card Inserted

EnterPIN --> VerifyPIN : PIN Entered

VerifyPIN --> MainMenu : Verified

MainMenu --> ProcessWithdrawal : Withdrawal Selected

ProcessWithdrawal --> DispenseCash : Cash Requested

DispenseCash --> PrintReceipt : Cash Dispensed

PrintReceipt --> ReturnCard : Receipt Printed

ReturnCard --> ResetSystem : Card Returned

ResetSystem --> [*] : System Ready
@enduml
