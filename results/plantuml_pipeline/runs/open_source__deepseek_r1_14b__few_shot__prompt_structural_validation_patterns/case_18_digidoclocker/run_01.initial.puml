@startuml
title Digidoclocker State Diagram

[*] --> Initial

state Initial
Initial --> CitizenMenu : [Citizen]
Initial --> RegistrarMenu : [Registrar]

state CitizenMenu
CitizenMenu --> UploadDocuments : upload documents
CitizenMenu --> ProfileView : view profile
CitizenMenu --> CertificateApplication : apply for certificate
CitizenMenu --> SessionEnd : done

state RegistrarMenu
RegistrarMenu --> RequestVerification : request certificates
RegistrarMenu --> MoreRequests : continue requests
RegistrarMenu --> SessionEnd : done

state UploadDocuments
UploadDocuments --> CitizenMenu : back to menu
UploadDocuments --> ProfileView : view profile after upload
UploadDocuments --> UploadDocuments : continue uploading

state ProfileView
ProfileView --> CitizenMenu : back to menu
ProfileView --> SessionEnd : done

state CertificateApplication
CertificateApplication --> CitizenMenu : back to menu
CertificateApplication --> MoreApplications : reapply
CertificateApplication --> SessionEnd : done

state RequestVerification
RequestVerification --> RegistrarMenu : back to menu
RequestVerification --> MoreRequests : continue requests
RequestVerification --> SessionEnd : done

state MoreRequests
MoreRequests --> RegistrarMenu : back to menu
MoreRequests --> RequestVerification : make request

state MoreApplications
MoreApplications --> CitizenMenu : back to menu
MoreApplications --> CertificateApplication : reapply

SessionEnd --> [*]

@enduml
