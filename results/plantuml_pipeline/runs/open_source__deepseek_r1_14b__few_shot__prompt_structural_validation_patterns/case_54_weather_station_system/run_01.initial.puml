@startuml
title Weather Station State Transition Diagram

[*] --> Shutdown : startup/reset

state Shutdown {
    [*] --> Running : startup/reset
}

state Running {
    --> ConfigurationMode : configuration needed
    --> ControlledMode : remote control command
    --> Running : data collection completed \\n summary sent \\n status checked
}

state ConfigurationMode {
    --> Running : configuration completed
}

state ControlledMode {
    --> Shutdown : shutdown command
}

Shutdown --> [*]
Running --> [*]

@enduml
