@startuml
title UML State Machine Diagram - Farm Management System

state "Initial" as InitialState
state "Logged In" as LoggedInState
state "Market Condition" as MarketConditionState
state "Pest Control" as PestControlState
state "Soil Suggestions" as SoilSuggestionsState
state "Weather Insights" as WeatherInsightsState
state "Labour Availability" as LabourAvailabilityState
state "Logout" as LogoutState

InitialState --> LoggedInState : Login

LoggedInState --> J1 <<choice>>
J1 --> MarketConditionState : Select Market Conditions
J1 --> PestControlState : Select Pest Control
J1 --> SoilSuggestionsState : Select Soil Info
J1 --> WeatherInsightsState : Select Weather
J1 --> LabourAvailabilityState : Select Labour

MarketConditionState --> MarketReportState : View Report
MarketReportState --> LoggedInState : Continue

PestControlState --> PhotoRequiredState : Request Pest Help
PhotoRequiredState --> PestTechniquesState : Show Techniques
PestTechniquesState --> LoggedInState : Continue

SoilSuggestionsState --> SoilInfoReceivedState : Provide Info
SoilInfoReceivedState --> SoilSuggestionsProvidedState : Show Suggestions
SoilSuggestionsProvidedState --> LoggedInState : Continue

WeatherInsightsState --> WeatherLocationState : Provide Location
WeatherLocationState --> WeatherDataState : Show Insights
WeatherDataState --> LoggedInState : Continue

LabourAvailabilityState --> LabourLocationState : Provide Location
LabourLocationState --> LabourDataState : Show Availability
LabourDataState --> LoggedInState : Continue

LoggedInState --> LogoutState : Logout
LogoutState --> [*] : Session Ended

[*] --> InitialState

@enduml
