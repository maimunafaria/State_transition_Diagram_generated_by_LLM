@startuml
title ATM State Diagram

state Initial
state SelectAmount
state VerifyTransaction
state ReEnterAmount
state FinalState

Initial --> SelectAmount : select amount

SelectAmount --> VerifyTransaction : enterAmount

VerifyTransaction --> FinalState : accepted
VerifyTransaction --> ReEnterAmount : rejected

ReEnterAmount --> SelectAmount : reenterAmount

SelectAmount --> FinalState : exit

@enduml
