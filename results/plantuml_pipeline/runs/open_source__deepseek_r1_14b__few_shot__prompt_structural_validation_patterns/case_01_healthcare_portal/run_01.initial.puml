@startuml
title UML State Transition Diagram - Healthcare Portal

[*] --> Idle

state "Idle" as Idle
Idle : entry/Welcome message
Idle : do/Display registration/login options
Idle : exit/Register/Login

state "Register" as Register
Register : entry/Register
Register : do/Validate and create account
Register : exit/RegistrationSuccess/RegistrationFailure

state "Registration Success" as RegistrationSuccess
RegistrationSuccess : entry/Account created
RegistrationSuccess : do/Proceed to login
RegistrationSuccess : exit/MainMenu

state "Registration Failure" as RegistrationFailure
RegistrationFailure : entry/Invalid details
RegistrationFailure : do/Cannot register
RegistrationFailure : exit/Abnormal termination

state "Login" as Login
Login : entry/Login
Login : do/Authenticate user
Login : exit/SignInSuccess/SignInFailure

state "Sign In Success" as SignInSuccess
SignInSuccess : entry/User authenticated
SignInSuccess : do/Access granted
SignInSuccess : exit/MainMenu

state "Sign In Failure" as SignInFailure
SignInFailure : entry/Invalid credentials
SignInFailure : do/Cannot login
SignInFailure : exit/Abnormal termination

state "Main Menu" as MainMenu
MainMenu : entry/Display options
MainMenu : do/Select facility
MainMenu : exit/NewsContent/HealthInfo/InsuranceProcessing/PaymentSelection/FeedbackCollection

state "Read News/Expert Content" as NewsContent
NewsContent : entry/View content
NewsContent : do/Browse articles/expert advice
NewsContent : exit/MainMenu

state "Check Health Information/Symptoms/Fitness" as HealthInfo
HealthInfo : entry/Select option
HealthInfo : do/Answer questions or check fitness
HealthInfo : exit/ResultView

state "View Result" as ResultView
ResultView : entry/Display result
ResultView : do/Decide next action
ResultView : exit/MainMenu/Logout

state "Insurance Processing" as InsuranceProcessing
InsuranceProcessing : entry/Select insurance
InsuranceProcessing : do/Validate insurance details
InsuranceProcessing : exit/PaymentSelection

state "Payment Selection" as PaymentSelection
PaymentSelection : entry/Choose method
PaymentSelection : do/Cash or insurance
PaymentSelection : exit/CashPaymentDetails/PaymentProcessing
@enduml
