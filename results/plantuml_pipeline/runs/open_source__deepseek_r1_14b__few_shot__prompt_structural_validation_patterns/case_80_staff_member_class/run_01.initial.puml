@startuml
title UML State Machine Diagram - Staff Member Assignment

[*] --> Unassigned

state "Unassigned" as Unassigned {
    [*] --> Unassigned : initial

    Unassigned --> Assigned : Assign
    Unassigned --> Switching : SwitchAssignment
}

state "Assigned" as Assigned {
    Assigned --> Unassigned : RemoveAssignment
    Assigned --> Switching : SwitchAssignment
}

state "Switching" as Switching {
    Switching --> Assigned : CompleteSwitch
}

state unemployed as unemployed

unemployed --> Archived : Archive

state Archived as Archived <<final>>

Unassigned --> unemployed : LeaveJob
Assigned --> unemployed : LeaveJob

@enduml
