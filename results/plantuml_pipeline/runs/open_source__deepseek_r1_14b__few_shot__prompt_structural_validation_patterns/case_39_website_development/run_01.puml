@startuml
title UML State Chart Diagram

[*] --> Homepage : Start

state Homepage {
  [*] --> Projects
  Homepage --> CareerOpportunities
}

state Projects {
  Projects --> Photos : [View Photos]
  Projects --> Videos : [Watch Videos]
}

state CareerOpportunities {
  CareerOpportunities --> Updates : [View Updates]
  CareerOpportunities --> ApplicationForm : [Open Form]
}

state ApplicationForm {
  ApplicationForm --> ApplicationChecked : [Submit Application]
}

state Photos
Photos --> [*]

state Videos
Videos --> [*]

state Updates
Updates --> [*]

ApplicationChecked --> [*]

@enduml
