@startuml
title E Visa Processing and Follow Up System State Machine

state CreateAccount {
    [*] --> CreateAccount : user creates account
}

state Login {
    CreateAccount --> Login : user logs in
}

state ApplyForVisa {
    Login --> ApplyForVisa : user applies for visa, makes payment
}

state ViewStatus {
    ApplyForVisa --> ViewStatus : application accepted
}

state CheckStatus {
    ViewStatus --> CheckStatus : user checks status
}

state CancelApplication {
    Login --> CancelApplication : user cancels application
}

state ModifyDetails {
    Login --> ModifyDetails : user modifies details
}

state ViewDetails {
    ModifyDetails --> ViewDetails : user views details
}

state GiveFeedback {
    CheckStatus --> GiveFeedback : user gives feedback
}

state Logout {
    ModifyDetails --> Logout
    ViewDetails --> Logout
    GiveFeedback --> Logout
    CheckStatus --> Logout
}

Login : entry / user logs in
ApplyForVisa : entry / application accepted
ViewStatus : entry / application accepted
CheckStatus : entry / based on document check
GiveFeedback : entry / user gives feedback
Logout : entry / user logs out
@enduml
