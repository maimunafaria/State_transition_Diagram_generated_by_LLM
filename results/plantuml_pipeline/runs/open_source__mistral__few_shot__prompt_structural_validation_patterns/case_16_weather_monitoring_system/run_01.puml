@startuml
title Weather Monitoring System State Diagram

state "Login Screen" as LoginScreen
state "Registration Screen" as RegistrationScreen
state "Main Menu" as MainMenu
state "Invalid Location" as InvalidLocation
state "Weather Details" as WeatherDetails
state "Additional Details" as AdditionalDetails
state "Logout" as Logout

LoginScreen --> RegistrationScreen : Register
RegistrationScreen --> LoginScreen : Back
RegistrationScreen --> [*] : Successful registration

LoginScreen --> MainMenu : Login
MainMenu --> WeatherDetails : Check weather for current location
MainMenu --> EnterLocation : Check weather for another location
EnterLocation --> InvalidLocation : Invalid location entered
InvalidLocation --> MainMenu : Back
EnterLocation --> MainMenu : Valid location entered

WeatherDetails --> WeatherDetails : Temperature
WeatherDetails --> WeatherDetails : Humidity
WeatherDetails --> WeatherDetails : Rainfall
WeatherDetails --> WeatherDetails : Pressure
WeatherDetails --> WeatherDetails : Dew Point
WeatherDetails --> AdditionalDetails : Alerts
WeatherDetails --> AdditionalDetails : Weekly Analysis
WeatherDetails --> AdditionalDetails : Future Prediction
WeatherDetails --> AdditionalDetails : Graph
AdditionalDetails --> MainMenu : Back

MainMenu --> Logout : Logout
Logout --> [*] : Session ended
@enduml
