@startuml
title Plane State Transition Diagram

[*] --> Order : Acquired

state "Order" as OrderState
state Arrival
state Preparation
state Operations
state Maintenance
state OutOfService
state Withdrawn

OrderState --> Arrival : AircraftArrived
Arrival --> Preparation : PlanePrepared

Preparation --> Operations : ScheduleAvailable
Preparation --> Maintenance : MaintenanceRequired

Operations --> Maintenance : NoMoreScheduledFlights
Maintenance --> Preparation : ReadyForOperations

OutOfService --> [*] : NIL
Withdrawn --> [*] : PermanentlyWithdrawn

@enduml
