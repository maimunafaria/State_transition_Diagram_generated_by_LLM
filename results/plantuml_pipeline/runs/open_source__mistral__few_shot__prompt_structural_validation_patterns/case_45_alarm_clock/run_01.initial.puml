@startuml
title UML State Machine Diagram (Alarm Clock)

[*] --> Off : Initialization

state Off {
    state "Set Alarm Time" as SetTime
    state Ringing
    state Active

    Off : do / Off
    Off : exit / After alarm set or canceled

    SetTime --> Activated : [Alarm time set]
    Activated --> Ringing : [Current time matches alarm time]
    Ringing --> Stopped : [User stops the alarm]
    Active --> Off : [Next scheduled alarm time]
}

Ringing : do / Ringing
Stopped : do / Stopping
Active : do / Active

Off : entry / Initial state
Off : exit / Final state

SetTime : do / Setting Alarm Time
Activated : do / Activated
Ringing : do / Ringing
Stopped : do / Stopped
Active : do / Active

@enduml
