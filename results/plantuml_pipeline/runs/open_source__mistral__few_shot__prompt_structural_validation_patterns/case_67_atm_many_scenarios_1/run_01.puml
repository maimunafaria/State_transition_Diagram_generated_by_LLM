@startuml
skinparam packageStyle rectangle

state INSERT_CARD {
    [*] --> ENTER_PIN : CARD_INSERTED
}

state ENTER_PIN {
    ENTER_PIN --> VERIFY_PIN : USER_ENTERS_PIN
    VERIFY_PIN --> PIN_SUCCESS : VALID_PIN
    VERIFY_PIN --> PIN_FAILURE : INVALID_PIN
}

state PIN_SUCCESS {
    PIN_SUCCESS --> OPTIONS : SUCCESSFUL_VERIFICATION
}

state OPTIONS {
    OPTIONS --> WITHDRAWAL : USER_SELECTS_WITHDRAWAL
    OPTIONS --> CANCEL : USER_SELECTS_CANCEL
}

state WITHDRAWAL {
    WITHDRAWAL --> PROCESS_WITHDRAWAL : USER_APPROVES_WITHDRAWAL
    PROCESS_WITHDRAWAL --> DISPENSE_CASH : SUCCESSFUL_WITHDRAWAL
    PROCESS_WITHDRAWAL --> INSUFFICIENT_CASH : INSUFFICIENT_CASH
    PROCESS_WITHDRAWAL --> OUT_OF_CASH : OUT_OF_CASH
}

state DISPENSE_CASH {
    DISPENSE_CASH --> PRINT_RECEIPT : CASH_DISPENSED
    DISPENSE_CASH --> RETURN_CARD : COMPLETED_TRANSACTION
}

state INSUFFICIENT_CASH {
    INSUFFICIENT_CASH --> PRINT_ERROR_MESSAGE : INSUFFICIENT_CASH
    INSUFFICIENT_CASH --> RETURN_CARD : INSUFFICIENT_CASH
}

state OUT_OF_CASH {
    OUT_OF_CASH --> PRINT_ERROR_MESSAGE : OUT_OF_CASH
    OUT_OF_CASH --> PRINT_RECEIPT : REMAINING_CASH_DISPENSED
    OUT_OF_CASH --> RETURN_CARD : OUT_OF_CASH
}

state CANCEL {
    CANCEL --> RETURN_CARD : USER_SELECTS_CANCEL
    CANCEL --> NO_ACTION : USER_SELECTS_CANCEL
}

@enduml
