@startuml
title State machine for Video Suggestion System

state "Request" as Request
state "Identify User" as IdentifyUser
state "Gather Videos" as GatherVideos
state "Add Details" as AddDetails
state "Send Suggestions" as SendSuggestions

[*] --> Request : userRequest()
Request --> IdentifyUser : userFound()
IdentifyUser --> GatherVideos : gatherVideoTypes()
GatherVideos --> AddDetails : videosCollected()
AddDetails --> SendSuggestions : suggestionsReady()
SendSuggestions --> [*] : sendToUser()
@enduml
