@startuml
title BPO Management System Search User

[*] --> Idle

state Idle
state "Select Filter Category" as SelectCategory
state "Select Price Range" as SelectPriceRange
state "Display Matched Users" as DisplayMatchedUsers

Idle --> SelectCategory : Search Selected / Display Categories
SelectCategory --> SelectPriceRange : Price Range Selected / Display Price Ranges
SelectCategory --> DisplayMatchedUsers : User Category Selected / Search Users by Category

SelectPriceRange --> DisplayMatchedUsers : Price Range Selected / Search Users by Price Range

@enduml
