@startuml
title State machine for Microwave Oven

state "Display Current Time" as DisplayTime
state "Choose Power Level" as ChoosePower
state "Set Cooking Time" as SetCookingTime
state "Inactive" as Inactive
state "Operation" as Operation
state "Cancel" as Cancel
state "Door Open" as DoorOpen

DisplayTime --> ChoosePower : [user input]
ChoosePower --> SetCookingTime : [full power or half power selected]
SetCookingTime --> Operation : [cooking time set]
Operation --> DoorOpen : [door opened during operation]
DoorOpen --> Inactive : [immediate stop]
Operation --> Cancel : [user cancels cooking process]
Cancel --> DisplayTime : [return to display current time]
Inactive --> DisplayTime : [wait for user input]
@enduml
