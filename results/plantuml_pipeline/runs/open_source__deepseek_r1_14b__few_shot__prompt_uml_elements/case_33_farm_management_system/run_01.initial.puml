@startuml
title UML State Transition Diagram - Farm Management System

[*] --> Start : Initial

state "Start" as Start
state "LoginState" as LoginState
state "MainMenu" as MainMenu
state "MarketConditions" as MarketConditions
state "PestControl" as PestControl
state "SoilAnalysis" as SoilAnalysis
state "WeatherReport" as WeatherReport
state "LabourAvailability" as LabourAvailability
state "EndSession" as EndSession

Start --> LoginState : Login

LoginState --> MainMenu : Successful login

MainMenu --> MarketConditions : Select market conditions
MainMenu --> PestControl : Select pest control
MainMenu --> SoilAnalysis : Select soil analysis
MainMenu --> WeatherReport : Select weather report
MainMenu --> LabourAvailability : Select labour availability

MarketConditions --> MainMenu : Back to main menu
MarketConditions --> MarketReport : Show report

PestControl --> MainMenu : Back to main menu
PestControl --> PestTechniques : Show techniques
PestControl --> LoginState : Request photo

SoilAnalysis --> SoilSuggestions : Get suggestions
SoilAnalysis --> MainMenu : Back to main menu

WeatherReport --> WeatherInsights : Show insights
WeatherReport --> MainMenu : Back to main menu

LabourAvailability --> LabourDetails : View details
LabourAvailability --> MainMenu : Back to main menu

MarketReport --> MainMenu : Continue using
PestTechniques --> MainMenu : Continue using
SoilSuggestions --> MainMenu : Continue using
WeatherInsights --> MainMenu : Continue using
LabourDetails --> MainMenu : Continue using

MainMenu --> EndSession : Logout

EndSession --> [*] : Session ended
@enduml
