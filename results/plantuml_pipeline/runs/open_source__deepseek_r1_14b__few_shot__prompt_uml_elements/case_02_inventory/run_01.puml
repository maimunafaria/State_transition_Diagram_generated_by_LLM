@startuml
title UML State Machine Diagram

state Initial
Initial --> [*]

state "Add Goods" as AddGoods
AddGoods : entry/Add new goods
AddGoods : do/Update inventory list
AddGoods : exit/Inventory updated

state "Update Price" as UpdatePrice
UpdatePrice : entry/Edit existing item
UpdatePrice : do/Modify price details
UpdatePrice : exit/Prices updated

state "Remove Goods" as RemoveGoods
RemoveGoods : entry/Delete unwanted items
RemoveGoods : do/Adjust inventory count
RemoveGoods : exit/Inventory adjusted

state "Search Items" as SearchItems
SearchItems : entry/Search for available items
SearchItems : do/Display search results
SearchItems : exit/Search completed

state "Purchase Selection" as PurchaseSelection
PurchaseSelection : entry/Select items to buy
PurchaseSelection : do/Add to cart
PurchaseSelection : exit/Cart updated

state "Calculate Discount & Tax" as CalculateDiscountTax
CalculateDiscountTax : entry/Prepare for billing
CalculateDiscountTax : do/Compute totals
CalculateDiscountTax : exit/Billing ready

state "Generate Receipt" as GenerateReceipt
GenerateReceipt : entry/Finalize purchase
GenerateReceipt : do/Create receipt
GenerateReceipt : exit/Sale completed

state "Place Order" as PlaceOrder
PlaceOrder : entry/Request more goods
PlaceOrder : do/Prepare order details
PlaceOrder : exit/Order ready for processing

state "Generate Invoice" as GenerateInvoice
GenerateInvoice : entry/Order placed
GenerateInvoice : do/Create invoice
GenerateInvoice : exit/Invoice sent

state "Detect Expired Goods" as DetectExpiredGoods
DetectExpiredGoods : entry/Automated check
DetectExpiredGoods : do/Identify expired items
DetectExpiredGoods : exit/Expiration list ready

state "Notify Removal" as NotifyRemoval
NotifyRemoval : entry/Prepare removal
NotifyRemoval : do/Remove expired goods
NotifyRemoval : exit/Inventory updated

state "Request Items" as RequestItems
RequestItems : entry/Customer request
RequestItems : do/Record request
RequestItems : exit/Request logged

state "Replace/Cancel Receipt" as ReplaceCancelReceipt
ReplaceCancelReceipt : entry/Edit receipt
ReplaceCancelReceipt : do/Modify or cancel
ReplaceCancelReceipt : exit/Receipt updated

state "View Summary Report" as ViewSummaryReport
ViewSummaryReport : entry/Access reports
ViewSummaryReport : do/Generate report
ViewSummaryReport : exit/
@enduml
