@startuml
title Digidoclocker State Diagram

[*] --> Start

state Start
Start --> IdentifyUserType : identify user type

state IdentifyUserType <<choice>>
IdentifyUserType --> CitizenRegister : citizen
IdentifyUserType --> RegistrarMainMenu : registrar

state CitizenRegister
CitizenRegister --> Login : registration successful

state Login
Login --> MainMenu : login successful

state MainMenu
MainMenu --> UploadDocuments : upload documents
MainMenu --> ViewProfile : view profile
MainMenu --> ApplyCertificate : apply for certificate
MainMenu --> EndSession : done with actions

state UploadDocuments
UploadDocuments --> UploadDocuments : continue uploading
UploadDocuments --> MainMenu : done uploading

state ApplyCertificate
ApplyCertificate --> MainMenu : application submitted
ApplyCertificate --> ApplyCertificate : reapply if needed

state RegistrarMainMenu
RegistrarMainMenu --> RequestCertificate : request verification
RegistrarMainMenu --> RegistrarMainMenu : continue requesting

state EndSession
EndSession --> [*] : session ended

@enduml
