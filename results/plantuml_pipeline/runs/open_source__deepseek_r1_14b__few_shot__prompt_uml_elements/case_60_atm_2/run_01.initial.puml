@startuml
title ATM Withdrawal State Diagram

[*] --> Start

state Start <<initial>>
state SelectAmount
state EnterCustomAmount
state VerifyTransaction
state ReEnterAmount
state End <<final>>

Start --> SelectAmount : select amount from list
SelectAmount --> VerifyTransaction : proceed with selected amount
Start --> EnterCustomAmount : enter custom amount
EnterCustomAmount --> VerifyTransaction : proceed with entered amount

VerifyTransaction --> End : transaction approved
VerifyTransaction --> ReEnterAmount : transaction rejected

ReEnterAmount --> SelectAmount : select new amount
ReEnterAmount --> EnterCustomAmount : enter new amount

SelectAmount --> [*] : cancel
EnterCustomAmount --> [*] : cancel

@enduml
