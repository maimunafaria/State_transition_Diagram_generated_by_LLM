@startuml
title Weather Station State Machine

[*] --> Shutdown : restart()

state Shutdown
state Running
state Configuration
state Controlled

Shutdown --> Running : start()

Running --> Configuration : configure()
Configuration --> Running : doneConfigure()

Running --> Controlled : remoteControl()
Controlled --> Running : exitControlled()

Running --> Shutdown : shutdown()

' Internal transitions in Running state
Running --> Running : collectData()
Running --> Running : prepareSummary()
Running --> Running : checkStatus()

@enduml
