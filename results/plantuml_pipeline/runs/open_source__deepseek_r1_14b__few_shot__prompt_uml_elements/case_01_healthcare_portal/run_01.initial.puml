@startuml
title UML State Transition Diagram - Healthcare Portal

[*] --> Idle

state "Idle" as Idle
Idle : entry/Welcome message
Idle : do/No action
Idle : exit/Register/Login

state "Register" as Register
Register : entry/Register details
Register : do/Validate registration
Register : exit/Success/Failure

state "InvalidRegistration" as InvalidReg
InvalidReg : entry/Invalid registration
InvalidReg : do/Cannot register
InvalidReg : exit/Abnormal termination

state "Login" as Login
Login : entry/Login credentials
Login : do/Authenticate user
Login : exit/Success/Failure

state "InvalidLogin" as InvalidLogin
InvalidLogin : entry/Invalid login
InvalidLogin : do/Cannot login
InvalidLogin : exit/Abnormal termination

state "MainMenu" as MainMenu
MainMenu : entry/Main menu
MainMenu : do/Access facilities
MainMenu : exit/Ready for next action

state "ViewNews" as ViewNews
ViewNews : entry/Read news
ViewNews : do/Browse content
ViewNews : exit/MainMenu

state "HealthInfo" as HealthInfo
HealthInfo : entry/Health information
HealthInfo : do/Chek symptoms or fitness
HealthInfo : exit/MainMenu

state "CheckSymptoms" as CheckSymptoms
CheckSymptoms : entry/Symptom check
CheckSymptoms : do/Evaluate symptoms
CheckSymptoms : exit/View result or MainMenu

state "FitnessCheck" as FitnessCheck
FitnessCheck : entry/Fitness check
FitnessCheck : do/Assess fitness level
FitnessCheck : exit/View result or MainMenu

state "ProcessInsurance" as ProcessIns
ProcessIns : entry/Validate insurance
ProcessIns : do/Check eligibility
ProcessIns : exit/Success/Failure

state "PaymentOptions" as PaymentOpts
PaymentOpts : entry/Payment options
PaymentOpts : do/Select cash/insurance
PaymentOpts : exit/Proceed accordingly

state "CashPayment" as CashPay
CashPay : entry/Cash payment
CashPay : do/Inform details
CashPay : exit/Feedback

state "InsurancePayment" as InsPay
InsPay : entry/Insurance payment
InsPay : do/Process insurance
InsPay : exit/Success or failure

state "Feedback" as Feedback
Feedback : entry/User feedback
Feedback : do/Collect input
Feedback : exit/Logout

state "Logout" as Logout
Logout : entry/Log out
Logout : do/Clear session
Logout : exit/Terminate

Register --> [*]
InvalidReg
@enduml
