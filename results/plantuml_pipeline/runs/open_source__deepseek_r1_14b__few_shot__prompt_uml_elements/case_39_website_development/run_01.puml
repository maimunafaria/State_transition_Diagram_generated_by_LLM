@startuml
title UML State Chart Diagram

state "Homepage" as Homepage {
  [*] --> HomePage
}

state HomePage <<entry point>> {
  HomePage --> Projects : [Select Projects]
  HomePage --> Career : [Select Career]
}

state "Project Information" as ProjectInfo {
  ProjectInfo --> ViewPhotos : [View Photos]
  ProjectInfo --> WatchVideos : [Watch Videos]
  ViewPhotos --> ProjectInfo
  WatchVideos --> ProjectInfo
}

state "Career Information" as CareerInfo {
  CareerInfo --> Updates : [View Updates]
  CareerInfo --> ApplicationForm : [Open Form]
}

state ApplicationForm {
  ApplicationForm --> CheckApplication : [Submit Application]
}

state CheckApplication <<exit point>> {
  CheckApplication --> [*]
}

HomePage --> ProjectInfo
HomePage --> CareerInfo

CareerInfo --> Updates
Updates --> CareerInfo
@enduml
