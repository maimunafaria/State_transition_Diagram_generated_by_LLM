@startuml
title UML State Transition Diagram for Sale Process

state "Waiting for Sale" as WaitingForSale
state EnteringItems
state Payment
state CashPayment
state CardOrCheckPayment
state CompletingSale

[*] --> WaitingForSale : Start

WaitingForSale --> EnteringItems : select items

EnteringItems --> Payment : all items added

Payment --> CashPayment : choose cash
Payment --> CardOrCheckPayment : choose card/check

CashPayment --> CompletingSale : process payment
CardOrCheckPayment --> CompletingSale : verify payment

CompletingSale --> WaitingForSale : payment finished

@enduml
