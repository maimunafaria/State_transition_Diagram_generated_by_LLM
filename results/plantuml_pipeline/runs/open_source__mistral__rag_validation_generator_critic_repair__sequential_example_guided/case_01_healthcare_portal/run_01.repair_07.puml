@startuml
title Car Care - Service Center Login State Machine Diagram

[*] --> PortalChoice1

PortalChoice1 --> PortalChoice2 : [Service Center Portal]
PortalChoice3 --> ServiceCenterRegistration : [New Service center]

state "Service Center Registration" as ServiceCenterRegistration
ServiceCenterRegistration : entry / Unregistered service center
ServiceCenterRegistration : do / Enter Valid Credentials
ServiceCenterRegistration : exit / Account registered

state "Service Center Verification"
ServiceCenterVerification : entry / Verify account
ServiceCenterVerification : do / Check if account is verified
ServiceCenterVerification : exit / ServiceCenterHome

PortalChoice1 --> ServiceCenterVerification

state "Service Center Home"
ServiceCenterHome : entry / Service center home
ServiceCenterHome : do / Display service center options
ServiceCenterHome : exit / MainArea

ServiceCenterVerification --> ServiceCenterHome

MainArea <<choice>> {
  MainArea --> MarketConditions : [showMarketConditions]
  MainArea --> PestControlHelp : [provideTechniques]
  MainArea --> SoilSuggestions : [receiveSoilInfo]
  MainArea --> WeatherInsights : [receiveLocation]
  MainArea --> LabourAvailability : [receiveLocation]
}

state MarketConditions {
  ValidLogin --> MarketConditions
}

state Techniques {
  PestControlHelp --> Techniques : provideTechniques
  Techniques : entry / provideTechniques
  Techniques : do / showTechniques
  Techniques : exit / MainArea
}

state Suggestions {
  SoilSuggestions --> Suggestions : provideSuggestions
  Suggestions : entry / receiveSoilInfo
  Suggestions : do / suggestCrops
  Suggestions : exit / MainArea
}

state Insights {
  WeatherInsights --> Insights : provideInsights
  Insights : entry / receiveLocation
  Insights : do / showWeather
  Insights : exit / MainArea
}

state Availability {
  LabourAvailability --> Availability : provideAvailability
  Availability : entry / receiveLocation
  Availability : do / showLabour
  Availability : exit / MainArea
}

ServiceCenterHome --> MainArea

Techniques --> [*] : COMPLETION_EVENT

Suggestions --> [*] : COMPLETION_EVENT

Insights --> [*] : COMPLETION_EVENT

Availability --> [*] : COMPLETION_EVENT

MainArea --> ServiceCenterHome : [logOut]
@enduml
