@startuml
title Car Care - Service Center Login State Machine Diagram

[*] --> PortalChoice1
PortalChoice1 --> PortalChoice2 : [Service Center Portal]
PortalChoice3 --> ServiceCenterRegistration : [New Service center]
PortalChoice3 --> ServiceJoin : [Registered Service center]

state "Service Center Registration" as ServiceCenterRegistration
ServiceCenterRegistration : entry / Unregistered service center
ServiceCenterRegistration : do / Enter Valid Credentials
ServiceCenterRegistration : exit / ServiceCenterRegistration
ServiceCenterRegistration --> ServiceJoin

state "Service Join" as ServiceJoin
ServiceJoin : entry / Verify Credentials
ServiceJoin : do / Allow Access to system
ServiceJoin : exit / MainArea

state MainArea <<choice>> {
  MainArea --> MarketConditions : [showMarketConditions]
  MainArea --> PestControlHelp : [provideTechniques]
  MainArea --> SoilSuggestions : [receiveSoilInfo]
  MainArea --> WeatherInsights : [receiveLocation]
  MainArea --> LabourAvailability : [receiveLocation]
}

MainArea --> ServiceJoin : [logOut]
@enduml
