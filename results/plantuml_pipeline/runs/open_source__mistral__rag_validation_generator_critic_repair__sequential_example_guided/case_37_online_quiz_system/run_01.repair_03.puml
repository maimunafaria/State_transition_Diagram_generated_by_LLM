@startuml
title UML State Machine Diagram

[*] --> StartJoin : [user action]
StartJoin --> Registration : [register user]
StartJoin --> Authentication : [login user]
StartJoin --> SearchBooks : [search books]
StartJoin --> GetBooksState : [get book details]
StartJoin --> BuyBooks : [buy book]

state "Registration" as Registration {
  Registration --> RegEnterDetails : [enter details]
  state "Enter Details" as RegEnterDetails
  RegEnterDetails --> GetMemberID : [valid entry]
  RegEnterDetails --> ReEnterDetails : [invalid entry]
  ReEnterDetails --> RegEnterDetails
  GetMemberID --> SuccessfulRegistration
}

state "Authentication" as Authentication {
  Authentication --> AuthEnterMemberID : [enter member ID]
  state "Enter Member_ID" as AuthEnterMemberID
  AuthEnterMemberID --> EnterPassword : [enter password]
  EnterPassword --> SuccessfulLogin : [valid entry]
  EnterPassword --> InvalidCreds : [invalid entry]
}

state "Search Books" as SearchBooks {
  SearchBooks --> EnterBookDetails : [enter book details]
  state "Enter Book Details" as EnterBookDetails
  EnterBookDetails --> DisplaySuggestion : [found]
  EnterBookDetails --> ChooseAlternate : [not found]
}

state "Get Books" as GetBooksState {
  GetBooksState --> GetEnterBookID : [enter book ID]
  state "Get Book ID" as GetEnterBookID
  GetEnterBookID --> GetBook : [valid entry]
  GetEnterBookID --> BookNotFound : [invalid entry]
}

state "Buy Books" as BuyBooks {
  BuyBooks --> Pay : [pay for book]
  state "Pay" as Pay
  Pay --> PaymentSuccessful : [valid payment]
  Pay --> PaymentFailed : [invalid payment]
}
@enduml
