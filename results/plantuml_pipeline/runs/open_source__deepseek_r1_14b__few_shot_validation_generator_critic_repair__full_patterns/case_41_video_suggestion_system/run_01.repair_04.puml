@startuml
title UML State Transition Diagram - Video Suggestion System

[*] --> UserSuggestionRequest

state "User suggestion request" as UserSuggestionRequest {
  [*] --> self : entry / Receive suggestion request
}

UserSuggestionRequest --> UserIdentification

state "User identification" as UserIdentification {
  UserIdentification --> GatherSuggestedVideos : Identify user
}

GatherSuggestedVideos : Gather based on profile
GatherSuggestedVideos --> AddVideoDetails

state "Add video details" as AddVideoDetails {
  AddVideoDetails --> SendSuggestions : Add thumbnails and view counts
}

SendSuggestions : Send to user
SendSuggestions --> [*]

@enduml
