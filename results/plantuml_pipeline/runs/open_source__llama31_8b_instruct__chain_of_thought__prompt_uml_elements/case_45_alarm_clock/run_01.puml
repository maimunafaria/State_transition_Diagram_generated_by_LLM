@startuml
[*] --> OffState : Initial State
OffState --> Activated : User sets alarm time
Activated --> Ringing : Current time matches set alarm time
Ringing --> Active : User stops ringing alarm
Activated --> OffState : User turns off activated alarm
Active --> OffState : Final State

state OffState {
  entry: System is in an off state initially
}

state Activated {
  entry: Alarm is set and waiting for alarm time
}

state Ringing {
  entry: Alarm is sounding
}

state Active {
  entry: System remains on after previous alarm stopped
}
@enduml
