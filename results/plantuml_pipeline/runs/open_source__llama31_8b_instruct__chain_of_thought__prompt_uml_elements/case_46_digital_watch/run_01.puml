@startuml
[*] --> Idle : Initial State
Idle --> Setting Hour : Button Pressed
Setting Hour --> Setting Minutes : Button Pressed
Setting Minutes --> Setting Alarm Hour : Button Pressed
Setting Alarm Hour --> Setting Alarm Minutes : Button Pressed
Setting Alarm Minutes --> Alarm On : Button Pressed
Alarm On --> Alarm Off : Alarm Time Matched or Button Pressed
Alarm Off --> Idle : Button Pressed
Idle --> Light On : Light Button Pressed (internal)
Light On --> Light Off : Light Button Released (internal)
Alarm On --> Alarm Disabled : Alarm Button Pressed
Alarm Disabled --> [*] : Final State

state Idle {
  entry: Initial Setup
}

state Setting Hour {
  entry: Display Current Hour
}

state Setting Minutes {
  entry: Display Current Minutes
}

state Setting Alarm Hour {
  entry: Display Alarm Hour
}

state Setting Alarm Minutes {
  entry: Display Alarm Minutes
}

state Alarm On {
  entry: Start Alarm Ringing
}

state Alarm Off {
  entry: Stop Alarm Ringing
}

state Light On {
  entry: Turn On Light
}

state Light Off {
  entry: Turn Off Light
}

state System Powered Down {
  entry: Save Current Settings
}
@enduml
