@startuml
[*] --> Idle
Idle --> Added : User adds new goods
Added --> Updated : User updates price of existing items
Updated --> Removed : Goods removed from inventory
Removed --> Expired : Expired goods identified and notified for removal
Expired --> Removed : Expired goods removed from inventory
Idle --> Ordered : User places order for additional goods
Ordered --> Invoiced : Invoice generated for order
Invoiced --> Selected : Customer selects items for purchase
Selected --> Purchased : Customer has purchased items
Purchased --> Replaced : Item replaced or receipt cancelled during billing process
Replaced --> Idle : Billing process completed

state Idle {
  entry: System is idle and ready to accept user input
}

state Added {
  entry: New goods added to inventory
}

state Updated {
  entry: Price of existing items updated
}

state Removed {
  entry: Goods removed from inventory
}

state Expired {
  entry: Expired goods identified and notified for removal
}

state Ordered {
  entry: Order placed for additional goods
}

state Invoiced {
  entry: Invoice generated for order
}

state Selected {
  entry: Customer selects items for purchase
}

state Purchased {
  entry: Customer has purchased items
}

state Replaced {
  entry: Item replaced or receipt cancelled during billing process
}
@enduml
