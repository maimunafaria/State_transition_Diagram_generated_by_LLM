@startuml
[*] as Initial State
state "Shut Down" {
  [*] ->> "Restart" : restart
}
state "Running" {
  [*] ->> "Configuration Mode" : changes or power-saving settings required
  [*] ->> "Data Collection" : clock trigger
  [*] ->> "Weather Summary Preparation" : request for summary
  [*] ->> "Status Check" : request for status check
  [*] ->> "Controlled Mode" : remote control input
}
state "Configuration Mode" {
  [*] ->> "Running" : configuration completed
}
state "Data Collection" {
  [*] ->> "Running" : activity completed
}
state "Weather Summary Preparation" {
  [*] ->> "Running" : activity completed
}
state "Status Check" {
  [*] ->> "Running" : activity completed
}
state "Controlled Mode" {
  [*] ->> "Shut Down" : shutdown command
}

Initial State -> Shut Down
Shut Down -> Running
Running -> Configuration Mode
Configuration Mode -> Running
Running -> Data Collection
Data Collection -> Running
Running -> Weather Summary Preparation
Weather Summary Preparation -> Running
Running -> Status Check
Status Check -> Running
Running -> Controlled Mode
Controlled Mode -> Shut Down

@enduml
