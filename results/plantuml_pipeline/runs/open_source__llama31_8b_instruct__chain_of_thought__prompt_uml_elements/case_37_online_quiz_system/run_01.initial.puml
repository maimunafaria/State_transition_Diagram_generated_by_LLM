@startuml
[*] as Initial State
Registered -> [*] : User registration/login
Logged In(Teacher) -> Logged In(Student) : Continue as teacher/student after login
Logged In(Teacher) -> Creating Quiz : Selection of "create new quiz" option
Creating Quiz -> Drafting/Publishing Quiz : Saving draft or posting quiz
Drafting/Publishing Quiz -> Viewing Results : Completion of quiz by students
Logged In(Student) -> Selecting Quiz : Student selection of quiz
Selecting Quiz -> Answering Quiz : Student selection of quiz
Answering Quiz -> Submitting Quiz : Submission of quiz answers
Submitting Quiz -> Viewing Result : Viewing result after submitting quiz

state Registered {
  entry: User registration/login
}

state Logged In(Teacher) {
  entry: Continue as teacher after login
  transition Creating Quiz : Selection of "create new quiz" option
  transition Editing Quiz : Selection of existing quiz
}

state Logged In(Student) {
  entry: Continue as student after login
  transition Selecting Quiz : Student selection of quiz
}

state Creating Quiz {
  entry: Saving draft or posting quiz
  transition Drafting/Publishing Quiz : Saving draft or posting quiz
}

state Drafting/Publishing Quiz {
  entry: Saving draft or posting quiz
  transition Viewing Results : Completion of quiz by students
}

state Editing Quiz {
  entry: Selection of existing quiz
  transition Drafting/Publishing Quiz : Saving draft or posting quiz
}

state Selecting Quiz {
  entry: Student selection of quiz
  transition Answering Quiz : Submission of quiz answers
}

state Answering Quiz {
  entry: Submission of quiz answers
  transition Submitting Quiz : Viewing result after submitting quiz
}

state Viewing Results {
  entry: Completion of quiz by students
  final
}

state Viewing Result {
  entry: Viewing result after submitting quiz
  final
}
@enduml
