@startuml
[*] --> Unassigned
state "Unassigned" as unassigned {
  entry: Assign staff member to client or campaign
  transition: Assignment added : Assigned to client
  transition: Assignment added : Assigned to campaign
}
state "Assigned to client" as assigned_to_client {
  transition: Assignment removed : Unassigned
  transition: Staff member leaves job : Unemployed
}
state "Assigned to campaign" as assigned_to_campaign {
  transition: Assignment removed : Unassigned
  transition: Staff member leaves job : Unemployed
}
state "Unemployed" as unemployed {
  transition: Time passed : Archived
}
state "Archived" as archived {
}

unassigned -->|[*] >| assigned_to_client
unassigned -->|[*] >| assigned_to_campaign
assigned_to_client -->|Assignment removed| unassigned
assigned_to_campaign -->|Assignment removed| unassigned
unassigned -->|Staff member leaves job| unemployed
assigned_to_client -->|Staff member leaves job| unemployed
assigned_to_campaign -->|Staff member leaves job| unemployed
unemployed -->|Time passed| archived

@enduml
