@startuml
title Microwave Oven State Machine Diagram

state Idle {
  [*] --> TimeDisplay
}

state TimeDisplay {
  state PowerLevelSelection {
    [*] --> CookingTimeInput
  }

  state CookingTimeInput {
    state DoorOpen {
      [*] --> Cancel : cancelButtonClicked()
      state Inactive : doorOpenDuringOperation()
      Inactive --> Idle : doorClosed()
      DoorOpen --> Stop : doorOpenedDuringCooking()
    }

    CookingTimeInput --> DoorOpen : enterCookingTime()
  }
}

state PowerLevelSelection {
  [*] --> PowerLevelSelection_PowerLevelSelection
}

state PowerLevelSelection_PowerLevelSelection {
  state Idle : userChosePowerLevel()
  Idle --> CookingTimeInput
}

state Cancel {
  [*] --> Cancel
}

state Stop {
  [*] --> Stop
}

state Inactive {
  [*] --> Inactive
}

state DoorOpen {
  [*] --> DoorOpen
}

@enduml
