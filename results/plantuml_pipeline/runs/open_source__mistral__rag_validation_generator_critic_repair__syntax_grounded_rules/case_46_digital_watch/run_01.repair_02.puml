@startuml
Digital Watch State Machine Diagram

[*] --> Idle : InitializationEvent
Idle --> ChangeTime
ChangeTime --> HourAdjust
HourAdjust --> MinuteAdjust
MinuteAdjust --> AlarmHourAdjust
AlarmHourAdjust --> AlarmMinuteAdjust
AlarmMinuteAdjust --> LightOnOff
LightOnOff --> Idle

state AlarmOn
AlarmOn --> AlarmRinging
AlarmRinging --> AlarmStopped : AlarmStopEvent
AlarmStopped --> Idle

state LightOn
LightOn --> LightOff
LightOff --> Idle

state FinalState
FinalState <-- Idle : CompletionEvent
@enduml
