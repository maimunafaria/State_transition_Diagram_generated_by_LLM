@startuml
[*] --> LoggedIn

state LoggedIn {
  [*] --> Dashboard
  Dashboard --> Settings : open settings
  Settings --> Dashboard : back
  Dashboard --> BookTicket : book ticket
  BookTicket --> PaymentConfirmation : payment confirmed
  PaymentConfirmation --> OrderCompleted : order completed
  OrderCompleted --> LoggedIn : logout
}

LoggedIn --> [*] : logout
[*] --> AccountCreation
AccountCreation --> LoggedIn : registration successful

state AccountCreation {
  [account creation form] --> AccountCreated : valid input
  AccountCreated --> InvalidCredentials : invalid input
}

InvalidCredentials --> [*] : retry or return to login
@enduml
