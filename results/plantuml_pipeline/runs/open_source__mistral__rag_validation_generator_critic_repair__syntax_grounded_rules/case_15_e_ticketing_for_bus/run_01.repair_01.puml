@startuml
[*] --> Initial
Initial --> LoggedOut

LoggedOut --> Register : register
Register --> ValidatedUser : valid registration
ValidatedUser --> LoggedIn : log in

state LoggedIn {
  [LoggedIn] --> Dashboard
  Dashboard --> Settings : open settings
  Settings --> Dashboard : back
  Dashboard --> BookTicket : book ticket
  BookTicket --> PaymentConfirmation : payment confirmed
  PaymentConfirmation --> OrderCompleted : order completed
  OrderCompleted --> LoggedOut : logout
}

LoggedIn --> [*] : logout
@enduml
