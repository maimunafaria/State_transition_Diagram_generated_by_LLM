@startuml
[*] --> Idle : Initial State
Idle -->|User selects a filter category|> Searching : Filter Category Selected
Idle -->|User selects a price range as a filter|> Searching : Price Range Selected
Searching -->|User closes the search results|> [*] : Search Results Closed

state Idle {
  note: Default state
}

state Searching {
  note: User has selected a filter category or price range
}

@enduml
