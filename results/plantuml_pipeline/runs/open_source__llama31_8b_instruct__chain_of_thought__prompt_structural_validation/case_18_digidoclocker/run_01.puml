@startuml
[*] --> Unregistered : Initial State
Unregistered --> Registered : User Registration
Registered --> Logged In : Successful Login
Logged In --> Uploading Documents : Upload Documents
Logged In --> Viewing Profile : View Profile
Logged In --> Applying for Certificate : Apply for Certificate
Logged In --> Session Ended : Session Timeout or Completion
Registered --> Unregistered : Logout

choice
  p(login_details_correct) = true -> Logged In : Correct Login Details
  p(login_details_correct) = false -> Registered : Incorrect Login Details
end

choice
  p(user_choice_upload_documents) = true -> Uploading Documents : Upload Documents Choice
  p(user_choice_view_profile) = true -> Viewing Profile : View Profile Choice
  p(user_choice_apply_certificate) = true -> Applying for Certificate : Apply Certificate Choice
end

choice
  p(registrar_request_certification) = true -> Requesting Certificates : Registrar Request
end

choice
  p(session_ended) = true -> [*] : Session Ended
end

Requesting Certificates --> Uploading Documents : Continue Requesting Certificates
Applying for Certificate --> Requesting Certificates : Apply for Multiple Certificates

@enduml
