@startuml
state PowerOn
state StartupCheck
state ReadyToUse
state Reset
state Activated
state Monitoring
state AlarmActivated
state FalseAlarm
state TimeEnd
state Normal

PowerOn --> StartupCheck: power-on
StartupCheck --|> ReadyToUse: StartupCheckComplete
StartupCheck --|> ProblemDuringStartup: ProblemDuringStartup
ReadyToUse --|> Reset: UserResetRequested
ReadyToUse --|> Activated: UserActivationRequested
Activated --|> Monitoring: UserDeactivationRequested
Monitoring --|> AlarmActivated: SensorTriggered
AlarmActivated --|> FalseAlarm : FalseAlarm
AlarmActivated --|> TimeEnd : TimeEnd
FalseAlarm --|> Monitoring
TimeEnd --|> Monitoring
Normal <--| PowerOn: PasswordEntered
@enduml
