@startuml
state Idle {
  [*] --> Idle: User Interaction Event
}

state Search {
  Idle --> Search: User Interaction Event
  Search -- Results: Search Processing Event & Results Retrieval Event
  Search -- Error: Search Criteria Validation Event & Error Detection Event
}

state Results {
  Search -- Results: Search Processing Event & Results Retrieval Event
  Results -- NoMoreResults: User Interaction Event
  Results -- Idle: User Interaction Event
}

state NoMoreResults {
  Results --> NoMoreResults: User Interaction Event
  NoMoreResults --> Idle: User Interaction Event
}

state Error {
  Search --> Error: Search Criteria Validation Event & Error Detection Event
  Error --> Idle: User Interaction Event
}
@enduml
