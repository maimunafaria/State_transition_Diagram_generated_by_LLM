@startuml
state Unregistered [*]
state Registering
state Registered
state SignedOut
state SignIn
state FacilityAccess
state NewsAndContent
state HealthInformation
state ResultView
state PaymentSelection
state CashPaymentDetails
state InsurancePayment
state FeedbackCollection
state LoggedOut

Unregistered --> Registering: NewUserRegistration
Registering -->|valid| Registered: RegistrationSuccess
Registering -->|invalid| SignedOut: RegistrationFailure
Registered --> SignIn
SignIn -->|valid| FacilityAccess, NewsAndContent, HealthInformation: UserSignInSuccess
HealthInformation --> ResultView: HealthInformationAccess
ResultView --> PaymentSelection: ResultViewing
PaymentSelection --> CashPaymentDetails: CashPaymentSelection
CashPaymentDetails --> LoggedOut: ServiceCompletion, CashPaymentSelection
InsurancePayment --> LoggedOut: ServiceCompletion, InsuranceValidation
SignIn --> SignedOut: SignOut
LoggedOut -->|valid| Unregistered: FeedbackSubmission
@enduml
