@startuml
state Off {
    [*] --> Off: User sets an alarm time
}

state AlarmActivated {
    Off --> AlarmActivated: User sets an alarm time
    AlarmActivated --> AlarmRinging: Current time matches set alarm time
}

state AlarmRinging {
    AlarmActivated --> AlarmRinging
    AlarmRinging --> AlarmStopped: User stops the ringing alarm
}

state AlarmStopped {
    AlarmRinging --> AlarmStopped
    AlarmStopped --> [*]: User turns off activated alarm (implicit)
}
@enduml
