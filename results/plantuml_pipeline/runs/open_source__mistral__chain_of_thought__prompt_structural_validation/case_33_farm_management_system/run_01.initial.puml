@startuml
hide empty package

package FarmManagementSystem {
  state LoggedOutState [*]
  state LoginState
  state LoggedInState
  state MainAreaState
  state MarketConditionsState
  state MarketReportState
  state PestControlHelpState
  state PestControlTechniquesState
  state SoilInformationState
  state SoilSuggestionsState
  state LocationState
  state WeatherInsightsState
  state LabourAvailabilityState
  state ContinueServiceState
  state LoggedOutConfirmationState

  event UserLoginEvent
  event ValidCredentialsEvent
  event MarketConditionsSelectionEvent
  event MarketReportSelectionEvent
  event PestControlHelpSelectionEvent
  event PhotoProvidedEvent
  event SoilInformationReceivedEvent
  event SuitableCropsSuggestedEvent
  event LocationProvidedEvent
  event WeatherInsightsRequestEvent
  event LabourAvailabilityRequestEvent
  event ContinueServiceEvent
  event LogoutEvent

  LoginState - UserLoginEvent -> LoginState
  LoginState - ValidCredentialsEvent -> LoggedInState
  LoggedInState - MarketConditionsSelectionEvent -> MainAreaState
  MainAreaState - MarketConditionsSelectionEvent -> MarketConditionsState
  MarketConditionsState - MarketReportSelectionEvent -> MarketReportState
  MainAreaState - PestControlHelpSelectionEvent -> PestControlHelpState
  PestControlHelpState - PhotoProvidedEvent -> PestControlTechniquesState
  LoggedInState - SoilInformationReceivedEvent -> SoilInformationState
  SoilInformationState - SuitableCropsSuggestedEvent -> SoilSuggestionsState
  LocationState - WeatherInsightsRequestEvent -> WeatherInsightsState
  LocationState - LabourAvailabilityRequestEvent -> LabourAvailabilityState
  LoggedInState - ContinueServiceEvent -> ContinueServiceState
  LoggedInState - LogoutEvent -> LoggedOutConfirmationState
}
@enduml
