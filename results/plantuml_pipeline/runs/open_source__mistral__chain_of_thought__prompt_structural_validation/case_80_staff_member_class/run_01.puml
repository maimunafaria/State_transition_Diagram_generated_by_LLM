@startuml
state Employed {
    [*] -> Assigned: Assignment
    Assigned -> Unassigned: Removal or Switching
    Unassigned -> Employed: Assignment
    Employed -> Unemployed: Leaving job
    Unemployed -> Archived: Archiving time elapsed
    Archived -> Employed: rehire or error handling
}
state Assigned {
    Employed -> Assigned
    Assigned -> Unassigned: Removal or Switching
}
state Unassigned {
    Employed -> Unassigned: Assignment
    Unassigned -> Employed: Assignment
}
state Unemployed {}
state Archived {}
@enduml
