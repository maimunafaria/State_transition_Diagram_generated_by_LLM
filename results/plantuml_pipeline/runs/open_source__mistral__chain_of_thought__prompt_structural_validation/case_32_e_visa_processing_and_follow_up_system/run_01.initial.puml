@startuml

state AccountCreation {
    [*] --> AccountCreation: User creates account
}

state Login {
    AccountCreation --> Login: User logs in
}

state ApplicationSubmission {
    Login --> ApplicationSubmission: User applies for a visa and makes payment
}

state Payment {
    ApplicationSubmission --> Payment
}

state ApplicationAcceptance {
    Payment --> ApplicationAcceptance: System accepts the application
}

state Cancellation {
    Login --> Cancellation: User cancels the application
}

state Logout {
    ApplicationAcceptance --> Logout: User logs out
    ApplicationSubmission --> Logout: User logs out
    Cancellation --> Logout: User logs out
    DetailsView --> Logout: User logs out
    Feedback --> Logout: User logs out
    PurposeView --> Logout: User logs out
}

state StatusCheck {
    Login --> StatusCheck: User checks the status of the application
}

state DetailsView {
    Login --> DetailsView: User views their details
}

state Feedback {
    Login --> Feedback: User gives feedback
}

state PurposeView {
    StatusCheck --> PurposeView: System updates the status based on document check
}

state Rejection {
    [*] --> Rejection: Visa application is rejected (implicit)
}

Rejection --> Cancellation: User cancels the rejected application
Rejection --> Logout: User logs out after receiving rejection

@enduml
