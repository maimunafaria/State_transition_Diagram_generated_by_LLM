@startuml
state Unregistered [*]
state Registered
state Logged-out
state Logged-in
state TicketStatusCheck
state BookingTicket
state PaymentConfirmation
state AccountManagement
state Logged-out_Final

Unregistered --> Registered:UserRegistration,AccountValidation
Registered --> Logged-in:LoginAttempt
Logged-in --> TicketStatusCheck,BookingTicket,AccountManagement
TicketStatusCheck --> Logged-in
BookingTicket --> PaymentConfirmation
PaymentConfirmation --> Logged-in
AccountManagement --> Logged-in
Logged-in --> Logged-out:Logout
Logged-out --> Logged-out_Final [*]
@enduml
