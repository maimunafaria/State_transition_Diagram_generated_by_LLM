@startuml
state Idle [*]
state Selection
state CustomInput
state Verification
state Rejected
state Accepted
state Completed

Idle --> Selection: SelectOption
Idle --> CustomInput: CustomInputEvent
Selection --> Verification: ConfirmAmount
CustomInput --> Verification: ValidateCustomValue
Verification --> Rejected: RejectedCondition
Verification --> Accepted: AcceptedCondition
Rejected --> Completed: RetryAmount
Accepted --> Completed: DispenseCash
Completed --> Idle: UserInteractionEnds
@enduml
