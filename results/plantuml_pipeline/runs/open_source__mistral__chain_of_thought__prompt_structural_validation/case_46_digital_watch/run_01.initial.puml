@startuml
state TimeViewingState {
    [*] --> TimeViewingState: AdjustTimeEvent
    TimeViewingState --> AlarmSettingState: SwitchSettingEvent
    TimeViewingState --> LightOnState: LightToggleEvent
}

state AlarmSettingState {
    AlarmSettingState --> TimeViewingState: SetAlarmEvent
}

state AlarmOnState {
    AlarmOnState --> AlarmOffState: AlarmStopEvent
    AlarmOnState --> TimeViewingState: AlarmMatchEvent
}

state AlarmOffState {
    AlarmOffState --> AlarmSettingState: SetAlarmEvent
    AlarmOffState --> LightOnState: LightToggleEvent
}

state LightOnState {
    LightOnState --> LightOffState: LightToggleEvent
}

state LightOffState {
    [*] --> LightOffState
}
@enduml
