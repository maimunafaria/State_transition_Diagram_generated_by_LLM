@startuml
state Idle [*]
state PowerSelection
state TimeInput
state Cooking
state DoorOpen
state Cancelled
state FinalState = Idle

Idle --> PowerSelection: UserInput
PowerSelection --> TimeInput: UserInput
TimeInput --> Cooking: UserInput
Cooking --> DoorOpen: DoorOpenEvent|Cancelled: CancelEvent|CookingCompleteEvent
DoorOpen --> Idle: DoorOpenEvent
Cancelled --> Idle: CancelEvent
CookingCompleteEvent --> FinalState

@enduml
