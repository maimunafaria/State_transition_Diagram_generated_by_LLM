@startuml

[*] --> Idle : Initial State

Idle --> WaitingForAmount : UserChoosesPredefinedAmount or UserEntersCustomAmount
WaitingForAmount --> ProcessingWithdrawal : UserConfirmsChoice
WaitingForAmount --> Cancelled : UserCancelsTransaction
ProcessingWithdrawal --> Idle : TransactionCompleted

Cancelled --> [*] : Final Transition

@enduml
