@startuml
title UML state machine diagram

state "Home" as Home
Home : entry/Home Page
Home : do/Navigate using Navigation Bar

state "Projects" as Projects
Projects : entry/Selected Projects from Home
Projects : do/View Photos or Videos

state "Career Opportunities" as CareerOpportunities
CareerOpportunities : entry/Selected Career Opportunities from Home
CareerOpportunities : do/View Updates or Application Form

state "Photo View" as PhotoView
PhotoView : entry/Selected Photos in Projects
PhotoView : exit/Return to Projects

state "Video View" as VideoView
VideoView : entry/Selected Videos in Projects
VideoView : exit/Return to Projects

state "Update View" as UpdateView
UpdateView : entry/Selected Updates in Career Opportunities
UpdateView : exit/Return to Career Opportunities

state "Application Form" as ApplicationForm
ApplicationForm : entry/Selected Application Form in Career Opportunities
ApplicationForm : do/Send Application
ApplicationForm : exit/Check Submitted Job Applications

state "Job Application Check" as JobApplicationCheck
JobApplicationCheck : entry/Application Checked
JobApplicationCheck : exit/Final State

[*] --> Home
Home --> Projects : View Projects
Projects --> PhotoView : View Photos
Projects --> VideoView : View Videos
Projects --> CareerOpportunities : View Career Opportunities
CareerOpportunities --> UpdateView : View Updates
CareerOpportunities --> ApplicationForm : Open Application Form
ApplicationForm --> JobApplicationCheck : Submit Application

@enduml
