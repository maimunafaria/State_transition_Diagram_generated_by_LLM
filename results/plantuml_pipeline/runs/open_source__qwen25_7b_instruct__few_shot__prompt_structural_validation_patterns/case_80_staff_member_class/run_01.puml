@startuml
title Staff Member Class State Machine

[*] --> Assigning : [new assignment]
state Assigning <<choice>>
Assigning --> AddingToCampaign : [add to campaign]
Assigning --> Unassigned : [remove from current assignment]

state Unassigned {
  state "Unemployed" as Unemployed <<final>>
  Unassigned --> Unemployed : [staff member leaves job]
}

state "Archived" as Archived <<final>>

Unemployed --> Archiving : [after some time]
Archiving --> [*] : [archive record]

Assigning --> Unassigned : [remove from current assignment]
AddingToCampaign --> Unassigned : [remove from campaign]

[*] --> Assigning

@enduml
