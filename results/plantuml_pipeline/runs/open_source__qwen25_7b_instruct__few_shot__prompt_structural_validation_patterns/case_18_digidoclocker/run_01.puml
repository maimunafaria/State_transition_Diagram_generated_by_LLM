@startuml
title Digidoclocker State Diagram

[*] --> CitizenRegistration

state CitizenRegistration
state "CitizenLogin" as CitizenLogin
state DocumentUpload
state ProfileView
state CertificateApplication
state "ContinueUploadingDocuments" as ContinueUploading
state RegistrarRequest
state "ContinueRegistrarRequests" as ContinueRegistrarRequests
state SessionEnd

citizenRegistration --> citizenLogin : register
citizenLogin --> documentUpload : login
documentUpload --> profileView : viewProfile
profileView --> certificateApplication : applyForCertificate
certificateApplication --> continueUploading : uploadMoreDocuments
continueUploading --> profileView : viewProfile
certificateApplication --> registrarRequest : requestCertificate
registrarRequest --> continueRegistrarRequests : requestMoreCertificates

citizenLogin --> sessionEnd : logout
documentUpload --> sessionEnd : complete
profileView --> sessionEnd : logout
certificateApplication --> sessionEnd : complete
continueUploading --> sessionEnd : logout
registrarRequest --> sessionEnd : complete
continueRegistrarRequests --> sessionEnd : complete

@enduml
