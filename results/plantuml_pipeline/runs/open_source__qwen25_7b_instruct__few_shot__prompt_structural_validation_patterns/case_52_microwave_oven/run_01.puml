@startuml

title UML State Machine Diagram - Microwave Oven

[*] --> DisplayTime

state "Display Time" as DisplayTime {
  [H] --> DisplayTime : [Door Closed]
}

state "Choose Power Level" as ChoosePowerLevel
state "Set Cooking Time" as SetCookingTime
state "Cooking Process" as CookingProcess
state "Inactive" as Inactive

DisplayTime --> ChoosePowerLevel : User Input

ChoosePowerLevel --> SetCookingTime : Full or Half Power Selected
ChoosePowerLevel --> Inactive : Door Opened

SetCookingTime --> CookingProcess : Time Set
SetCookingTime --> Inactive : Cancel Cooking

state "Door Open" as DoorOpen <<choice>>
CookingProcess --> DoorOpen : Door Opened
DoorOpen --> Inactive : [Door Closed]

Inactive --> DisplayTime : Next Use

@enduml
