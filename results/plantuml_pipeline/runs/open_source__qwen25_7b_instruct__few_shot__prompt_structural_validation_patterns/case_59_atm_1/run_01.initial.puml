@startuml
title State diagram for ATM Withdrawal

state "Initial" as Initial {
  [*] --> Initial : Start
}

state "SelectAmount" as SelectAmount
state "CustomAmount" as CustomAmount
state "CancelTransaction" as CancelTransaction
state "ReturnCard" as ReturnCard

Initial --> SelectAmount : Choose predefined amount
Initial --> CustomAmount : Enter custom amount

SelectAmount --> SelectAmount : Confirm selection
SelectAmount --> CancelTransaction : Cancel transaction

CustomAmount --> CancelTransaction : Cancel transaction

CancelTransaction --> ReturnCard : Stop transaction and return card
ReturnCard --> [*]

@enduml
