@startuml
title Process Sale State Machine

[*] --> WaitingForSale

state WaitingForSale {
  state AddingItems <<fork>>
}

AddingItems --> Payment : all items added

Payment --> CashPayment : pay with cash
CashPayment --> CompleteSale : payment received
CompleteSale --> [*] : sale completed

Payment --> CardCheckVerification : choose card or check
CardCheckVerification --> VerifyPayment : verify payment
VerifyPayment --> ApprovedPayment : payment approved
ApprovedPayment --> CompleteSale : complete sale
CompleteSale --> [*] : sale completed

@enduml
