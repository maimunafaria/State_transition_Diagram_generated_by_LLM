@startuml
title Weather Station System State Diagram

[*] --> Running

state Running <<choice>>
state Shutdown
state ConfigMode
state SummaryPrep
state StatusCheck

Running --> ConfigMode : enterConfig
ConfigMode --> Running : exitConfig
Shutdown --> Running : restart
Running --> SummaryPrep : prepareSummary
SummaryPrep --> Running : completeSummary
Running --> StatusCheck : checkStatus
StatusCheck --> Running : completeCheck
Running --> Shutdown : shutdownCommand
Shutdown --> [*] : powerOff

ConfigMode --> Running : completeConfig

@enduml
