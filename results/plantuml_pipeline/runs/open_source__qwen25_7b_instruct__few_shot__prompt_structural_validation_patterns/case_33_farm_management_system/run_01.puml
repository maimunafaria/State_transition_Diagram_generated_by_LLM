@startuml
title UML State Chart Diagram for Farm Management System

state "Logged Out" as LoggedOut {
  [*] --> Login
}

state "Login" as Login
state "Main Area" as MainArea
state "Market Conditions" as MarketConditions
state "Market Report" as MarketReport
state "Pest Control Help" as PestControlHelp
state "Pest Control Techniques" as PestControlTechniques
state "Soil Suggestions" as SoilSuggestions
state "Weather Insights" as WeatherInsights
state "Labour Availability" as LabourAvailability
state "Logged In" as LoggedIn

Login --> MainArea : loginSuccessful

MainArea --> MarketConditions : selectMarketConditions
MainArea --> MarketReport : selectMarketReport
MainArea --> PestControlHelp : selectPestControlHelp
MainArea --> SoilSuggestions : provideSoilInfo
MainArea --> WeatherInsights : provideLocationForWeather
MainArea --> LabourAvailability : provideLocationForLabour

MarketConditions --> MainArea : viewResults
MarketReport --> MainArea : viewResults
PestControlHelp --> PestControlTechniques : providePhoto
PestControlTechniques --> MainArea : viewResults
SoilSuggestions --> MainArea : viewResults
WeatherInsights --> MainArea : viewResults
LabourAvailability --> MainArea : viewResults

PestControlHelp --> PestControlTechniques : [photoProvided]

LoggedIn --> MainArea : continueUsingService
MainArea --> LoggedIn : logout

@enduml
