@startuml
title UML State Machine Diagram - Healthcare Portal

[*] --> Registration : [New User]

state "Registration" as Registration
Registration : entry/Unregistered User
Registration : do/Register
Registration : exit/Registered User or Failure

state "Login" as Login
Login : entry/Not Logged In
Login : do/Login
Login : exit/Logged In Successfully

state "Home" as Home
Home : entry/User Logged in
Home : do/Access Facilities
Home : exit/View News and Content
Home : exit/Check Symptoms or Fitness
Home : exit/Payment for Services
Home : exit/Feedback Collection
Home : exit/Logout

state "Read News and Content" as ReadContent
ReadContent : entry/To Read Content
ReadContent : do/Read News and Expert Content
ReadContent : exit/Return to Home

state "Check Symptoms or Fitness" as CheckSymptoms
CheckSymptoms : entry/To Check Symptoms/Fitness
CheckSymptoms : do/Check Symptoms or Fitness
CheckSymptoms : exit/Return to Home

state "Payment for Services" as PaymentServices
PaymentServices : entry/Payment Required
PaymentServices : do/Process and Validate Insurance
PaymentServices : exit/Insurance Payment Complete
PaymentServices : exit/Cash Payment Details
PaymentServices : exit/Complete Cash Payment Process

state "Cash Payment Details" as CashDetails
CashDetails : entry/Payment Method Chosen: Cash
CashDetails : do/Collect Cash Payment Details
CashDetails : exit/Return to Home

state "Feedback Collection" as Feedback
Feedback : entry/Service Completed
Feedback : do/Capture User Feedback
Feedback : exit/Return to Home

state "Logout" as Logout
Logout : entry/User Logging Out
Logout : do/Log Out
Logout : exit/User Logged Out

Login --> Home : [User Logs In]
Registration --> Login : [Registration Successful]

Home --> ReadContent : [Read Content]
Home --> CheckSymptoms : [Check Symptoms/Fitness]
Home --> PaymentServices : [Payment Required for Services]
Home --> Feedback : [Service Completed]

ReadContent --> Home
CheckSymptoms --> Home

PaymentServices --> CashDetails : [Cash Payment Chosen]
PaymentServices --> Home : [Insurance Payment Complete or Cash Payment Processed]

CashDetails --> Home

Feedback --> Home

Logout --> [*] : [Session Ended]

@enduml
