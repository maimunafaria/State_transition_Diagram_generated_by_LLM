@startuml
title Video Suggestion System State Machine

[*] --> IdentifyUser

state "IdentifyUser" as IdentifyUser

state GatherVideos {
  [*] --> GatherVideos
  state "Gathering Profile Videos"
  state "Gathering Trending Videos"
  state "Gathering Tagged Videos"
  state "Gathering Genre Videos"
  state "Gathering Promoted Videos"
}

state SendSuggestions

IdentifyUser --> GatherVideos : Video Suggestion Request Received / Identify User
GatherVideos --> SendSuggestions : Videos Gathered / Add Details and Send Suggestions
SendSuggestions --> [*] : Suggestions Sent to User / End Process

@enduml
