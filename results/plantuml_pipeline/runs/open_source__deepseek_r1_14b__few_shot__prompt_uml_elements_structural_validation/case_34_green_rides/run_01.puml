@startuml
title UML State Transition Diagram for Green Rides

[*] --> DisplayJourneyDetails : User Login & Destination Selected

state "Display Journey Details" as DisplayJourneyDetails
DisplayJourneyDetails : entry / Show journey details
DisplayJourneyDetails : exit / Ready for next action

state "Driving Mode" as DrivingMode
DrivingMode : entry / Activate driving mode
DrivingMode : do / Monitor driving conditions
DrivingMode : exit / Deactivate driving mode

state "Other Options" as OtherOptions
OtherOptions : entry / Show additional options
OtherOptions : exit / Ready for next action

state "Select Place to Eat" as SelectPlaceToEat
SelectPlaceToEat : entry / Choose restaurant
SelectPlaceToEat : do / View menu and place order
SelectPlaceToEat : exit / Order confirmed or canceled

state "Accident Reported" as AccidentReported
AccidentReported : entry / Notify authorities
AccidentReported : do / Handle accident situation
AccidentReported : exit / Situation resolved

DisplayJourneyDetails --> DrivingMode : [Activate driving mode]
DisplayJourneyDetails --> OtherOptions : [Choose other options]

DrivingMode --> DisplayJourneyDetails : [Deactivate driving mode]
DrivingMode --> AccidentReported : [Detect accident condition]

OtherOptions --> SelectPlaceToEat : [Select place to eat]
SelectPlaceToEat --> OtherOptions : [Order completed or canceled]

AccidentReported --> DrivingMode : [Continue driving after reporting]

state "Provide Feedback" as ProvideFeedback
ProvideFeedback : entry / Show feedback form
ProvideFeedback : do / Submit feedback
ProvideFeedback : exit / Journey completion

SelectPlaceToEat --> ProvideFeedback : [Complete journey]
DrivingMode --> ProvideFeedback : [Journey completed normally]

ProvideFeedback --> [*] : [Feedback submitted]

@enduml
