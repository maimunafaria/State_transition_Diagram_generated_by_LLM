@startuml
title Online Quiz System State Diagram

[*] --> InitialState

state InitialState {
  [*] --> RegistrationLogin
}

state RegistrationLogin {
  entry / Start registration/login process
  do / Perform registration or login
  exit / Move to role selection
  RegistrationLogin --> TeacherRole : teacher selected
  RegistrationLogin --> StudentRole : student selected
}

state TeacherRole {
  entry / Logged in as teacher
  do / Ready to manage quizzes
  exit / Role change or action taken
  TeacherRole --> CreateQuiz : create new quiz
  TeacherRole --> EditQuiz : edit existing quiz
  TeacherRole --> ViewResults : view results
}

state CreateQuiz {
  entry / Creating a new quiz
  do / Add questions and configure settings
  exit / Move to next action
  CreateQuiz --> SaveDraft : save as draft
  CreateQuiz --> PostQuiz : post for students
  CreateQuiz --> TeacherRole : back to teacher menu
}

state EditQuiz {
  entry / Editing an existing quiz
  do / Modify questions or settings
  exit / Move to next action
  EditQuiz --> SaveDraft : save changes
  EditQuiz --> ViewResults : view results
  EditQuiz --> TeacherRole : back to teacher menu
}

state Save
@enduml
