@startuml
title UML State Chart Diagram (Campaign Management)

[*] --> CampaignStarted

state CampaignStarted
state ApprovedAndContractSigned
state AdvertsPrepared
state AdvertsApprovedScheduled
state AdvertsRunning
state AdjustedCampaign
state AllAdvertsFinished
state PaymentProcessing
state BalanceSettled
state FullAmountPaid
state ArchiveAndRelease

CampaignStarted --> ApprovedAndContractSigned : approveAndContractSigned

ApprovedAndContractSigned --> AdvertsPrepared : prepareAdverts

AdvertsPrepared --> AdvertsApprovedScheduled : approveScheduleAdverts

AdvertsApprovedScheduled --> AdvertsRunning : runAdverts

AdvertsRunning --> AllAdvertsFinished : advertsFinished
AdvertsRunning --> AdjustedCampaign : adjustCampaign

AdjustedCampaign --> AdvertsApprovedScheduled : reapproveScheduleAdverts

AllAdvertsFinished --> PaymentProcessing : processPayment

PaymentProcessing --> FullAmountPaid : amountCorrect
PaymentProcessing --> BalanceSettled : amountOverpaid

BalanceSettled --> PaymentProcessing : settleBalance

FullAmountPaid --> ArchiveAndRelease : archiveCampaign

ArchiveAndRelease --> [*]

@enduml
