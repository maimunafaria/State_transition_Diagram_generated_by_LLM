@startuml
title Sale Process State Diagram

[*] --> WaitingForSale : Start

state "Waiting for sale" as WaitingForSale
state AddingItems
state Payment
state VerifyingPayment
state SaleCompleted <<final>>

WaitingForSale --> AddingItems : select items

AddingItems --> Payment : all items added

Payment --> SaleCompleted : cash payment [cashSelected]
Payment --> VerifyingPayment : card or check payment [cardOrCheckSelected]

VerifyingPayment --> SaleCompleted : payment approved [paymentApproved]

SaleCompleted --> WaitingForSale : next customer

@enduml
