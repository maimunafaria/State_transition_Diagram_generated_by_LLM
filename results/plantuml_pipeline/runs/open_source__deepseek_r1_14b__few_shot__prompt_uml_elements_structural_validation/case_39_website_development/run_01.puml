@startuml
title UML State Transition Diagram for Website Development

state "Homepage" as Homepage {
  [*] --> HomePage
}

state HomePage {
  HomePage --> ProjectInfo : Projects
  HomePage --> CareerInfo : Career
}

state "Project Info" as ProjectInfo {
  ProjectInfo --> Photos : [View Photos]
  ProjectInfo --> Videos : [Watch Videos]
}

state "Career Info" as CareerInfo {
  CareerInfo --> Updates : [View Updates]
  CareerInfo --> ApplicationForm : [Open Form]
}

state Photos
Photos --> HomePage

state Videos
Videos --> HomePage

state Updates
Updates --> HomePage

state ApplicationForm {
  ApplicationForm --> ApplicationCheck : Submit
}

state "Application Check" as ApplicationCheck
ApplicationCheck --> HomePage

@enduml
