@startuml
title UML State Machine Diagram

[*] --> Initial

state Initial {
  [*] --> Processing_Category_Search : [Select Category Filter]
  [*] --> Processing_Price_Search : [Select Price Range]
}

state "Processing Category Search" as Processing_Category_Search
Processing_Category_Search --> Display_Results : [Search Completed]

state "Processing Price Search" as Processing_Price_Search
Processing_Price_Search --> Display_Results : [Search Completed]

state "Display Results" as Display_Results
Display_Results --> [*] : [Process Complete]
@enduml
