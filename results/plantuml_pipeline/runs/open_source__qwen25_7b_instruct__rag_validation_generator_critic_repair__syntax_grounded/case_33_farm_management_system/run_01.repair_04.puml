@startuml
title UML State Chart Diagram

[*] --> Login

state Login {
  [*] --> ValidLogin
  ValidLogin : entry / verifyData
  ValidLogin : do / allow Access to system
  ValidLogin : exit / MainArea
}

state MainArea <<choice>> {
  MainArea --> MarketConditions : [showMarketConditions]
  MainArea --> PestControlHelp : [requestPestControlHelp]
  MainArea --> SoilSuggestions : [provideSoilInfo]
  MainArea --> WeatherInsights : [receiveLocation]
  MainArea --> LabourAvailability : [receiveLocation]
}

state MarketConditions {
  ValidLogin --> MarketConditions
}

state PestControlHelp {
  ValidLogin --> Techniques : [requestTechniques]
  Techniques : entry / provideTechniques
  Techniques : do / showTechniques
  Techniques : exit / MainArea
}

state SoilSuggestions {
  ValidLogin --> Suggestions : [receiveSoilInfo]
  Suggestions : entry / receiveSoilInfo
  Suggestions : do / suggestCrops
  Suggestions : exit / MainArea
}

state WeatherInsights {
  ValidLogin --> Insights : [receiveLocation]
  Insights : entry / receiveLocation
  Insights : do / showWeather
  Insights : exit / MainArea
}

state LabourAvailability {
  ValidLogin --> Availability : [receiveLocation]
  Availability : entry / receiveLocation
  Availability : do / showLabour
  Availability : exit / MainArea
}

state Techniques {
  Techniques --> [*] : COMPLETION_EVENT
}

state Suggestions {
  Suggestions --> [*] : COMPLETION_EVENT
}

state Insights {
  Insights --> [*] : COMPLETION_EVENT
}

state Availability {
  Availability --> [*] : COMPLETION_EVENT
}

Login --> ValidLogin

ValidLogin --> MainArea

MainArea --> MarketConditions
MainArea --> PestControlHelp
MainArea --> SoilSuggestions
MainArea --> WeatherInsights
MainArea --> LabourAvailability

PestControlHelp --> Techniques

SoilSuggestions --> Suggestions

WeatherInsights --> Insights

LabourAvailability --> Availability

Techniques --> [*]

Suggestions --> [*]

Insights --> [*]

Availability --> [*]

[*] --> Logout

Logout : entry / endSession
@enduml
