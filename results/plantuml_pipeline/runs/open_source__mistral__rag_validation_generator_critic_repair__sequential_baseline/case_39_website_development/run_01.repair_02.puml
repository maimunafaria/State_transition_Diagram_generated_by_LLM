@startuml
[*] --> Homepage
Homepage -- Login : LoginButton
Login --|> LoggedIn : authenticate
LoggedIn --> Projects : navigate
Projects --|> PhotoView : viewPhotos
Projects --|> VideoView : viewVideos
Projects --|> CareerOpportunities : careerInfo
CareerOpportunities --|> Updates : viewUpdates
CareerOpportunities --|> ApplicationForm : openApplicationForm
LoggedIn --|> Logout : logout
LoggedOut --> [*]
AccessEnded --> [*]
@enduml
