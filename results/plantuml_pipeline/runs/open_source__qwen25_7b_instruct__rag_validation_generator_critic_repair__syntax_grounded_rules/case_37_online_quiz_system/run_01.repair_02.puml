@startuml
title UML State Machine Diagram

[*] --> RegisterOrLogin

state "Register or Login" as RegisterOrLogin {
  [*] --> Register
  Register : do / Fill details
  Register : exit / Registration successful

  Register : --> Login
  Login : entry / Registered user
  Login : do / Enter login credentials
  Login : exit / Valid username and password

  Login : --> TeacherChoice
  Login : --> StudentChoice
}

state "Teacher Choice" as TeacherChoice {
  entry / Teacher logged in
  do / Create, edit, or save quiz
  exit / Action completed
}

state "Student Choice" as StudentChoice {
  entry / Student logged in
  do / Select and answer quiz
  exit / Quiz submitted
}

state "Create Quiz" as CreateQuiz {
  entry / New quiz creation
  do / Define questions, options, etc.
  exit / Quiz saved or posted
}

state "Edit Quiz" as EditQuiz {
  entry / Existing quiz editing
  do / Modify questions, options, etc.
  exit / Quiz updated
}

state "Save Quiz" as SaveQuiz {
  CreateQuiz --> SaveQuiz
  EditQuiz --> SaveQuiz
  entry / Saving changes
  do / Save quiz as draft or post it
  exit / Quiz saved or posted
}

state "View Results" as ViewResults {
  TeacherChoice --> ViewResults
  entry / Quiz results available
  do / Review student answers and scores
  exit / Results reviewed
}

state "Select Quiz" as SelectQuiz {
  StudentChoice --> SelectQuiz
  entry / Quizzes available for selection
  do / Choose a quiz to take
  exit / Quiz selected
}

state "Answer Quiz" as AnswerQuiz {
  SelectQuiz --> AnswerQuiz
  entry / Quiz questions displayed
  do / Answer each question
  exit / Answers submitted
}

state "Submit Quiz" as SubmitQuiz {
  AnswerQuiz --> SubmitQuiz
  entry / Quiz submission
  do / Finalize and submit answers
  exit / Quiz submitted, results viewable
}

state "View Result" as ViewResult {
  SubmitQuiz --> ViewResult
  entry / Results available
  do / Review quiz score and feedback
  exit / Results reviewed
}

TeacherChoice --> CreateQuiz
TeacherChoice --> EditQuiz

[*] --> ViewResults : COMPLETION_EVENT

@enduml
