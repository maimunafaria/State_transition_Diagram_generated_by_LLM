@startuml
title ATM State Machine

[*] --> InitialSelect : amount

state SelectAmount {
  state "SelectAmount <<initial>>" as InitialSelect
  InitialSelect --> VerifyTransaction : verifyTransaction
}

state VerifyTransaction

state ReleaseCard

VerifyTransaction --> VerifyTransaction : [invalid]
VerifyTransaction --> ReleaseCard : [valid]

@enduml
