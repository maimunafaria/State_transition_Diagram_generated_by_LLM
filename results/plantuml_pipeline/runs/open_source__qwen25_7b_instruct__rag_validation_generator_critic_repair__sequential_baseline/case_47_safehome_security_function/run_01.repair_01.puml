@startuml
[*] --> Idle

state Idle {
  ReadyToUse : reset
  ReadyToUse : activate
  ReadyToUse : turnOff
  ReadyToUse : monitor
}

state ReadyToUse {
  ReadyToUse : reset
  ReadyToUse : activate
  ReadyToUse : turnOff
  ReadyToUse : monitor
}

state Monitoring {
  Monitoring : sensorTriggered
  Monitoring : falseAlarm
  Monitoring : timeEnds
  Monitoring : passwordEntry
}

state Alarm {
  Alarm : passwordEntry
}

@enduml
