@startuml
[*] --> Running

state Running {
  Running --> Configuring : configurationRequired
  Configuring --> Running : configurationCompleted
  Running --> DataCollection : clockTriggered
  DataCollection --> Running : activityCompleted
  Running --> SummaryPreparation : summaryRequest
  SummaryPreparation --> Running : activityCompleted
  Running --> StatusChecking : statusRequest
  StatusChecking --> Running : activityCompleted
  Running --> ControlledMode : remoteControl
  ControlledMode --> Running : modeExited
  Running --> Shutdown : shutdownCommand
  Shutdown --> [*]
}

@enduml
