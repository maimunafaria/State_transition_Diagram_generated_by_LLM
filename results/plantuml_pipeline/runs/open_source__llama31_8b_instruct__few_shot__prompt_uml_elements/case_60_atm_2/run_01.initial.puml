@startuml
title ATM Withdrawal Process

[*] --> SelectAmount

state "Select Amount" as SelectAmount
state "Verify Transaction" as VerifyTransaction
state "Invalid Transaction" as InvalidTransaction
state "Successful Withdrawal" as SuccessfulWithdrawal

SelectAmount : entry / Display list of withdrawal options
SelectAmount : do / User selects an amount from the list
SelectAmount : exit / [amount selected]

SelectAmount --> VerifyTransaction : [custom value entered]
VerifyTransaction : entry / Validate transaction
VerifyTransaction : do / Check if transaction is valid
VerifyTransaction : exit / [transaction valid] or [transaction invalid]

VerifyTransaction --> SuccessfulWithdrawal : [transaction valid]
SuccessfulWithdrawal : entry / Process withdrawal
SuccessfulWithdrawal : do / Withdraw cash from account
SuccessfulWithdrawal : exit / [withdrawal successful]

VerifyTransaction --> InvalidTransaction : [transaction invalid]
InvalidTransaction : entry / Display error message
InvalidTransaction : do / Allow user to re-enter amount
InvalidTransaction : exit / [amount re-entered]

SelectAmount --> [*] : [custom value entered]

@enduml
