@startuml
title E Ticketing For Bus - State Diagram

[*] --> CreateUserAccount

state "Create User Account" as CreateUserAccount
state "Validate Registration" as ValidateRegistration
state "Login" as Login
state "Check Ticket Status" as CheckTicketStatus
state "Book Ticket" as BookTicket
state "Manage Account Details" as ManageAccountDetails
state "Logout" as Logout

CreateUserAccount --> ValidateRegistration : [Successful registration]
ValidateRegistration --> Login : [Validated user]

Login --> CheckTicketStatus : [Logged-in user]
CheckTicketStatus --> BookTicket : [Book ticket option selected]
BookTicket --> BookTicket : [Confirm booking and payment]

BookTicket --> ManageAccountDetails : [Manage account details option selected]
ManageAccountDetails --> Logout : [Logout after completing action]

ValidateRegistration --> CreateUserAccount : [Invalid registration, create new account again]
Login --> CreateUserAccount : [Failed login, create new account again]

CheckTicketStatus --> Login : [Logged-out user needs to log in first]
BookTicket --> Login : [Logged-out user needs to log in first]
ManageAccountDetails --> Login : [Logged-out user needs to log in first]

Logout --> [*] : [User logged out successfully]

@enduml
