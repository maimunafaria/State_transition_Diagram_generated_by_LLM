@startuml
title UML State Machine Diagram

[*] --> J0

state "Logged Out" as LoggedOut
state "Login" as Login
state "Main Area" as MainArea
state "Market Conditions" as MarketConditions
state "Market Report" as MarketReport
state "Pest Control Help" as PestControlHelp
state "Pest Control Techniques" as PestControlTechniques
state "Soil Suggestions" as SoilSuggestions
state "Weather Insights" as WeatherInsights
state "Labour Availability" as LabourAvailability

LoggedOut --> Login : [User Logs In]

Login --> MainArea : [Successful Login]
MainArea --> MarketConditions : [Select Market Conditions]
MarketConditions --> MarketReport : [Select Market Report]
MarketReport --> MainArea : [Return to Main Area]

MainArea --> PestControlHelp : [Select Pest Control Help]
PestControlHelp --> PestControlTechniques : [Provide Photo and Select Pest Control Techniques]
PestControlTechniques --> MainArea : [Return to Main Area]

MainArea --> SoilSuggestions : [Provide Soil Information]
SoilSuggestions --> MainArea : [Continue Using Service]

MainArea --> WeatherInsights : [Provide Location]
WeatherInsights --> MainArea : [Continue Using Service]

MainArea --> LabourAvailability : [Provide Location]
LabourAvailability --> MainArea : [Continue Using Service]

MainArea --> LoggedOut : [User Logs Out]

@enduml
