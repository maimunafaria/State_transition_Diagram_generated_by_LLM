@startuml
title Digital Watch States

[*] --> InitialSetup

state "Initial Setup" as InitialSetup
state "Time Adjustment Mode" as TimeAdjustmentMode
state "Alarm Setting Mode" as AlarmSettingMode
state "Alarm Triggered" as AlarmTriggered
state "Light On" as LightOn
state "Idle" as Idle

InitialSetup --> TimeAdjustmentMode : [press button]
TimeAdjustmentMode --> AlarmSettingMode : [press button]
AlarmSettingMode --> TimeAdjustmentMode : [press button]

TimeAdjustmentMode : entry / display current time
TimeAdjustmentMode : do / increase hour, minute values
TimeAdjustmentMode : exit / save adjusted time

AlarmSettingMode : entry / display alarm settings
AlarmSettingMode : do / set alarm hour, minute
AlarmSettingMode : exit / save alarm settings

AlarmTriggered --> AlarmTriggered : [alarm matches current time]
AlarmTriggered --> LightOn : [alarm triggered]

LightOn --> Idle : [button released]

Idle --> InitialSetup : [power on or reset]

@enduml
