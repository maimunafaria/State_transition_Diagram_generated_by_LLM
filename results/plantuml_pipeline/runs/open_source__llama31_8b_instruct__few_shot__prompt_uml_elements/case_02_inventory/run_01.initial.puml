@startuml
title Inventory State Machine

[*] --> Idle

state Idle
state AddingGoods
state UpdatingPrice
state RemovingGoods
state ExpiredGoods
state PlacingOrder
state GeneratingInvoice
state SearchingItems
state CalculatingDiscountTax
state GeneratingReceipt
state ReplacingItem
state CancelingReceipt
state ViewingSummaryReport

Idle --> AddingGoods : addGoods
AddingGoods --> Idle : saveGoods

Idle --> UpdatingPrice : updatePrice
UpdatingPrice --> Idle : savePrice

Idle --> RemovingGoods : removeGoods
RemovingGoods --> ExpiredGoods : checkExpiration

ExpiredGoods --> Idle : notifyUser

Idle --> PlacingOrder : placeOrder
PlacingOrder --> GeneratingInvoice : generateInvoice

GeneratingInvoice --> CalculatingDiscountTax : calculateDiscountTax

CalculatingDiscountTax --> GeneratingReceipt : generateReceipt

GeneratingReceipt --> ReplacingItem : replaceItem
ReplacingItem --> CancelingReceipt : cancelReceipt

CancelingReceipt --> ViewingSummaryReport : viewSummaryReport

ViewingSummaryReport --> [*] : exit

@enduml
