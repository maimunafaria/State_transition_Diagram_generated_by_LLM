@startuml
title Staff Member State Machine Diagram

state "Unassigned" as Unassigned {
  [*] --> AssignToClient : [assign to client]
  AssignToClient --> AssignedToClient : [staff member assigned]

  state "Assigned to Client" as AssignedToClient {
    AssignedToClient --> SwitchAssignments : [switch assignments]
    SwitchAssignments --> SwitchedAssignment : [staff member switched]

    state "Switched Assignment" as SwitchedAssignment
    SwitchedAssignment --> ReturnToUnassigned : [return to unassigned]
  }

  Unassigned --> MarkAsUnemployed : [mark as unemployed]
}

state MarkAsUnemployed {
  MarkAsUnemployed --> ArchiveRecord : [archive record after some time]
}

ArchiveRecord --> [*]

@enduml
