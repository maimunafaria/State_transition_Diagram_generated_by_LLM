@startuml
[*] --> Idle

state Idle {
  [*] --> ViewingTime
}

state ViewingTime {
  --> AdjustingHour : buttonPressed[adjust]
  --> AdjustingMinutes : buttonPressed[adjust]
  --> AdjustingAlarmHour : buttonPressed[adjust]
  --> AdjustingAlarmMinutes : buttonPressed[adjust]
}

state AdjustingHour {
  --> ViewingTime : buttonPressed[confirm]
  --> AdjustingHour : buttonPressed[increase]
}

state AdjustingMinutes {
  --> ViewingTime : buttonPressed[confirm]
  --> AdjustingMinutes : buttonPressed[increase]
}

state AdjustingAlarmHour {
  --> ViewingTime : buttonPressed[confirm]
  --> AdjustingAlarmHour : buttonPressed[increase]
}

state AdjustingAlarmMinutes {
  --> ViewingTime : buttonPressed[confirm]
  --> AdjustingAlarmMinutes : buttonPressed[increase]
}

state AlarmActive {
    --> StoppedAlarm : buttonPressed[stop]
}

state StoppedAlarm {
    --> Idle : buttonPressed[reset]
}

Idle --> AlarmActive : alarmTimeReached

@enduml
