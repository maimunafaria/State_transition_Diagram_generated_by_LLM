@startuml
title UML State Machine Diagram (E Ticketing For Bus)

[*] --> Unregistered

state Unregistered {
  [*] --> CreateAccount
  CreateAccount --> ValidateAccount : create account
  ValidateAccount --> LoggedIn : valid
  ValidateAccount --> Unregistered : invalid
}

state LoggedIn {
  [*] --> CheckTicketStatus
  CheckTicketStatus --> BookTicket : check ticket status
  BookTicket --> ConfirmPayment : book ticket
  ConfirmPayment --> MakePayment : confirm
  MakePayment --> ManageAccount : make payment
  ManageAccount --> LogOut : manage account
}

LoggedIn --> [*] : LogOut
@enduml
