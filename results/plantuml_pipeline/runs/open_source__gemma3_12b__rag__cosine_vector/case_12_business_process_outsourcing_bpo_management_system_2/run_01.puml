@startuml
title UML State Machine Diagram - BPO Management System

[*] --> FilterCategory

state "Filter Category" as FilterCat {
    [*] --> SelectCategory
}

state "Select Category" as SelectCat
SelectCat --> PriceRange

state "Price Range" as PriceRan {
    [*] --> SelectPrice
}

state "Select Price" as SelectPri
SelectPri --> DisplayResults

state "Display Results" as DispRes {
    [*] --> End
}

FilterCat : entry / Select filter category
FilterCat : do / Filter
FilterCat : exit / After filtering

SelectCat --> DisplayResults : [requirement 1 evidence]
SelectPri --> DisplayResults : [requirement 2 evidence]
DispRes : do / Display matching users
DispRes : exit / After displaying

@enduml
