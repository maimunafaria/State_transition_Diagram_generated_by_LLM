@startuml
title Farm Management System State Diagram

[*] --> LoggedIn

state LoggedIn {
  [*] --> MainMenu
  MainMenu --> MarketConditions : select market conditions
  MarketConditions --> MarketReport : select market report
  MainMenu --> PestControlHelp : select pest control help
  PestControlHelp --> PhotoCapture : provide photo
  PhotoCapture --> PestControlTechniques : show techniques
  MainMenu --> SoilSuggestions : provide soil information
  SoilSuggestions --> CropSuggestions : provide suggestions
  MainMenu --> WeatherInsights : provide location
  WeatherInsights --> WeatherData : show weather data
  MainMenu --> LabourAvailability : provide location
  LabourAvailability --> LabourDetails : show details
  MainMenu --> ContinueService : continue using service
}

LoggedIn --> LoggedOut : logout

state LoggedOut {
    [*] --> End
}

@enduml
