@startuml
[*] --> SelectAmountOption
state SelectAmountOption {
  [*] --> SelectPredefinedAmount
  SelectPredefinedAmount --> VerifyTransaction : select
  SelectCustomAmount --> VerifyTransaction : enter
}
state VerifyTransaction
state ReEnterAmount

VerifyTransaction --> ReEnterAmount : rejected
ReEnterAmount --> SelectAmountOption : re-enter
@enduml
