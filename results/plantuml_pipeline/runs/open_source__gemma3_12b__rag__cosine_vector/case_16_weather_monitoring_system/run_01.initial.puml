@startuml
title UML state machine diagram

[*] --> LoggedIn

state LoggedIn {
  [*] --> CheckWeather
  CheckWeather --> ChooseWeatherInfo : [location is valid]
  ChooseWeatherInfo --> UpdateWeatherInfo : [weatherljanje]
  UpdateWeatherInfo --> CheckWeather : [weather update]
  CheckWeather --> Logout : [user wants to logout]
}

Logout --> [*]
@enduml
