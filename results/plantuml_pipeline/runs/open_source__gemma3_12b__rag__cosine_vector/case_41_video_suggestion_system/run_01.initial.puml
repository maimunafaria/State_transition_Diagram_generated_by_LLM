@startuml
title Video Suggestion System State Machine

[*] --> Idle

state Idle {
    entry / wait for request
}

Idle --> RequestReceived : video suggestion request received

state RequestReceived {
    entry / identify user
    RequestReceived --> GatheringVideos : user identified
}

state GatheringVideos {
    entry / gather videos
    GatheringVideos --> AddingDetails : videos gathered
}

state AddingDetails {
    entry / add thumbnails and view counts
    AddingDetails --> SendingVideos : details added
}

state SendingVideos {
    entry / send suggested videos
    SendingVideos --> Idle : videos sent
}

@enduml
