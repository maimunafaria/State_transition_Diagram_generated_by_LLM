@startuml
title Microwave Oven — Polished Requirement Specification

state Idle {
  [*] --> TimeDisplay
  state TimeDisplay {
    [*] --> PowerSelection
    state PowerSelection {
      [*] --> TimeInput
      state TimeInput {
        [*] --> DoorOpen
        state DoorOpen {
          [*] --> FoodPlaced
          state FoodPlaced {
            [*] --> DoorClosed
            state DoorClosed {
              [*] --> Cooking
            }
            state Cancel {
              [*] --> Idle
            }
          }
          state DoorOpenWithFood {
            [*] --> DoorClosed
            state DoorClosed {
              [*] --> Cooking
            }
          }
        }
        state DoorOpenWithoutFood {
          [*] --> Idle
        }
      }
    }
  }
  state OperationError {
    [*] --> Alert
    state Alert {
      [*] --> Idle
    }
  }
}
@enduml
