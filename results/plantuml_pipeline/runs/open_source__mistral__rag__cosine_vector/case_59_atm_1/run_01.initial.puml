@startuml
title ATM Withdrawal State Machine

state "Waiting for Input" as WaitingInput
state "Choosing Amount" as ChoosingAmount
state "Selecting Predefined Amount" as SelectPredefined
state "Entering Custom Amount" as EnterCustom
state "Cancelling Transaction" as CancelTransaction
state "Returning Card" as ReturnCard

WaitingInput --> ChoosingAmount : [*]
ChoosingAmount --> SelectPredefined : Predefined Amount Selected
ChoosingAmount --> EnterCustom : Custom Amount Entered
SelectPredefined --> WaitingInput : Back to Input
EnterCustom --> WaitingInput : Back to Input
ChoosingAmount --> CancelTransaction : Transaction Cancelled
CancelTransaction --> ReturnCard : Card Returned

@enduml
