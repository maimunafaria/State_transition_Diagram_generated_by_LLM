@startuml
title UML State Machine Diagram (Digidoclocker)

[*] --> LoggedIn

state LoggedIn {
  [*] --> Dashboard
  Dashboard --> Settings : open settings
  Settings --> Dashboard : back
  CitizenUploadDocs : upload documents
  CitizenUploadDocs --> CitizenViewDocs : success
  CitizenViewDocs --> CitizenUploadDocs : view documents
  CitizenLogout : logout
}

state CitizenUploadDocs {
  [*] --> UploadID
  UploadID --> UploadPassword
  UploadPassword --> UploadConfirmation : success
  UploadConfirmation --> CitizenViewDocs
  UploadID --> InvalidCredentials : invalid credentials
}

state CitizenViewDocs {
  [*] --> ViewID
  ViewID --> ViewPassword
  ViewPassword --> ViewConfirmation : success
  ViewPassword --> InvalidCredentials : invalid credentials
}

state CitizenLogout {
  [*] --> LoggedOut
}

state LoggedOut {
  [*] --> Login
}
@enduml
