@startuml
[*] --> LoggedIn

state LoggedIn {
  [*] --> Dashboard
  Dashboard --> MarketConditions : check market conditions
  MarketConditions --> MarketReport
  Dashboard --> PestControlHelp : request pest control help
  PestControlHelp --> PestControlTechniques
  Dashboard --> SoilInfo : receive soil information
  SoilInfo --> Suggestions : provide suggestions for suitable crops
  Dashboard --> WeatherInsights : offer weather insights
  Dashboard --> LabourAvailability : display labour availability details
  Dashboard --> Results : show any of the results
  Results --> LoggedIn : continue using service
  Dashboard --> Logout : end session when user logs out
}
@enduml
