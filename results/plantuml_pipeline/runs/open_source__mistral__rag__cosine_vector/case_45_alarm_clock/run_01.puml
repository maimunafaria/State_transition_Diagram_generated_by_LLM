@startuml
title Alarm Clock State Diagram

state Off {
  [*] --> SetAlarm
}

state ActiveAlarm {
  state Ringing {
    [*] --> Ringing : TimeMatchesAlarmTime
    Ringing --> Stopped : UserTurnsOffAlarm
  }

  state Stopped {
    [*] --> NextScheduledAlarm : UserDoesNotStopAlarm
    Stopped --> Off : AlarmTurnedOff
  }
}

state SetAlarm {
  [*] --> ActiveAlarm : UserSetsAlarmTime
}

Off --> SetAlarm : UserSetsAlarm
ActiveAlarm --> Off : UserTurnsOffAlarm
@enduml
