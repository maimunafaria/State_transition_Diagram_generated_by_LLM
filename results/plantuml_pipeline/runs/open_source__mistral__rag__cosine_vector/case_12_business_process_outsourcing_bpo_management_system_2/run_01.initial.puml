@startuml
title UML State Machine Diagram - Search Users

[*] --> ChooseFilter

state "Choose filter category" as ChooseFilter {
    state PriceRange
    state OtherCategory

    ChooseFilter --> PriceRange : [user chooses price range]
    ChooseFilter --> OtherCategory : [user chooses other category]
}

PriceRange --> DisplayMatches
OtherCategory --> DisplayMatches

state "Display matching users" as DisplayMatches {
    [*] --> BackToSearch

    DisplayMatches --> BackToSearch : [user returns to search]
}
@enduml
