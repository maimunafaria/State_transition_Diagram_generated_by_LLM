@startuml
title Weather Station System State Machine

state Running {
  [*] --> Running
  state CollectingData
  CollectingData --> Running : clock trigger
  state PreparingSummary
  PreparingSummary --> Running : summary prepared
  state CheckingStatus
  CheckingStatus --> Running : status check complete
  state ControlledMode
  ControlledMode --> Running : remote control off
}

state Shutdown {
  [*] --> Shutdown
  state Restarting
  Restarting --> Running : restart successful
}

Running --> Shutdown : shutdown command
Shutdown --> [*]

ControlledMode --> ControlledMode : remote control on
ControlledMode --> Running : remote control off
@enduml
