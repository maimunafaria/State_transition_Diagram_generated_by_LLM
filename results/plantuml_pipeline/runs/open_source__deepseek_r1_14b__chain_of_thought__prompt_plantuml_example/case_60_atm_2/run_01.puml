@startuml
title ATM Withdrawal Process

state Ready {
  [*] --> Ready
}

state SelectAmountOptions {
  SelectAmountOptions : do / Display Options
}

state CustomAmountEntry {
  CustomAmountEntry : do / Enter Amount
}

state TransactionVerification {
  TransactionVerification : do / Verify Transaction
}

state Re-enterAmount {
  Re-enterAmount : do / Re-enter Amount
}

state TransactionApproved {
  TransactionApproved : do / Approve Transaction
}

state TransactionRejected {
  TransactionRejected : do / Reject Transaction
}

Ready --> SelectAmountOptions : Select amount

SelectAmountOptions --> CustomAmountEntry : Choose custom

CustomAmountEntry --> TransactionVerification : Enter amount

TransactionVerification --> TransactionApproved : Approved
TransactionVerification --> TransactionRejected : Rejected

TransactionRejected --> Re-enterAmount : Re-enter

Re-enterAmount --> TransactionVerification : Re-enter

TransactionApproved --> [*]
TransactionRejected --> [*]

@enduml
