@startuml
title Digidoclocker State Transition Diagram

state Unregistered
state Registered
state LoggedIn
state DocumentUpload
state CertificateApplication
state LoggedOut

[*] --> Unregistered

Unregistered --> Registered : Register
Registered --> LoggedIn : LoginSuccess

LoggedIn --> DocumentUpload : UploadDocuments
LoggedIn --> CertificateApplication : ApplyForCertificate
LoggedIn --> [*] : Logout

DocumentUpload --> LoggedIn : FinishUpload
DocumentUpload --> DocumentUpload : ContinueUploading

CertificateApplication --> LoggedIn : RequestMore
CertificateApplication --> [*] : EndSession

@enduml
