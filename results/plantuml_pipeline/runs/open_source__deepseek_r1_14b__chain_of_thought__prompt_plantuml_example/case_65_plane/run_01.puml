@startuml
title Plane State Transition Diagram

[*] --> Order

state Order {
    Order --> Arrival : arrival
}

state Arrival {
    Arrival --> Preparation : completion of preparation
}

state Preparation {
    Preparation --> Operations : condition is good / schedule allows
    Preparation --> Maintenance : not suitable for operations
}

state Operations {
    Operations --> Maintenance : no more scheduled flights or maintenance required
    Operations --> OutOfService : taken out of service
}

state Maintenance {
    Maintenance --> Preparation : after servicing
}

state OutOfService {
    OutOfService --> Retired : permanent withdrawal from service
}

Retired --> [*] : end

@enduml
