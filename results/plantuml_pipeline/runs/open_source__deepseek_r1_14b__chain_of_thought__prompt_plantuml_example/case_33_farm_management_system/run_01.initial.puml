@startuml
title Farm Management System State Machine

[*] --> Initial

state Initial {
  [*] --> MainMenu : login
}

state MainMenu {
  MainMenu --> MarketConditions : selectMarket
  MainMenu --> PestControl : selectPestControl
  MainMenu --> SoilSuggestions : selectSoil
  MainMenu --> WeatherInsights : selectWeather
  MainMenu --> LabourAvailability : selectLabour
}

state MarketConditions {
  MarketConditions --> MainMenu : continue
}

state PestControl {
  [*] --> PestControlPhoto : photoRequired
  PestControlPhoto --> PestControlTechniques : submitPhoto
  PestControlTechniques --> MainMenu : continue
}

state SoilSuggestions {
  SoilSuggestions --> MainMenu : continue
}

state WeatherInsights {
  WeatherInsights --> MainMenu : continue
}

state LabourAvailability {
  LabourAvailability --> MainMenu : continue
}

state LoggedOut <<final>> {
  [*] --> LoggedOut : logout
}

MainMenu --> LoggedOut : logout

PestControlTechniques --> LoggedOut : logout
MarketConditions --> LoggedOut : logout
SoilSuggestions --> LoggedOut : logout
WeatherInsights --> LoggedOut : logout
LabourAvailability --> LoggedOut : logout
@enduml
