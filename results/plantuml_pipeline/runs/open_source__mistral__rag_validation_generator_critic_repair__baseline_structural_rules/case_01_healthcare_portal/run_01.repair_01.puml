@startuml
title Healthcare Portal - User Login State Machine Diagram

state InitialState <<choice>>
state RegistrationFailed <<choice>>
state SignInFailed <<choice>>
state SignedIn <<choice>>
state HomePage <<choice>>
state NewsContent <<choice>>
state HealthInfo <<choice>>
state Payment <<choice>>
state Feedback <<choice>>
state Logout <<choice>>

[*] --> InitialState

InitialState --> RegistrationFailed : [Registration Fails]
InitialState --> SignInFailed : [Sign In Fails]

InitialState --> SignedIn : [Sign In Successful]
SignedIn --> HomePage : [Access Facilities]
SignedIn --> NewsContent : [Read News and Expert Content]
SignedIn --> HealthInfo : [Check Symptoms or Use Fitness Checking Options]
SignedIn --> Payment : [Payment Process]
SignedIn --> Feedback : [Collect User Feedback]
SignedIn --> Logout : [Log Out]

state "Registration" as Registration
Registration : entry / Unregistered user
Registration : do / Enter Valid Credentials
Registration : exit / Account registered or RegistrationFailed

state "Insurance Processing" as InsuranceProcessing
InsuranceProcessing : entry / Available finance-related services
InsuranceProcessing : do / Process and validate insurance
InsuranceProcessing : exit / Insurance processed successfully or InsuranceProcessingFailed

state "Payment Process" as PaymentProcess
PaymentProcess : entry / Insurance processed successfully
PaymentProcess : do / Check payment with insurance for doctor consultations
PaymentProcess : exit / Payment completed successfully or PaymentProcessFailed

state "Cash Payment Details" as CashPaymentDetails
CashPaymentDetails : entry / Chosen cash payment method
CashPaymentDetails : do / Inform user about cash payment details
CashPaymentDetails : exit / Return to Payment

state "LoggedOut" <<choice>>
LoggedOut --> [*] : Logged out Successfully
@enduml
