@startuml
[*] --> Idle
Idle --> AdjustTime
AdjustTime --> IncreaseValue
AdjustTime --> DecreaseValue
AdjustTime --> SetAlarm
SetAlarm --> AdjustAlarmHour
SetAlarm --> AdjustAlarmMinute
AdjustAlarmHour --> SetAlarm
AdjustAlarmMinute --> SetAlarm
IncreaseValue --> AdjustTime : increase
DecreaseValue --> AdjustTime : decrease
AdjustTime --> On
On --> Off : button pressed
Off --> On : button pressed
AdjustTime --> Alarm : alarm on
Alarm --> AdjustTime : alarm off
AdjustTime --> LightOn : button pressed
LightOn --> LightOff : button released
LightOff --> LightOn : button pressed
LightOn --> AdjustTime
LightOff --> AdjustTime

@enduml
