@startuml
[*] --> WaitingForNewSale

state WaitingForNewSale
WaitingForNewSale --> AddingItems : customer selects items

state AddingItems
AddingItems --> AddingItems : item selected
AddingItems --> MovingToPayment : all items added

state MovingToPayment
MovingToPayment --> PaymentReceived : customer chooses payment method

state PaymentReceived
PaymentReceived --> CompletingSale : payment approved
PaymentReceived --> CompletingSale : cash payment

state CompletingSale
CompletingSale --> ReturningToWaiting : sale completed

ReturningToWaiting --> WaitingForNewSale
@enduml
