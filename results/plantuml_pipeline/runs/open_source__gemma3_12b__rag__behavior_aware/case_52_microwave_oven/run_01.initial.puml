@startuml
[*] --> Idle

state Idle {
    [*] --> DisplayTime
}

state DisplayTime {
    DisplayTime --> PowerSelect : powerRequest
    DisplayTime --> TimeSet : timeRequest
    DisplayTime --> Cancel : cancelRequest
}

state PowerSelect {
    PowerSelect --> Idle : powerSelectionComplete
}

state TimeSet {
    TimeSet --> Idle : timeEntryComplete
}

state Cancel {
    Cancel --> Idle : cancelComplete
}

Idle --> [*] : doorOpen
Idle --> [*] : cookingComplete
@enduml
