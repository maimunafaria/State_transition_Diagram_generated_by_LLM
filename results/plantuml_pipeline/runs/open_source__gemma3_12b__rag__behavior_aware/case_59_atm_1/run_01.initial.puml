@startuml
[*] --> WaitingForInput

state WaitingForInput
state EnteringAmount
state ConfirmingAmount
state ProcessingTransaction
state ReturningCard

WaitingForInput --> EnteringAmount : User chooses/enters withdrawal amount
EnteringAmount --> ConfirmingAmount : Amount entered
ConfirmingAmount --> ProcessingTransaction : User confirms amount
ConfirmingAmount --> EnteringAmount : User changes amount
ProcessingTransaction --> ReturningCard : Transaction completed
ProcessingTransaction --> ReturningCard : Transaction cancelled
@enduml
