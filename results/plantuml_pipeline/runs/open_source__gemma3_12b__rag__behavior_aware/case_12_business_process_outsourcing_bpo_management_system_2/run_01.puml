@startuml
title UML State Machine Diagram - BPO Management System

[*] --> SearchFilter
[*] --> PriceRange

state SearchFilter <<state>>
SearchFilter --> DisplayMatchingUsers : [filter selected]

state PriceRange <<state>>
PriceRange --> DisplayMatchingUsers : [price range selected]

state DisplayMatchingUsers <<state>>
DisplayMatchingUsers --> [*] : [user action]

@enduml
