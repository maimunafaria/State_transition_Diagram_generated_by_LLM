@startuml
title System State Diagram

[*] --> J1 : [System Start]
state J1 <<choice>> {
    state ServiceCenterSide
    state CarOwnerSide
}
J1 --> ServiceCenterSide : [Select Service Center Side]
J1 --> CarOwnerSide : [Select Car Owner Side]

state ServiceCenterSide {
    state ServiceCenterRegistration
    state ServiceCenterLogin
    state ServiceCenterDashboard
}

ServiceCenterRegistration --> ServiceCenterLogin : [Registration Complete]
ServiceCenterLogin --> ServiceCenterDashboard : [Login Successful]

state CarOwnerSide {
    state CarOwnerRegistration
    state CarOwnerLogin
    state CarOwnerDashboard
}

CarOwnerRegistration --> CarOwnerLogin : [Registration Complete]
CarOwnerLogin --> CarOwnerDashboard : [Login Successful]

ServiceCenterDashboard --> [*] : [Logout]
CarOwnerDashboard --> [*] : [Logout]

@enduml
