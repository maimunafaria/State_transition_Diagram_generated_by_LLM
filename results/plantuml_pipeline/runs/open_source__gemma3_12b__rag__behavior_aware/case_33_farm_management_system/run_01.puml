@startuml
title Farm Management System State Diagram

[*] --> LoggedIn

state LoggedIn {
  [*] --> MainMenu
}

MainMenu --> ShowMarketConditions : select "Show Market Conditions"
MainMenu --> ShowPestControlHelp : select "Pest Control Help"
MainMenu --> ProvideSoilInformation : select "Soil Suggestions"
MainMenu --> ProvideLocationForWeather : select "Weather Insights"
MainMenu --> ProvideLocationForLabor : select "Labor Availability"
MainMenu --> LogOut : select "Log Out"

ShowMarketConditions --> MarketReport : select "Show Report"
ShowMarketConditions --> LoggedIn : continue
MarketReport --> LoggedIn : continue

ShowPestControlHelp --> ProvidePhoto : require photo
ProvidePhoto --> ShowPestControlTechniques : photo provided
ShowPestControlTechniques --> LoggedIn : continue

ProvideSoilInformation --> SuggestCrops : receive soil information
SuggestCrops --> LoggedIn : continue

ProvideLocationForWeather --> ShowWeatherInsights : receive location
ShowWeatherInsights --> LoggedIn : continue

ProvideLocationForLabor --> ShowLaborDetails : receive location
ShowLaborDetails --> LoggedIn : continue

LogOut --> [*]
@enduml
