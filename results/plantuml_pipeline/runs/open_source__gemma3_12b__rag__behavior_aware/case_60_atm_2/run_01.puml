@startuml
[*] --> EnterAmount
state EnterAmount {
  [*] --> EnterCustomAmount
  state EnterCustomAmount
  EnterCustomAmount --> VerifyTransaction : amountEntered
}
state VerifyTransaction {
  [*] --> ReEnterAmount : transactionRejected
  state ReEnterAmount
  ReEnterAmount --> EnterAmount : reEnter
}
VerifyTransaction --> ReleaseCard : transactionApproved
ReleaseCard --> [*]
@enduml
