@startuml
state Unauthenticated {
  [*] --> self
}

state RegisteredUser {
  on loginSuccess --> AuthenticatedUser
}

state AuthenticatedUser {
  on accessFacility --> self
  on readContent --> self
  on selectPaymentMethod(cash) --> PaymentProcessingCash
  on selectPaymentMethod(insurance) --> PaymentProcessingInsurance
  on logout -->LoggedOut
}

state PaymentProcessingCash {
  on paymentComplete -->AuthenticatedUser
}

state PaymentProcessingInsurance {
  on insuranceApproved -->AuthenticatedUser
}

state LoggedOut {
  self --> [*]
}
@enduml
