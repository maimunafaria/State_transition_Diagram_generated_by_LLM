@startuml
state Unauthenticated {
}
state Authenticated(Main Menu) {
  state MarketConditions
  state PestControl
  state SoilSuggestions
  state WeatherInsights
  state LabourAvailability
}

Unauthenticated --> Authenticated: login()

Authenticated:
  when selecting market conditions -> MarketConditions
  when selecting pest control help -> PestControl
  when selecting soil suggestions -> SoilSuggestions
  when selecting weather insights -> WeatherInsights
  when selecting labour availability -> LabourAvailability

MarketConditions --> Authenticated: return to main menu
PestControl --> Authenticated: return to main menu
SoilSuggestions --> Authenticated: return to main menu
WeatherInsights --> Authenticated: return to main menu
LabourAvailability --> Authenticated: return to main menu

Authenticated:
  when logout -> Unauthenticated

[*] --> Unauthenticated
@enduml
