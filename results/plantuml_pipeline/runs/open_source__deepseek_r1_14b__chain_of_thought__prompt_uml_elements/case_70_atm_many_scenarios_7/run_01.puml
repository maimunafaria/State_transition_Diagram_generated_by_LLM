@startuml
state Initial {
  [*] -> Card_Inserted : card inserted
}
state Card_Inserted {
  transition Check_PIN : check PIN
}
state Check_PIN {
  transition PIN_Verified : correct PIN
  transition Incorrect_PIN_Attempt : incorrect PIN
}
state Incorrect_PIN_Attempt {
  transition Security_Alert : (after 3 failed attempts)
  transition Check_PIN : another attempt
}
state Security_Alert {
  transition Return_Card : cancel operation
  transition Check_PIN : valid card and correct PIN
}
state PIN_Verified {
  transition Menu_Options_Displayed : display options
}
state Menu_Options_Displayed {
  transition Processing_Request : select option
}
state Processing_Request {
  transition Transaction_Complete : process request
}
state Return_Card {
  transition Initial : return card
  transition [*] : end
}
state Transaction_Complete {
  transition [*] : end
}
@enduml
