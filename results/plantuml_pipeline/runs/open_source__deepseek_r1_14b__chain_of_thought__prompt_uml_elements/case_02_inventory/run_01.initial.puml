@startuml
state Main Menu/Dashboard {
  [*] -> Main Menu/Dashboard
}

state Adding Goods {
  Main Menu/Dashboard -> Adding Goods : Add Item Event
  Adding Goods --> Main Menu/Dashboard : Back to Dashboard
}

state Removing Goods {
  Main Menu/Dashboard -> Removing Goods : Remove Item Event
  Removing Goods --> Main Menu/Dashboard : Back to Dashboard
}

state Order Placement {
  Main Menu/Dashboard -> Order Placement : Order Placement Trigger
  Order Placement --> Invoice Generation : Order Placed
  Order Placement --> Main Menu/Dashboard : Cancel Order
}

state Invoice Generation {
  Order Placement --> Invoice Generation : Invoice Generation Signal
  Invoice Generation --> Main Menu/Dashboard : Back to Dashboard
}

state Searching Inventory {
  Main Menu/Dashboard -> Searching Inventory : Search Query
  Searching Inventory --> Checkout Process : Item Selected
  Searching Inventory --> Main Menu/Dashboard : Cancel Search
}

state Checkout Process {
  Searching Inventory --> Checkout Process : Item Selected
  Checkout Process --> Generating Receipt
@enduml
