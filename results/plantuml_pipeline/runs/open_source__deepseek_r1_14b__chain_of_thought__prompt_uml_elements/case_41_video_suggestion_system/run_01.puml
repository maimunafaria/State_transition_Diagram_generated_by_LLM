@startuml
state "Request Received" {
    [*] -> "Request Received"
}
state "Gathering Videos" {
    transition "User submits request":
        "Request Received" --> "Gathering Videos"
        action: Identify user and gather data based on preferences
    transition "Video data ready":
        "Gathering Videos" --> "Gathering Videos"
        action: Add thumbnails, view counts, etc.
}
state "Suggestion Sent" {
    transition "Send response":
        "Gathering Videos" --> "Suggestion Sent"
        action: Send suggested videos to user
    [*] <- "Suggestion Sent"
}
@enduml
