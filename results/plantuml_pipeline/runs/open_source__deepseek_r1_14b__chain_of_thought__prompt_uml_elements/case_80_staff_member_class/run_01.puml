@startuml
state Unassigned {
  [*] --> Assigned: Add to Client/Campaign
}

state Assigned {
  state Client {
    --> Unassigned: Remove Assignment
    <--> Campaign : Switch Assignment
  }

  state Campaign {
    --> Unassigned: Remove Assignment
    <--> Client : Switch Assignment
  }
}

state Unemployed {
  on Leave Job --> self
  after 30 days --> Archived
}

Archived -[*]--> [*]
@enduml
