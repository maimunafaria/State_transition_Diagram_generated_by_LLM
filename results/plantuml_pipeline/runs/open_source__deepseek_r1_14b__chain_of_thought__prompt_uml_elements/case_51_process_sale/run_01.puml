@startuml
state Waiting for Sale {
  [*] -> Waiting for Sale
}

state Adding Items {
  Waiting for Sale -> Adding Items : New sale
  Adding Items -> Payment : All items added
}

rectangle Payment {
  state Processing Cash Payment {
    Payment -> Processing Cash Payment : Cash payment received
    Processing Cash Payment -> Sale Completed : Cash processed
  }

  state Verifying Card/Check Payment {
    Payment -> Verifying Card/Check Payment : Card/Check submitted
    Verifying Card/Check Payment -> Sale Completed : Payment approved
  }
}

Sale Completed {
  Sale Completed -> Waiting for Sale : Return to waiting
}
@enduml
