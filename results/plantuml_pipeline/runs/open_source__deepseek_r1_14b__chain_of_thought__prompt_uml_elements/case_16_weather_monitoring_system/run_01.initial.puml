@startuml
state Unauthenticated {
  entry: "Start system"
}

state Authenticated {
  entry: "Successful login/register"
  exit: "Logout request"
}

state Logout {
  [*]
}

Unauthenticated --> Authenticated : "Login success"
Unauthenticated --> Logout : "Registration failed"

Authenticated --> Logout : "Logout request"

Authenticated --> Logout : "Invalid location entered"

Authenticated --> Authenticated : "Valid location entered" / "Check weather data"
Authenticated --> Authenticated : "View additional details"
Authenticated --> Logout : "End session after viewing"
@enduml
