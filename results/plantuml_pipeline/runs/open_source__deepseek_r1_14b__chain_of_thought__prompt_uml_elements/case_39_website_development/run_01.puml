@startuml
state Homepage {
  [*] --> Homepage
}

state Project_Info {
  Homepage -> Project_Info : select projects
}

state Photos_Video {
  Project_Info -[>Photos_Video : choose photos
  Project_Info -[>Video : choose videos
}

state Career_Info {
  Homepage -> Career_Info : select careers
}

state Updates_Application_Form {
  Career_Info --> Updates_Application_Form : view updates
  Career_Info --> Application_Form : open application form
}

state Submitted_Application {
  Updates_Application_Form --> Submitted_Application : submit application
  Submitted_Application --> [*]
}

Homepage --> Project_Info
Homepage --> Career_Info

note right of Photos_Video: Viewing project photos or videos
note right of Updates_Application_Form: Viewing career updates or starting application
note right of Submitted_Application: Application submission complete
@enduml
