@startuml
state Order {
}

state Arrival {
}

state Preparation {
}

state Operations {
}

state Maintenance {
}

state OutOfService {
}

state Retired {
}

[*] --> Order

Order -> Arrival : delivery notification

Arrival -> Preparation : arrival event

Preparation -> Operations : condition (plane's schedule has flights)
Preparation -> Maintenance : else

Operations -> Maintenance : no scheduled flights OR maintenance required
Operations -> Retired : retirement notification

Maintenance -> Preparation : completion of servicing

Retired --> [*]

OutOfService --> Retired : permanent withdrawal
@enduml
