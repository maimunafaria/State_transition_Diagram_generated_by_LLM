@startuml
state Initial {
  [*] -> Initial: start
}
state CardInserted
state PINEntered
state PINVerified
state OptionsProvided
state ProcessingWithdrawal
state DispensingCash
state PrintingReceipt
state CardReturned
state Reset

Initial -> CardInserted : card inserted
CardInserted -> PINEntered : PIN entered
PINEntered -> PINVerified : PIN verified
PINVerified -> OptionsProvided : options provided
OptionsProvided -> ProcessingWithdrawal : withdrawal selected
ProcessingWithdrawal -> DispensingCash : process withdrawal
DispensingCash -> PrintingReceipt : cash dispensed
PrintingReceipt -> CardReturned : receipt printed
CardReturned -> Reset : timeout
Reset -> [*] : reset complete
@enduml
