@startuml
state Initial {
  [*] --> CreatingAccount : registration attempt
}
state CreatingAccount {
  --> LoggedIn : successful login
}

state LoggedIn {
  --> ApplicationSubmitted : apply for visa
  --> PaymentCompleted : payment made
  --> DocumentCheck : document review outcome
  --> Canceled : application cancellation
  --> ModifyDetails : modify details
  --> ViewDetails : view details
  --> GiveFeedback : give feedback
}

state ApplicationSubmitted {
  --> PaymentCompleted : payment required
}

state PaymentCompleted {
  --> DocumentCheck : document check initiated
}

state DocumentCheck {
  --> Approved : approved
  --> Rejected : rejected
}

state Canceled {
  --> Initial : logout
}

state ModifyDetails {
  --> LoggedIn : details modified
}

state ViewDetails {
  --> LoggedIn : details viewed
}

state GiveFeedback {
  --> LoggedIn : feedback submitted
}

state Approved {
  --> end : status updated
}

state Rejected {
  --> end : status updated
}

state Initial -> CreatingAccount : registration attempt

CreatingAccount --> LoggedIn : successful login

LoggedIn:
  apply for visa --> ApplicationSubmitted
  payment made --> PaymentCompleted
  document review outcome --> DocumentCheck
  application cancellation --> Canceled
  modify details --> ModifyDetails
  view details --> ViewDetails
  give feedback --> GiveFeedback

ApplicationSubmitted --> PaymentCompleted : payment required

PaymentCompleted --> DocumentCheck : document check initiated

DocumentCheck:
  approved --> Approved
  rejected --> Rejected

Canceled --> Initial : logout

ModifyDetails --> LoggedIn : details modified

ViewDetails --> LoggedIn : details viewed

GiveFeedback --> LoggedIn : feedback submitted

Approved --> end : status updated

Rejected --> end : status updated
@enduml
