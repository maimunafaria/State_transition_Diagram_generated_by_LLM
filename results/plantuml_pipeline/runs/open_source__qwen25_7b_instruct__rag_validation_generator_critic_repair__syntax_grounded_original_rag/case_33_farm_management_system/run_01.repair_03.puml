@startuml
hide empty description
[*] --> LoggedIn

state LoggedIn {
  Dashboard <|-- MarketConditions : select market condition
  MarketConditions --> MarketReport : view market report
  MarketConditions --> [*] : back

  PestControlHelp <|-- PestControlTechniques : select pest control help
  PestControlHelp --> [*] : back

  SoilSuggestions --> SoilSuggestionsResult : provide soil information
  SoilSuggestionsResult --> SoilSuggestions : receive soil-related suggestions
  SoilSuggestions --> [*] : back

  WeatherInsights --> WeatherDetails : provide location
  WeatherDetails --> WeatherInsights : receive weather insights
  WeatherInsights --> [*] : back

  LabourAvailability --> LabourDetails : provide location
  LabourDetails --> LabourAvailability : receive labour availability details
  LabourAvailability --> [*] : back
}

LoggedIn --> [*] : logout
@enduml
