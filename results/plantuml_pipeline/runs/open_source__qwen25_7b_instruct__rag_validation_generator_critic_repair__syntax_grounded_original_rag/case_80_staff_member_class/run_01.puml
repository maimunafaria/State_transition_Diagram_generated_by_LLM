@startuml
title UML State Machine Diagram for Staff Member Class

[*] --> Assigned

state Assigned {
  Working : endWorkPeriod
  switchAssignment
}

Assigned --> Working
Working --> Unassigned : endWorkPeriod
Working --> Assigned : switchAssignment

Assigned --> Unassigned : markUnemployed
Unassigned --> [*] : archiveRecord

@enduml
