@startuml
title UML State Machine Diagram (BPO Management System - Search & Display)

[*] --> Idle

state Idle {
    [*] --> SearchCategory
}

state SearchCategory {
    SearchCategory : entry / Select filter category
    SearchCategory --> PriceRange
}

state PriceRange {
    PriceRange : entry / Select price range
    PriceRange --> DisplayResults
}

state DisplayResults {
    DisplayResults : entry / Display matching users
    DisplayResults --> [*]
}

Idle --> SearchCategory : user selects filter category
SearchCategory --> PriceRange : user selects price range
@enduml
