@startuml
title UML State Machine Diagram (ATM)

[*] --> SelectAmount

state "Select Amount" as SelectAmount
SelectAmount : entry / Display list of options
SelectAmount : do / User selects an option or enters a custom value
SelectAmount : exit / Valid or Invalid amount entered

SelectAmount --> VerifyTransaction : [Valid amount]

state "Verify Transaction" as VerifyTransaction
VerifyTransaction : entry / Validate transaction
VerifyTransaction : do / Transaction is valid or rejected
VerifyTransaction : exit / Transaction accepted or rejected

VerifyTransaction --> SelectAmount : [Invalid amount]
VerifyTransaction --> DispenseCash : [Valid transaction]

state "Dispense Cash" as DispenseCash
DispenseCash : entry / Dispense cash to user
DispenseCash : do / Cash is dispensed
DispenseCash : exit / Transaction complete

SelectAmount --> [*] : [Cancel transaction]

@enduml
