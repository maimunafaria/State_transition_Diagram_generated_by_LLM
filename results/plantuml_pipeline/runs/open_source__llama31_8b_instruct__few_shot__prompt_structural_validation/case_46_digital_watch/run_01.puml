@startuml
title Digital Watch System States

[*] --> AdjustTime

state "Adjust Time" as AdjustTime
state "Switch Mode" as SwitchMode
state "Increase Value" as IncreaseValue
state "Alarm On/Off" as AlarmOnOff
state "Alarm Triggered" as AlarmTriggered
state "Stop Alarm" as StopAlarm
state "Light On/Off" as LightOnOff

AdjustTime : entry / View time
AdjustTime : do / Adjust hour, minutes, alarm hour, and alarm minutes
AdjustTime : exit / [button pressed]

SwitchMode --> IncreaseValue : [hour button pressed]
IncreaseValue --> SwitchMode : [minute button pressed]
SwitchMode --> AlarmOnOff : [alarm button pressed]
AlarmOnOff --> AlarmTriggered : [alarm time matches current time]
AlarmTriggered --> StopAlarm : [alarm triggered]
StopAlarm --> [*] : [stop alarm button pressed]

LightOnOff --> AdjustTime : [light button pressed]
AdjustTime --> LightOnOff : [light button released]

@enduml
