@startuml
title Digidoclocker System States

[*] --> Register : [citizen = new]

state "Register" as Register
state "Login" as Login
state "Upload Documents" as UploadDocuments
state "View Profile" as ViewProfile
state "Apply for Certificate" as ApplyForCertificate
state "Request Certificate from Registrar" as RequestCertificateFromRegistrar

Register --> Login : [registration successful]
Login --> UploadDocuments : [login details correct]
Login --> ViewProfile : [login details correct]
Login --> ApplyForCertificate : [login details correct]

UploadDocuments --> UploadDocuments : [uploading multiple documents]
ApplyForCertificate --> UploadDocuments : [applying for multiple certificates]
RequestCertificateFromRegistrar --> RequestCertificateFromRegistrar : [requesting multiple certificates]

ViewProfile --> [*] : [done with profile view]
UploadDocuments --> [*] : [done with document upload]
ApplyForCertificate --> [*] : [done with certificate application]
RequestCertificateFromRegistrar --> [*] : [done with certificate request]

@enduml
