@startuml
title E Ticketing For Bus - State Diagram

[*] --> CreateUser

state "Create User" as CreateUser
state "Validate Registration" as ValidateRegistration
state "Login Successful" as LoginSuccessful
state "Logged In" as LoggedIn
state "Check Ticket Status" as CheckTicketStatus
state "Book Ticket" as BookTicket
state "Confirm Payment" as ConfirmPayment
state "Manage Account" as ManageAccount

CreateUser --> ValidateRegistration : Registration Form Submitted
ValidateRegistration --> LoginSuccessful : Valid Credentials Entered
LoginSuccessful --> LoggedIn : Successful Login

LoggedIn --> CheckTicketStatus : User Requests to Check Status
CheckTicketStatus --> BookTicket : User Requests to Book Ticket
BookTicket --> ConfirmPayment : Payment Method Selected
ConfirmPayment --> ManageAccount : Payment Confirmed

ManageAccount --> Logout : User Completes Action
Logout --> [*] : User Logs Out

@enduml
