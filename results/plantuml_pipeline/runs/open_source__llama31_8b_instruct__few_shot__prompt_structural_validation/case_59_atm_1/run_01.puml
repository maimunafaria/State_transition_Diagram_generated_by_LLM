@startuml
title State machine for ATM Scenario 1

state "Idle" as Idle
state "Select Amount" as SelectAmount
state "Custom Amount" as CustomAmount
state "Cancel Transaction" as CancelTransaction
state "Return Card" as ReturnCard

[*] --> Idle : /insertCard

Idle --> SelectAmount : selectPredefinedAmount()
SelectAmount --> CustomAmount : selectCustomAmount()
CustomAmount --> SelectAmount : cancelTransaction()

CustomAmount --> Idle : customAmountEntered(amount)
SelectAmount --> Idle : predefinedAmountSelected(amount)

Idle --> CancelTransaction : cancelTransactionButtonClicked()

CancelTransaction --> ReturnCard : confirmCancellation()
ReturnCard --> [*] : returnCard()

@enduml
