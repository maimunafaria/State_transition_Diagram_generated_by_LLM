@startuml
title Campaign State Machine Diagram

[*] --> Idle

state "Idle" as Idle
state "Campaign Preparation" as CP
state "Advert Approval" as AA
state "Advert Scheduling" as AS
state "Running Adverts" as RA
state "Campaign Extension" as CE
state "Final Statement" as FS
state "Payment Handling" as PH
state "Archiving Campaign" as AC

Idle --> CP : Manager and Staff Assigned / Start Campaign
CP --> AA : Everything Approved / Activate Campaign
AA --> AS : Adverts Prepared / Approve and Schedule Adverts
AS --> RA : Adverts Scheduled / Run Adverts
RA --> CE : Extension Requested / Extend or Adjust Campaign
CE --> FS : All Adverts Finished / Complete Campaign
FS --> PH : Payment Handling Required / Handle Payment
PH --> AC : Full Amount Paid / Mark as Paid
AC --> [*] : Campaign Archived

state "Extension" as E
E : entry / Extension Requested
E : do / Extend or Adjust Campaign
E : exit / Return to Running Adverts

state "Adjustment" as A
A : entry / Adjustment Requested
A : do / Extend or Adjust Campaign
A : exit / Return to Running Adverts

CE --> E
CE --> A

@enduml
