@startuml
title UML State Machine Diagram - Healthcare Portal

[*] --> Registration

state "Registration" as Registration
state "Failed Registration" as FailedRegistration
state "Signed In" as SignedIn
state "Access Denied" as AccessDenied
state "Facilities" as Facilities
state "News and Expert Content" as NewsAndExpertContent
state "Health Information" as HealthInformation
state "Result Viewed" as ResultViewed
state "Payment Processing" as PaymentProcessing
state "Insurance Validation" as InsuranceValidation
state "Doctor Consultation" as DoctorConsultation
state "Drug Purchase" as DrugPurchase
state "Cash Payment Details" as CashPaymentDetails
state "Payment Completion" as PaymentCompletion
state "User Feedback" as UserFeedback
state "Logged Out" as LoggedOut

Registration --> FailedRegistration : registration failed
FailedRegistration --> AccessDenied : access denied
AccessDenied --> [*] : exit system

SignedIn --> Facilities : sign in successful
Facilities --> NewsAndExpertContent : view facilities
NewsAndExpertContent --> HealthInformation : view news and expert content
HealthInformation --> ResultViewed : view health information
ResultViewed --> PaymentProcessing : continue using the system or finish session
PaymentProcessing --> InsuranceValidation : process payment with insurance
InsuranceValidation --> DoctorConsultation : validate insurance for doctor consultation
DoctorConsultation --> PaymentCompletion : complete payment process for doctor consultation
PaymentCompletion --> CashPaymentDetails : select cash as payment method
CashPaymentDetails --> PaymentCompletion : inform user about cash payment details
PaymentCompletion --> DrugPurchase : select insurance as payment method
DrugPurchase --> PaymentCompletion : complete payment process for drug purchase

ResultViewed --> UserFeedback : collect user feedback after service completion
UserFeedback --> LoggedOut : log out users at the end of their session
LoggedOut --> [*] : exit system

@enduml
