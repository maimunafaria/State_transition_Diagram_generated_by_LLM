@startuml
title UML State Machine Diagram - Atm System

[*] --> GreetUser

state "Greet User" as GreetUser
state "Check PIN" as CheckPIN
state "Invalid PIN" as InvalidPIN
state "Return Card" as ReturnCard
state "Display Options" as DisplayOptions
state "Process Request" as ProcessRequest

GreetUser --> CheckPIN
CheckPIN --> CheckPIN : Repeats until correct PIN entered
CheckPIN --> InvalidPIN : Incorrect PIN entered too many times
InvalidPIN --> ReturnCard
CheckPIN --> ReturnCard : User cancels operation

ReturnCard --> [*]

DisplayOptions --> ProcessRequest
ProcessRequest --> DisplayOptions : User selects another option
ProcessRequest --> [*] : Request processed successfully

@enduml
