@startuml
title Process Sale State Machine

[*] --> WaitingForSale

state WaitingForSale
WaitingForSale : entry / Wait for new sale

state AddingItems
AddingItems : entry / Add items to sale
AddingItems : do / Add item to sale

state Payment
Payment : entry / Move to payment
Payment : do / Verify payment method

state VerifyingCardPayment
VerifyingCardPayment : entry / Verify card payment
VerifyingCardPayment : do / Verify card details

state VerifyingCheckPayment
VerifyingCheckPayment : entry / Verify check payment
VerifyingCheckPayment : do / Verify check details

state CompletingSale
CompletingSale : entry / Complete sale
CompletingSale : do / Complete sale

WaitingForSale --> AddingItems : New Sale Added
AddingItems --> Payment : All Items Added
Payment --> VerifyingCardPayment : Card Selected
Payment --> VerifyingCheckPayment : Check Selected
VerifyingCardPayment --> CompletingSale : Payment Approved
VerifyingCheckPayment --> CompletingSale : Payment Approved
CompletingSale --> WaitingForSale : Payment Finished

@enduml
