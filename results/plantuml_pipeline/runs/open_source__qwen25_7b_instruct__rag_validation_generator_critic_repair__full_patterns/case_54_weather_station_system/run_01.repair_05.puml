@startuml
[*] --> Running

state Running {
  INITIAL --> Configuring : configurationRequired
  Configuring --> Running : configurationCompleted
  INITIAL --> DataCollection : clockTriggered
  DataCollection --> Running : activityCompleted
  INITIAL --> SummaryPreparation : summaryRequest
  SummaryPreparation --> Running : activityCompleted
  INITIAL --> StatusChecking : statusRequest
  StatusChecking --> Running : activityCompleted
  INITIAL --> ControlledMode : remoteControl
  ControlledMode --> Running : modeExited
  [*] --> Shutdown : shutdownCommand
}

[*] --> Running

@enduml
