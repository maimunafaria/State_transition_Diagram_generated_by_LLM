@startuml
title UML State Machine Diagram - BPO Management System

[*] --> InitialState

state "FilterSelection" as FS {
    InitialState --> CategoryFilter : [Select category]
    InitialState --> PriceRangeFilter : [Select price range]
}

FS : entry / User selects filter criteria
FS : do / Display matching users based on chosen criteria
FS : exit / After displaying results

CategoryFilter --> CriteriaDisplay : [Criteria selected]

state "CriteriaDisplay" as CD {
    [*] --> UsersList : [Matching users displayed]
}

PriceRangeFilter --> PriceSelection : [Select price range]

state "PriceSelection" as PS {
    [*] --> UsersList : [Matching users displayed]
}

UsersList --> FilterSelection : [Back to filter selection]

InitialState --> [*] : COMPLETION_EVENT

@enduml
