@startuml
[*] --> Register

state Register {
  [*] --> Login : registration successful
  Login --> [*] : registration unsuccessful
}

Login --> CheckLocation
CheckLocation --> [*] : location invalid
CheckLocation --> ChooseInfo : location valid

ChooseInfo --> ShowWeather : choose to check weather
ShowWeather --> [*] : end process

state ShowWeather {
  [*] --> AdditionalDetails : view additional details
  AdditionalDetails --> [*] : logout
}

[*] --> Logout : logout user
INITIAL_STATE --> Register : start
Login --> INITIAL_STATE : login unsuccessful
CheckLocation --> Login : location invalid, retry login
ChooseInfo --> CheckLocation : choose info without valid location
ShowWeather --> ChooseInfo : weather check without choosing info
AdditionalDetails --> ShowWeather : view details without checking weather
Logout --> [*] : end session
@enduml
