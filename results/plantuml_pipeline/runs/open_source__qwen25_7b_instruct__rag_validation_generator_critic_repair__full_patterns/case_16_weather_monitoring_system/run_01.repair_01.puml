@startuml
[*] --> Register

state Register {
  [*] --> Login : registration successful
  Login --> [*] : registration unsuccessful
}

Login --> CheckLocation
CheckLocation --> [*] : location invalid
CheckLocation --> ChooseInfo : location valid

ChooseInfo --> ShowWeather : choose to check weather
ShowWeather --> [*] : end process

state ShowWeather {
  [*] --> AdditionalDetails : view additional details
  AdditionalDetails --> [*] : logout
}

[*] --> Logout : logout user
INITIAL_STATE --> Register : start
Login --> INITIAL_STATE : login unsuccessful
CheckLocation --> Login : location invalid
ChooseInfo --> CheckLocation : choose info
ShowWeather --> ChooseInfo : show weather
AdditionalDetails --> ShowWeather : view details
Logout --> AdditionalDetails : logout user

state Initial {
  [*] --> Register : start
}

state Final {
  ShowWeather --> [*] : end process
  Logout --> [*] : logout user
}
@enduml
