@startuml
[*] --> INITIAL

state Initial {
  [*] --> LoggedIn
}

state LoggedIn {
  LoggedIn --> Dashboard
  Dashboard --> Settings : open settings
  Settings --> Dashboard : back
  Dashboard --> ViewStatus : view status
  ViewStatus --> ViewStatus : check status
  ViewStatus --> CancelApp : cancel application
  ViewStatus --> ModifyDetails : modify details
  ViewStatus --> ViewDetails : view details
  ViewDetails --> ViewPurpose : view purpose of application
  ViewPurpose --> ViewPurpose : update status based on document check
  ViewPurpose --> Feedback : give feedback
}

LoggedIn --> [*] : logout

state CancelApp {
  CancelApp --> ViewStatus : back to view status
}

state ModifyDetails {
  ModifyDetails --> ViewDetails : back to view details
  ModifyDetails --> ViewPurpose : view purpose of application
  ModifyDetails --> Feedback : give feedback
  ModifyDetails --> ViewStatus : update status
}

state ViewDetails {
  ViewDetails --> ViewPurpose : view purpose of application
  ViewDetails --> Feedback : give feedback
  ViewDetails --> ViewStatus : update status
}

state ViewPurpose {
  ViewPurpose --> ViewStatus : update status
}

Feedback --> ViewStatus

@enduml
