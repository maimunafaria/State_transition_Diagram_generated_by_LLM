@startuml
title UML State Machine Diagram for Staff Member Class

[*] --> Assigned

state Assigned {
  [*] --> Working
  Working --> Unassigned : endWorkPeriod | [endWorkPeriod]
  Working --> Assigned : switchAssignment | [switchAssignment]
}

Assigned --> Unassigned : markUnemployed | [markUnemployed]
Unassigned --> [*] : archiveRecord | [archiveRecord]

@enduml
