@startuml
title UML State Machine Diagram (Bus Ticketing System)

[*] --> CreateAccount

state CreateAccount {
    [*] --> GettingDetails
    GettingDetails --> ValidatingRegistration : [Registration details entered]
}

state ValidatingRegistration {
    [*] --> RegistrationSuccessful : [Valid details]
    ValidatingRegistration --> RegistrationFailed : [Invalid details]
}

state RegistrationSuccessful {
    [*] --> Login : [Registration successful]
}

state RegistrationFailed {
    [*] --> CreateAccount : [Registration failed]
}

state Login {
    [*] --> TicketStatus : [Successful login]
    Login --> CreateAccount : [Failed login]
}

state TicketStatus {
    [*] --> BookTicket : [Check ticket status]
    TicketStatus --> Login : [Logout]
}

state BookTicket {
    [*] --> Confirmation : [Book ticket]
    BookTicket --> Payment : [Ticket confirmed]
}

state Confirmation {
    [*] --> Payment : [Payment required]
}

state Payment {
    [*] --> AccountManagement : [Payment successful]
    Payment --> BookTicket : [Payment failed]
}

state AccountManagement {
    [*] --> Login : [Manage account details]
}

AccountManagement --> Login : [Logout]

@enduml
