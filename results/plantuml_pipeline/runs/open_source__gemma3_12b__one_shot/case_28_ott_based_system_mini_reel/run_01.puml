@startuml
title Ott Based System State Machine

[*] --> LoggedOut : /userCreation

state LoggedOut
state Watching
state Uploading
state Liking
state LikesList
state Discussion

LoggedOut --> LoggedIn : /login

state LoggedIn {
    [*] --> Watching

    Watching --> Uploading : /uploadVideo
    Watching --> Liking : /likeVideo
    Watching --> LikesList : /viewLikes
    Watching --> Discussion : /enterDiscussion
}

Uploading --> Watching : /videoUploaded
Liking --> Watching : /likeRemoved
LikesList --> Watching : /backToWatching
Discussion --> Watching : /exitDiscussion

@enduml
