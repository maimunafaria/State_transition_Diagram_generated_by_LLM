@startuml
title UML State Chart Diagram

state "Registration" as REG
REG : entry / New user initiates registration
REG : do / Collects user details
REG : exit / Validates user details

state "Registration Failed" as REGF
REGF : entry / Registration fails
REGF : exit / Ends access

state "Sign In" as SI
SI : entry / Registered user attempts sign in
SI : do / Verifies user credentials
SI : exit / Grants access if credentials are correct

state "Access Available Facilities" as AAF
AAF : entry / Signed in successfully
AAF : do / Provides access to facilities
AAF : exit / User interacts with facilities

state "Read News and Expert Content" as RNEC
RNEC : entry / User requests news and content
RNEC : do / Displays news and content

state "Health Information" as HI
HI : entry / User requests health information
HI : do / Provides symptom checking and fitness options
HI : exit / Displays results

state "Continue or Finish Session" as COFS
COFS : entry / User views results
COFS : do / User chooses to continue or finish
COFS : exit / Transitions to next state

state "Process Insurance" as PI
PI : entry / User selects finance-related services
PI : do / Validates insurance details
PI : exit / Proceeds to payment

state "Payment Processing" as PP
PP : entry / Initiates payment process
PP : do / Checks payment with insurance
PP : exit / Completes payment

state "Select Payment Method" as SPM
SPM : entry / User selects payment method
SPM : do / Presents payment options (cash or insurance)
SPM : exit / Proceeds to payment processing

state "Inform Cash Payment Details" as ICPD
ICPD : entry / User chooses cash payment
ICPD : do / Displays cash payment details
ICPD : exit / Completes payment

state "Complete Insurance Payment" as CIP
CIP : entry / User chooses insurance payment
CIP : do / Completes payment process
CIP : exit / Payment successful

state "Collect User Feedback" as CUB
CUB : entry / Service completion
CUB : do / Collects user feedback

state "Log Out" as LO
LO : entry / User initiates log out
LO : exit / Ends session

[*] --> REG : New User
REG --> REGF : Registration Fails
REG --> SI : Registration Successful

SI --> AAF : Successful Sign In
SI --> [*] : Sign In Failed

AAF --> RNEC : Access Facilities
AAF --> HI : Access Health Information
HI --> COFS : View Results
COFS --> AAF : Continue Session
COFS --> LO : Finish Session

AAF --> PI : Access Finance Services
PI --> PP : Validate Insurance

PP --> SPM : Proceed to Payment
SPM --> ICPD : Cash Payment
SPM --> CIP : Insurance Payment

ICPD --> [*] : Cash Payment Complete
CIP --> [*] : Insurance Payment Complete

AAF --> CUB : Service Completion
CUB --> LO : Feedback Submitted
LO --> [*] : Session Ended

@enduml
