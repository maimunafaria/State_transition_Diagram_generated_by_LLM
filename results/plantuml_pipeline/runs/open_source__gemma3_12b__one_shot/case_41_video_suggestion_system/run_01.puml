@startuml
title UML state machine diagram

[*] --> Idle : [video suggestion request]

state Idle {
  state GatheringVideos : entry / identify user
  GatheringVideos : do / gather videos based on user profile, trending videos, similar tags, genres, promoted videos
  GatheringVideos : exit / add thumbnails and view counts
}

Idle --> GatheringVideos

GatheringVideos --> SendingVideos : [videos gathered]

state SendingVideos {
  SendingVideos : do / send suggested videos to user
  SendingVideos : exit / request completed
}

SendingVideos --> Idle : [request completed]

Idle --> [*]
@enduml
