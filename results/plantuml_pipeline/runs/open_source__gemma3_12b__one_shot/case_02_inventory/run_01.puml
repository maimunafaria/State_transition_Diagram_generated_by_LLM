@startuml
title State diagram for the Inventory class

[*] --> InitialInventory : Initialize

state "Initial\nInventory" as InitialInventory
state "Active\nInventory" as ActiveInventory
state "Billing\nProcess" as BillingProcess
state "Receipt\nGenerated" as ReceiptGenerated
state "Customer\nRequest" as CustomerRequest
state "Summary\nReport" as SummaryReport

InitialInventory --> ActiveInventory : Add Goods

ActiveInventory --> ActiveInventory : Update Price
ActiveInventory --> ActiveInventory : Remove Goods
ActiveInventory --> ActiveInventory : Identify Expired Goods

ActiveInventory --> ActiveInventory : Place Order
ActiveInventory --> BillingProcess : Select Items for Purchase

BillingProcess --> BillingProcess : Calculate Discount/Tax
BillingProcess --> ReceiptGenerated : Generate Invoice
ReceiptGenerated --> BillingProcess : Replace Item/Cancel Receipt

ReceiptGenerated --> ActiveInventory : Generate Receipt
ActiveInventory --> CustomerRequest : Record Customer Request

ActiveInventory --> SummaryReport : View Summary Report

[*] --> InitialInventory

@enduml
