@startuml
title UML State Machine Diagram - User

[*] --> LoggedOut

state "LoggedOut" as LoggedOut
state "LoggedIn" as LoggedIn
state "ApplicationSubmitted" as ApplicationSubmitted
state "StatusViewed" as StatusViewed
state "ApplicationCancelled" as ApplicationCancelled
state "DetailsModified" as DetailsModified
state "DetailsViewed" as DetailsViewed
state "PurposeViewed" as PurposeViewed
state "FeedbackGiven" as FeedbackGiven

LoggedOut --> CreateAccount
CreateAccount --> LoggedOut

LoggedOut --> Login
Login --> LoggedIn

LoggedIn --> ApplyForVisa
ApplyForVisa --> ApplicationSubmitted

ApplicationSubmitted --> ViewStatus
ViewStatus --> StatusViewed

StatusViewed --> CheckStatus
CheckStatus --> StatusViewed

LoggedIn --> CancelApplication
CancelApplication --> ApplicationCancelled

LoggedIn --> ModifyDetails
ModifyDetails --> DetailsModified

LoggedIn --> ViewDetails
ViewDetails --> DetailsViewed

LoggedIn --> ViewPurpose
ViewPurpose --> PurposeViewed

StatusViewed --> GiveFeedback
GiveFeedback --> FeedbackGiven

DetailsModified --> LoggedOut
DetailsViewed --> LoggedOut
PurposeViewed --> LoggedOut
FeedbackGiven --> LoggedOut

LoggedIn --> Logout
Logout --> LoggedOut

@enduml
