@startuml
title UML state machine diagram

state Homepage <<choice>>
state NavigationBar <<choice>>
state Projects <<choice>>
state CareerOpportunities <<choice>>
state Updates <<choice>>
state ApplicationForm <<choice>>
state SubmittedApplications <<choice>>

[*] --> Homepage

Homepage --> NavigationBar : [User Interaction]

NavigationBar --> Projects : [Select Project]
NavigationBar --> CareerOpportunities : [Select Career]

Projects --> PhotoView : [View Photos]
Projects --> VideoView : [View Video]

CareerOpportunities --> UpdatesView : [View Updates]
CareerOpportunities --> ApplicationFormOpen : [Open Application Form]

UpdatesView --> CareerOpportunities : [Return to Career Opportunities]
ApplicationFormOpen --> CareerOpportunities : [Return to Career Opportunities]

ApplicationFormOpen --> SubmittedApplications : [Submit Application]

SubmittedApplications --> SubmittedApplications : [Checking Application]
SubmittedApplications --> [*]

PhotoView --> Projects : [Return to Projects]
VideoView --> Projects : [Return to Projects]

@enduml
