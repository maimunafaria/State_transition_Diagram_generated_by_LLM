@startuml
title UML State Machine Diagram (Campaign)

[*] --> NotStarted

state NotStarted {
    [*] --> Assigned : [Manager and staff assigned]
}

state Assigned {
    [*] --> AwaitingApproval : [Everything approved, contract signed]
}

state AwaitingApproval {
    [*] --> PreparingAdverts : [Approved]
}

state PreparingAdverts {
    [*] --> ApprovingAndScheduling : [Adverts prepared]
}

state ApprovingAndScheduling {
    [*] --> Running : [Adverts approved and scheduled]
}

state Running {
    [*] --> ExtendingOrAdjusting : [Extension or adjustment requested]
    [*] --> Completing : [All adverts finished]
}

state ExtendingOrAdjusting {
    --> Running : [Adjustment complete]
}

state Completing {
    [*] --> PaymentHandling : [Final statement prepared]
}

state PaymentHandling {
    [*] --> AwaitingBalance : [Amount paid < required]
    [*] --> MarkedPaid : [Amount paid >= required]
}

state AwaitingBalance {
    --> MarkedPaid : [Correct balance settled]
}

state MarkedPaid {
    [*] --> Archived : [Full amount paid]
}

state Archived {
    [*] --> [*] : [Campaign archived, staff and managers released]
}

@enduml
