@startuml
title UML State Chart Diagram

[*] --> EnterPIN

state "Enter PIN" as EnterPIN {
  EnterPIN --> VerifyPIN : [PIN Entered]
}

state "Verify PIN" as VerifyPIN {
  VerifyPIN --> ProvideOptions : [PIN Verified]
  VerifyPIN --> EnterPIN : [PIN Incorrect]
}

state "Provide Options" as ProvideOptions {
  ProvideOptions --> ProcessWithdrawal : [User Approval]
}

state "Process Withdrawal" as ProcessWithdrawal {
  ProcessWithdrawal --> DispenseCash : [Withdrawal Approved]
}

state "Dispense Cash" as DispenseCash {
  DispenseCash --> PrintReceipt : [Cash Dispensed]
}

state "Print Receipt" as PrintReceipt {
  PrintReceipt --> ReturnCard : [Receipt Printed]
}

state "Return Card" as ReturnCard {
  ReturnCard --> Reset : [Card Returned]
}

state "Reset" as Reset {
  Reset --> [*] : [Reset Complete]
}

@enduml
