@startuml
title State diagram of the system operations of "Green Rides"

[*] --> JourneyDetails

state "Journey Details" as JourneyDetails
state "Driving Mode" as DrivingMode
state "Eating Options" as EatingOptions
state "Accident Reported" as AccidentReported
state "Feedback" as Feedback

JourneyDetails --> DrivingMode : activate driving mode
JourneyDetails --> EatingOptions : select eating option
JourneyDetails --> AccidentReported : accident occurs
JourneyDetails --> Feedback : journey complete

DrivingMode --> DrivingMode : notification
DrivingMode --> AccidentReported : accident occurs
DrivingMode --> Feedback : journey complete

EatingOptions --> EatingOptions : place order
EatingOptions --> DrivingMode : return to driving
EatingOptions --> JourneyDetails : cancel order

AccidentReported --> DrivingMode : authorities informed
AccidentReported --> JourneyDetails : authorities informed

Feedback --> JourneyDetails : submit feedback

@enduml
