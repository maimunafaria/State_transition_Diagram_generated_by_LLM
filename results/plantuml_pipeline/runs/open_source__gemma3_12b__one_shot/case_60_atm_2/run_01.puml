@startuml
title ATM Withdrawal Amount Selection

[*] --> Idle

state Idle
state "Selecting Amount" as SelectingAmount
state "Entering Custom Amount" as EnteringCustomAmount
state "Verifying Transaction" as VerifyingTransaction

Idle --> SelectingAmount : User Initiates Withdrawal / Display Options
SelectingAmount --> EnteringCustomAmount : User Enters Custom Amount / Request Custom Amount
SelectingAmount --> VerifyingTransaction : User Selects Option / Verify Transaction
EnteringCustomAmount --> VerifyingTransaction : Custom Amount Entered / Verify Transaction

VerifyingTransaction --> SelectingAmount : Transaction Rejected / Display Options
VerifyingTransaction --> [*] : Transaction Approved / Complete Transaction

@enduml
