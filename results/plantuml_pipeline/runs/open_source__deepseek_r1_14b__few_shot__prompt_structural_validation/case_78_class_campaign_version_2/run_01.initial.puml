@startuml
title Campaign State Transition Diagram

[*] --> Initial

state Initial {
    entry / Start campaign setup
}

Initial --> Preparing : [Assign manager and staff]

state Preparing {
    do / Prepare campaign details
}

Preparing --> Activated : [Approve and sign contract]

state Activated {
    do / Campaign is active
}

Activated --> AdvertPrepared : [Prepare adverts]

state AdvertPrepared {
    do / Create advert content
}

AdvertPrepared --> AdvertScheduled : [Schedule adverts]

state AdvertScheduled {
    do / Schedule time slots
}

AdvertScheduled --> AdvertRunning : [Start campaign]

state AdvertRunning {
    do / Run adverts
}

AdvertRunning --> Adjusting : [Extend/Adjust]
AdvertRunning --> Completed : [Adverts finish]

state Adjusting {
    do / Make adjustments
}

Adjusting --> AdvertPrepared : [Re-prepare adverts]
Adjusting --> AdvertScheduled : [Reschedule]
Adjusting --> AdvertRunning : [Resume campaign]

state Completed {
    do / End of advert run
}

Completed --> PaymentHandling : [Handle payment]

state PaymentHandling {
    do / Process payments
}

PaymentHandling --> Paid : [Full amount paid]
PaymentHandling --> WaitingForBalance : [Overpayment]

state WaitingForBalance {
    do / Wait for balance
}

WaitingForBalance --> Paid : [Settle overpayment]

state Paid {
    do / Campaign marked as paid
}

Paid --> Archived : [Prepare final statement]

state Archived {
    do / Archive campaign
}

Archived --> [*] : [Release staff and manager]

@enduml
