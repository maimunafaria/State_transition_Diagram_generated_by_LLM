@startuml
title E-Ticketing System State Transition Diagram

state CreateUser
state ValidateRegistration
state Login
state Home <<entry point>>
state CheckTicketStatus
state BookTicket
state ManageAccount
state Logout

[*] --> CreateUser : Initial state

CreateUser --> ValidateRegistration : Register User
ValidateRegistration --> CreateUser : Invalid registration (back to create)
ValidateRegistration --> Login : Valid registration

Login --> Home : Successful login
Login --> Login : Invalid credentials

Home --> CheckTicketStatus : Check ticket status
Home --> BookTicket : Book ticket
Home --> ManageAccount : Manage account details
Home --> Logout : Log out

CheckTicketStatus --> Home : Back to home

BookTicket --> Home : Confirm and pay
BookTicket --> BookTicket : Payment failed (back to book)

ManageAccount --> Home : Back to home
ManageAccount --> CreateUser : Delete account

Logout --> [*] : Final state

@enduml
