@startuml
title UML State Chart Diagram

state "User Search" as UserSearch {
  [*] --> StartSearch

  state "Start Search" as StartSearch
}

state "Select Category" as SelectCategory {
  StartSearch --> SelectCategory : «M» Select Filter/
}

state "Apply Price Range" as ApplyPriceRange {
  SelectCategory --> ApplyPriceRange : «M» Apply Price Filter/
}

state "Display Results" as DisplayResults {
  ApplyPriceRange --> DisplayResults : «M» Show Matching Users/
  DisplayResults --> [*] : «M» Search Complete/
}

UserSearch --> StartSearch

SelectCategory --> [*]

@enduml
