@startuml
title UML State Machine Diagram - Farm Management System

state "Initial" as InitialState
state "Login" as LoginState
state "Main Menu" as MainMenu
state "Market Conditions" as MarketConditions
state "Pest Control Photo Upload" as PestControlPhoto
state "Pest Control Techniques" as PestControlTechniques
state "Soil Suggestions" as SoilSuggestions
state "Weather Insights" as WeatherInsights
state "Labour Details" as LabourDetails
state "End Session" as EndSession

InitialState --> LoginState : Attempt Login
LoginState --> MainMenu : Successful Login

MainMenu --> MarketConditions : Select Market Conditions
MarketConditions --> MainMenu : Back to Menu
MainMenu --> PestControlPhoto : Select Pest Control
PestControlPhoto --> PestControlTechniques : Upload Photo
PestControlTechniques --> MainMenu : Back to Menu
MainMenu --> SoilSuggestions : Select Soil Info
SoilSuggestions --> MainMenu : Back to Menu
MainMenu --> WeatherInsights : Select Weather
WeatherInsights --> MainMenu : Back to Menu
MainMenu --> LabourDetails : Select Labour
LabourDetails --> MainMenu : Back to Menu

MainMenu --> LoginState : Logout
LoginState --> EndSession : Logout Successful
EndSession --> [*] : Terminate

@enduml
