@startuml
title ATM Control - Scenario 1: PIN Entry and Transaction Processing

state "Insert Card" as InsertCard {
  [*] --> EnterPIN
}

state "Enter PIN" as EnterPIN {
  EnterPIN : do / enter PIN
  EnterPIN --> VerifyPIN : [Valid]
}

state "Verify PIN" as VerifyPIN {
  VerifyPIN : entry / check stored information
  VerifyPIN --> MainMenu : [PIN Verified]
}

state "Main Menu" as MainMenu {
  MainMenu : do / display options
  MainMenu --> ProcessWithdrawal : [Select Withdrawal]
}

state "Process Withdrawal" as ProcessWithdrawal {
  ProcessWithdrawal : do / process withdrawal request
  ProcessWithdrawal --> DispenseCash
}

state "Dispense Cash" as DispenseCash {
  DispenseCash : do / dispense cash
  DispenseCash --> PrintReceipt
}

state "Print Receipt" as PrintReceipt {
  PrintReceipt : do / print receipt
  PrintReceipt --> ReturnCard
}

state "Return Card" as ReturnCard {
  ReturnCard : do / return card to user
  ReturnCard --> ResetSystem
}

state "Reset System" as ResetSystem {
  ResetSystem : entry / reset system for next user
  ResetSystem --> [*]
}

InsertCard --> EnterPIN

EnterPIN --> VerifyPIN

VerifyPIN --> MainMenu

MainMenu --> ProcessWithdrawal

ProcessWithdrawal --> DispenseCash

DispenseCash --> PrintReceipt

PrintReceipt --> ReturnCard

ReturnCard --> ResetSystem

ResetSystem --> [*]

@enduml
