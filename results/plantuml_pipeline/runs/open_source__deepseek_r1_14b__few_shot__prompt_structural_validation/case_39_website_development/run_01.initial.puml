@startuml
title UML State Chart Diagram

state Homepage {
  [*] --> HomePage
}

state "Homepage" as HomePage {
  HomePage --> Projects : [Select Projects]
  HomePage --> Careers : [Select Careers]
  HomePage --> JobApps : [Check Applications]
}

state "Project Info" as ProjectInfo {
  [*] --> ViewProjects
}

state "View Projects" as ViewProjects {
  ViewProjects --> Photos : [Choose Photos]
  ViewProjects --> Videos : [Choose Videos]
}

state "Career Info" as CareerInfo {
  [*] --> ViewCareers
}

state "View Careers" as ViewCareers {
  ViewCareers --> Updates : [View Updates]
  ViewCareers --> ApplicationForm : [Open Form]
}

state "Job Application Check" as JobAppCheck
@enduml
