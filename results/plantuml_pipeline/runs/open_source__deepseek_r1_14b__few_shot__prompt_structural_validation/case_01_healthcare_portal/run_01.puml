@startuml
title UML State Transition Diagram - Healthcare Portal

[*] --> Idle

state "Idle" as Idle
Idle: entry/Waiting for action
Idle: do/No active session
Idle: exit/Register/Login

state "Register" as Register
Register: entry/Register
Register: do/Validate registration details
Register: exit/MainMenu if successful / InvalidRegistration if failed

state "InvalidRegistration" as InvalidReg
InvalidReg: entry/Invalid registration
InvalidReg: do/Cannot register
InvalidReg: exit/Idle

state "Login" as Login
Login: entry/Login
Login: do/Authenticate user
Login: exit/MainMenu if successful / InvalidLogin if failed

state "InvalidLogin" as InvalidLogin
InvalidLogin: entry/Invalid login
InvalidLogin: do/Cannot login
InvalidLogin: exit/Idle

state "Main Menu" as MainMenu
MainMenu: entry/Main Menu
MainMenu: do/Access facilities
MainMenu: exit/ReadContent/HealthInfo/ProcessInsurance etc.

state "Read Content" as ReadContent
ReadContent: entry/Read news/expert content
ReadContent: do/Browse articles
ReadContent: exit/MainMenu

state "Check Health Info" as CheckHealth
CheckHealth: entry/Check symptoms or fitness
CheckHealth: do/Provide health information
CheckHealth: exit/ViewResult

state "View Result" as ViewResult
ViewResult: entry/View result
ViewResult: do/Continue using system or finish session
ViewResult: exit/MainMenu if continue / Logout if finish

state "Process Insurance" as ProcessIns
ProcessIns: entry/Process insurance for services
ProcessIns: do/Validate insurance details
ProcessIns: exit/PaymentOptions

state "Payment Options" as PaymentOpts
PaymentOpts: entry/Select payment method
PaymentOpts: do/Cash or Insurance
PaymentOpts: exit
@enduml
