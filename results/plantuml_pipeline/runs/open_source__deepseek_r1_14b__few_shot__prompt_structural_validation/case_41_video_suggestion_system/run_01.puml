@startuml
title UML State Transition Diagram - Video Suggestion System

[*] --> ReceiveRequest

state "Receive request" as ReceiveRequest
ReceiveRequest --> IdentifyUser

state "Identify user" as IdentifyUser
IdentifyUser --> GatherVideos

state "Gather videos" as GatherVideos
GatherVideos --> EnrichDetails

state "Enrich details" as EnrichDetails
EnrichDetails --> SendSuggestions

state "Send suggestions" as SendSuggestions
SendSuggestions --> [*]

@enduml
