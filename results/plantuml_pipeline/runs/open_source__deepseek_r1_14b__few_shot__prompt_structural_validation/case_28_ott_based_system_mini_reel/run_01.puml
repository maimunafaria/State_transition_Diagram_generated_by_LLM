@startuml
title UML State Machine Diagram - Ott Based System Mini Reel

[*] --> NoAccount

state "No Account" as NoAccount
NoAccount --> LoggedIn : Create account

state "Logged In" as LoggedIn
LoggedIn --> J1

state J1 <<choice>>
J1 --> WatchingVideo : Watch videos
J1 --> UploadingVideo : Upload videos
J1 --> LikesList : View saved videos
J1 --> DiscussionForum : Enter discussion

state "Watching Video" as WatchingVideo
WatchingVideo --> LikesList : Save to likes
WatchingVideo --> J2
state J2 <<choice>>
J2 --> WatchingVideo : Continue watching
J2 --> LoggedIn : Back to home

state "Uploading Video" as UploadingVideo
UploadingVideo --> LoggedIn : Upload complete

state "Likes List" as LikesList
@enduml
