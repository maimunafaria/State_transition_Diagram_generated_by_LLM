@startuml
[*] --> CreateUserAccount : [User creates account]
state CreateUserAccount {
  entry / User enters required information
  do / Account created successfully
  exit / Login page displayed
}

CreateUserAccount --> LogIn : [User logs in after creating account]

state LogIn {
  entry / User enters login credentials
  do / Login successful
  exit / Dashboard displayed
}

LogIn --> ApplyForVisa : [User applies for visa]
ApplyForVisa : entry / User selects visa type and makes payment
ApplyForVisa : do / Application accepted
ApplyForVisa : exit / Status page displayed

state StatusPage {
  entry / User views status of application
  do / Status updated
  exit / Check status button displayed
}

StatusPage --> CheckStatus : [User checks status]
CheckStatus : entry / User checks status of application
CheckStatus : do / Status checked successfully
CheckStatus : exit / Cancel application button displayed

state CancelApplication {
  entry / User cancels application
  do / Application cancelled successfully
  exit / Dashboard displayed
}

CancelApplication --> LogIn : [User logs in after cancelling application]

LogIn --> ModifyDetails : [User modifies details]
ModifyDetails : entry / User updates personal information
ModifyDetails : do / Details updated successfully
ModifyDetails : exit / View details button displayed

state ViewDetails {
  entry / User views modified details
  do / Details viewed successfully
  exit / Dashboard displayed
}

ViewDetails --> LogIn : [User logs in after viewing details]

LogIn --> GiveFeedback : [User gives feedback]
GiveFeedback : entry / User provides feedback on application process
GiveFeedback : do / Feedback submitted successfully
GiveFeedback : exit / Dashboard displayed

state ViewPurpose {
  entry / User views purpose of application
  do / Purpose viewed successfully
  exit / Status page displayed
}

ViewPurpose --> ApplyForVisa : [User applies for visa]

ApplyForVisa --> StatusPage : [Status updated after application accepted]
StatusPage --> CheckStatus : [User checks status]
CheckStatus --> CancelApplication : [User cancels application]
CancelApplication --> LogIn : [User logs in after cancelling application]
LogIn --> ModifyDetails : [User modifies details]
ModifyDetails --> ViewDetails : [User views modified details]
ViewDetails --> LogIn : [User logs in after viewing details]
LogIn --> GiveFeedback : [User gives feedback]

GiveFeedback --> [*] : [User logs out after giving feedback]

@enduml
