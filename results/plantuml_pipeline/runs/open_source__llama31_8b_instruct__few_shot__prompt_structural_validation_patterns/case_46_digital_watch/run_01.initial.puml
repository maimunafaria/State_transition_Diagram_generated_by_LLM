@startuml
title Digital Watch States

[*] --> InitialSetup

state "Initial Setup" as InitialSetup
state "Adjust Time Settings" as AdjustTimeSettings
state "Switch Between Options" as SwitchBetweenOptions
state "Increase Values" as IncreaseValues
state "Alarm Feature" as AlarmFeature
state "Trigger Alarm" as TriggerAlarm
state "Stop Alarm" as StopAlarm
state "Light Feature" as LightFeature

InitialSetup --> AdjustTimeSettings : [button pressed]
AdjustTimeSettings --> SwitchBetweenOptions : [button pressed]

SwitchBetweenOptions --> IncreaseValues : [hour option selected]
IncreaseValues --> AdjustTimeSettings : [value increased]

SwitchBetweenOptions --> AlarmFeature : [alarm option selected]
AlarmFeature --> TriggerAlarm : [alarm enabled and time matches current time]

TriggerAlarm --> StopAlarm : [alarm triggered]

StopAlarm --> LightFeature : [stop alarm button pressed]
LightFeature --> InitialSetup : [light turned off]

@enduml
