@startuml
title State Machine for ATM Scenario 1

state "Idle" as Idle
state "Select Amount" as SelectAmount
state "Input Custom Amount" as InputCustomAmount
state "Cancel Transaction" as CancelTransaction
state "Complete Transaction" as CompleteTransaction

[*] --> Idle : entry/To action

Idle --> SelectAmount : selectWithdrawalAmount()

SelectAmount --> SelectAmount : predefinedAmountSelected()
SelectAmount --> InputCustomAmount : customAmountEntered()

InputCustomAmount --> CompleteTransaction : amountConfirmed()

CancelTransaction --> Idle : cancelPressed()

CompleteTransaction --> [*] : transactionCompleted()

@enduml
