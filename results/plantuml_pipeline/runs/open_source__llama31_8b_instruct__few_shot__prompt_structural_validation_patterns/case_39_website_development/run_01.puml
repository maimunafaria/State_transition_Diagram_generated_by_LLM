@startuml
title Website Development

[*] --> NavigationBar

state "Navigation Bar" as NavigationBar
state "Project Information" as ProjectInformation
state "View Photos" as ViewPhotos
state "Watch Videos" as WatchVideos
state "Career Opportunities" as CareerOpportunities
state "View Updates" as ViewUpdates
state "Open Application Form" as OpenApplicationForm

NavigationBar --> ProjectInformation : Select Project
ProjectInformation --> ViewPhotos : Choose Photos
ProjectInformation --> WatchVideos : Choose Videos
ProjectInformation --> NavigationBar : Back to Navigation Bar

ProjectInformation --> CareerOpportunities : Select Career Opportunities

CareerOpportunities --> ViewUpdates : Choose Updates
CareerOpportunities --> OpenApplicationForm : Apply for Employment or Internship

OpenApplicationForm --> NavigationBar : Submit Application Form

NavigationBar --> [*]

@enduml
