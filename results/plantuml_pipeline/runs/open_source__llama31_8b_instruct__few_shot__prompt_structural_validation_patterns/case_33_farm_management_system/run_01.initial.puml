@startuml
title Farm Management System State Machine Diagram

state "Logged Out" as LoggedOut
state "Login Page" as LoginPage
state "Main Area" as MainArea
state "Market Conditions" as MarketConditions
state "Market Report" as MarketReport
state "Pest Control Help" as PestControlHelp
state "Pest Control Techniques" as PestControlTechniques
state "Soil Information" as SoilInformation
state "Weather Insights" as WeatherInsights
state "Labour Availability" as LabourAvailability

LoggedOut --> LoginPage : [Login]
LoginPage --> MainArea : [Successful Login]

MainArea --> MarketConditions : [Select Market Conditions]
MarketConditions --> MarketReport : [Select Market Report]

MainArea --> PestControlHelp : [Select Pest Control Help]
PestControlHelp --> PestControlTechniques : [Provide Photo]

MainArea --> SoilInformation : [Provide Soil Information]
SoilInformation --> WeatherInsights : [Provide Location]

WeatherInsights --> LabourAvailability : [Provide Location]

LabourAvailability --> MainArea : [Continue Using Service]

MainArea --> LoggedOut : [Logout]

@enduml
