@startuml
title Video Suggestion System

state "Idle" as Idle
state "Video Suggestion Request Received" as VideoSuggestionRequestReceived
state "User Identified" as UserIdentified
state "Videos Gathered" as VideosGathered {
  state "Based on User Profile or Preferences" as BasedOnUserProfileOrPreferences
  state "Trending Videos from User's Area" as TrendingVideosFromUsersArea
  state "Videos with Similar Tags" as VideosWithSimilarTags
  state "Videos from Similar Genres" as VideosFromSimilarGenres
  state "Promoted Videos" as PromotedVideos
}
state "Additional Details Added" as AdditionalDetailsAdded {
  state "Thumbnails Added" as ThumbnailsAdded
  state "View Counts Added" as ViewCountsAdded
}
state "Suggested Videos Sent to User" as SuggestedVideosSentToUser

Idle --> VideoSuggestionRequestReceived : Video Suggestion Request Received / Receive Request

VideoSuggestionRequestReceived --> UserIdentified : Identify User / Identify User

UserIdentified --> VideosGathered : Gather Videos / Gather Videos
BasedOnUserProfileOrPreferences --> AdditionalDetailsAdded : Add Thumbnails and View Counts / Add Details
TrendingVideosFromUsersArea --> AdditionalDetailsAdded : Add Thumbnails and View Counts / Add Details
VideosWithSimilarTags --> AdditionalDetailsAdded : Add Thumbnails and View Counts / Add Details
VideosFromSimilarGenres --> AdditionalDetailsAdded : Add Thumbnails and View Counts / Add Details
PromotedVideos --> AdditionalDetailsAdded : Add Thumbnails and View Counts / Add Details

AdditionalDetailsAdded --> SuggestedVideosSentToUser : Send Suggested Videos to User / Send Videos

@enduml
