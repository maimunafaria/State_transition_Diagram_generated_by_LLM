@startuml
title UML State Machine Diagram (BPO Management System)

[*] --> SelectFilter

state "Select Filter" as SelectFilter
SelectFilter : entry / Get the Filter Category
SelectFilter : do / Validate the Filter Category
SelectFilter : exit / Valid or Invalid Filter Category

SelectFilter --> [*] : [Invalid Filter Category]

SelectFilter --> PriceRange : [Valid Filter Category]

state "Price Range" as PriceRange
PriceRange : entry / Get the Price Range
PriceRange : do / Validate the Price Range
PriceRange : exit / Valid or Invalid Price Range

PriceRange --> [*] : [Invalid Price Range]

PriceRange --> DisplayResults : [Valid Price Range]

state "Display Results" as DisplayResults
DisplayResults : entry / Get the Matching Users
DisplayResults : do / Display the Matching Users
DisplayResults : exit / Exit from Displaying Results

DisplayResults --> [*]

@enduml
