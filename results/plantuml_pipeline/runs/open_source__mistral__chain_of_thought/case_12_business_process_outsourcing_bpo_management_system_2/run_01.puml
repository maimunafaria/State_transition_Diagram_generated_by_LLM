@startuml
hide empty package

package BpoManagementSystem {
  state Idle {
    [*]->Idle: User selects filter or price range
    Idle --> Search: User interacts with filter options
  }

  state Search {
    Search --> Results: Valid search results found
    Search --> NoResults: No matching users for selected filters
    Search --> Error: Error during search process
    Search [*]-- Search: User clears filters or navigates away
  }

  state Results {
    Results -- Idle: User clears filters or navigates away
  }

  state NoResults {
    NoResults -- Idle: User clears filters or navigates away
  }

  state Error {
    Error -- Idle: User retries search or resets filters (not specified)
  }
}
@enduml
