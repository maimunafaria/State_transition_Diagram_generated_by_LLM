@startuml
!define STATE_SHUTDOWN_INITIAL Shut Down State (Initial state)
!define STATE_RUNNING Running State
!define STATE_CONFIGURATION Configuration Mode
!define STATE_CONTROLLED Controlled Mode
!define STATE_SHUTDOWN_FINAL Shut Down State (Final state)

!define EVENT_POWERON Power On/Off event
!define EVENT_CONFIGURATION Configuration Request event
!define EVENT_REMOTE Control Command event
!define EVENT_SHUTDOWN Shutdown Command event
!define EVENT_CLOCK Tick event
!define EVENT_SUMMARY Weather Summary Request event
!define EVENT_STATUS Status Check Request event

STATE_SHUTDOWN_INITIAL --|> STATE_RUNNING [* PowerOn]
STATE_RUNNING --|> STATE_CONFIGURATION [ConfigurationRequest]
STATE_CONFIGURATION --|> STATE_RUNNING [ConfigurationCompletion]
STATE_RUNNING --|> STATE_CONTROLLED [RemoteControlCommand]
STATE_RUNNING --|> STATE_SHUTDOWN_FINAL [Shutdown]
STATE_RUNNING --|> STATE_RUNNING [CLOCKTick]
STATE_RUNNING --|> STATE_RUNNING [WeatherSummaryRequest]
STATE_RUNNING --|> STATE_RUNNING [StatusCheckRequest]
@enduml
