@startuml
hide empty package

package StaffManagementSystem {
  State Employed {
    [*] -> Assigned: Assignment
    Assigned - Switch: Switch
    Assigned - Removal: Removal
    Assigned - Unemployed: Departure
  }

  State Unassigned {
    [*] <- Assigned: Removal
    Unassigned - Employed: Assignment
  }

  State Unemployed {
    Employed - Unemployed: Departure
  }

  State Archived {
    Employed - Archived: Archival
  }
}
@enduml
