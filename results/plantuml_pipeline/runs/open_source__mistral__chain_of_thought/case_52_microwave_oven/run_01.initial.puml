@startuml
!define PI = Pi
state Idle[Idle]
state TimeInput[Time Input]
state PowerSelection[Power Selection]
state Cooking[Cooking]
state DoorOpen[Door Open]
state Cancelled[Cancelled]
state Stopped[Stopped]
state DisplayTime[Display Time]

Idle --> TimeInput: User Input
TimeInput --> PowerSelection: *
PowerSelection --> Cooking: *
Cooking --> DoorOpen: Door Open
Cooking --> Stopped: Timer Stop
DoorOpen --> DisplayTime
Cancelled --> DisplayTime: Cancel Request
Stopped --> DisplayTime
@enduml
