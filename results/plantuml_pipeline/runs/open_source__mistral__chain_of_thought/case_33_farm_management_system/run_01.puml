@startuml

state LoginState {
  [*] -> LoginState: User login event
  LoginState -- UserLoginSuccess >> MainMenuState: upon successful login
}

state MainMenuState {
  MainMenuState -- MarketConditionsState: Select market conditions
  MainMenuState -- PestControlHelpState: Select pest control help
  MainMenuState -- SoilInformationInputState: Provide soil information
  MainMenuState -- WeatherInsightsState: Select weather insights (location required)
  MainMenuState -- LabourAvailabilityDetailsState: Select labour availability details (location required)
  MainMenuState -- ContinueUsingServiceState: User chooses to continue using the service
}

state MarketConditionsState {
  MarketConditionsState -- MarketReportState: View market report
}

state PestControlHelpState {
  PestControlHelpState -- PestControlTechniquesState: View pest control techniques
}

state SoilInformationInputState {
  SoilInformationInputState -- SoilSuitabilitySuggestionsState: Upon system processing and generating suggestions
}

state WeatherInsightsState {
  WeatherInsightsState -- WeatherInsightsDetailsState: Display weather insights details (location required)
}

state LabourAvailabilityDetailsState {
  LabourAvailabilityDetailsState -- LabourAvailabilityDetails: Display labour availability details (location required)
}

state ContinueUsingServiceState {
  ContinueUsingServiceState -- MainMenuState: User chooses to continue using the service
}

state LogoutState {
  MainMenuState -- LogoutState: User logs out
}

@enduml
