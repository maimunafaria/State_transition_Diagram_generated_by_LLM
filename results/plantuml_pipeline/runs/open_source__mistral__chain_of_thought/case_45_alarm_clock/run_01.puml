@startuml
hide empty package

package AlarmClock {
  state Off {
    [*] -> AlarmActivated: User sets an alarm time
  }

  state AlarmActivated {
    AlarmActivated -> AlarmRinging: Current time matches set alarm time
  }

  state AlarmRinging {
    AlarmRinging -> AlarmStopped: User stops the ringing alarm or elapsed duration
    AlarmStopped -> AlarmActivated: Next scheduled alarm time arrives
  }

  state AlarmStopped {
    [*] -> Off: User turns off the activated alarm
  }
}
@enduml
