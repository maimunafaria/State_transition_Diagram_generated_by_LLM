@startuml

!define PURPLE #8000FF
!define GREEN #27AE60
!define BLUE #4D90FE
!define RED #F44336
!define YELLOW #FFEB3B

Unregistered [*] -|> Registered: UserRegistration
Registered -. RegistrationValidation .> PendingValidation: RegistrationValidation
PendingValidation -. SuccessfulValidation .> Validated: RegistrationValidation
Validated -. InvalidCredentials .> Registered: LoginAttempt
Validated -|> LoggedIn: LoginAttempt
LoggedIn -. TicketBookingInitiation .> TicketBooking: TicketBookingInitiation
TicketBooking -. PaymentConfirmation .> PaymentConfirmation: SuccessfulPayment
TicketBooking -. CancelTransaction .> LoggedIn: CancelTransaction
LoggedIn -. AccountManagementAction .> AccountManagement: AccountManagementAction
LoggedIn -. Logout .> LoggedOut: Logout

@enduml
