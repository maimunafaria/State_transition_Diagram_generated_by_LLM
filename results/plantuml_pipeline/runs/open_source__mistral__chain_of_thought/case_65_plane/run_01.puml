@startuml
hide empty package

package System {
  state Order {
    [*]->Order: Delivery of a plane
    Order->Arrival: Delivery of a plane
  }

  state Arrival {
    Arrival->Preparation: Arrival of a plane
  }

  state Preparation {
    Preparation-->Operations: Assignment to Operations or Maintenance
    Preparation-->Maintenance: Assignment to Maintenance
  }

  state Operations {
    Operations-- Operations: Completion of scheduled flights
    Operations->Maintenance: Requirement for maintenance
    Operations-->Preparation: Readiness after servicing (ambiguous)
  }

  state Maintenance {
    Maintenance->Preparation: Readiness for operations (ambiguous)
    Maintenance-->Out_of_Service: Unavailability for use (missing detail)
    Maintenance-->Removed_from_Operations: Permanent withdrawal from service (missing detail)
  }

  state Out_of_Service {
    [*]-->Out_of_Service: Unavailability for use (missing detail)
  }

  state Removed_from_Operations {
    [*]-->Removed_from_Operations: Permanent withdrawal from service (missing detail)
  }
}
@enduml
