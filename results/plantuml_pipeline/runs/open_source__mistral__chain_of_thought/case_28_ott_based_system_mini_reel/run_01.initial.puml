@startuml
!define STATE_UNREGISTERED UnregisteredState
!define STATE_REGISTERED RegisteredState
!define STATE_VIDEOWATCHING VideoWatchingState
!define STATE_LIKESLIST LikesListState
!define STATE_DISCUSSION DiscussionState
!define STATE_LOGGEDOUT LoggedOutState

STATE_UNREGISTERED -- CreateAccountEvent:> STATE_REGISTERED
STATE_UNREGISTERED -- LoginEvent:> STATE_REGISTERED
STATE_REGISTERED -- WatchVideoEvent:> STATE_VIDEOWATCHING
STATE_VIDEOWATCHING -- SaveVideoEvent:> STATE_LIKESLIST
STATE_REGISTERED -- ViewSavedVideosEvent:> STATE_LIKESLIST
STATE_REGISTERED -- DiscussionEvent:> STATE_DISCUSSION
STATE_REGISTERED -- LogoutEvent:> STATE_LOGGEDOUT
@enduml
