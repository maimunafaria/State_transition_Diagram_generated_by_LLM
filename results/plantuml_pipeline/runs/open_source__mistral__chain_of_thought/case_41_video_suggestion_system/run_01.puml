@startuml
hide empty package

package VideoSuggestionSystem {
  state RequestState {
    [*] -> RequestState: Video Suggestion Request Event
  }

  state GatheringState {
    RequestState -> GatheringState: Video Suggestion Request Event
  }

  state ProcessingState {
    GatheringState -> ProcessingState: Video Gathering Completion Event
  }

  state SendingState {
    ProcessingState -> SendingState: Video Processing Completion Event
    SendingState -- ReceivedState: Video Received Event (optional)
    ReceivedState -- ViewedState: Video Viewed Event (optional)
  }

  package OptionalStates {
    state ReceivedState {
      SendingState -> ReceivedState: Video Received Event
    }

    state ViewedState {
      ReceivedState -> ViewedState: Video Viewed Event
    }
  }
}
@enduml
