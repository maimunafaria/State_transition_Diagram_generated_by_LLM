@startuml
[*] --> Idle : UserArrives
Idle --> CardInserted : CardInserted
CardInserted --> PINIncorrect : PINIncorrectTooManyTimes
CardInserted --> PINCorrect : PINEntered and CorrectPIN
PINCorrect --> TransactionProcessing : ChoiceMade
CardInserted, PINIncorrect, PINCorrect --> Cancelled : UserCancel
PINIncorrect --> PINIncorrect
Cancelled --> [*] : CardReturned

@enduml
