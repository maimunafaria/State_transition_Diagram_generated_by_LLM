@startuml
[*] --> Idle : Initial

Idle --> WithdrawalAmountSelection : ChoosePredefinedAmount
Idle --> WithdrawalAmountSelection : EnterCustomAmount

WithdrawalAmountSelection --> CustomWithdrawalAmountInput : EnterCustomAmount

WithdrawalAmountSelection, CustomWithdrawalAmountInput --> TransactionInProgress : ConfirmTransaction

TransactionInProgress --> CancelTransaction : CancelTransaction

CancelTransaction --> Idle : CardReturned

[*] <|-- Idle : Final
@enduml
