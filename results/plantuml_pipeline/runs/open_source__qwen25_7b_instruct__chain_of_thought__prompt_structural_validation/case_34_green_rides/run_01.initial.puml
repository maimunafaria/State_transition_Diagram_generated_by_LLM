@startuml

[*] --> LoginScreen : UserLogsIn, DestinationSelected

LoginScreen --> JourneyDetailsViewed : ViewJourneyDetails
JourneyDetailsViewed --> DrivingModeActive : DriveModeActivated
JourneyDetailsViewed --> EatingOptionsViewed : Hungry

EatingOptionsViewed --> OrderPlaced : PlaceOrder

DrivingModeActive, EatingOptionsViewed, OrderPlaced --> AccidentReported : AccidentOccurred

anyState --> FeedbackProvided : JourneyCompleted

AccidentReported --> [*] : *

@enduml
