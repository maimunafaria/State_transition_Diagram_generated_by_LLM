@startuml
[*] --> Idle : Card Inserted
Idle --> PIN_Entry : Card Inserted
PIN_Entry --> PIN_Verification : PIN Entered
PIN_Verification --> Options : PIN Verified
PIN_Verification --> Idle : PIN Incorrect
Options --> Withdrawal_Processing : User Approval
Options --> Idle : User Cancels
Withdrawal_Processing --> Receipt_Printing : Withdrawal Approved
Receipt_Printing --> Card_Return : Transaction Complete
Card_Return --> Reset : Card Returned
Reset --> [*] : Timeout

@enduml
