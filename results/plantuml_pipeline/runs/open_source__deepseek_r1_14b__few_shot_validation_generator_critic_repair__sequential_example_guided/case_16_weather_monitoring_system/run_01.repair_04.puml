@startuml
title Weather Monitoring System State Machine Diagram

state "Portal Choice" as PortalChoice
state "New Registration" as NewRegistration
state "Existing Login" as ExistingLogin
state "User Home" as UserHome
state "Location Check" as LocationCheck
state "Weather Selection" as WeatherSelection
state "Additional Details" as AdditionalDetails
state Logout

[*] --> PortalChoice

PortalChoice --> NewRegistration : [Register]
PortalChoice --> ExistingLogin : [Login]

NewRegistration --> [*] : [Registration Failed]
ExistingLogin --> UserHome : [Successful Login]

UserHome --> LocationCheck : [Enter Location]

LocationCheck --> WeatherSelection : [Valid Location]
LocationCheck --> [*] : [Invalid Location]

WeatherSelection --> AdditionalDetails : [Select Details]
WeatherSelection --> UserHome : [Back to Home]

AdditionalDetails --> UserHome : [View Data]
AdditionalDetails --> Logout : [End Session]

Logout --> [*] : [Logged Out]
@enduml
