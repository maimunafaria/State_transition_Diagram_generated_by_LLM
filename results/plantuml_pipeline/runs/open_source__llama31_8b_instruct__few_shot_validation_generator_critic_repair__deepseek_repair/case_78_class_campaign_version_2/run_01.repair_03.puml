@startuml
title Campaign State Machine Diagram

state "Idle" as Idle
[*] --> Idle

Idle -> StartCampaign: Assign manager and staff
state "Start Campaign" as StartCampaign
StartCampaign -> ActivateCampaign: Start campaign

state "Activate Campaign" as ActivateCampaign
ActivateCampaign -> PrepareAdverts: Prepare adverts

state "Prepare Adverts" as PrepareAdverts
PrepareAdverts -> ScheduleAdverts: Approve adverts

state "Schedule Adverts" as ScheduleAdverts
ScheduleAdverts -> AdjustCampaign: Run adverts
ScheduleAdverts -> CompleteCampaign: No adjustment needed

state "Adjust Campaign" as AdjustCampaign
AdjustCampaign -> CompleteCampaign: Adjustment done

state "Complete Campaign" as CompleteCampaign
CompleteCampaign -> PayCampaign: Prepare final statement

state "Pay Campaign" as PayCampaign
PayCampaign -> ArchiveCampaign: Payment handled
PayCampaign -> RefundCampaign: Generate refund needed

state "Refund Campaign" as RefundCampaign
RefundCampaign -> WaitForBalance: Wait for balance

state "Wait for Balance" as WaitForBalance
WaitForBalance -> MarkCampaignAsPaid: Balance settled

state "Mark Campaign as Paid" as MarkCampaignAsPaid
MarkCampaignAsPaid --> [*]

state "Archive Campaign" as ArchiveCampaign
ArchiveCampaign --> [*]
@enduml
