@startuml
Digital Watch State Machine Diagram

[*] --> Idle
Idle --> ChangeTime
ChangeTime --> HourAdjust
HourAdjust --> MinuteAdjust
MinuteAdjust --> AlarmHourAdjust
AlarmHourAdjust --> AlarmMinuteAdjust
AlarmMinuteAdjust --> LightOnOff
LightOnOff --> Idle

state AlarmOn
AlarmOn --> AlarmRinging
AlarmRinging --> AlarmStopped
AlarmStopped --> Idle

state LightOn
LightOn --> LightOff
LightOff --> Idle

state AlarmOff
Idle --> AlarmOff
AlarmOff --> ChangeTime

state LightOnOffTerminal
LightOn --> LightOnOffTerminal : LIGHT_TURNED_ON
LightOnOffTerminal --> [*]

@enduml
