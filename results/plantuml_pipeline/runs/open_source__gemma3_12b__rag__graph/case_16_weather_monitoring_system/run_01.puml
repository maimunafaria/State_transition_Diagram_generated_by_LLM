@startuml
[*] --> CreateAccount
CreateAccount --> RegistrationSuccess : registration successful
CreateAccount --> RegistrationFailure : registration failed
RegistrationFailure --> [*]
CreateAccount --> [*]

RegistrationSuccess --> Login
Login --> LoginSuccess : login successful
Login --> LoginFailure : login failed
LoginFailure --> [*]
LoginSuccess --> CheckWeather
CheckWeather --> ValidLocation : location is valid
CheckWeather --> InvalidLocation : location is invalid
InvalidLocation --> [*]
CheckWeather --> [*]

ValidLocation --> ChooseWeatherInfo
ChooseWeatherInfo --> UpdateWeatherInfo : weather info selected
ChooseWeatherInfo --> [*]
UpdateWeatherInfo --> ViewWeatherDetails
ViewWeatherDetails --> Logout : user logs out
ViewWeatherDetails --> [*]

Logout --> [*]

@enduml
