@startuml
[*] --> Idle

state Idle {
    state LoggedOut
    state LoggedIn
}

Idle --> LoggedIn : login successful
LoggedIn --> LoggedOut : logout

state LoggedIn {
    state TeacherMode
    state StudentMode
}

LoggedIn --> TeacherMode : select teacher
LoggedIn --> StudentMode : select student

TeacherMode --> QuizCreation : create quiz
TeacherMode --> QuizEditing : edit quiz
TeacherMode --> QuizSaving : save quiz

QuizCreation --> TeacherMode : save draft / post quiz
QuizEditing --> TeacherMode : save draft / post quiz
QuizSaving --> TeacherMode : save draft / post quiz

TeacherMode --> QuizResults : view results

StudentMode --> QuizSelection : select quiz
QuizSelection --> QuizAnswering : answer quiz
QuizAnswering --> QuizSubmission : submit quiz
QuizSubmission --> QuizResultViewing : view result

QuizResults --> LoggedIn : return
QuizSelection --> LoggedIn : return
QuizResultViewing --> LoggedIn : return

@enduml
