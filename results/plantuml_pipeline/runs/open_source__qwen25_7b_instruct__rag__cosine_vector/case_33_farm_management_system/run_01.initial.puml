@startuml
title UML State Chart Diagram

[*] --> Login

state Login {
  [*] --> ValidLogin
  ValidLogin : entry / verifyData
  ValidLogin : do / user provide Login Details
  ValidLogin : exit / login Successful
}

state ValidLogin {
  [*] --> Dashboard
  Dashboard : entry / show Main Area
  Dashboard : do / allow to choose options
  Dashboard : exit / continue using service
}

state "Market Condition" as MarketCondition {
  Dashboard --> MarketCondition
  MarketCondition : entry / user select market condition
  MarketCondition : do / show market conditions
  MarketCondition : exit / continue using service
}

state "Pest Control Help" as PestControlHelp {
  Dashboard --> PestControlHelp
  PestControlHelp : entry / user select pest control help
  PestControlHelp : do / require photo and show techniques
  PestControlHelp : exit / continue using service
}

state SoilSuggestions {
  Dashboard --> SoilSuggestions
  SoilSuggestions : entry / user provide soil information
  SoilSuggestions : do / provide suggestions for suitable crops
  SoilSuggestions : exit / continue using service
}

state WeatherInsights {
  Dashboard --> WeatherInsights
  WeatherInsights : entry / user provide location
  WeatherInsights : do / offer weather insights
  WeatherInsights : exit / continue using service
}

state LabourAvailability {
  Dashboard --> LabourAvailability
  LabourAvailability : entry / user provide location
  LabourAvailability : do / display labour availability details
  LabourAvailability : exit / continue using service
}

Login --> [*] : logout

@enduml
