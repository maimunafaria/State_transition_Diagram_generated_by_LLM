@startuml
[*] --> Register

state Register {
  [*] --> Login : registration successful
  Login --> [*] : registration unsuccessful
}

Login --> CheckLocation
CheckLocation --> [*] : location invalid
CheckLocation --> ChooseInfo : location valid

ChooseInfo --> ShowWeather : choose weather information
ShowWeather --> [*] : end process

state ViewAdditionalDetails {
  [*] --> Alerts : view alerts
  Alerts --> WeeklyAnalysis : view weekly analysis
  WeeklyAnalysis --> FuturePrediction : view future prediction
  FuturePrediction --> Graph : view graph
  Graph --> [*] : end session
}

CheckLocation --> ViewAdditionalDetails
ViewAdditionalDetails --> Logout : logout

Logout --> [*]
@enduml
