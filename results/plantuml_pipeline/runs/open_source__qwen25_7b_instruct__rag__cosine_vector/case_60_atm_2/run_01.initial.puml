@startuml
title ATM State Machine

[*] --> SelectAmount

state "SelectAmount" as SelectAmount {
  state "SelectAmountFromList"
  state "EnterCustomValue"
}

SelectAmount --> VerifyTransaction : verifyTransaction / <<final>>

state OutOfService
state ReleaseCard

VerifyTransaction --> ReleaseCard : releaseCard / <<final>>

@enduml
