@startuml
title Digital Watch State Diagram

[*] --> Idle

state "Idle" as Idle
state "Adjusting Time" as AdjustingTime
state "Alarm Setting" as AlarmSetting
state "Alarm Triggered" as AlarmTriggered
state "Light On" as LightOn

Idle --> AdjustingTime : Press Button to Change Time
Idle --> AlarmSetting : Press Button for Alarm Settings
AdjustingTime --> Idle : Press Button to Exit
AdjustingTime --> IncreaseValue : Press Button to Increase Value
AlarmSetting --> Idle : Press Button to Exit
AlarmSetting --> AlarmTriggered : Set Alarm and Current Time Match
LightOn --> Idle : Press Button to Turn Off

IncreaseValue --> AdjustingTime : Press Button to Exit

AlarmTriggered --> Idle : Press Button to Stop Alarm

@enduml
