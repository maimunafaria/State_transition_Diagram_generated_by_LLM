@startuml
[*] --> LoggedIn

state LoggedIn {
  [*] --> Dashboard
  Dashboard --> ViewStatus : view status
  ViewStatus --> ViewStatus : check status
  ViewStatus --> CancelApplication : cancel application
  ViewStatus --> ModifyDetails : modify details
  ViewStatus --> ViewDetails : view details
  ViewStatus --> ViewPurpose : view purpose of application
  ViewPurpose --> ViewStatus : update status
  ViewPurpose --> ViewStatus : view status
  ViewPurpose --> ViewFeedback : give feedback
}

LoggedIn --> [*] : logout

state Dashboard {
  [*] --> ApplyForVisa
  ApplyForVisa --> PaymentConfirmed : make payment
  PaymentConfirmed --> ApplicationAccepted : application accepted
  ApplicationAccepted --> ViewStatus : view status
}

ApplyForVisa --> PaymentConfirmed : pay now
PaymentConfirmed --> ApplicationAccepted : accept application

state CancelApplication {
  [*] --> [*] : cancel
}

state ModifyDetails {
  [*] --> [*] : modify details
}

state ViewDetails {
  [*] --> [*] : view details
}

state ViewPurpose {
  [*] --> [*] : view purpose of application
}

state ViewFeedback {
  [*] --> [*] : give feedback
}

@enduml
