@startuml
title UML State Machine Diagram for Website Navigation

[*] --> HomePage

state "HomePage" as Home {
  [*] --> NavBar : navigate
}

state "ProjectPage" as Project {
  NavBar --> Project : selectProjects
  Project --> PhotoOrVideo : chooseView
  state "PhotoView" as Photo {
    PhotoOrVideo --> Photo : viewPhotos
  }
  state "VideoView" as Video {
    PhotoOrVideo --> Video : watchVideos
  }
}

state "CareerOpportunitiesPage" as Career {
  NavBar --> Career : selectCareers
  Career --> JobUpdatesOrForm : chooseOption
  state "JobUpdateView" as Update {
    JobUpdatesOrForm --> Update : viewUpdates
  }
  state "ApplicationFormView" as Form {
    JobUpdatesOrForm --> Form : openForm
  }
}

state "SubmittedApplications" as Submitted {
  Form --> Submitted : submit
  Submitted --> [*] : checkSubmissions
}
@enduml
