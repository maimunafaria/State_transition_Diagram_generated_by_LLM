@startuml
[*] --> Running

state Running {
  [*] --> Configuring : configuration required
  Configuring --> Running : configuration completed
}

Running --> DataCollection : clock triggered
DataCollection --> Running : activity completed

Running --> SummaryPreparation : summary requested
SummaryPreparation --> Running : activity completed

Running --> StatusChecking : status requested
StatusChecking --> Running : activity completed

Running --> ControlledMode : remote control
ControlledMode --> Running : mode exited

Running --> ShuttingDown : shutdown command
ShuttingDown --> [*] : shutdown complete
@enduml
