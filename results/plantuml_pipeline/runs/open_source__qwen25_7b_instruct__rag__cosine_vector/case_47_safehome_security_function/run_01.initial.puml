@startuml
[*] --> Idle

state Idle {
  [*] --> ReadyToUse
  ReadyToUse --> [*]
}

state ReadyToUse {
  ReadyToUse --> Reset : reset
  ReadyToUse --> Activate : activate
  ReadyToUse --> TurnOff : turn off
  ReadyToUse --> Monitoring : monitor
}

state Monitoring {
  Monitoring --> AlarmActive : sensor triggered
  Monitoring --> Idle : false alarm or time ends
}

state AlarmActive {
  [*] --> Idle : password entered
}
@enduml
