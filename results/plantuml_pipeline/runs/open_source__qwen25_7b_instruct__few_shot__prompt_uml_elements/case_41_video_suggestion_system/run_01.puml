@startuml
title Video Suggestion System State Transition Diagram

[*] --> Idle

state Idle {
  state "Receive Request" as ReceiveRequest
  state "Identify User" as IdentifyUser
  state "Gather Videos" as GatherVideos
  state "Add Details" as AddDetails
  state "Send Suggestions" as SendSuggestions
}

Idle --> ReceiveRequest : Video Suggestion Request

ReceiveRequest --> IdentifyUser : Process Request
IdentifyUser --> GatherVideos : User Identified
GatherVideos --> AddDetails : Gather Complete
AddDetails --> SendSuggestions : Details Added
SendSuggestions --> Idle : Suggestions Sent

@enduml
