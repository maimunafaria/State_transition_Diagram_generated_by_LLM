@startuml
title UML State Machine Diagram - ATM Withdrawal

[*] --> SelectAmount

state "Select Amount" as SelectAmount {
    entry / Show withdrawal options
}

state "Custom Value" as CustomValue

state "Verify Transaction" as VerifyTransaction

state "Re-enter Amount" as ReEnterAmount

SelectAmount --> VerifyTransaction : [amount selected]
SelectAmount --> CustomValue : [custom amount]

VerifyTransaction : entry / Verification process
VerifyTransaction : do / Validate transaction
VerifyTransaction : exit / Transaction verified or rejected

VerifyTransaction --> [*] : [transaction accepted]
VerifyTransaction --> ReEnterAmount : [transaction rejected]

ReEnterAmount --> SelectAmount : [re-enter amount]

@enduml
