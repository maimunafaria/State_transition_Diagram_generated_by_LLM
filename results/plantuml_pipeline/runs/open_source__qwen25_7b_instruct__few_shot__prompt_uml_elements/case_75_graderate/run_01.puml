@startuml
title Graderate State Transition Diagram

state "Waiting" as Waiting
Waiting : entry/Initialize
Waiting : do/Wait until start date

state Active
Active : do/Operate within validity period

state Expired
Expired : entry/Mark as expired
Expired : exit/Remove or archive after one year

[*] --> Waiting

Waiting --> Active : Start Date Reached

Active --> Expired : Finish Date Reached

Expired --> [*]

@enduml
