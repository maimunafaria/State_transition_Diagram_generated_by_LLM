@startuml
title Process Sale State Diagram

[*] --> WaitingForSale

state WaitingForSale {
  state AddingItems
}

AddingItems --> Payment : all items added
Payment --> CashPayment : pay with cash
CashPayment --> CompleteSale : complete sale

Payment --> CardCheckVerification : verify payment
CardCheckVerification --> PaymentApproval : approve payment
PaymentApproval --> CompleteSale : complete sale

CompleteSale --> WaitingForSale : next customer

@enduml
