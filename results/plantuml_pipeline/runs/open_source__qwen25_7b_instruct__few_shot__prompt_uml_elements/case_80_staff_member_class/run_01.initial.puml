@startuml
title Staff Member Class State Machine

[*] --> Unassigned

state Unassigned {
  entry : [Staff member is unassigned]
}

state AssignedToClient {
  entry : [Staff member assigned to client]
  exit : [Assignment ends or staff member switches assignment]
  do : [Perform client-related tasks]
}

state AssignedToCampaign {
  entry : [Staff member assigned to campaign]
  exit : [Campaign ends or staff member switches assignment]
  do : [Participate in campaign activities]
}

state Unemployed {
  entry : [Staff member leaves the job]
  [*] --> Archive
}

state Archived {
  [*] --> [*]
  entry : [Record of former employee archived after a period]
}

Unassigned --> AssignedToClient : Assign to Client / Assign
AssignedToClient --> AssignedToCampaign : Switch Assignment / Campaign
AssignedToCampaign --> Unassigned : End Assignment / Unassign
AssignedToCampaign --> Unemployed : Leave Job / Unemploy

[*] --> Unassigned : [Initial state]

Unemployed --> [*] : Archive Record / Archive

@enduml
