@startuml
title UML State Transition Diagram for Website Navigation

state "Homepage" as Homepage
Homepage : entry/Initial Page

state "Projects" as Projects
Projects : entry/Viewing Projects
Projects : do/Display Project Info

state "ProjectDetails" as ProjectDetails
ProjectDetails : entry/View Photos or Videos
ProjectDetails : do/Display Photos
ProjectDetails : do/Display Videos

state "CareerOpportunities" as CareerOpportunities
CareerOpportunities : entry/Viewing Career Opportunities
CareerOpportunities : do/Display Career Info

state "CareerInfo" as CareerInfo
CareerInfo : entry/View Updates or Application Form
CareerInfo : do/Display Updates
CareerInfo : do/Open Application Form

state "ApplicationCheck" as ApplicationCheck
ApplicationCheck : entry/Application Submitted
ApplicationCheck : do/Check Application

[*] --> Homepage
Homepage --> Projects : Select Projects
Projects --> ProjectDetails : View Photos/Videos
ProjectDetails --> Projects : Back to Projects
Projects --> CareerOpportunities : View Career Opportunities
CareerOpportunities --> CareerInfo : View Updates/Form
CareerInfo --> CareerOpportunities : Back to Career Info
CareerInfo --> ApplicationCheck : Submit Application

ApplicationCheck --> [*] : Check Complete

@enduml
