@startuml

title E-Ticketing for Bus State Diagram

state "Initial" as Initial {
  [*] --> RegisterAccount
}

state "RegisterAccount" as RegisterAccount
state "ValidateRegistration" as ValidateRegistration
state "Login" as Login
state "Logged In" as LoggedIn
state "CheckTicketStatus" as CheckTicketStatus
state "BookTicket" as BookTicket
state "ConfirmBooking" as ConfirmBooking
state "MakePayment" as MakePayment
state "ManageAccountDetails" as ManageAccountDetails
state "Logout" as Logout

Initial --> RegisterAccount

RegisterAccount --> ValidateRegistration : [Valid]
RegisterAccount --> RegisterAccount : [Invalid]

ValidateRegistration --> Login

Login --> LoggedIn : [Successful]
Login --> RegisterAccount : [Unsuccessful]

LoggedIn --> CheckTicketStatus
LoggedIn --> BookTicket
LoggedIn --> ManageAccountDetails

CheckTicketStatus --> LoggedIn

BookTicket --> ConfirmBooking
ConfirmBooking --> MakePayment

MakePayment --> Logout

ManageAccountDetails --> Logout

Logout --> [*]

@enduml
