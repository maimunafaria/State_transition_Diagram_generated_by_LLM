@startuml
title State machine for Ott Based System Mini Reel

state "Initial" as Initial
state AccountCreated
state WatchingVideos
state UploadingVideos
state SavedVideos
state DiscussionOption

[*] --> Initial

Initial --> AccountCreated : createUserAccount

AccountCreated --> WatchingVideos : watchVideo
AccountCreated --> UploadingVideos : uploadVideo

WatchingVideos --> SavedVideos : saveVideoToLikesList
SavedVideos --> WatchingVideos : viewSavedVideosFromLikesList

WatchingVideos --> WatchingVideos : enterDiscussionOption
UploadingVideos --> UploadingVideos : enterDiscussionOption

DiscussionOption --> Initial : exitDiscussionOption

AccountCreated --> [*] : logout

@enduml
