@startuml
title UML State Transition Diagram for Campaign Version 2

state "Initial" as Initial {
    [*] --> AssignManagerStaff : [Campaign Not Started]
}

state "AssignManagerStaff" as AssignManagerStaff
state "AwaitApproval" as AwaitApproval
state "ContractSigned" as ContractSigned
state "PrepareAdverts" as PrepareAdverts
state "ApproveScheduleAdverts" as ApproveScheduleAdverts
state "RunAdverts" as RunAdverts
state "CampaignRunning" as CampaignRunning {
    state "ExtendAdjustCampaign" as ExtendAdjustCampaign
}
state "FinalizeCampaign" as FinalizeCampaign
state "PaymentProcessing" as PaymentProcessing
state "Paid" as Paid
state "Complete" as Complete

Initial --> AssignManagerStaff : [Manager and Staff Assigned]

AssignManagerStaff --> AwaitApproval : [All Approved]
AwaitApproval --> ContractSigned : [Contract Signed]

ContractSigned --> PrepareAdverts : [Ready to Advertise]

PrepareAdverts --> ApproveScheduleAdverts : [Adverts Prepared]

ApproveScheduleAdverts --> RunAdverts : [Approved and Scheduled]

RunAdverts --> CampaignRunning : [Campaign Running]

CampaignRunning --> ExtendAdjustCampaign : [Extend or Adjust]
CampaignRunning --> FinalizeCampaign : [All Adverts Finished]

FinalizeCampaign --> PaymentProcessing : [Final Statement Ready]

PaymentProcessing --> Paid : [Full Amount Paid]
Paid --> Complete : [Campaign Completed and Archived]

Complete --> [*] : [Campaign Archiving Complete]

@enduml
