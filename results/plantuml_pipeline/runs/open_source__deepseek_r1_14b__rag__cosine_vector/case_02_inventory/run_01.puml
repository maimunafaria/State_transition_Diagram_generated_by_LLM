@startuml
[*] --> InitialState

state InitialState
InitialState --> MainMenu : start system

state MainMenu
MainMenu --> AddGoods : add new goods
MainMenu --> UpdatePrice : update price
MainMenu --> RemoveGoods : remove goods
MainMenu --> SearchItems : search items
MainMenu --> ViewReport : view report

state AddGoods
AddGoods --> ConfirmationAdd : added successfully

state UpdatePrice
UpdatePrice --> MainMenu : back to main menu

state RemoveGoods
RemoveGoods --> ConfirmationRemove : removed successfully

state SearchItems
SearchItems --> SelectForPurchase : select for purchase
SearchItems --> BackToMenu : back to main menu

state SelectForPurchase
SelectForPurchase --> CalculateDiscount : calculate discount
SelectForPurchase --> CancelPurchase : cancel purchase

state CalculateDiscount
CalculateDiscount --> GenerateReceipt : generate receipt
CalculateDiscount --> MainMenu : back to main menu

state GenerateReceipt
GenerateReceipt --> ReplaceItem : replace item
GenerateReceipt --> CancelReceipt : cancel receipt
GenerateReceipt --> MainMenu : back to main menu

state OrderPlacement
OrderPlacement --> GenerateInvoice : order placed

state GenerateInvoice
GenerateInvoice --> ViewSummary : view summary
GenerateInvoice --> MainMenu : back to main menu

state ConfirmationAdd
ConfirmationAdd --> MainMenu : back to main menu

state ConfirmationRemove
ConfirmationRemove --> MainMenu : back to main menu

state BackToMenu
BackToMenu --> MainMenu : return to main menu

state ViewReport
ViewReport --> [*] : exit system

@enduml
