@startuml
[*] --> Idle

Idle -->
Idle --> AdjustingTime : Press Button
Idle --> SettingAlarm : Press Button

AdjustingTime -->
AdjustingTime --> AdjustingHour : Press Button
AdjustingTime --> AdjustingMinute : Press Button
AdjustingTime --> AdjustingAlarmHour : Press Button
AdjustingTime --> AdjustingAlarmMinute : Press Button

SettingAlarm -->
SettingAlarm --> AlarmOn : Set Time

AlarmOn -->
AlarmOn --> AlarmRinging : Current Time Matches

AlarmRinging -->
AlarmRinging --> AlarmOff : Press Button

Light -->
Light --> LightOn : Press Button
Light --> LightOff : Release Button

AdjustingHour -->
AdjustingHour --> AdjustingMinute : Press Button

AdjustingMinute -->
AdjustingMinute --> AdjustingAlarmHour : Press Button

AdjustingAlarmHour -->
AdjustingAlarmHour --> AdjustingAlarmMinute : Press Button

AdjustingAlarmMinute -->
AdjustingAlarmMinute --> Idle : Press Button
@enduml
