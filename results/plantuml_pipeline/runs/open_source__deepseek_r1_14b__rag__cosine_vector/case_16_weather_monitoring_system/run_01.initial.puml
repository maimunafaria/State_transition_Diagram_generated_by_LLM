@startuml
title Weather Monitoring System

state Initial
state Registration
state Login
state Dashboard
state ViewData
state ViewHistory
state Alerts
state Logout

Initial --> Registration : Start
Registration --> Login : Successful registration
Registration --> Initial : Failed registration

Login --> Dashboard : Successful login
Login --> Initial : Invalid credentials

Dashboard --> ViewData : Check current weather
Dashboard --> ViewHistory : Check historical data
Dashboard --> Alerts : Get weather alerts
Dashboard --> Login : Logout

ViewData --> Dashboard : Back to dashboard
ViewHistory --> Dashboard : Back to dashboard
Alerts --> Dashboard : No active alerts
Alerts --> Alerts : New alert triggered

Logout --> Initial : Session ended

@enduml
