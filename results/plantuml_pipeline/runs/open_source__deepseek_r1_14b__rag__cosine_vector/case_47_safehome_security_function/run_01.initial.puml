@startuml
[*] --> CheckingStartup : Power On

state CheckingStartup {
  [*] --> CheckingStartup : Check Status
  CheckingStartup --> Stopped : Problem Detected
  CheckingStartup --> ReadyToUse : All Good
}

ReadyToUse --> CheckingStartup : Reset
ReadyToUse --> Activated : Activate
ReadyToUse --> Stopped : Turn Off

Activated --> Monitoring : Start Monitoring

state Monitoring {
  Monitoring --> AlarmTriggered : Sensor Triggered
  AlarmTriggered --> Monitoring : False Alarm or Timeout
}

Monitoring --> Stopped : Password Entered
AlarmTriggered --> Stopped : Password Entered

Stopped --> [*] : Power Off
@enduml
