@startuml
[*] --> Login
state Login {
  [*] --> MainMenu : successful login
}

state MainMenu <<choice>> {
 MainMenu --> MarketConditions
 MainMarketCondition --> MainMenu
 MainMenu --> PestControl
 PestControl --> PhotoCapture
 PhotoCapture --> PestTechniques
 PestTechniques --> MainMenu
 MainMenu --> SoilInfo
 SoilInfo --> CropSuggestions
 CropSuggestions --> MainMenu
 MainMenu --> WeatherReport
 WeatherReport --> LocationRequest
 LocationRequest --> MainMenu
 MainMenu --> LabourAvailability
 LabourAvailability --> LocationProvide
 LocationProvide --> LabourDetails
 LabourDetails --> MainMenu
}

state MarketConditions {
  [*] --> ShowMarketReport
 ShowMarketReport --> MainMenu : continue using service
}

state PestControl {
  [*] --> RequestPhoto
 RequestPhoto --> PestTechniques
}

state PhotoCapture {
  [*] --> PestControl
}

state SoilInfo {
  [*] --> SoilAnalysis
 SoilAnalysis --> CropSuggestions
}

state WeatherReport {
  [*] --> GetWeatherData
 GetWeatherData --> MainMenu : continue using service
}

state LabourAvailability {
  [*] --> RequestLabourLocation
 RequestLabourLocation --> LabourDetails
}

state Logout <<final>> {
  [*] --> end
}

MainMenu --> Logout
@enduml
