@startuml
state "Idle" as Idle
state "Waiting for Amount Selection" as WaitingAmount
state "Predefined Amount Selected" as PredefinedSelected
state "Custom Amount Entered" as CustomEntered
state "Cancel Transaction" as Canceling
state "Return Card" as Returning

[*] --> Idle

Idle --> WaitingAmount : Insert Card / Get Ready

WaitingAmount --> PredefinedSelected : Select Predefined Amount
WaitingAmount --> CustomEntered : Enter Custom Amount
WaitingAmount --> Canceling : Cancel

PredefinedSelected --> Canceling : Cancel
CustomEntered --> Canceling : Cancel

Canceling --> Returning : Return Card

Returning --> Idle : Transaction Complete
@enduml
