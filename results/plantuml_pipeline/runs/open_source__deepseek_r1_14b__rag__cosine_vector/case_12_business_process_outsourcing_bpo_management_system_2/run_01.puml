@startuml
title UML State Machine Diagram (Search Filters)

[*] --> ChoiceFilter

state ChoiceFilter <<choice>>

ChoiceFilter --> CategorySearch : [select category filter]
ChoiceFilter --> PriceRangeSearch : [select price range]

state "Apply Category Filter" as ApplyCategory
state "Apply Price Range" as ApplyPrice

CategorySearch --> ApplyCategory
PriceRangeSearch --> ApplyPrice

ApplyCategory --> DisplayResults : [show matching users]
ApplyPrice --> DisplayResults : [show matching users]

DisplayResults --> [*] : [process complete]

@enduml
