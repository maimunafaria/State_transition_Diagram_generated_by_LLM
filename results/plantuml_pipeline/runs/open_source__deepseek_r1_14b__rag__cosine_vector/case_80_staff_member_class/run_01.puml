@startuml
[*] --> Unassigned

state Unassigned {
  [*] --> Unassigned
}

Unassigned --> AssignedToClient : assignClient
Unassigned --> AssignedToCampaign : assignCampaign
AssignedToClient --> Unassigned : removeAssignment
AssignedToClient --> AssignedToCampaign : switchToCampaign
AssignedToCampaign --> Unassigned : removeAssignment
AssignedToCampaign --> AssignedToClient : switchToClient

state unemployed {
  [*] --> unemployed
}

unemployed --> Archived : archiveAfterTime

Archived --> [*]

@enduml
