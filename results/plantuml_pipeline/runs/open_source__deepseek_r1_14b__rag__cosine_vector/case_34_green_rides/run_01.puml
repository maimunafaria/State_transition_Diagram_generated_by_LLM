@startuml
title Journey Management System

state Login {
  entry / User inputs credentials
  do / Validate login
  exit / Display journey details
}

state DisplayJourneyDetails {
  entry / Journey details displayed
  do / Show options: Driving Mode or Other Options
  exit / Option selected
}

state DrivingMode {
  entry / Activate driving mode
  do / Prepare for driving
  exit / Ready to drive
}

state Driving {
  entry / Start driving
  do / Monitor journey and send notifications
  exit / Stop driving
}

state AccidentDetected {
  entry / Collision detected while driving
  do / Trigger accident handling
  exit / Authorities informed
}

state InformAuthorities {
  entry / Contact emergency services
  do / Report incident details
  exit / Send notification to user
}

state Notifications {
  entry / Receive updates during driving
  do / Display notifications
  exit / Continue journey or stop
}

state SelectPlaceToEat {
  entry / Choose a restaurant from options
  do / Navigate to restaurant page
  exit / Restaurant selected
}

state ViewMenu {
  entry / Display menu of selected restaurant
  do / Review menu items
  exit / Order placed or canceled
}

state OrderPlaced {
  entry / Confirm order details
  do / Process
@enduml
