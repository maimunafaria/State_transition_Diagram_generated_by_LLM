@startuml
[*] --> WaitingForAmountSelection : User inserts card

state "Waiting for Amount Selection" as WaitingForAmountSelection
state AmountEntered
state TransactionVerification
state Rejected
state Accepted

WaitingForAmountSelection --> AmountEntered : Select amount or enter custom
AmountEntered --> TransactionVerification : Verify transaction
TransactionVerification --> Rejected : Transaction rejected
Rejected --> AmountEntered : Re-enter amount
TransactionVerification --> Accepted : Transaction accepted

@enduml
