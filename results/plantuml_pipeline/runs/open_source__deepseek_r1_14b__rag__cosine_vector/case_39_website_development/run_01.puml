@startuml
[*] --> Homepage
Homepage --> ProjectView : navigate to projects
Homepage --> CareerView : navigate to careers

state ProjectView {
    [*] --> PhotoOrVideo : choose photos or videos
}

state CareerView {
    [*] --> UpdatesOrApplication : choose updates or application forms
}

state PhotoOrVideo {
    PhotoOrVideo --> InfoDisplayedForProject : display project info
}

state UpdatesOrApplication {
    UpdatesOrApplication --> InfoDisplayedForCareer : display career info
}

state InfoDisplayedForProject {
    InfoDisplayedForProject --> ProjectView : back to projects
}

state InfoDisplayedForCareer {
    InfoDisplayedForCareer --> CareerView : back to careers
}

InfoDisplayedForProject --> JobCheck : submit application
JobCheck --> [*] : check completed
@enduml
