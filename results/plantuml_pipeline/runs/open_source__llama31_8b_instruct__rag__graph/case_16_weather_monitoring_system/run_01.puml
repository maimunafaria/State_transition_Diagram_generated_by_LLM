@startuml
title Weather Monitoring System - Polished Requirement Specification


[*] --> CreateAccount

state "Create Account" as CA
CA : entry / enter account details
CA : do / verify details
CA : exit / login page

state Login <<choice>>
CA --> Login

state "Login Page" as LP
LP : entry / enter login credentials
LP : do / verify credentials
LP : exit / logged in

state LoggedIn
LoggedIn : entry / logged in
LoggedIn : do / check weather
LoggedIn : exit / logout

state "Check Weather" as CW
CW : entry / entered location
CW : do / get weather details
CW : exit / show weather info

state "View Additional Details" as VAD
VAD : entry / selected additional details
VAD : do / display details
VAD : exit / logged out

Login --> LP : [login successful]
LP --> LoggedIn : [login successful]

LoggedIn --> CW : [check weather]
CW --> [*] : [new location entered is not valid]

LoggedIn --> VAD : [entered location is valid]
VAD --> [*] : [additional details selected]

LoggedIn --> [*] : [logout]
VAD --> [*] : [logged out]


@enduml
