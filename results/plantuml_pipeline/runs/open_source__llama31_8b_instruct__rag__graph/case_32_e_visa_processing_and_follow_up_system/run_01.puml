@startuml
[*] --> CreateAccount
state "Create Account" as CreateAccount
CreateAccount : entry / user create account
CreateAccount : do / save details
CreateAccount : exit / login page

CreateAccount --> Login
state "Login" as Login
Login : entry / user logged in
Login : do / verify credentials
Login : exit / application page

Login --> ApplyForVisa
state "Apply For Visa" as ApplyForVisa
ApplyForVisa : entry / user logged in
ApplyForVisa : do / fill out form
ApplyForVisa : exit / payment page

ApplyForVisa --> MakePayment
state "Make Payment" as MakePayment
MakePayment : entry / application submitted
MakePayment : do / process payment
MakePayment : exit / application accepted

MakePayment --> ViewStatus
state "View Status" as ViewStatus
ViewStatus : entry / user logged in
ViewStatus : do / view status
ViewStatus : exit / check status page

ViewStatus --> CheckStatus
state "Check Status" as CheckStatus
CheckStatus : entry / user viewed status
CheckStatus : do / check status
CheckStatus : exit / cancel application page

CheckStatus --> CancelApplication
state "Cancel Application" as CancelApplication
CancelApplication : entry / user logged in
CancelApplication : do / cancel application
CancelApplication : exit / logout page

CancelApplication --> Logout
state "Logout" as Logout
Logout : entry / user logged out
Logout : do / end session
Logout : exit / final state

CheckStatus --> ModifyDetails
state "Modify Details" as ModifyDetails
ModifyDetails : entry / user logged in
ModifyDetails : do / modify details
ModifyDetails : exit / view details page

ModifyDetails --> ViewDetails
state "View Details" as ViewDetails
ViewDetails : entry / user logged in
ViewDetails : do / view details
ViewDetails : exit / give feedback page

ViewDetails --> GiveFeedback
state "Give Feedback" as GiveFeedback
GiveFeedback : entry / user viewed details
GiveFeedback : do / give feedback
GiveFeedback : exit / logout page

GiveFeedback --> Logout

ModifyDetails --> ViewDetails
ViewDetails --> GiveFeedback

ApplyForVisa --> ViewStatus
ViewStatus --> CheckStatus
CheckStatus --> CancelApplication
CancelApplication --> Logout
ModifyDetails --> ViewDetails
ViewDetails --> GiveFeedback

MakePayment --> [*]
Logout --> [*]

@enduml
