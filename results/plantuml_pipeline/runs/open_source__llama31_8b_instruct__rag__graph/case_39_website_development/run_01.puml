@startuml
[*] --> Homepage
Homepage --> ProjectList : select project
ProjectList --> ViewPhotosOrVideos : view photos or videos
ViewPhotosOrVideos --> Photos : view photos
ViewPhotosOrVideos --> Videos : view videos
ProjectList --> CareerOpportunities : career opportunities
CareerOpportunities --> ViewUpdatesOrApply : view updates or apply
ViewUpdatesOrApply --> ViewUpdates : view updates
ViewUpdatesOrApply --> ApplyForEmploymentOrInternship : apply for employment or internship
ApplyForEmploymentOrInternship --> EmploymentApplicationForm : open application form
[*] --> Homepage : submitted job applications checked

state "Homepage" as Homepage
state "Project List" as ProjectList
state "View Photos/Videos" as ViewPhotosOrVideos
state "Photos" as Photos
state "Videos" as Videos
state "Career Opportunities" as CareerOpportunities
state "View Updates/Apply" as ViewUpdatesOrApply
state "View Updates" as ViewUpdates
state "Apply for Employment/Internship" as ApplyForEmploymentOrInternship
state "Employment Application Form" as EmploymentApplicationForm

Homepage --> ProjectList : navigate to project list
ProjectList --> CareerOpportunities : select career opportunities
CareerOpportunities --> ViewUpdatesOrApply : view updates or apply
ViewUpdatesOrApply --> ViewUpdates : view updates
ViewUpdatesOrApply --> ApplyForEmploymentOrInternship : apply for employment or internship

@enduml
