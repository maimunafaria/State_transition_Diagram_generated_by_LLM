@startuml
title ATM State Machine

[*] --> VerifyCard <<final>>
VerifyCard --> ReadAmount : acceptCard
state "Read Amount" as ReadAmount {
  [*] --> SelectAmount
  state SelectAmount
  SelectAmount --> [*] : amount
}
ReadAmount --> OutOfService : outOfService
ReadAmount --> VerifyTransaction
VerifyTransaction --> ReleaseCard : releaseCard / <<final>>
ReleaseCard --> [*]

@enduml
