@startuml
title Microwave Oven State Machine

[*] --> Idle

state "Idle" as Idle
state "Displaying Time" as DisplayingTime
state "Waiting for User Input" as WaitingForUserInput
state "Cooking" as Cooking
state "Door Open" as DoorOpen
state Stopped

Idle --> DisplayingTime : start

DisplayingTime --> WaitingForUserInput : user input

WaitingForUserInput --> Cooking : select power level [full or half]
WaitingForUserInput --> Idle : cancel

Cooking --> DisplayingTime : cooking complete
Cooking --> DoorOpen : door opened during cooking

DoorOpen --> Stopped : stop immediately

Stopped --> DisplayingTime : return to idle

@enduml
