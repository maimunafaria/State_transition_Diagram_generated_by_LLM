@startuml
title State diagram of the Farm Management System operations

[*] --> LoggedIn

state "Logged In" as LoggedIn
state "Main Area" as MainArea
state "Market Conditions" as MarketConditions
state "Pest Control Help" as PestControlHelp
state "Soil Information" as SoilInformation
state "Weather Insights" as WeatherInsights
state "Labour Availability Details" as LabourAvailabilityDetails

LoggedIn --> MainArea : login successful
MainArea --> MarketConditions : select market conditions
MarketConditions --> MarketConditions : display market report
PestControlHelp --> PestControlHelp : provide photo for pest control help
PestControlHelp --> PestControlHelp : show pest control techniques
SoilInformation --> SoilInformation : receive soil information
SoilInformation --> WeatherInsights : provide location for weather insights
WeatherInsights --> WeatherInsights : offer weather insights
LabourAvailabilityDetails --> LabourAvailabilityDetails : display labour availability details

LoggedIn --> [*] : logout

@enduml
