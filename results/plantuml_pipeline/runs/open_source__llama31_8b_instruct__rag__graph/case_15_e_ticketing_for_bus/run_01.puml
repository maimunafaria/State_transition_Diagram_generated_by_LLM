@startuml
[*] --> CreateAccount : user creates account
CreateAccount --> ValidateRegistration : registration validated
ValidateRegistration --> Login : login successful
Login --> CheckTicketStatus : logged-in users check ticket status
CheckTicketStatus --> BookTicket : user books ticket
BookTicket --> ConfirmPayment : payment confirmed
ConfirmPayment --> ManageAccount : user manages account details
ManageAccount --> Logout : user logs out after completing action

state "Create Account" as CreateAccount
state "Validate Registration" as ValidateRegistration
state "Login" as Login
state "Check Ticket Status" as CheckTicketStatus
state "Book Ticket" as BookTicket
state "Confirm Payment" as ConfirmPayment
state "Manage Account" as ManageAccount
state "Logout" as Logout

CreateAccount --> ValidateRegistration : user creates account
ValidateRegistration --> Login : registration validated
Login --> CheckTicketStatus : login successful
CheckTicketStatus --> BookTicket : logged-in users check ticket status
BookTicket --> ConfirmPayment : user books ticket
ConfirmPayment --> ManageAccount : payment confirmed
ManageAccount --> Logout : user manages account details
Logout --> [*] : user logs out after completing action

@enduml
