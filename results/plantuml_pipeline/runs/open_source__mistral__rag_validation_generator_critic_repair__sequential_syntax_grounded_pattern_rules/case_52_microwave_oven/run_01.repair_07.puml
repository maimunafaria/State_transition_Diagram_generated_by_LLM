@startuml
title Microwave Oven State Machine Diagram

state Idle {
  [*] --> INITIAL_STATE
}

INITIAL_STATE --> TimeDisplay
INITIAL_STATE --> PowerLevelSelection
INITIAL_STATE --> CookingTimeInput
INITIAL_STATE --> DoorOpen
INITIAL_STATE --> Cancel

TimeDisplay --> PowerLevelSelection : user_interaction()
PowerLevelSelection --> CookingTimeInput : user_interaction()
CookingTimeInput --> DoorOpen : enterCookingTime()
DoorOpen --> Inactive : doorOpenDuringOperation()
DoorOpen --> Stop : doorOpenedDuringCooking()
Cancel --> Idle : cancelButtonClicked()
TERMINAL_STATE --> [*] : COMPLETION_EVENT
@enduml
