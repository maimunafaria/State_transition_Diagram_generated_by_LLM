@startuml
title UML State Chart Diagram for Farm Management System

state "Logged Out" as LoggedOut {
  [*] --> Login
}

state "Login" as Login {
  state "Enter Credentials" as EnterCredentials
  state "Invalid Credentials" as InvalidCredentials
  state "Valid Credentials" as ValidCredentials

  Login --> EnterCredentials : [No Credentials]
  EnterCredentials --> ValidCredentials : [Valid]
  EnterCredentials --> InvalidCredentials : [Invalid]

  ValidCredentials --> MainArea
}

state "Main Area" as MainArea {
  state "Market Conditions" as MarketConditions
  state "Pest Control Help" as PestControlHelp
  state "Soil Suggestions" as SoilSuggestions
  state "Weather Insights" as WeatherInsights
  state "Labour Availability" as LabourAvailability

  MainArea --> MarketConditions : [Select Market Conditions]
  MainArea --> PestControlHelp : [Select Pest Control Help]
  MainArea --> SoilSuggestions : [Provide Soil Info]
  MainArea --> WeatherInsights : [Provide Location for Weather]
  MainArea --> LabourAvailability : [Provide Location for Labour]

  MarketConditions --> MarketReport
  PestControlHelp --> PestTechniques : [Provide Photo]
  SoilSuggestions --> SoilSuggestionsResult
  WeatherInsights --> WeatherDetails
  LabourAvailability --> LabourDetails

  MarketReport --> MainArea
  PestTechniques --> MainArea
  SoilSuggestionsResult --> MainArea
  WeatherDetails --> MainArea
  LabourDetails --> MainArea
}

state "Market Report" as MarketReport {
  state "View Report" as ViewReport
  state "Back to Main Area" as BackToMain

  MarketReport --> ViewReport : [View]
  ViewReport --> MarketReport : [Continue Viewing]
  ViewReport --> BackToMain : [Back]

  BackToMain --> MainArea
}

state "Pest Control Techniques" as PestTechniques {
  state "View Techniques" as ViewTechniques
  state "Back to Main Area" as BackToMain

  PestTechniques --> ViewTechniques : [View]
  ViewTechniques --> PestTechniques : [Continue Viewing]
  ViewTechniques --> BackToMain : [Back]

  BackToMain --> MainArea
}

state "Soil Suggestions Result" as SoilSuggestionsResult {
  state "Back to Main Area" as BackToMain

  SoilSuggestionsResult --> BackToMain : [Back]

  BackToMain --> MainArea
}

state "Weather Details" as WeatherDetails {
  state "View Details" as ViewDetails
  state "Back to Main Area" as BackToMain

  WeatherDetails --> ViewDetails : [View]
  ViewDetails --> WeatherDetails : [Continue Viewing]
  ViewDetails --> BackToMain : [Back]

  BackToMain --> MainArea
}

state "Labour Details" as LabourDetails {
  state "View Details" as ViewDetails
  state "Back to Main Area" as BackToMain

  LabourDetails --> ViewDetails : [View]
  ViewDetails --> LabourDetails : [Continue Viewing]
  ViewDetails --> BackToMain : [Back]

  BackToMain --> MainArea
}

state "Logged Out" <<choice>>

[*] --> LoggedOut

Login --> [*] : Logout
MarketReport --> [*] : Logout
PestTechniques --> [*] : Logout
SoilSuggestionsResult --> [*] : Logout
WeatherDetails --> [*] : Logout
LabourDetails --> [*] : Logout

@enduml
