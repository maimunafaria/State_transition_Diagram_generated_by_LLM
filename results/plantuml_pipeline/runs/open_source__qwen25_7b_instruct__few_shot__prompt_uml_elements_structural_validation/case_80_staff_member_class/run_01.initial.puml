@startuml
title Staff Member Class State Machine

[*] --> Unassigned

state "Unassigned" as Unassigned {
  state "Available for Assignment" as AvailableForAssignment
}

state Assigned {
  state "Client Assignment" as ClientAssignment
  state "Campaign Assignment" as CampaignAssignment
}

state Unemployed

Assigned --> Unassigned : [Remove Assignment]
Unassigned --> Unemployed : [Mark as Unemployed]

[*] --> AvailableForAssignment
AvailableForAssignment --> ClientAssignment : [Assign to Client]
AvailableForAssignment --> CampaignAssignment : [Assign to Campaign]

ClientAssignment --> AvailableForAssignment : [Switch Assignment]
CampaignAssignment --> AvailableForAssignment : [Switch Assignment]

Unassigned --> [*]
Unemployed --> [*]

@enduml
