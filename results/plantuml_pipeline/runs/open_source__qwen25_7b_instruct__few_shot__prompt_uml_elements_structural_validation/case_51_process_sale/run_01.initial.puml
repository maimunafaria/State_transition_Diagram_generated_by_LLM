@startuml
title Process Sale State Machine

[*] --> WaitingForSale

state WaitingForSale {
  state AddingItems
}

AddingItems --> Payment : all items added

state Payment {
  state CashPayment
  state CardCheckPayment
  state Completed
}

CashPayment --> Completed : payment received

CardCheckPayment --> Verification : verify payment
Verification --> Completed : payment verified

Completed --> Finished : sale completed

Finished --> WaitingForSale : next customer

WaitingForSale --> [*] : exit

@enduml
