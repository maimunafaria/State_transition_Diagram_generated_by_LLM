@startuml
title UML State Machine Diagram - ATM Withdrawal

[*] --> SelectAmount

state "Select Amount" as SelectAmount {
    entry / Show withdrawal options
}

state "Enter Custom Value" as EnterCustomValue

state "Verify Transaction" as VerifyTransaction {
    entry / Check transaction validity
}

state "Re-enter Amount" as ReenterAmount

state "Withdrawal Complete" as WithdrawalComplete

SelectAmount --> EnterCustomValue : [custom value]
SelectAmount --> VerifyTransaction : [selected amount]

VerifyTransaction --> SelectAmount : [transaction rejected]
VerifyTransaction --> ReenterAmount : [valid transaction]

ReenterAmount --> SelectAmount : [re-entered amount]

VerifyTransaction --> WithdrawalComplete : [valid transaction]

@enduml
