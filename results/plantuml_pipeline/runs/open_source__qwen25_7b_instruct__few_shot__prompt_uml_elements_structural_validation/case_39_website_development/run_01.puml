@startuml
title UML state machine diagram for Website Development

state "Home" as Home
Home : entry/Initial State
Home --> Projects : Select Projects
Home --> CareerOpportunities : Select Career Opportunities

state "Projects" as Projects
Projects : entry/Viewing Projects
Projects : do/Navigate from Home
Projects --> Photos : Choose Photos
Projects --> Videos : Choose Videos

state "Photos" as Photos
Photos : entry/Viewing Photos
Photos : do/Navigate back to Projects

state "Videos" as Videos
Videos : entry/Viewing Videos
Videos : do/Navigate back to Projects

state "CareerOpportunities" as CareerOpportunities
CareerOpportunities : entry/Viewing Career Opportunities
CareerOpportunities : do/Navigate from Home
CareerOpportunities --> Updates : Choose Updates
CareerOpportunities --> ApplicationForm : Choose Application Form

state "Updates" as Updates
Updates : entry/Viewing Updates
Updates : do/Navigate back to CareerOpportunities

state "ApplicationForm" as ApplicationForm
ApplicationForm : entry/Applying for Job
ApplicationForm : do/Submitted Application
ApplicationForm --> CheckSubmissions : Check Submitted Applications

state "CheckSubmissions" as CheckSubmissions
CheckSubmissions : entry/Checking Submissions
CheckSubmissions : do/Process Application
CheckSubmissions --> [*] : Process Complete

[*] --> Home : Return to Home

@enduml
