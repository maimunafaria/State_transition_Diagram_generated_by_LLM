@startuml
title State diagram for ATM Withdrawal Transaction

state "Initial" as Initial {
  entry / Display welcome message
}

[*] --> Initial : Start

state "Withdrawal Amount Selection" as AmountSelection
state "Custom Amount Entry" as CustomEntry
state "Transaction Cancelled" as Cancelled
state "Transaction Completed" as Completed

Initial --> AmountSelection : Select predefined amount
Initial --> CustomEntry : Enter custom amount

AmountSelection --> Cancelled : Cancel transaction
AmountSelection --> Completed : Confirm withdrawal

CustomEntry --> Cancelled : Cancel transaction
CustomEntry --> Completed : Confirm withdrawal

Cancelled --> [*] : Return card

Completed --> [*] : Finish transaction and return card

@enduml
