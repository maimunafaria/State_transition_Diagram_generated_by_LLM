@startuml
title Plane State Transition Diagram

[*] --> Order

state Order {
    entry : Place in 'Order' state until delivered;
}

Order --> Arrival

state Arrival {
    entry : Plane has arrived at the facility;
}

Arrival --> Preparation

state Preparation {
    entry : Plane is prepared for operations or maintenance;
}

Preparation --> Operations

state Operations {
    entry : Plane is assigned to active flights;
    do : Maintain current state if scheduled flights are available;
}

Operations --> Maintenance

state Maintenance {
    entry : Plane requires servicing or has no more scheduled flights;
}

Maintenance --> Preparation

state Preparation {
    do : Check and service the plane until it is ready for operations;
}

Preparation --> [*]

state OutOfService {
    entry : Plane is no longer available for use;
}

Operations --> OutOfService

OutOfService --> [*]

@enduml
