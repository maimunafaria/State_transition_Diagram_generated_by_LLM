@startuml
title Digidoclocker State Diagram

[*] --> CitizenRegistration

state CitizenRegistration
state "CitizenLogin" as CitizenLogin
state DocumentUpload
state ProfileView
state CertificateApplication
state "CertificateRequest" as CertificateRequest
state RegistrarRequest
state Finalizing

citizenRegistration --> CitizenLogin : register
CitizenLogin --> DocumentUpload : login
DocumentUpload --> ProfileView : view profile
DocumentUpload --> CertificateApplication : apply for certificate
ProfileView --> DocumentUpload : upload more documents
CertificateApplication --> DocumentUpload : continue uploading
CertificateApplication --> CertificateRequest : request certificate
CertificateRequest --> RegistrarRequest : registrar requests
RegistrarRequest --> CertificateRequest : continue requesting

CertificateRequest --> Finalizing : complete session
CitizenLogin --> Finalizing : logout
DocumentUpload --> Finalizing : done with uploads
ProfileView --> Finalizing : done viewing profile
CertificateApplication --> Finalizing : done applying for certificate
RegistrarRequest --> Finalizing : done requesting certificates

Finalizing --> [*]

@enduml
