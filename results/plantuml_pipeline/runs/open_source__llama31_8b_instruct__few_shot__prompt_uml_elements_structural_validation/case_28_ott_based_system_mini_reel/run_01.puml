@startuml
title State machine diagram for Ott Based System Mini Reel

[*] --> Idle

state "Idle" as Idle
Idle : entry/To action
Idle : do/Remain in same state
Idle : exit/Create Account / Watch Video

state "Create Account" as CreateAccount
CreateAccount : entry/Register
CreateAccount : do/Register after validating
CreateAccount : exit/Login/Invalid registration

state "Invalid registration" as InvalidRegistration
InvalidRegistration : entry/Invalid registration
InvalidRegistration : do/Cannot register
InvalidRegistration : exit/Abnormal termination

state "Login" as Login
Login : entry/Login
Login : do/Login using valid username and password
Login : exit/Watch Video / Upload Video

state "Upload Video" as UploadVideo
UploadVideo : entry/To home page
UploadVideo : do/Upload video after validating
UploadVideo : exit/View Video

state "Invalid login" as InvalidLogin
InvalidLogin : entry/Invalid login
InvalidLogin : do/Cannot login
InvalidLogin : exit/Abnormal termination

state "Watch Video" as WatchVideo
WatchVideo : entry/To home page
WatchVideo : do/Watch video after validating
WatchVideo : exit/Saved Video / Discussion Option

state "Saved Video" as SavedVideo
SavedVideo : entry/View saved videos
SavedVideo : do/View saved videos
SavedVideo : exit/Home Page

state "Discussion Option" as DiscussionOption
DiscussionOption : entry/To discussion option
DiscussionOption : do/Discussion option after validating
DiscussionOption : exit/Home Page

[*] --> CreateAccount
CreateAccount --> Login
Login --> WatchVideo
WatchVideo --> SavedVideo
WatchVideo --> DiscussionOption
UploadVideo --> WatchVideo
InvalidRegistration --> [*]
InvalidLogin --> [*]

@enduml
