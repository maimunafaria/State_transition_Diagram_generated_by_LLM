@startuml
title State machine for ATM Scenario 1

state "Idle" as Idle
state "Select Amount" as SelectAmount
state "Enter Custom Amount" as EnterCustomAmount
state "Cancel Transaction" as CancelTransaction
state "Complete Transaction" as CompleteTransaction

[*] --> Idle : /card inserted/

Idle --> SelectAmount : selectWithdrawalOption()
SelectAmount --> SelectAmount : selectPredefinedAmount()
SelectAmount --> EnterCustomAmount : enterCustomAmount()

EnterCustomAmount --> SelectAmount : cancelTransaction()
SelectAmount --> CancelTransaction : cancelTransaction()
CancelTransaction --> [*] : returnCard()

CompleteTransaction --> Idle : transactionCompleted()
Idle --> CompleteTransaction : startNewTransaction()

@enduml
