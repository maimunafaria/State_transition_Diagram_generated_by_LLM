@startuml
title E Ticketing For Bus - State Diagram

[*] --> CreateUserAccount

state "Create User Account" as CreateUserAccount
state "Validate Registration" as ValidateRegistration
state "Login Successful" as LoginSuccessful
state "Logged In" as LoggedIn
state "Check Ticket Status" as CheckTicketStatus
state "Book Ticket" as BookTicket
state "Confirm Payment" as ConfirmPayment
state "Manage Account Details" as ManageAccountDetails

CreateUserAccount --> ValidateRegistration : Registration Form Submitted
ValidateRegistration --> LoginSuccessful : Validation Successful
LoginSuccessful --> LoggedIn : Login Credentials Validated

LoggedIn --> CheckTicketStatus : User Requests Ticket Status
CheckTicketStatus --> BookTicket : User Wants to Book Ticket
BookTicket --> ConfirmPayment : Payment Initiated
ConfirmPayment --> ManageAccountDetails : Payment Confirmed

ManageAccountDetails --> Logout : User Completes Action
Logout --> [*] : User Logs Out

@enduml
