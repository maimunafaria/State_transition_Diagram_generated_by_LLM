@startuml
title Campaign Version 2 State Transition Diagram

[*] --> Idle

state Idle as I
state "Assign Manager and Staff" as AMS
state "Activate Campaign" as AC
state "Prepare Adverts" as PA
state "Approve and Schedule Adverts" as ASA
state "Run Adverts" as RA
state "Extend or Adjust Campaign" as EAC
state "Complete Campaign" as CC
state "Handle Payment" as HP
state "Archive Campaign" as AC

I --> AMS : Manager and Staff Assigned
AMS --> AC : Everything Approved and Contract Signed
AC --> PA : Activate Campaign
PA --> ASA : Prepare Adverts
ASA --> RA : Approve and Schedule Adverts
RA --> EAC : Run Adverts
EAC --> CC : Extend or Adjust Campaign
CC --> HP : Complete Campaign
HP --> AC : Handle Payment
AC --> AC : Mark as Paid
AC --> AC : Generate Refund if Amount Paid is Less than Required
AC --> AC : Wait for Correct Balance to be Settled if Amount Paid Exceeds Required Amount

EAC --> CC : Extend or Adjust Campaign
CC --> HP : Complete Campaign
HP --> AC : Handle Payment
AC --> AC : Mark as Paid
AC --> AC : Generate Refund if Amount Paid is Less than Required
AC --> AC : Wait for Correct Balance to be Settled if Amount Paid Exceeds Required Amount

RA --> CC : Run Adverts
CC --> HP : Complete Campaign
HP --> AC : Handle Payment
AC --> AC : Mark as Paid
AC --> AC : Generate Refund if Amount Paid is Less than Required
AC --> AC : Wait for Correct Balance to be Settled if Amount Paid Exceeds Required Amount

HP --> AC : Handle Payment
AC --> AC : Mark as Paid
AC --> AC : Generate Refund if Amount Paid is Less than Required
AC --> AC : Wait for Correct Balance to be Settled if Amount Paid Exceeds Required Amount

CC --> AC : Complete Campaign
AC --> AC : Mark as Paid
AC --> AC : Generate Refund if Amount Paid is Less than Required
AC --> AC : Wait for Correct Balance to be Settled if Amount Paid Exceeds Required Amount

HP --> AC : Handle Payment
