@startuml
title Website Development

[*] --> NavigationBar

state "Navigation Bar" as NavigationBar
state "Project Info" as ProjectInfo
state "Photo View" as PhotoView
state "Video View" as VideoView
state "Career Opportunities" as CareerOpportunities
state "Update View" as UpdateView
state "Application Form" as ApplicationForm

NavigationBar --> ProjectInfo : Select Project
ProjectInfo --> PhotoView : Choose Photos
ProjectInfo --> VideoView : Choose Videos
ProjectInfo --> NavigationBar : Back to Navigation Bar

PhotoView --> NavigationBar : Back to Navigation Bar
VideoView --> NavigationBar : Back to Navigation Bar

CareerOpportunities --> UpdateView : View Updates
CareerOpportunities --> ApplicationForm : Open Application Form

UpdateView --> NavigationBar : Back to Navigation Bar
ApplicationForm --> NavigationBar : Back to Navigation Bar

state "Job Application" as JobApplication

NavigationBar --> JobApplication : Submit Job Application
JobApplication --> [*] : Check Submitted Applications

@enduml
