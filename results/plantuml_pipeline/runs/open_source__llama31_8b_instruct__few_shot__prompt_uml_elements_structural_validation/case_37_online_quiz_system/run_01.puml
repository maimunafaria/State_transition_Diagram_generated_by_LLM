@startuml
title UML State Machine Diagram (Online Quiz System)

[*] --> UserType

state UserType <<choice>>
UserType --> Registration : [New user]
UserType --> Login : [Registered user]

state "Registration" as Registration {
    [*] --> GettingDetails

    state GettingDetails
    state ChoiceReg <<choice>>
    state "Update Database" as UpdateDB
    state EndInvalid <<choice>>

    GettingDetails --> ChoiceReg : [Registration verification]
    ChoiceReg --> UpdateDB : [valid]
    ChoiceReg --> EndInvalid : [invalid]

    EndInvalid --> [*]
}

Registration : entry / New user
Registration : do / Registration
Registration : exit / After updation

UpdateDB --> Login : [verified]

state Login
Login : do / Enter username and password
Login : exit / After verification

Login --> Profile : [valid uname & pwd]

state "Profile" as Profile {
    [*] --> ChoiceProfile

    state ChoiceProfile <<choice>>
    state "Teacher Home" as TeacherHome
    state "Student Home" as StudentHome

    ChoiceProfile --> TeacherHome : [teacher]
    ChoiceProfile --> StudentHome : [student]


}

Profile : entry / View or Edit profile
Profile : do / Upload or Accept request
Profile : do / Search users
Profile : do / View current deals
Profile : exit / Logout

TeacherHome --> CreateQuiz : [create new quiz]
CreateQuiz --> EditQuiz : [edit existing quiz]

state "Create Quiz" as CreateQuiz {
    [*] --> GettingDetails

    state GettingDetails
    state ChoiceReg <<choice>>
    state "Update Database" as UpdateDB
    state EndInvalid <<choice>>

    GettingDetails --> ChoiceReg : [Registration verification]
    ChoiceReg --> UpdateDB : [valid]
    ChoiceReg --> EndInvalid : [invalid]

    EndInvalid --> [*]
}

CreateQuiz : entry / New quiz
CreateQuiz : do / Registration
CreateQuiz : exit / After updation

UpdateDB --> PostQuiz : [verified]

state "Post Quiz" as PostQuiz {
    [*] --> GettingDetails

    state GettingDetails
    state ChoiceReg <<choice>>
    state "Update Database" as UpdateDB
    state EndInvalid <<choice>>

    GettingDetails --> ChoiceReg : [Registration verification]
    ChoiceReg --> UpdateDB : [valid]
    ChoiceReg --> EndInvalid : [invalid]

    EndInvalid --> [*]
}

PostQuiz : entry / New quiz
PostQuiz : do / Registration
PostQuiz : exit / After updation

TeacherHome --> ViewResults : [view results]

state "View Results" as ViewResults {
    [*] --> GettingDetails

    state GettingDetails
    state ChoiceReg <<choice>>
    state "Update Database" as UpdateDB
    state EndInvalid <<choice>>

    GettingDetails --> ChoiceReg : [Registration verification]
    ChoiceReg --> UpdateDB : [valid]
    ChoiceReg --> EndInvalid : [invalid]

    EndInvalid --> [*]
}

ViewResults : entry / View results
ViewResults : do / Registration
ViewResults : exit / After updation

StudentHome --> SelectQuiz : [select quiz]

state "Select Quiz" as SelectQuiz {
    [*] --> GettingDetails

    state GettingDetails
    state ChoiceReg <<choice>>
    state "Update Database" as UpdateDB
    state EndInvalid <<choice>>

    GettingDetails --> ChoiceReg : [Registration verification]
    ChoiceReg --> UpdateDB : [valid]
    ChoiceReg --> EndInvalid : [invalid]

    EndInvalid --> [*]
}

SelectQuiz : entry / Select quiz
SelectQuiz : do / Registration
SelectQuiz : exit / After updation

StudentHome --> AnswerQuiz : [answer quiz]

state "Answer Quiz" as AnswerQuiz {
    [*] --> GettingDetails

    state GettingDetails
    state ChoiceReg <<choice>>
    state "Update Database" as UpdateDB
    state EndInvalid <<choice>>

    GettingDetails --> ChoiceReg : [Registration verification]
    ChoiceReg --> UpdateDB : [valid]
    ChoiceReg --> EndInvalid : [invalid]

    EndInvalid --> [*]
}

AnswerQuiz : entry / Answer quiz
AnswerQuiz : do / Registration
AnswerQuiz : exit / After updation

StudentHome --> ViewResult : [view result]

state "View Result" as ViewResult {
    [*] --> GettingDetails

    state GettingDetails
    state ChoiceReg <<choice>>
    state "Update Database" as UpdateDB
    state EndInvalid <<choice>>

    GettingDetails --> ChoiceReg : [Registration verification]
    ChoiceReg --> UpdateDB : [valid]
    ChoiceReg --> EndInvalid : [invalid]

    EndInvalid --> [*]
}

ViewResult : entry / View result
ViewResult : do / Registration
ViewResult : exit / After updation

@enduml
