@startuml
[*] --> LoggedIn

state LoggedIn {
  Dashboard --> LoggedIn : open settings or book ticket
  Dashboard :bookTicket--> PaymentConfirmation : payment confirmed
  PaymentConfirmation --> OrderCompleted : order completed
  OrderCompleted --> LoggedIn : logout
  LoggedIn :settings--> Dashboard : back
}

LoggedIn --> [*] : logout
@enduml
