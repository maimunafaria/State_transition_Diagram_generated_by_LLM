@startuml
title Weather Monitoring System - UML State Machine Diagram

[*] --> Login

state "User Registration" as UserRegistration
UserRegistration : entry / enter registration details
UserRegistration : do / verify registration
UserRegistration : exit / login if successful

state "Login" as Login
Login : entry / enter username and password
Login : do / verify credentials
Login : exit / access system if valid
Login : exit / display error message if invalid

state "Location Selection" as LocationSelection
LocationSelection : entry / select location
LocationSelection : do / validate entered location
LocationSelection : exit / show weather information if valid
LocationSelection : exit / display error message if invalid

state "Weather Information Selection" as WeatherInformationSelection
WeatherInformationSelection : entry / choose what to check
WeatherInformationSelection : do / update and show selected weather information
WeatherInformationSelection : exit / allow viewing additional details

state "Logout" as Logout
Logout : entry / log out of system
Logout : exit / end session

Login --> LocationSelection
LocationSelection --> WeatherInformationSelection
WeatherInformationSelection --> Logout

@enduml
