@startuml

state "User Registration" as UserRegistration
UserRegistration : entry / fill in required details
UserRegistration : do / create account
UserRegistration : exit / login

state "Login" as Login
Login : entry / registered user
Login : do / enter login credentials
Login : exit / logged in

state "Apply for Visa" as ApplyVisa
ApplyVisa : entry / logged in
ApplyVisa : do / apply, make payment, application accepted
ApplyVisa : exit / application submitted

state "View Status" as ViewStatus
ViewStatus : entry / applied for visa
ViewStatus : do / view status
ViewStatus : exit / check status

state "Check Status" as CheckStatus
CheckStatus : entry / viewed status
CheckStatus : do / check status
CheckStatus : exit / update status

state "Cancel Application" as CancelApplication
CancelApplication : entry / logged in
CancelApplication : do / cancel application
CancelApplication : exit / application cancelled

state "Modify Details" as ModifyDetails
ModifyDetails : entry / logged in
ModifyDetails : do / modify details
ModifyDetails : exit / updated details

state "View Details" as ViewDetails
ViewDetails : entry / logged in
ViewDetails : do / view details
ViewDetails : exit / view own details

state "View Purpose" as ViewPurpose
ViewPurpose : entry / logged in
ViewPurpose : do / view purpose of application
ViewPurpose : exit / status updated

state "Give Feedback" as GiveFeedback
GiveFeedback : entry / checked status
GiveFeedback : do / give feedback
GiveFeedback : exit / end

Login --> ApplyVisa
ApplyVisa --> ViewStatus
ViewStatus --> CheckStatus
CheckStatus --> Login
CancelApplication --> Login
ModifyDetails --> Login
ViewDetails --> Login
ViewPurpose --> Login
GiveFeedback --> Login
Login --> Logout

@enduml
