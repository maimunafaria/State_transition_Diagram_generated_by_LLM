@startuml
state WaitingForInput {
  [*] --> WaitingForInput : PowerOn
}

WaitingForInput --> FullPower : HalfPowerSelected
WaitingForInput --> HalfPower : FullPowerSelected

WaitingForInput --> SettingTime {
  state SettingTime
  Note right of SettingTime: Enter a number for cooking time
  SettingTime --> WaitingForInput : TimeSet
}

WaitingForInput --> Inactive : DoorOpenDuringOperation

Inactive --> Stopped : DoorOpenedDuringCooking
Stopped --> WaitingForInput : CancelCooking

@enduml
