@startuml
title Healthcare Portal State Machine Diagram

state NewUserRegistration
state FailedRegistration
state SignedIn
state LoggedOut
state FacilityAccess
state NewsContent
state HealthInformation
state ResultViewed
state InsuranceProcessing
state DoctorConsultationPayment
state DrugPurchasePayment
state FeedbackCollection
state PaymentDetails
state CompletedSession

[*] --> NewUserRegistration
NewUserRegistration --> SignedIn : registration successful
NewUserRegistration --> FailedRegistration : registration failed
FailedRegistration --> [*]
SignedIn --> FacilityAccess
FacilityAccess --> LoggedOut
NewsContent --> LoggedOut
HealthInformation --> ResultViewed
ResultViewed --> LoggedOut
InsuranceProcessing --> DoctorConsultationPayment
DoctorConsultationPayment --> PaymentDetails : payment confirmed
PaymentDetails --> CompletedSession
DrugPurchasePayment --> PaymentDetails : payment confirmed
PaymentDetails --> CompletedSession
FeedbackCollection --> CompletedSession
LoggedOut --> NewUserRegistration
@enduml
