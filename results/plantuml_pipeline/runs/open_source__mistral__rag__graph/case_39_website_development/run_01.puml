@startuml
title UML State Machine Diagram - Website Development

[*] --> NavigationBar

state "Homepage" as Homepage
state "Project Information" as ProjectInformation
state "Media Selection" as MediaSelection
state "Career Opportunities" as CareerOpportunities
state "Application Type Selection" as ApplicationTypeSelection
state "Job Applications Checked" as JobApplicationsChecked

NavigationBar --> Homepage
Homepage --> [*] : user navigates
Homepage --> ProjectInformation : user selects project
ProjectInformation --> MediaSelection : user chooses media type
MediaSelection --> [*] : user views photos or videos
CareerOpportunities --> ApplicationTypeSelection : user selects career opportunity
ApplicationTypeSelection --> [*] : user views updates or opens application form
JobApplicationsChecked --> [*] : submitted applications checked
@enduml
