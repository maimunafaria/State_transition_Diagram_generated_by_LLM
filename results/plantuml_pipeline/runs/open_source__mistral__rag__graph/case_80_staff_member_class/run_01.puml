@startuml
state AssignedToClient {
  state Unassigned
  state Assigned

  [*] --> AssignedToClient[*] : assignStaff

  Unassigned --> Assigned : clientOrCampaignAssigned
  Assigned --> Unassigned : removeAssignment
}

state Unemployed {
  state Employed

  Employed --> Unemployed : leaveJob
}

state Archived {
  state NotArchived

  Unemployed --> Archived : timePassed
  Archived --> [*] : [*]
}

AssignedToClient --> Unemployed : unemployedStatusSet
Unemployed --> AssignedToClient : rehire
@enduml
