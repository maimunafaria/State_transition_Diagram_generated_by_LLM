@startuml
title Online Quiz System - State Diagram

state "Not Logged In" as NotLoggedIn
state "Logged In as Student" as Student
state "Logged In as Teacher" as Teacher
state "Creating Quiz" as CreatingQuiz
state "Editing Quiz" as EditingQuiz
state "Saving Draft" as SavingDraft
state "Posting Quiz" as PostingQuiz
state "Taking Quiz" as TakingQuiz
state "Submitting Quiz" as SubmittingQuiz
state "Viewing Results" as ViewingResults

NotLoggedIn --> "Logged In as Student" : login as student
NotLoggedIn --> "Logged In as Teacher" : login as teacher

"Logged In as Student" --> NotLoggedIn : logout
"Logged In as Teacher" --> NotLoggedIn : logout

"Logged In as Student" --> TakingQuiz : selectQuiz
"Logged In as Teacher" --> CreatingQuiz : createNewQuiz
"Logged In as Teacher" : editExistingQuiz --> EditingQuiz
"Logged In as Teacher" : saveDraft --> SavingDraft
"Logged In as Teacher" : postQuiz --> PostingQuiz
"Logged In as Student" : submitQuiz --> SubmittingQuiz
"Logged In as Teacher" : viewResults --> ViewingResults

CreatingQuiz --> "Logged In as Teacher" : finishCreation
EditingQuiz --> "Logged In as Teacher" : finishEditing
SavingDraft --> "Logged In as Teacher" : saveSuccessful
PostingQuiz --> "Logged In as Teacher" : postSuccessful
SubmittingQuiz --> "Logged In as Student" : submitSuccessful
ViewingResults --> "Logged In as Teacher" : viewResultsSuccessful
@enduml
