@startuml
title Safehome Security Function State Machine Diagram

state PowerOnCheck
PowerOnCheck --> ReadyToUse : everything_fine
PowerOnCheck --> Stopped : problem_during_startup

state ReadyToUse
ReadyToUse --> Activated : user_activates
ReadyToUse --> Reset : user_resets
ReadyToUse --> Off : user_turns_off

state Activated
Activated --> Monitoring : user_activates

state Monitoring
Monitoring --> Alarm : sensor_triggered
Monitoring --> ContinueMonitoring : false_alarm_or_time_ends

state Alarm
Alarm --> Normal : user_enters_password

@enduml
