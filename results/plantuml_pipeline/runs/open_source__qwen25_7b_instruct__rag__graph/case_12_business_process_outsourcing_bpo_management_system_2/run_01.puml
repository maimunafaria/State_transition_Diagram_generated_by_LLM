@startuml
title UML State Machine Diagram - BPO Management System

[*] --> SearchByCategory

state "Search by category" as SearchByCategory
state "Search by price range" as SearchByPriceRange
state "Display matching users" as DisplayMatchingUsers

SearchByCategory --> SearchByPriceRange : select price range
SearchByPriceRange --> DisplayMatchingUsers : apply filters
DisplayMatchingUsers --> [*]

@enduml
