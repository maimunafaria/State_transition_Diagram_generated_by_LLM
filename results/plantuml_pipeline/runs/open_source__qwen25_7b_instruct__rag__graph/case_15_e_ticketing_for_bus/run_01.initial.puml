@startuml
[*] --> CreateAccount

state "Waiting for Account Validation" as ValidateAccount

CreateAccount --> ValidateAccount : user submits registration details
ValidateAccount --> LoggedIn : validation successful
LoggedIn --> CheckTicketStatus : check ticket status
LoggedIn --> BookTicket : book a ticket
BookTicket --> PaymentConfirmed : payment confirmed
PaymentConfirmed --> TicketBooked : ticket booked successfully
TicketBooked --> [*] : logout

state "Edit Account Details" as EditAccountDetails
state "Delete Account" as DeleteAccount

LoggedIn --> EditAccountDetails : edit account details
EditAccountDetails --> LoggedIn : update successful
LoggedIn --> DeleteAccount : delete account
DeleteAccount --> [*] : account deleted

@enduml
