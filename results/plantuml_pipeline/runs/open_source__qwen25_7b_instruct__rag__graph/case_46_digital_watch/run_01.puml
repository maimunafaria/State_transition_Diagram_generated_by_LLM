@startuml
[*] --> TimeSettings

state TimeSettings {
  [*] --> AdjustHour : press button
  AdjustHour --> AdjustMinute : press button
  AdjustHour --> AlarmHour : press button
  AdjustMinute --> AlarmMinute : press button
}

state AlarmSettings {
  [*] --> OnOff : press button
  OnOff --> Triggered : current time matches alarm time
  Triggered --> Stopped : press stop button
}

state LightSettings {
  [*] --> On : press button
  On --> Off : release button
}
@enduml
