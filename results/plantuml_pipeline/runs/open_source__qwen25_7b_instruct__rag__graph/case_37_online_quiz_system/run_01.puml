@startuml
title Online Quiz System - State Diagram

[*] --> Idle

state "Idle" as Idle {
    state "Login" as Login
    state "Teacher Mode" as TeacherMode
    state "Student Mode" as StudentMode

    Login --> [*] : logout
    Login --> TeacherMode : login as teacher
    Login --> StudentMode : login as student
}

TeacherMode --> [*] : logout

state "Teacher Mode" {
    state "Create Quiz" as CreateQuiz
    state "Edit Quiz" as EditQuiz
    state "Save Draft" as SaveDraft
    state "Post Quiz" as PostQuiz
    state "View Results" as ViewResults

    TeacherMode --> CreateQuiz : create quiz
    CreateQuiz --> [*] : cancel
    CreateQuiz --> EditQuiz : edit quiz
    EditQuiz --> [*] : cancel
    EditQuiz --> SaveDraft : save draft
    SaveDraft --> [*] : cancel
    SaveDraft --> PostQuiz : post quiz
    PostQuiz --> ViewResults : view results
}

StudentMode --> [*] : logout

state "Student Mode" {
    state "Select Quiz" as SelectQuiz
    state "Answer Quiz" as AnswerQuiz
    state "Submit Quiz" as SubmitQuiz
    state "View Result" as ViewResult

    StudentMode --> SelectQuiz : select quiz
    SelectQuiz --> [*] : cancel
    SelectQuiz --> AnswerQuiz : start answering
    AnswerQuiz --> [*] : cancel
    AnswerQuiz --> SubmitQuiz : submit quiz
    SubmitQuiz --> ViewResult : view result
}

@enduml
