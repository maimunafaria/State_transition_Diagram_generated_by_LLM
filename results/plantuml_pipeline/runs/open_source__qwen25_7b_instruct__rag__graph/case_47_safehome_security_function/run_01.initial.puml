@startuml
[*] --> PowerOnCheck

state PowerOnCheck {
  [*] --> StartupProblem : problem detected
  [*] --> ReadyToUse : everything fine
}

ReadyToUse --> ResetAllowed : reset button pressed
ReadyToUse --> ActivateAllowed : activate button pressed
ReadyToUse --> TurnOffAllowed : turn off button pressed
ActivateAllowed --> MonitoringStart : activation confirmed

state Monitoring {
  [*] --> AlarmTriggered : sensor triggered
  AlarmTriggered --> AlertSent : send alerts
  AlarmTriggered --> ContinueMonitoring : false alarm or time ends
}

ContinueMonitoring --> ReadyToUse : continue monitoring
TurnOffAllowed --> ReadyToUse : password entered
@enduml
