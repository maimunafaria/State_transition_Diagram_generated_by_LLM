@startuml
[*] --> Idle
state "Idle" as Idle
Idle : entry / initial state
Idle --> LoggedIn : login successful
LoggedIn : do / user provide Login Details
LoggedIn : exit / login Successful

state "LoggedIn" as LoggedIn
LoggedIn : entry / user logged in
LoggedIn --> ApplyingForVisa : apply for visa
LoggedIn --> ViewingDetails : view details
LoggedIn --> ModifyingDetails : modify details
LoggedIn --> CheckingStatus : check status
LoggedIn --> GivingFeedback : give feedback
LoggedIn --> LoggingOut : logout

state "ApplyingForVisa" as ApplyingForVisa
ApplyingForVisa : entry / user applies for visa
ApplyingForVisa : do / make payment and accept application
ApplyingForVisa : exit / application accepted

state "ViewingDetails" as ViewingDetails
ViewingDetails : entry / user views details
ViewingDetails : do / view personal information
ViewingDetails : exit / details viewed

state "ModifyingDetails" as ModifyingDetails
ModifyingDetails : entry / user modifies details
ModifyingDetails : do / update personal information
ModifyingDetails : exit / details modified

state "CheckingStatus" as CheckingStatus
CheckingStatus : entry / user checks status
CheckingStatus : do / view application status
CheckingStatus : exit / status checked

state "GivingFeedback" as GivingFeedback
GivingFeedback : entry / user gives feedback
GivingFeedback : do / provide feedback on application
GivingFeedback : exit / feedback given

state "LoggingOut" as LoggingOut
LoggingOut : entry / user logs out
LoggingOut : do / logout from system
LoggingOut : exit / logged out

ApplyingForVisa --> CheckingStatus : view status after applying
CheckingStatus --> ApplyingForVisa : reapply or check again
ModifyingDetails --> ViewingDetails : view details after modification
ViewingDetails --> ModifyingDetails : modify details after viewing
GivingFeedback --> Idle : feedback given, return to idle state

state "CanceledApplication" as CanceledApplication
CanceledApplication : entry / application canceled
CanceledApplication : do / cancel application
CanceledApplication : exit / application cancelled

LoggedIn --> CanceledApplication : cancel application

Idle --> [*]
@enduml
