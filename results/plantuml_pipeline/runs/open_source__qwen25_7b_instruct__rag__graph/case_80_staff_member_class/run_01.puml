@startuml
title State Machine for Staff Member Class

[*] --> Assigned

state Assigned {
  [*] --> Assigned : assignToClientOrCampaign
}

Assigned --> Unassigned : removeAssignment
Unassigned --> Assigned : reassign

state Assigned {
  [*] --> Assigned : switchAssignmentsDuringWorkPeriod
}

Assigned --> Unemployed : markAsUnemployedWhenLeavesJob
Unemployed --> Archived : archiveRecordAfterTimePasses

@enduml
