@startuml
title ATM Scenario 1 — Polished Requirement Specification

[*] --> ChooseAmount : Card Inserted / Get Amount Option

state "Choose Amount" as ChooseAmount
state PredefinedAmounts as "Predefined\nAmounts"
state CustomAmount as "Custom\nAmount"

ChooseAmount --> PredefinedAmounts : Select Predefined Amount
ChooseAmount --> CustomAmount : Enter Custom Amount

state Transaction as "Transaction in Progress"
state Cancelled as "Cancelled"

PredefinedAmounts --> Transaction : Amount Selected / Process Withdrawal
CustomAmount --> Transaction : Amount Entered / Process Withdrawal

Transaction --> CancelTransaction : Cancel Transaction / Stop Transaction
Transaction --> ReturnCard : Transaction Completed / Return Card

CancelTransaction --> Cancelled : User Cancels / Stop Transaction and Return Card
Cancelled --> [*] : Return Card

@enduml
