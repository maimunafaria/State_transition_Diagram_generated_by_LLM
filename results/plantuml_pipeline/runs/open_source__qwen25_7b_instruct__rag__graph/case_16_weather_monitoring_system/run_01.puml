@startuml
title UML State Chart Diagram


state "Idle" as Idle
Idle : entry / initial state

state "Registration" as Registration
Registration : entry / enter username, password
Registration : do / verify credentials
Registration : exit / account created or not successful

state "Login" as Login
Login : entry / enter username, password
Login : do / verify credentials
Login : exit / logged in or not successful

state "Weather Checking" as WeatherChecking
WeatherChecking : entry / check weather for location
WeatherChecking : do / validate location
WeatherChecking : exit / show weather information

state "Location Selection" as LocationSelection
LocationSelection : entry / select location
LocationSelection : do / choose weather parameter
LocationSelection : exit / display selected weather

state "Additional Details" as AdditionalDetails
AdditionalDetails : entry / view additional details
AdditionalDetails : do / provide details
AdditionalDetails : exit / session ended

state "LoggedOut" as LoggedOut
LoggedOut : entry / logout action
LoggedOut : do / end session
LoggedOut : exit / final state


[*] --> Registration
Registration --> Login : login successful
Login --> WeatherChecking : location entered
WeatherChecking --> LocationSelection : parameter selected
LocationSelection --> AdditionalDetails : details requested
AdditionalDetails --> LoggedOut : logged out

Login --> [*] : login unsuccessful
Registration --> [*] : registration unsuccessful
WeatherChecking --> [*] : invalid location
LocationSelection --> [*] : no parameter selected
AdditionalDetails --> [*] : session ended

@enduml
