@startuml

[*] --> WaitingForSale
state "Adding Items" as AddingItems <<choice>>
state "Payment Processing" as PaymentProcessing <<choice>>
state SaleCompleted as CompletedSale

WaitingForSale --> AddingItems : item selected
AddingItems --> PaymentProcessing : all items added
PaymentProcessing --> SaleCompleted : payment method chosen
PaymentProcessing --> SaleCompleted : payment verified and approved

SaleCompleted --> WaitingForSale : sale finished

@enduml
