@startuml
[*] --> HomePage

state "HomePage" as HomePage
state "ProjectsPage" as ProjectsPage
state "CareerOpportunitiesPage" as CareerOpportunitiesPage
state "JobApplicationPage" as JobApplicationPage

HomePage --> ProjectsPage : select projects
ProjectsPage --> PhotosVideos : choose photos or videos
PhotosVideos --> ProjectsPage : back to projects page
ProjectsPage --> CareerOpportunitiesPage : select career opportunities
CareerOpportunitiesPage --> UpdatesForm : choose updates or form
UpdatesForm --> CareerOpportunitiesPage : back to career opportunities page

CareerOpportunitiesPage --> JobApplicationPage : submit application
JobApplicationPage --> [*] : check submitted job applications
@enduml
