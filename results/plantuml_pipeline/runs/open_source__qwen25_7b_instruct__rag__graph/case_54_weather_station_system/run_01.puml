@startuml
title Weather Station System State Diagram

[*] --> Idle

state Idle as "Running"
state ConfigMode as "Configuring"
state DataCollection as "Collecting Data"
state SummaryPreparation as "Preparing Summary"
state StatusChecking as "Checking Status"
state ControlledMode as "Controlled Mode"

Idle --> ConfigMode : enter config mode
ConfigMode --> Idle : config complete

Idle --> DataCollection : clock trigger
DataCollection --> Idle : activity complete

Idle --> SummaryPreparation : request summary
SummaryPreparation --> Idle : activity complete

Idle --> StatusChecking : request status
StatusChecking --> Idle : activity complete

Idle --> ControlledMode : remote control
ControlledMode --> Idle : exit controlled mode

ConfigMode --> [*] : shutdown command

@enduml
