@startuml
title UML State Machine Diagram (Alert Notifier)

[*] --> Initialization

state Initialization <<choice>>
Initialization --> WaitingMode : [Initialization successful]
Initialization --> UnloadingPhase : [Initialization fails]

state WaitingMode
WaitingMode --> ProcessUpdate : [Detected update]
ProcessUpdate --> NotifyOperators : [Conditions met for notification]
NotifyOperators --> ReturnToWait : [After processing an update]
ReturnToWait --> WaitingMode

state UnloadingPhase <<entry/Unloading phase>>
UnloadFailure --> UnloadingPhase : [System is shutting down while running]

state SuccessState
SuccessState --> [*] : [Unloading complete]

state FailureState
FailureState --> [*] : [Unloading complete]

state End
@enduml
