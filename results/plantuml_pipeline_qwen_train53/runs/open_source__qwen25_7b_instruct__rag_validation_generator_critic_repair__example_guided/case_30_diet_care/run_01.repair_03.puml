@startuml
title UML State Machine Diagram (Diet Care System)

[*] --> ChoiceEntryOrConsult

state ChoiceEntryOrConsult <<choice>>
ChoiceEntryOrConsult --> UserEntry : [Enter information]
ChoiceEntryOrConsult --> ConsultNutritionist : [Consult nutritionist]

state UserEntry
UserEntry --> AnalyzeInfo : [Analyze entered info]
AnalyzeInfo --> UnhealthyDiet : [Unhealthy diet detected]
AnalyzeInfo --> HealthyDiet : [Healthy diet detected]
AnalyzeInfo --> DiseaseDeficiency : [Disease or deficiency detected]

state ConsultNutritionist
ConsultNutritionist --> SpeakWithNutritionist : [Speak with nutritionist]
SpeakWithNutritionist --> RateExperience : [Rate experience after consultation]
RateExperience --> End

state UnhealthyDiet
UnhealthyDiet --> ProvideSuggestions : [Provide food suggestions]

state HealthyDiet
HealthyDiet --> AppreciateUser : [Appreciate user for healthy diet]

state DiseaseDeficiency
DiseaseDeficiency --> ProvideMedicalSuggestions : [Provide medical food suggestions]

state End <<final>>
AnalyzeInfo --> End : [End]
SpeakWithNutritionist --> End : [End]
ProvideSuggestions --> End : [End]
ProvideMedicalSuggestions --> End : [End]
AppreciateUser --> End : [End]

@enduml
