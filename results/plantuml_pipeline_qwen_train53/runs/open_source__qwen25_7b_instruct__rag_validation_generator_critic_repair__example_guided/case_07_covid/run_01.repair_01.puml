@startuml
title UML State Machine Diagram - Vehicle Tracking System

[*] --> Start : initial

state "Start" as Start
state "Select Amount" as SelectAmount
state "Enter Custom Amount" as EnterCustomAmount
state "Verify Transaction" as VerifyTransaction
state "Re-enter Amount" as ReEnterAmount
state "Transaction Successful" as TransactionSuccessful
state "Transaction Rejected" as TransactionRejected

Start --> SelectAmount : [select amount from list]

SelectAmount --> EnterCustomAmount : [enter custom value]
SelectAmount --> VerifyTransaction : [amount selected]

state "Verify Transaction" <<choice>>

VerifyTransaction --> TransactionSuccessful : [valid transaction]
VerifyTransaction --> TransactionRejected : [invalid transaction]

TransactionRejected --> ReEnterAmount

ReEnterAmount --> SelectAmount : [re-enter amount]

TransactionSuccessful --> End : [end transaction]

@enduml
