@startuml
title UML State Machine Diagram

[*] --> CreateAccount : "Create an account"

state CreateAccount
    CreateAccount --> SignedIn : "Sign in with correct username and password"
SignedIn <<choice>>
    SignedIn --> ReadBlogs : [valid] "Read blogs shared by recovered patients"
    SignedIn --> UpdateInfectedPeople : [valid] "Update number of infected people"
    SignedIn --> ShareInfo : [valid] "Share information from home quarantine"
    SignedIn --> ViewMedicalShops : [valid] "View nearby medical shops and purchase medicines"
    SignedIn --> AssignCleaners : [valid] "Assign workers to clean an area"
SignedIn --> SignedIn : [invalid] "Invalid action"

[*] --> CreateAccount : "Create an account"
[*] --> SignedIn : "Sign in with correct username and password"

state Completion
    SignedIn --> Completion : "Completion"

@enduml
