@startuml
title UML State Machine Diagram

[*] --> PendingReview

state PendingReview
state Approved
state Rejected
state Finalized

PendingReview --> Approved : "After review, application is approved"
PendingReview --> Rejected : "After review, application is rejected"

Approved --> Finalized : "Finalize process after approval"
Rejected --> Finalized : "Finalize process after rejection"

@enduml
