@startuml
title UML State Machine Diagram

[*] --> CreateAccount : "Create an account"
CreateAccount --> SignedIn : "Sign in with correct username and password"

SignedIn --> ReadBlogs : "Read blogs shared by recovered patients"
SignedIn --> UpdateInfectedPeople : "Update number of infected people"
SignedIn --> ShareInfo : "Share information from home quarantine"
SignedIn --> ViewMedicalShops : "View nearby medical shops and purchase medicines"
SignedIn --> AssignCleaners : "Assign workers to clean an area"

ReadBlogs --> [*] : BlogsRead
UpdateInfectedPeople --> [*] : InfectedUpdated
ShareInfo --> [*] : InfoShared
ViewMedicalShops --> [*] : ShopsVisited
AssignCleaners --> [*] : CleanersAssigned

state StartChoice <<choice>>
CreateAccount --> StartChoice : "Start"
StartChoice --> 1: [valid]
StartChoice --> 2: [invalid]

state UserChoice <<choice>>
SignedIn --> UserChoice : "User choice"
UserChoice --> ReadBlogs : [ReadBlogsAllowed]
UserChoice --> UpdateInfectedPeople : [UpdateAllowed]
UserChoice --> ShareInfo : [ShareAllowed]
UserChoice --> ViewMedicalShops : [ViewAllowed]
UserChoice --> AssignCleaners : [AssignAllowed]

@enduml
