@startuml
[*] --> InitializationFailed
[*] --> Initialized

Initialized --> WaitingForUpdates
WaitingForUpdates --> ProcessingUpdate : detect update
ProcessingUpdate --> NotifyingOperators : notify operators
NotifyingOperators --> WaitingForUpdates : done notifying

InitializationFailed --> UnloadingOnFailure
UnloadingOnFailure --> CleanupComplete
CleanupComplete --> [*]

LoadingFailed --> FailureState
FailureState --> [*]
@enduml
