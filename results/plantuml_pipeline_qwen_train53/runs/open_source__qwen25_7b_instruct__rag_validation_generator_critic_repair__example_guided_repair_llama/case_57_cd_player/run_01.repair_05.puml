@startuml
title Cd Player State Machine

[*] --> Stopped : system startup

state Stopped {
  entry / start state
  do / remain in same state
  exit / no disc inserted
}

Stopped --> Playing : insert disc / press play
Playing --> Paused : press pause
Paused --> Playing : press resume
Playing --> Stopped : press stop
Pausing --> Resuming : press resume
Resuming --> Playing : continue playing

Stopped --> Stopped : no more discs

@enduml
