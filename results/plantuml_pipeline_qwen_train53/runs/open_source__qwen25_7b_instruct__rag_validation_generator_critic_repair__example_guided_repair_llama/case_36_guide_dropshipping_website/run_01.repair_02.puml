@startuml

[*] --> Login

state "Login" as L1
L1 -->|1| SellerRegistration : [seller]
L1 -->|2| CustomerRegistration : [customer]

state "Seller Registration" as S1
S1 -->|3| WorkspaceAccess : [complete registration and verification]

state "Customer Registration" as C1
C1 -->|4| DashboardAccess : [complete registration and verification]

state "Workspace Access" as W1
W1 -->|5| AddProducts : [add new products]
W1 -->|6| PromoteProducts : [promote existing products]
W1 -->|7| CommunicateWithCustomers : [communicate with customers]
W1 -->|8| Logout : [log out]
W1 --> [*] : [end access]

state "Dashboard Access" as D1
D1 -->|9| ExploreProducts : [explore products]
D1 -->|10| ViewAvailableProducts : [view available products]
D1 -->|11| BrowseAndPurchase : [browse and purchase]

state "Add Products" as AP
AP --> W1

state "Promote Products" as PP
PP --> W1

state "Communicate With Customers" as CC
CC --> W1

state "Logout" as L2
L2 --> W1

state "Explore Products" as EP
EP --> D1

state "View Available Products" as VAP
VAP --> D1

state "Browse And Purchase" as BAP
BAP --> D1

[*] -->|12| Login : [initial login]

Login -->|1| SellerRegistration : [seller]
Login -->|2| CustomerRegistration : [customer]

SellerRegistration -->|3| WorkspaceAccess : [complete registration and verification]

CustomerRegistration -->|4| DashboardAccess : [complete registration and verification]

WorkspaceAccess -->|5| AddProducts : [add new products]
WorkspaceAccess -->|6| PromoteProducts : [promote existing products]
WorkspaceAccess -->|7| CommunicateWithCustomers : [communicate with customers]
WorkspaceAccess -->|8| Logout : [log out]
WorkspaceAccess --> [*] : [end access]

DashboardAccess -->|9| ExploreProducts : [explore products]
DashboardAccess -->|10| ViewAvailableProducts : [view available products]
DashboardAccess -->|11| BrowseAndPurchase : [browse and purchase]

AddProducts --> WorkspaceAccess

PromoteProducts --> WorkspaceAccess

CommunicateWithCustomers --> WorkspaceAccess

Logout --> WorkspaceAccess

ExploreProducts --> DashboardAccess

ViewAvailableProducts --> DashboardAccess

BrowseAndPurchase --> DashboardAccess

@enduml
