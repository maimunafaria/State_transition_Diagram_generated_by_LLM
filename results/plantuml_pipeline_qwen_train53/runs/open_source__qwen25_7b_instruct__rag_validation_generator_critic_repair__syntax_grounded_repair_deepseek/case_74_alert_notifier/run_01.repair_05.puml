@startuml
[*] --> Initializing
Initializing -> Waiting : success
Initializing -> Unloading : failure

Waiting -> Processing : detect update
Processing -> Notifying : significant change
Notifying -> Waiting : notify operators
Processing -> Waiting : no significant change

UnloadRequested --> Unloading
Unloading -> CleaningUp
CleaningUp -> Terminated
Terminated --> [*] : completion

Waiting -> Unloading : shutdown
@enduml
