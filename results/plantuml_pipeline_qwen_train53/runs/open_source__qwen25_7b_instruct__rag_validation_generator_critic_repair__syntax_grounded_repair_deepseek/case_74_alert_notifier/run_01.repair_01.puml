@startuml
title UML State Machine Diagram (Alert Notifier)

[*] --> Initialization

state Initialization <<choice>>
Initialization --> WaitingMode : [Initialization successful]
Initialization --> UnloadingPhase : [Initialization fails]

state WaitingMode
WaitingMode --> ProcessUpdate : [Detected update]
ProcessUpdate --> NotifyOperators : [Conditions met for notification]
NotifyOperators --> WaitingMode : [After processing an update]

state UnloadingPhase <<choice>>
UnloadFailure --> CleanupOperations : [Condition met for cleanup]
UnloadFailure --> EndState : [Condition not met]

state CleanupOperations
CleanupOperations --> EndState : [Cleanup complete]

state EndState
EndState --> [*] : [Termination event]

state FailureState
FailureState --> EndState : [Unloading complete]

@enduml
