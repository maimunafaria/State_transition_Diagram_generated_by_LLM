@startuml
[*] --> UserSelection
UserSelection -> Seller : chooseSeller
UserSelection -> Customer : chooseCustomer

Seller:
    Seller -> ProductManagement : addProduct
    Seller -> ProductManagement : removeProduct
    Seller -> FinalizeOffering : finalize

ProductManagement:
    ProductManagement -> Seller : back
    ProductManagement -> FinalizeOffering : done

FinalizeOffering --> ProductAvailability

Customer:
    Customer -> ProductViewing : viewProducts

ProductViewing:
    ProductViewing -> Customer : back
    ProductViewing -> SelectItem : select

SelectItem:
    SelectItem --> Communication : discuss

Communication:
    Communication --> PurchaseCompletion : deal
    Communication --> NoDeal : noDeal

PurchaseCompletion:
    PurchaseCompletion --> Payment : pay

Payment:
    Payment --> Feedback : complete

Feedback --> [*] : finish

NoDeal --> [*] : end
@enduml
