@startuml
[*] --> INITIAL_STATE

INITIAL_STATE -> {Seller | Customer} : Choose role

{Seller}:
    rectangle Seller {
        add product
        remove product
        finalize offerings
    }
    Seller -[>->] add product
    add product --> view products
    view products --> [finalize offerings]
    finalize offerings --> [*]

{Customer}:
    rectangle Customer {
        view products
        select item
        discuss deal
        make payment
        provide feedback
    }
    Customer -[>->] view products
    view products --> [select item]
    select item --> [discuss deal]
    discuss deal --> [make payment]
    make payment --> [provide feedback]
    provide feedback --> [*]

[*]
@enduml
