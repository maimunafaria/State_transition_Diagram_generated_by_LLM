@startuml
[*] --> Start
Start -> UserSelection : "Select Role"
UserSelection -> Seller : "Choose Seller"
UserSelection -> Customer : "Choose Customer"

Seller -> ProductManagement : "Manage Products"
ProductManagement -> Communication : "Finalize Offerings"
ProductManagement -> ProductManagement : "Add/Remove Products" loop

Customer -> ProductViewing : "View Products"
ProductViewing -> Communication : "Select Product"
ProductViewing -> ProductViewing : "No Selection" loop

Communication -> PurchaseCompletion : "Deal Reached"
Communication -> ProductViewing : "No Deal"

PurchaseCompletion -> PaymentProcessing : "Confirm Purchase"
PaymentProcessing -> Feedback : "Make Payment"

Feedback --> [*] : "Provide Feedback"

Communication -> End : "End Interaction"
ProductManagement -> End : "End Interaction"
ProductViewing -> End : "End Interaction"
@enduml
