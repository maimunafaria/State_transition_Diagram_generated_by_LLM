@startuml
title UML State Chart Diagram

[*] --> ReadyForActivation

ReadyForActivation --> Activated : managerAssigned and staffAssigned and approved and contractSigned

Activated --> Surveying : surveysCarriedOutAndEvaluated
Activated --> AdvertsPreparation : prepareAdverts
Activated --> AdvertsApproval : approveAdverts
Activated --> AdvertsScheduling : scheduleAdverts
Activated --> AdvertsRunning : runAdverts
Activated --> Adjustments : adjustCampaign
Activated --> Paused : pauseCampaign
Activated --> CostsCalculation : calculateCosts
Activated --> FinalStatementPreparation : prepareFinalStatement
Activated --> Completed : allWorkFinished

Completed --> StatementPreparation : completeCampaign

StatementPreparation --> PaymentHandling : handlePayment

PaymentHandling --> Paid : correctPaymentSettled
Paid --> [*] : campaignArchived

AdvertsRunning --> Activated : backToActivatedFromAdverts

Paused --> Resumed : resumeCampaign

Adjustments --> Activated : adjustmentsApplied

Surveying --> Activated : surveysEvaluated

AdvertsPreparation --> AdvertsApproval : advertsApproved

AdvertsScheduling --> AdvertsRunning : advertsStarted

FinalStatementPreparation --> Completed : finalStatementsReady

CostsCalculation --> FinalStatementPreparation : costsReviewedAndApproved

Resumed --> Activated : resumeToActivated

@enduml
