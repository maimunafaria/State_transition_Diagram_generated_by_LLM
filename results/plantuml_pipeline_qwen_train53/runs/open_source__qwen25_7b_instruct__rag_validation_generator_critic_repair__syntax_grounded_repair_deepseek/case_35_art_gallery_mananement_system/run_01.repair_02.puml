@startuml
title UML State Machine Diagram (Art Gallery Management System)

[*] --> LoginVerification

state LoginVerification <<choice>>
LoginVerification --> IncorrectLogin : [Incorrect login details]
LoginVerification --> SuccessfulLogin : [Successful login]

state IncorrectLogin
IncorrectLogin --> [*] : [End after failed login]

state SuccessfulLogin
SuccessfulLogin --> ViewProductsOrUpdateInfo : [View products or update info]

state ViewProductsOrUpdateInfo
ViewProductsOrUpdateInfo --> SelectItemsAndOrder : [Select items and place an order]
ViewProductsOrUpdateInfo --> UpdateUserInfo : [Update user information]

state SelectItemsAndOrder
SelectItemsAndOrder --> AddToOrder : [Add to order and prepare billing details]
SelectItemsAndOrder --> ViewProductsOrUpdateInfo : [Cancel order and return to product view]

state AddToOrder
AddToOrder --> ChoosePaymentMethod : [Choose payment method]
AddToOrder --> SelectItemsAndOrder : [Modify order before proceeding]

state ChoosePaymentMethod <<choice>>
ChoosePaymentMethod --> ProcessOrderSuccess : [Process with selected payment method]
ChoosePaymentMethod --> OrderFailed : [Payment method rejected or failed]

state ProcessOrderSuccess
ProcessOrderSuccess --> [*] : [Order processed successfully]

state OrderFailed
OrderFailed --> [*] : [End process without further action]

state UpdateUserInfo
UpdateUserInfo --> SuccessfulLogin : [Return to successful login state]
@enduml
