@startuml
title UML State Machine Diagram

state StartChoice <<choice>>
state UserChoice <<choice>>
state LoggedOut <<final>>
state InfectedPeopleUpdate <<action>>
state HomeQuarantineInfoShare <<action>>
state DoctorViewInfo <<action>>
state MedicinePurchase <<action>>
state CleanArea <<action>>

[*] --> StartChoice : "Start"
StartChoice --> LoggedOut : "No user"
StartChoice --> UserChoice : "User present"

UserChoice --> SignedIn : "Correct username and password"
UserChoice --> AccessEnded : "Incorrect username or password"
AccessEnded --> [*] : "Try again"
SignedIn --> InfectedPeopleUpdate : "Update number of infected people"
SignedIn --> HomeQuarantineInfoShare : "Share information from home quarantine"
SignedIn --> MedicinePurchase : "View nearby medical shops and purchase medicines"
SignedIn --> DoctorViewInfo : "Doctors view shared information"
SignedIn --> CleanArea : "Assign workers to clean an area"
SignedIn --> LoggedOut : "Log out"

InfectedPeopleUpdate --> UpdateInfectedPeople : "Update infection statistics and mask demand"
HomeQuarantineInfoShare --> ShareInfo : "Share information from home quarantine"
DoctorViewInfo --> ViewMedicalShops : "View nearby medical shops and purchase medicines"
CleanArea --> AssignCleaners : "Assign workers to clean an area"

@enduml
