@startuml
title UML State Machine Diagram

state StartChoice <<choice>>
state UserChoice <<choice>>
state LoggedOut <<final>>
state CovidInfectedArea <<choice>>
state HomeQuarantineUser <<choice>>
state MedicalShop <<final>>
state CleaningArea <<choice>>

[*] --> CreateAccount : "Create an account"
CreateAccount --> SignedIn : "Sign in with correct username and password"
SignedIn --> CovidInfectedArea : "Check if user is infected or not"
CovidInfectedArea --> ReadBlogs : "User is recovered, read blogs"
CovidInfectedArea --> UpdateInfectedPeople : "Update number of infected people"

CovidInfectedArea --> HomeQuarantineUser : "Check if user is in home quarantine"
HomeQuarantineUser --> ShareInfo : "Share information from home quarantine"

SignedIn --> MedicalShop : "View nearby medical shops and purchase medicines"

CleaningArea --> AssignCleaners : "Assign workers to clean an area"
CleaningArea --> LoggedOut : "Log out"

UserChoice --> SignedIn : "Enter correct username and password"
UserChoice --> AccessEnded : "Enter incorrect username or password"
AccessEnded --> [*] : "Try again"

@enduml
