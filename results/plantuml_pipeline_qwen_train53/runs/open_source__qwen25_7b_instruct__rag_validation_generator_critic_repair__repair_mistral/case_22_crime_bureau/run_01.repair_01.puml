@startuml
title UML State Machine Diagram (Crime Bureau System)

[*] --> LoginType
LoginType --> UserLogin : [User]
LoginType --> PoliceLogin : [Police]

state UserLogin
UserLogin --> TryAgain : [Incorrect login details]
TryAgain --> UserLogin : [Retry]
UserLogin --> MainOptions : [Successful login]
UserLogin --> LoggedOut : [Logout or session timeout]

state PoliceLogin
PoliceLogin --> TryAgain : [Incorrect login details]
TryAgain --> PoliceLogin : [Retry]
PoliceLogin --> ViewListOrMajorActivities : [Successful login]
PoliceLogin --> LoggedOut : [Logout or session timeout]

state MainOptions <<choice>>
MainOptions --> RequestFIR : [Request FIR]
MainOptions --> RequestPetition : [Request petition]
MainOptions --> ViewPersons : [View persons]
MainOptions --> LoggedOut : [Logout or session timeout]

state ViewPersons <<choice>>
ViewPersons --> DisplayInfo : [Display requested info]
ViewPersons --> LoggedOut : [Logout or session timeout]

state ViewListOrMajorActivities <<choice>>
ViewListOrMajorActivities --> ViewPersons : [View list of wanted and missing persons]
ViewListOrMajorActivities --> MajorActivities : [Perform major activities]
ViewListOrMajorActivities --> LoggedOut : [Logout or session timeout]

state LoggedOut
LoggedOut --> [*] : [Logout or session timeout]
@enduml
