@startuml

[*] --> Login

state "Login" as L1
L1 --> SellerRegistration : [seller]
L1 --> CustomerRegistration : [customer]

state "Seller Registration" as S1
S1 --> WorkspaceAccess : [complete registration and verification]
WorkspaceAccess --> AddProducts : [add new products]
WorkspaceAccess --> PromoteProducts : [promote existing products]
WorkspaceAccess --> CommunicateWithCustomers : [communicate with customers]
WorkspaceAccess --> Logout : [log out]

state "Customer Registration" as C1
C1 --> DashboardAccess : [complete registration and verification]
DashboardAccess --> ExploreProducts : [explore products]
DashboardAccess --> ViewAvailableProducts : [view available products]
DashboardAccess --> BrowseAndPurchase : [browse and purchase]

state "Workspace Access" as W1
W1 --> DashboardAccess : [customer browses or seller manages]

state "Add Products" as AP
AP --> W1

state "Promote Products" as PP
PP --> W1

state "Communicate With Customers" as CC
CC --> W1

state "Logout" as L2
L2 --> W1

state "Explore Products" as EP
EP --> D1

state "View Available Products" as VAP
VAP --> D1

state "Browse And Purchase" as BAP
BAP --> D1 : [purchase completed]
D1 --> Payment : [make payment]
Payment --> Feedback : [provide feedback]
Feedback --> W1 : COMPLETION_EVENT

@enduml
