@startuml
title Coin Operated Pay Phone State Machine

[*] --> Idle

Idle --> Active : lift receiver / get dial tone
Active --> DialTone : lift receiver / get dial tone
DialTone --> CreditCheck : enter coins
CreditCheck --> CallStart : valid number dialed and answered
CallStart --> Calling : call in progress
Calling --> CreditCheck_1 : check credit during call
Calling --> EndCall : credit runs out
EndCall --> Idle : hang up

state Idle {
    [*] --> Active : lift receiver / get dial tone
}

state Active {
    [*] --> DialTone : lift receiver / get dial tone
}

state DialTone {
    [*] --> CreditCheck : enter coins
}

state CreditCheck {
    [*] --> CallStart : valid number dialed and answered
}

state CallStart {
    [*] --> Calling : call in progress
    [*] --> EndCall_1 : credit runs out
}

state Calling {
    [*] --> CreditCheck_1 : check credit during call
    [*] --> EndCall_2 : credit runs out
}

state EndCall {
    [*] --> Idle : hang up
}

CallStart --> Calling : call in progress
EndCall_1 --> EndCall_2 : call continues with added coins
EndCall_2 --> Idle : hang up
@enduml
