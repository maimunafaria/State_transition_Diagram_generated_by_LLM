@startuml
@startstateDiagram

[*] --> Login

state "Login" as L1
L1 --> SellerRegistration : [seller]
L1 --> CustomerRegistration : [customer]

state "Seller Registration" as S1
S1 --> WorkspaceAccess : [complete registration and verification]
S1 --> Logout : [log out]

state "Customer Registration" as C1
C1 --> DashboardAccess : [complete registration and verification]
C1 --> Logout : [log out]

state "Workspace Access" as W1
W1 --> AddProducts : [add new products]
W1 --> PromoteProducts : [promote existing products]
W1 --> CommunicateWithCustomers : [communicate with customers]
W1 --> Logout : [log out]

state "Dashboard" <<choice>>
Dashboard --> PatientDashboard : [patient user]
Dashboard --> SellerDashboard : [seller user]

state "SellerDashboard"
SellerDashboard --> AccessEnded : Fail
SellerDashboard --> ContinueUsing : Continue

state "ContinueUsing"
ContinueUsing --> ViewResult : View Result

state "PatientDashboard"
PatientDashboard --> AccessEnded : Fail
PatientDashboard --> PurchaseCompleted : Purchase Completed
PatientDashboard --> Logout : [log out]

state "PurchaseCompleted"
PurchaseCompleted --> MakePayment : [make payment]
PurchaseCompleted --> Feedback : [provide feedback later]
PurchaseCompleted --> EndInteraction : [end interaction if no deal occurs]

state "MakePayment"
MakePayment --> PaymentCompleted : [payment completed]
MakePayment --> Logout : [log out]

state "EndInteraction"
EndInteraction --> [*]
@endstateDiagram
@enduml
