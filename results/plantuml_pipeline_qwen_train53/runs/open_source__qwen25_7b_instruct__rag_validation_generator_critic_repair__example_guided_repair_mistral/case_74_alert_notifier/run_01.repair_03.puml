@startuml
title Inventory State Machine

[*] --> InventoryMenu

state AddGoods {
  entry / start state
  do / add new goods
  exit / goods added
  AddGoods --> InventoryMenu
}

state UpdatePrice {
  entry / start state
  do / update price of existing items
  exit / price updated
  UpdatePrice --> InventoryMenu
}

state RemoveGoods {
  entry / start state
  do / remove goods from inventory
  exit / goods removed
  RemoveGoods --> InventoryMenu
}

state ViewTransactions {
  entry / start state
  do / view a summary report of all transactions carried out in the system at any point
  exit / return to InventoryMenu
  ViewTransactions --> InventoryMenu
}

InventoryMenu --> Logout
@enduml
