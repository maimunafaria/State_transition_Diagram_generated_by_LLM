@startuml
title UML State Machine Diagram (Alert Notifier)

[*] --> Initialization : [Initialization starts]

state Initialization <<choice>>
Initialization --> SuccessState : [Initialization successful]
SuccessState --> WaitingMode : [Enter waiting mode if initialization successful]

state WaitingMode
WaitingMode --> ProcessUpdate : [Detected update]
ProcessUpdate --> NotifyOperators : [Conditions met for notification]
NotifyOperators --> ReturnToWait : [After processing an update]
ReturnToWait --> SuccessState : [Back to waiting mode after unloading]
SuccessState --> End : [Unloading complete]

state FailureState
FailureState --> CleanupOperations : [Cleanup operations before unloading]
CleanupOperations --> UnloadingPhase : [Unloading phase starts]
UnloadingPhase --> End : [Unloading complete]
End --> [*] : [System terminated]

state UnloadFailure <<choice>>
UnloadFailure --> Unloading : [System is shutting down while running]
Unloading --> UnloadingPhase : [System unloaded]
UnloadingPhase --> End : [Unloading complete]
End --> [*] : [System terminated]

@enduml
