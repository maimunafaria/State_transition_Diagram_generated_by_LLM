@startuml

[*] --> Login : [initial]

state "Login" as L1
L1 -->|1|[seller] SellerRegistration
L1 -->|2|[customer] CustomerRegistration

state "Seller Registration" as S1
S1 --> WorkspaceAccess : [complete registration and verification]

state "Customer Registration" as C1
C1 --> DashboardAccess : [complete registration and verification]

state "Workspace Access" as W1
W1 --> AddProducts : [add new products]
W1 --> PromoteProducts : [promote existing products]
W1 --> CommunicateWithCustomers : [communicate with customers]
W1 --> Logout : [log out]
W1 --> [*] : logged out

state "Dashboard Access" as D1
D1 --> ExploreProducts : [explore products]
D1 --> ViewAvailableProducts : [view available products]
D1 --> BrowseAndPurchase : [browse and purchase]

state "Add Products" as AP
AP --> W1

state "Promote Products" as PP
PP --> W1

state "Communicate With Customers" as CC
CC --> W1

state "Logout" as L2
L2 --> W1

state "Explore Products" as EP
EP --> D1

state "View Available Products" as VAP
VAP --> D1

state "Browse And Purchase" as BAP
BAP --> D1

state "LoggedOut" as LO
LO --> [*]

[*] --> L1 : [initial]
L1 --> S1 : [seller]
L1 --> C1 : [customer]

S1 --> W1 : [complete registration and verification]
C1 --> D1 : [complete registration and verification]

W1 --> AP : [add new products]
W1 --> PP : [promote existing products]
W1 --> CC : [communicate with customers]
D1 --> EP : [explore products]
D1 --> VAP : [view available products]
D1 --> BAP : [browse and purchase]

@enduml
