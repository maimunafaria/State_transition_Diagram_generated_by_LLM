@startuml
title UML State Machine Diagram

state StartChoice <<choice>>
state UserChoice <<choice>>
state LoggedOut <<final>>  // added final state

[*] --> CreateAccount : "Create an account"
CreateAccount --> SignedIn : "Sign in with correct username and password"

SignedIn --> ReadBlogs : "Read blogs shared by recovered patients"
SignedIn --> UpdateInfectedPeople : "Update number of infected people"
SignedIn --> ShareInfo : "Share information from home quarantine"
SignedIn --> ViewMedicalShops : "View nearby medical shops and purchase medicines"
SignedIn --> AssignCleaners : "Assign workers to clean an area"

ReadBlogs --> LoggedOut : "Logged out"
UpdateInfectedPeople --> SignedIn : "Continue updating infected people"
ShareInfo --> SignedIn : "Continue sharing information from home quarantine"
ViewMedicalShops --> SignedIn : "Continue viewing nearby medical shops and purchasing medicines"
AssignCleaners --> SignedIn : "Continue assigning workers to clean an area"

SignedIn --> LoggedOut : "Logged out"  // added final transition

@enduml
