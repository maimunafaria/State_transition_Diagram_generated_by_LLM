@startuml
title UML State Machine Diagram

state StartChoice <<choice>>
state UserChoice <<choice>>
state LoggedOut <<final>>  // added final state

[*] --> CreateAccount : "Create an account"
CreateAccount --> SignedIn : "Sign in with correct username and password"

SignedIn --> ReadBlogs : "Read blogs shared by recovered patients"
SignedIn --> UpdateInfectedPeople : "Update number of infected people"
SignedIn --> ShareInfo : "Share information from home quarantine"
SignedIn --> ViewMedicalShops : "View nearby medical shops and purchase medicines"
SignedIn --> AssignCleaners : "Assign workers to clean an area"

ReadBlogs --> LoggedOut : "Log out after reading blogs"
UpdateInfectedPeople --> SignedIn : "Continue updating infected people stats"
ShareInfo --> SignedIn : "Continue sharing info from home quarantine"
ViewMedicalShops --> SignedIn : "Continue viewing medical shops and purchasing medicines"
AssignCleaners --> SignedIn : "Continue assigning cleaners"

UserChoice --> CreateAccount : "Create an account"
UserChoice --> ReadBlogs : "Read blogs shared by recovered patients"
UserChoice --> UpdateInfectedPeople : "Update number of infected people"
UserChoice --> ShareInfo : "Share information from home quarantine"
UserChoice --> ViewMedicalShops : "View nearby medical shops and purchase medicines"
UserChoice --> AssignCleaners : "Assign workers to clean an area"

SignedIn --> LoggedOut : "Log out"  // added final transition

@enduml
