@startuml
title UML State Machine Diagram


[*] --> C1

state C1 <<choice>>
C1 --> RoleSelection : [user selects role]
C1 --> SignIn : [sign in after selecting role]

state RoleSelection

state Investor
Investor --> SubmitIdea : [submit startup idea]

state Entrepreneur
Entrepreneur --> SubmitIdea : [submit startup idea]

state Mentor
Mentor --> ReviewIdea : [review submitted idea]

state ReviewIdea
ReviewIdea --> Mentorship : [provide mentorship based on review]
ReviewIdea --> InvestmentDecision : [make investment decision if applicable]

state InvestmentDecision
InvestmentDecision --> Funding : [provide funding based on decision]

state Funding
Funding --> [*] : [end process]

state EndProcess : [end process once all actions are completed]
EndProcess --> [*] : [end process]

state SignIn <<choice>>
SignIn --> Investor : [investor sign in]
SignIn --> Entrepreneur : [entrepreneur sign in]
SignIn --> Mentor : [mentor sign in]
@enduml
