@startuml
title UML State Chart Diagram for Campaign

[*] --> ManagerAssigned

ManagerAssigned --> StaffAssigned : "Staff Assigned"

StaffAssigned --> ContractApproved : "Contract Approved and Signed"

ContractApproved --> FinalStatementPrepared : "Campaign Finished"

FinalStatementPrepared --> PaymentHandled : "Prepare Final Statement"

PaymentHandled --> RefundGenerated : "Payment < Due Amount"
RefundGenerated --> [*] : "Process Completed"

PaymentHandled --> ExcessAmountSettled : "Payment > Due Amount"
ExcessAmountSettled --> [*] : "Process Completed"

FinalStatementPrepared --> CampaignArchived : "Payment = Due Amount, Process Completed"
CampaignArchived --> [*] : "Campaign Fully Paid and Process Completed"

@enduml
