@startuml
title UML state machine diagram

[*] --> J1 : [check user]
state J1 <<choice>> {
  J1 --> Register : [ new user ]
  J1 --> J4 : [ existing user ]
}

state Register {
  entry/when the user are user
  do/Register process
  exit/ successful registration
  exit/ invalid registration
}

state J4 <<choice>> {
  J4 --> PatientDashboard : [ patient login ]
  J4 --> HealthWorkerDashboard : [ health worker login ]
  J4 --> GovernmentDashboard : [ government official login ]
  J4 --> [*] : [ logout ]
}

state PatientDashboard {
  entry/if the user is logged in as patient
  do/dashboard is displayed
  exit/when user logout
}

state HealthWorkerDashboard {
  entry/if the user is logged in as health worker
  do/display the health worker dashboard
  exit/when user logout
}

state GovernmentDashboard {
  entry/if the user is government official
  do/display government dashboard
  exit/when user logout
}

state J2 <<choice>> {
  J2 --> ProjectInfo : [ view project ]
  J2 --> Homepage : [ navigate away ]
}

state ProjectInfo {
  entry/ display information about projects
  do/projects information displayed
  exit/ when user done viewing
}

state J3 <<choice>> {
  J3 --> ViewUpdates : [ view updates ]
  J3 --> ApplicationForm : [ open application form ]
}

state ViewUpdates {
  entry/ display career opportunities updates
  do/display updates
  exit/ when user done viewing
}

state ApplicationForm {
  entry/ display employment/internship application form
  do/form displayed
  exit/ when form submitted or closed
}

state Homepage {
  entry/ display homepage
  do/homepage displayed
  exit/ when user navigates away
}
@enduml
