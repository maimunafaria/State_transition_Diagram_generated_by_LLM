@startuml
title UML state machine diagram

[*] --> J1 : [check user]
state J1 <<choice>> {
  J1 --> Register : [ new user ]
  J1 --> J4 : [ existing user ]
}

state Register {
  entry/when the user are user
  do/Register process
  exit/ successful registration
  exit/ invalid registration
}

state J4 <<choice>> {
  J4 --> PatientDashboard : [ patient login ]
  J4 --> HealthWorkerDashboard : [ health worker login ]
  J4 --> GovernmentDashboard : [ government official login ]
  J4 --> [*] : [ logout ]
}

state PatientDashboard {
  entry/if the user is logged in as patient
  do/dashboard is displayed
  exit/when user logout
  PatientDashboard --> ProjectInfo : [ view project ]
}

state HealthWorkerDashboard {
  entry/if the user is logged in as health worker
@enduml
