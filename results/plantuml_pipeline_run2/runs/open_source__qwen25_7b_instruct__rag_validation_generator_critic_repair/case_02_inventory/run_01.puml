@startuml

[*] --> CustomerRegistration

state CustomerRegistration
CustomerRegistration : entry / start
CustomerRegistration : exit / complete

state InventoryManagement
InventoryManagement : entry / start
InventoryManagement : exit / complete

state OrderPlacement
OrderPlacement : entry / start
OrderPlacement : exit / complete

state Reporting
Reporting : entry / start
Reporting : exit / complete

state LoginDecision <<choice>>
CustomerRegistration --> LoginDecision
InventoryManagement --> LoginDecision
OrderPlacement --> LoginDecision
Reporting --> LoginDecision

LoginDecision --> CustomerRegistration : verifyData
LoginDecision --> InventoryManagement : verifyData
LoginDecision --> OrderPlacement : verifyData
LoginDecision --> Reporting : verifyData

@enduml
