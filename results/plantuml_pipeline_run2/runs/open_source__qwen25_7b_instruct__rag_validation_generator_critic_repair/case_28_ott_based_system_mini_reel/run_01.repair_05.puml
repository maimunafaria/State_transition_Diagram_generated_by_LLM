@startuml
title UML State Machine Diagram

state StartChoice <<choice>>

[*] --> CreateAccount : "Create an account"
CreateAccount --> AccountCreated : "Account created successfully" [valid]

AccountCreated --> WatchVideos : "Watch videos after creating an account" [valid]
WatchVideos --> VideoSaved : "Save video in likes list during viewing" [valid]
VideoSaved --> ViewLikesList : "View saved videos from likes list" [valid]
ViewLikesList --> EnterDiscussion : "Enter discussion option" [valid]

CreateAccount --> UserChoice : "Choose next action"
UserChoice --> CreateAccount : "Create an account" [invalid]
UserChoice --> WatchVideos : "Watch videos after creating an account" [valid]

AccountCreated --> [*] : "System exit or logout"

state UserChoice <<choice>>
StartChoice --> UserChoice : "Initial choice"

AccountCreated --> StartChoice : "Initial choice"

@enduml
