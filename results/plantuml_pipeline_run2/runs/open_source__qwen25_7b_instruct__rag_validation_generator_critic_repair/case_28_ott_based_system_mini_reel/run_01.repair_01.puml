@startuml
title UML State Machine Diagram

state StartChoice <<choice>>
state UserChoice <<choice>>

[*] --> CreateAccount : "Create an account"
CreateAccount --> AccountCreated : "Account created successfully"

AccountCreated --> WatchVideos : "Watch videos after creating an account"
WatchVideos --> VideoSaved : "Save video in likes list during viewing"
VideoSaved --> ViewLikesList : "View saved videos from likes list"
ViewLikesList --> EnterDiscussion : "Enter discussion option"

CreateAccount --> UserChoice : "Choose next action"
UserChoice --> CreateAccount : "Create an account"
UserChoice --> WatchVideos : "Watch videos after creating an account"

AccountCreated --> [*] : "System exit or logout"

@enduml
