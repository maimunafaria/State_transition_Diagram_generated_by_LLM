@startuml
title UML state machine diagram

[*] --> HomePage

state HomePage <<choice>>
HomePage --> Projects : [Select projects]
HomePage --> CareerOpportunities : [Select career opportunities]

state Projects <<choice>>
Projects --> ViewPhotos : [Choose photos]
Projects --> ViewVideos : [Choose videos]
ViewPhotos --> ProjectInfo
ViewVideos --> ProjectInfo

state CareerOpportunities <<choice>>
CareerOpportunities --> ViewUpdates : [Choose updates]
CareerOpportunities --> ApplicationForm : [Choose application form]
ViewUpdates --> OpportunityInfo
ApplicationForm --> EmploymentUpdate : [Choose employment update] | InternshipUpdate : [Choose internship update]

EmploymentUpdate --> CheckApplications
InternshipUpdate --> CheckApplications

state CheckApplications <<choice>>
CheckApplications --> Submitted : [Check submitted applications]
CheckApplications --> [*]

@enduml
