@startuml
title UML State Machine Diagram (BPO Management System)

[*] --> SearchFilterCategory

state "SearchFilterCategory" as SearchFilterCategory {
    entry / Select category filter
    do / Apply category filter
    exit / Display matching users
}

state "SearchPriceRange" as SearchPriceRange {
    entry / Select price range filter
    do / Apply price range filter
    exit / Display matching users
}

state "DisplayMatchingUsers"

[*] --> UploadRequest

state "UploadRequest" as UploadRequest {
    entry / Upload new request
    do / Save project details
    exit / Request uploaded successfully
}

state "SaveProjectDetails" as SaveProjectDetails {
    entry / Enter project details
    do / Save project
    exit / Project saved
}

[*] --> SearchProjectCategory

state "SearchProjectCategory" as SearchProjectCategory {
    entry / Select project category filter
    do / Apply project category filter
    exit / Display matching projects
}

state "AcceptOrDeclineRequest"

[*] --> ClientDecision

state "ClientDecision" as ClientDecision {
    entry / Decide on project acceptance
    do / Update project status
    exit / Project status updated
}

[*] --> TrackProjectProgress

state "TrackProjectProgress" as TrackProjectProgress {
    entry / Track project progress
    do / View progress
    exit / Progress viewed
}

[*] --> BPOUpdateProgress

state "BPOUpdateProgress" as BPOUpdateProgress {
    entry / Update project progress
    do / Save progress update
    exit / Progress updated
}

[*] --> UploadFinalProject

state "UploadFinalProject" as UploadFinalProject {
    entry / Upload final project
    do / Perform quality check
    exit / Final project uploaded and checked
}

[*] --> RestartProcess

state "RestartProcess" as RestartProcess {
    entry / Restart process
    do / Re-upload final project
    exit / Process restarted
}

[*] --> MakePayment

state "MakePayment" as MakePayment {
    entry / Confirm payment
    do / Perform payment
    exit / Payment made
}

SearchFilterCategory --> DisplayMatchingUsers
SaveProjectDetails --> [*]
ClientDecision --> TrackProjectProgress
BPOUpdateProgress --> UploadFinalProject
UploadFinalProject --> RestartProcess

@enduml
