@startuml
title UML State Machine Diagram (BPO Management System)

[*] --> SearchFilterCategory

state "SearchFilterCategory" as SearchFilterCategory {
    SearchFilterCategory : entry / Select category filter
    SearchFilterCategory : do / Apply category filter
    SearchFilterCategory : exit / Display matching users
}

state "SearchPriceRange" as SearchPriceRange {
    SearchPriceRange : entry / Select price range filter
    SearchPriceRange : do / Apply price range filter
    SearchPriceRange : exit / Display matching users
}

state "DisplayMatchingUsers"

[*] --> UploadRequest

state "UploadRequest" as UploadRequest {
    UploadRequest : entry / Upload new request
    UploadRequest : do / Save project details
    UploadRequest : exit / Request uploaded successfully
}

state "SaveProjectDetails" as SaveProjectDetails {
    SaveProjectDetails : entry / Enter project details
    SaveProjectDetails : do / Save project
    SaveProjectDetails : exit / Project saved
}

[*] --> SearchProjectCategory

state "SearchProjectCategory" as SearchProjectCategory {
    SearchProjectCategory : entry / Select project category filter
    SearchProjectCategory : do / Apply project category filter
    SearchProjectCategory : exit / Display matching projects
}

state "AcceptOrDeclineRequest"

[*] --> ClientDecision

state "ClientDecision" as ClientDecision {
    ClientDecision : entry / Decide on project acceptance
    ClientDecision : do / Update project status
    ClientDecision : exit / Project status updated
}

[*] --> TrackProjectProgress

state "TrackProjectProgress" as TrackProjectProgress {
    TrackProjectProgress : entry / Track project progress
    TrackProjectProgress : do / View progress
    TrackProjectProgress : exit / Progress viewed
}

[*] --> BPOUpdateProgress

state "BPOUpdateProgress" as BPOUpdateProgress {
    BPOUpdateProgress : entry / Update project progress
    BPOUpdateProgress : do / Save progress update
    BPOUpdateProgress : exit / Progress updated
}

[*] --> UploadFinalProject

state "UploadFinalProject" as UploadFinalProject {
    UploadFinalProject : entry / Upload final project
    UploadFinalProject : do / Perform quality check
    UploadFinalProject : exit / Final project uploaded and checked
}

[*] --> RestartProcess

state "RestartProcess" as RestartProcess {
    RestartProcess : entry / Restart process
    RestartProcess : do / Re-upload final project
    RestartProcess : exit / Process restarted
}

[*] --> MakePayment

state "MakePayment" as MakePayment {
    MakePayment : entry / Confirm payment
    MakePayment : do / Perform payment
    MakePayment : exit / Payment made
}

SearchFilterCategory --> DisplayMatchingUsers
SaveProjectDetails --> [*]
ClientDecision --> TrackProjectProgress
BPOUpdateProgress --> UploadFinalProject
UploadFinalProject --> RestartProcess

SearchPriceRange --> DisplayMatchingUsers

@enduml
