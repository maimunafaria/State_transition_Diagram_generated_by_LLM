@startuml
title UML State Machine Diagram

[*] --> Registration : startRegistration

state Registration
Registration : entry / startRegistration
Registration : exit / registrationComplete

state RegistrationFailure <<choice>>
Registration --> RegistrationFailure : registrationFailed
RegistrationFailure : exit / handleFailure

state Login
Login : entry / verifyCredentials
Login : exit / loginSuccess

state MainMenu <<choice>>
Login --> MainMenu : verifyCredentials [valid]
MainMenu --> FacilityAccess : accessFacilities [valid]
MainMenu --> NewsAndContent : readNewsOrContent [invalid]

state FacilityAccess
FacilityAccess : entry / grantAccess
FacilityAccess : exit / accessGranted

state NewsAndContent
NewsAndContent : entry / readContent
NewsAndContent : exit / contentRead

state SymptomChecker
NewsAndContent --> SymptomChecker : checkSymptomsOrFitness [valid]
SymptomChecker --> SessionContinuation : continueSession [valid]
SessionContinuation --> SymptomChecker : viewResult [invalid]

state InsuranceProcessing
RegistrationFailure --> InsuranceProcessing : processInsurance [valid]
MainMenu --> InsuranceProcessing : validateInsuranceForFinanceServices [valid]

state PaymentSelection
InsuranceProcessing --> PaymentSelection : selectPaymentMethod [valid]

state CashDetails
PaymentSelection --> CashDetails : showCashDetails [valid]

state InsurancePayment
PaymentSelection --> InsurancePayment : completeInsurancePayment [valid]

state FeedbackCollection
SessionContinuation --> FeedbackCollection : provideFeedback [valid]

state Logout
MainMenu --> Logout : endSession

FacilityAccess --> [*] : endAccess
NewsAndContent --> [*] : endContentReading
SymptomChecker --> [*] : endSymptomChecking
InsuranceProcessing --> [*] : processComplete
PaymentSelection --> [*] : paymentSelected
CashDetails --> [*] : detailsShown
InsurancePayment --> [*] : paymentCompleted
FeedbackCollection --> [*] : feedbackProvided

@enduml
