@startuml
title UML State Machine Diagram (Weather Monitoring System)

[*] --> RegistrationOrLogin

state RegistrationOrLogin <<choice>>
RegistrationOrLogin --> CreateAccount : [New user]
RegistrationOrLogin --> ExistingUser : [Registered user]

state CreateAccount
CreateAccount --> AccountCreated : [Successful registration]
CreateAccount --> EndProcess : [Not successful]

state ExistingUser
ExistingUser --> LoginSuccess : [Valid login]
ExistingUser --> EndProcess : [Invalid login]

state MainMenu
MainMenu --> CheckWeather : [Check weather]
MainMenu --> ViewDetails : [View additional details]

state CheckWeather
CheckWeather --> LocationValid : [Valid location]
CheckWeather --> EndProcess : [Not valid location]

state LocationValid
LocationValid --> WeatherInfoSelected : [Choose what to check]
LocationValid --> EndProcess : [No selection]

state WeatherInfoSelected
WeatherInfoSelected --> ShowWeatherInfo : [Show selected weather info]
WeatherInfoSelected --> EndProcess : [Invalid choice]

state ViewDetails
ViewDetails --> DetailsChosen : [Choose details]
ViewDetails --> LoggedOut : [Logout]

state DetailsChosen
DetailsChosen --> ShowDetails : [Show chosen details]
DetailsChosen --> EndSession : [Logout]

state ShowWeatherInfo
ShowWeatherInfo --> [*] : [End process]

state ShowDetails
ShowDetails --> [*] : [End process]

state AccountCreated
AccountCreated --> [*] : [End process]

state LoginSuccess
LoginSuccess --> [*] : [End process]

state EndProcess
EndProcess --> [*] : [End process]

state LoggedOut
LoggedOut --> [*] : [End session]

@enduml
