@startuml
title Alarm Clock State Machine

[*] --> Off

state "Off" as Off {
    [*] --> SetAlarmTime
}

state "SetAlarmTime" {
    SetAlarmTime --> Activated : activate alarm
}

state "Activated" {
    Activated --> TurnOffAlarm : turn off alarm
    Activated --> Ringing : current time matches set alarm time
}

state "Ringing" {
    Ringing --> StopRinging : stop ringing
}

StopRinging --> Off : stop ringing

@enduml
