@startuml
title ATM Control - Validate PIN and Withdraw Funds

[*] --> Idle : entry / Display Welcome

state Idle

state "Checking PIN" as CheckingPIN {
  state "Correct PIN" as CorrectPIN
  state "Incorrect PIN" as IncorrectPIN
}

state CorrectPIN : entry / Verify PIN, Provide Options

state IncorrectPIN : entry / Keep Card, Ask for PIN Again

state "Processing Transaction" as ProcessingTransaction

state "Dispensing Cash and Printing Receipt" as DispensingCashAndReceipt {
  Idle : entry / Reset System
}

CheckingPIN --> CorrectPIN : [Correct]
CheckingPIN --> IncorrectPIN : [Incorrect]

CorrectPIN --> ProcessingTransaction : [Approved]

ProcessingTransaction --> DispensingCashAndReceipt : [Proceed]

DispensingCashAndReceipt --> [*] : entry / Return Card and Reset

@enduml
