@startuml
title ATM Control - Validate PIN and Withdraw Funds

[*] --> Idle : entry / Display Welcome

state Idle

state Idle : entry / Display Welcome

state "Checking PIN" as CheckingPIN {
  state "Correct PIN" as CorrectPIN
  state "Incorrect PIN" as IncorrectPIN
}

state CorrectPIN : entry / Verify PIN, Provide Options --> ProcessingTransaction

state IncorrectPIN : entry / Keep Card, Ask for PIN Again --> Idle

state "Processing Transaction" as ProcessingTransaction {
  state "Dispensing Cash and Printing Receipt" as DispensingCashAndReceipt
}

state DispensingCashAndReceipt : entry / Dispense Cash, Print Receipt --> Idle

state Idle : entry / Reset System --> [*] : entry / Display Welcome

@enduml
