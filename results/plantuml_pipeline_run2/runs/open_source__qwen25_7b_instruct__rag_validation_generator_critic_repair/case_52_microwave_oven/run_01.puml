@startuml
title Microwave Oven Operation

[*] --> DoorShut : Initial State

state "Door Shut" as DoorShut
state "Door Open" as DoorOpen
state "Stop Cooking" as StopCooking
state "Display Time" as DisplayTime
state "Power Selection" as PowerSelection
state "Time Setting" as TimeSetting
state "Cooking" as Cooking

DoorShut --> DisplayTime : Door Closed
DoorShut --> PowerSelection : Power Selection
DoorShut --> TimeSetting : Set Cooking Time

PowerSelection --> DoorShut : Door Closed
PowerSelection --> DoorOpen : Door Opened

TimeSetting --> DoorShut : Door Closed
TimeSetting --> DoorOpen : Door Opened

DoorOpen --> DoorShut : Door Closed
DoorOpen --> StopCooking : Cancel
DoorOpen --> DoorShut : Door Closed During Cooking

state "Stop Cooking" as StopCooking
StopCooking --> DisplayTime : Door Closed

DisplayTime --> PowerSelection : Power Selection
DisplayTime --> TimeSetting : Set Cooking Time

Cooking --> StopCooking : Door Opened
Cooking --> Cooking : Time

Cooking --> DisplayTime : Door Closed

DoorShut --> [*] : Final State

@enduml
