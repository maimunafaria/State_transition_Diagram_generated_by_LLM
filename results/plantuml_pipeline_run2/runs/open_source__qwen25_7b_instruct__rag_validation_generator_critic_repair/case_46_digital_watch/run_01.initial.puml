@startuml
title UML State Machine Diagram for Digital Watch

state Idle [*]
state TimeSetting [Time Setting]
state AlarmSetting [Alarm Setting]
state LightOn [Light On]

Idle --> TimeSetting : View/Adjust Time
TimeSetting --> AlarmSetting : Switch to Alarm Settings
AlarmSetting --> TimeSetting : Switch to Time Settings
TimeSetting --> IncreaseHour : Increase Hour
TimeSetting --> IncreaseMinute : Increase Minute
AlarmSetting --> IncreaseAlarmHour : Increase Alarm Hour
AlarmSetting --> IncreaseAlarmMinute : Increase Alarm Minute
AlarmSetting --> StopAlarm : Turn Off Alarm
Idle --> LightOn : Toggle Light

@enduml
