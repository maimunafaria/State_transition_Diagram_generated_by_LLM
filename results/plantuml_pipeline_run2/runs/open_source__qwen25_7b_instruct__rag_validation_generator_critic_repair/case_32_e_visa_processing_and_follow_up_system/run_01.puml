@startuml
title UML State Machine Diagram

[*] --> AccountCreated
AccountCreated --> LoggedIn : "Create an account"
LoggedIn --> VisaApplied : "Apply for a visa after logging in, make payment and accept application"
VisaApplied --> VisaStatusViewed : "View the status after applying for a visa"
VisaStatusViewed --> StatusChecked : "Check the status after viewing it"
StatusChecked --> ApplicationCancelled : "Cancel an application after logging in"
LoggedIn --> DetailsModified : "Modify details after logging in"
DetailsModified --> DetailsViewed : "View details after modifying them"
DetailsViewed --> FeedbackGiven : "Give feedback after checking the status"
FeedbackGiven --> LoggedOut : "Log out"
LoggedOut --> [*]

@enduml
