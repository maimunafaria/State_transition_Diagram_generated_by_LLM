@startuml
title State diagram for Graderate

[*] --> ws : "Current Date < Start Date"

state WaitingStart as ws
state Active as a
state Expired as e
state Archived as ar

ws --> ws : "Current Date < Start Date"
ws --> a : "Current Date >= Start Date"
a --> a : "Current Date <= End Date"
a --> e : "Current Date > End Date"
e --> ar : "Date >= Expiration Date + 1 Year"
ar --> [*] : "After 1 Year"

@enduml
