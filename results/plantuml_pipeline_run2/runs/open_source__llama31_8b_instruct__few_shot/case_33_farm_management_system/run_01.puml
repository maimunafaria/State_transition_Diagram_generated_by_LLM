@startuml
title UML State Machine Diagram - Farm Management System

state "Login" as Login
state "Main Area" as MainArea
state "Market Conditions" as MarketConditions
state "Market Report" as MarketReport
state "Pest Control Help" as PestControlHelp
state "Pest Control Techniques" as PestControlTechniques
state "Soil Suggestions" as SoilSuggestions
state "Weather Insights" as WeatherInsights
state "Labour Availability" as LabourAvailability
state "Logout" as Logout

Login --> MainArea : successfulLogin()

MainArea --> MarketConditions : marketSelected()
MarketConditions --> MarketReport : reportSelected()
MarketReport --> MainArea : backToMain()

MainArea --> PestControlHelp : pestControlSelected()
PestControlHelp --> PestControlTechniques : techniquesSelected()
PestControlTechniques --> MainArea : backToMain()

MainArea --> SoilSuggestions : soilInformationProvided()
SoilSuggestions --> MainArea : backToMain()

MainArea --> WeatherInsights : locationProvided()
WeatherInsights --> MainArea : backToMain()

MainArea --> LabourAvailability : locationProvided()
LabourAvailability --> MainArea : backToMain()

MainArea --> Logout : logoutSelected()

[*] --> Login

Login --> Login : invalidCredentials()
Login --> MainArea : validCredentials()

Logout --> [*]

@enduml
