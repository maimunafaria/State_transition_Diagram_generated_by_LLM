@startuml
title State machine for Alarm Clock

state Off
state Activated
state Ringing
state Stopped

[*] --> Off : /initial state/

Off --> Activated : setAlarmTime(alarmTime)

Activated --> Off : turnOffAlarm()

Activated --> Ringing : alarmTimeMatchesCurrentTime(currentTime, alarmTime)

Ringing --> Stopped : stopAlarm()

Stopped --> Activated : nextScheduledAlarmTime(scheduledAlarmTime)

[*] --> Off : /final state/

@enduml
