@startuml
title UML State Machine Diagram - Process Sale

[*] --> WaitingForNewSale

state "Waiting for new sale" as WaitingForNewSale
state "Entering items" as EnteringItems
state "Payment" as Payment
state "Verify payment" as VerifyPayment
state "Complete sale" as CompleteSale
state "Return to waiting" as ReturnToWaiting

WaitingForNewSale --> EnteringItems : New Sale Detected

EnteringItems --> Payment : All Items Added

Payment --> VerifyPayment : Card/Check Selected

VerifyPayment --> CompleteSale : Approved Payment

CompleteSale --> ReturnToWaiting : Payment Finished

VerifyPayment --> ReturnToWaiting : Rejected Payment

@enduml
