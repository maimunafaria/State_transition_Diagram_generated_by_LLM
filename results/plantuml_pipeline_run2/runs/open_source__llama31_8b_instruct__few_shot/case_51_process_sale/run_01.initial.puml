@startuml
title UML State Machine Diagram - Process Sale

[*] --> WaitingForNewSale

state "Waiting for new sale" as WaitingForNewSale
state "Entering items" as EnteringItems
state "Payment processing" as PaymentProcessing
state "Cash payment completed" as CashPaymentCompleted
state "Card/check payment verified" as CardCheckPaymentVerified
state "Sale completed" as SaleCompleted

WaitingForNewSale --> EnteringItems : New sale detected

EnteringItems --> PaymentProcessing : All items added

PaymentProcessing --> CashPaymentCompleted : Cash payment received
PaymentProcessing --> CardCheckPaymentVerified : Card/check payment selected

CashPaymentCompleted --> SaleCompleted
CardCheckPaymentVerified --> SaleCompleted : Payment approved

SaleCompleted --> WaitingForNewSale : Next customer arrived


@enduml
