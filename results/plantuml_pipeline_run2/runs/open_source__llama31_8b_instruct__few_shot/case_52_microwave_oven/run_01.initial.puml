@startuml
title Microwave Oven State Machine

state "Idle" as Idle
state "Cooking" as Cooking
state "Error" as Error

[*] --> Idle

' idle loop
Idle --> Idle : nextEvent = timerTick() / advance

' user selects power level
Idle --> Cooking : powerLevelSelected()
Cooking --> Cooking : powerLevelSelected()

' cooking process
Cooking --> Cooking : cookingTimeSet()
Cooking --> Error : doorOpenedDuringCooking()

' error handling
Error --> Idle : cancelPressed()
Error --> Idle : doorClosedAfterError()

' user cancels cooking process
Cooking --> Idle : cancelPressed()

Idle --> Idle : timerTick() / advance

@enduml
