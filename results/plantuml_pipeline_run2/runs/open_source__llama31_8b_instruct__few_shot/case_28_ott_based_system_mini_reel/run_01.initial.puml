@startuml
title UML State Machine Diagram - Ott Based System Mini Reel

[*] --> CreateAccount

state "Create account" as CreateAccount
state "Watch video" as WatchVideo
state "Upload video" as UploadVideo
state "Save to likes list" as SaveToLikesList
state "View saved videos" as ViewSavedVideos
state "Enter discussion option" as EnterDiscussionOption

CreateAccount --> WatchVideo
WatchVideo --> SaveToLikesList
SaveToLikesList --> ViewSavedVideos
ViewSavedVideos --> UploadVideo
UploadVideo --> CreateAccount
CreateAccount --> EnterDiscussionOption
EnterDiscussionOption --> [*]

@enduml
