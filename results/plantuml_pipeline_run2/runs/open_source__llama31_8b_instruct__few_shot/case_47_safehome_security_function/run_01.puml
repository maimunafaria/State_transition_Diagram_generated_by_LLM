@startuml
title UML State Machine Diagram - Safehome Security Function

[*] --> Startup

state "Startup" as Startup {
  state "Problem during startup" as ProblemDuringStartup
  ProblemDuringStartup : entry/when there is a problem during startup
  ProblemDuringStartup : do/system stops
  ProblemDuringStartup : exit/ system stopped

  state "Ready to use" as ReadyToUse
  ReadyToUse : entry/when everything is fine during startup
  ReadyToUse : do/system becomes ready to use
  ReadyToUse : exit/ system ready to use
}

Startup --> [*] : power-on / problem during startup
ProblemDuringStartup --> Startup : reset / restart

state "Ready to use" as ReadyToUse {
  state "Reset" as Reset
  Reset : entry/when user resets it
  Reset : do/system resets
  Reset : exit/ system reset

  state "Activate" as Activate
  Activate : entry/when user activates it
  Activate : do/system starts monitoring
  Activate : exit/ system activated

  state "Turn off" as TurnOff
  TurnOff : entry/when user turns it off
  TurnOff : do/system stops monitoring
  TurnOff : exit/ system turned off
}

ReadyToUse --> [*] : reset / activate / turn off
Reset --> ReadyToUse : reset
Activate --> Monitoring : activate
TurnOff --> ReadyToUse : turn off

state "Monitoring" as Monitoring {
  state "Alarm triggered" as AlarmTriggered
  AlarmTriggered : entry/when a sensor is triggered during monitoring
  AlarmTriggered : do/system starts alarm and sends alerts
  AlarmTriggered : exit/ system continues monitoring

  state "False alarm or time ends" as FalseAlarmOrTimeEnds
  FalseAlarmOrTimeEnds : entry/when it turns out to be a false alarm or the time ends
  FalseAlarmOrTimeEnds : do/system continues monitoring
  FalseAlarmOrTimeEnds : exit/ system continues monitoring
}

Monitoring --> [*] : password entered / false alarm or time ends
AlarmTriggered --> ReadyToUse : stop and return to normal

state "Ready to use" as ReadyToUse {
  state "Enter password" as EnterPassword
  EnterPassword : entry/when user enters the password at any time
  EnterPassword : do/system stops and returns to normal
  EnterPassword : exit/ system stopped and returned to normal
}

@enduml
