@startuml
title UML State Machine Diagram of Digital Watch

state "Idle" as Idle
state "Adjusting Time" as AdjustingTime
state "Setting Alarm" as SettingAlarm
state "Alarm Triggered" as AlarmTriggered
state "Light On" as LightOn
state "Light Off" as LightOff

Idle : entry / Uninitialized Watch
Idle --> AdjustingTime : [Press Button]

AdjustingTime : entry / Time Adjustment Started
AdjustingTime : do / Increase Values
AdjustingTime --> Idle : [Release Button]

SettingAlarm : entry / Alarm Setting Started
SettingAlarm : do / Set Alarm Time
SettingAlarm --> AlarmTriggered : [Match Current Time]
AlarmTriggered : entry / Alarm Triggered
AlarmTriggered : do / Ring Alarm
AlarmTriggered --> LightOn : [Turn On Light]

LightOn : entry / Light Turned On
LightOn : do / Provide Illumination
LightOn --> LightOff : [Release Button]

LightOff : entry / Light Turned Off
LightOff : do / No Action

Idle --> SettingAlarm : [Press Alarm Button]
SettingAlarm --> Idle : [Release Alarm Button]

@enduml
