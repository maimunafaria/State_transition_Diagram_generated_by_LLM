@startuml
title UML state chart diagram

state "Registration" as Registration
Registration : entry/new user registration
Registration : do/validate registration details
Registration : exit/registration failed
Registration : exit/registered successfully

state "Login" as Login
Login : entry/registered user login
Login : do/validate login credentials
Login : exit/login failed
Login : exit/logged in successfully

state "Access Facilities" as AccessFacilities
AccessFacilities : entry/logged in user access facilities
AccessFacilities : do/view available facilities
AccessFacilities : exit/facility selection made

state "News and Expert Content" as NewsAndExpertContent
NewsAndExpertContent : entry/logged in user view news and content
NewsAndExpertContent : do/read news and expert content
NewsAndExpertContent : exit/content viewed

state "Health Information" as HealthInformation
HealthInformation : entry/logged in user check health information
HealthInformation : do/check symptoms or fitness options
HealthInformation : exit/result viewed

state "Payment Process" as PaymentProcess
PaymentProcess : entry/logged in user payment process
PaymentProcess : do/validate insurance for finance services
PaymentProcess : do/check payment with insurance for doctor consultations
PaymentProcess : exit/payment completed

state "Cash Payment Details" as CashPaymentDetails
CashPaymentDetails : entry/logged in user select cash payment method
CashPaymentDetails : do/inform about cash payment details
CashPaymentDetails : exit/cash payment made

state "Insurance-Based Payments" as InsuranceBasedPayments
InsuranceBasedPayments : entry/logged in user select insurance-based payment method
InsuranceBasedPayments : do/complete payment process for insurance payments
InsuranceBasedPayments : exit/payment completed

state "User Feedback" as UserFeedback
UserFeedback : entry/logged in user provide feedback after service completion
UserFeedback : do/collect user feedback
UserFeedback : exit/feedback collected

state "Logout" as Logout
Logout : entry/logged in user logout session
Logout : do/logout user from system
Logout : exit/user logged out

[*] --> Registration

Registration --> Login : registration successful
Login --> AccessFacilities : login successful
AccessFacilities --> NewsAndExpertContent : access facilities made
NewsAndExpertContent --> HealthInformation : news and content viewed
HealthInformation --> PaymentProcess : health information accessed
PaymentProcess --> CashPaymentDetails : payment method selected
CashPaymentDetails --> InsuranceBasedPayments : cash payment details informed
InsuranceBasedPayments --> UserFeedback : insurance-based payment completed
UserFeedback --> Logout : feedback collected

Logout --> [*] : logout successful

@enduml
