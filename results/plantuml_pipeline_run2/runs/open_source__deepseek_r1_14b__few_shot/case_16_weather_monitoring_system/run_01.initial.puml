@startuml
title Weather Monitoring System State Diagram

state "Not Logged In"
stateLoggedIn <<state>> as LoggedIn
stateLocationInput <<state>> as LocationInput
stateWeatherSelection <<state>> as WeatherSelection
stateSelectedInfo <<state>> as SelectedInfo
stateAdditionalDetails <<state>> as AdditionalDetails
stateEnd <<end>> as End

[*] --> Not Logged In

Not Logged In --> LoggedIn : registrationSuccess()
Not Logged In --> LoggedIn : login()

LoggedIn --> LocationInput : checkWeather()

LocationInput --> WeatherSelection : locationValid()
LocationInput --> End : locationInvalid()

WeatherSelection --> SelectedInfo : parameterSelected()

SelectedInfo --> AdditionalDetails : viewAdditionalDetails()

AdditionalDetails --> LoggedIn : backToMainMenu()

LoggedIn --> End : logout()

LoggedIn --> LocationInput : checkWeatherAgain()

LoggedIn --> AdditionalDetails : viewAdditionalDetailsFromMainMenu()

LoggedIn --> WeatherSelection : selectDifferentParameter()

LoggedIn --> SelectedInfo : viewPreviouslySelected()

LoggedIn --> [*] : exitSystem()
@enduml
