@startuml
title UML State Machine Diagram - ATM Transaction

[*] --> Initial

state "Initial" as Initial
state "Select Amount" as SelectAmount
state "Verify Transaction" as VerifyTransaction
state "Re-enter Amount" as ReEnterAmount
state "Final" as FinalState

Initial --> SelectAmount : [User selects amount option]

SelectAmount --> VerifyTransaction : [Select predefined amount]
SelectAmount --> VerifyTransaction : [Enter custom amount]

VerifyTransaction --> FinalState : [Transaction approved]
VerifyTransaction --> ReEnterAmount : [Transaction rejected]

ReEnterAmount --> VerifyTransaction : [Re-enter amount]

FinalState --> [*] : [User completes transaction]

@enduml
