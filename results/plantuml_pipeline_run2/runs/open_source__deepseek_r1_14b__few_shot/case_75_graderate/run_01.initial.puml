@startuml
title Graderate State Transition Diagram

state "Waiting" as Waiting {
  [*] --> Waiting : [Initial]
}

state "Active" as Active {
  Waiting --> Active : [Start Date Arrived]
}

state "Expired" as Expired {
  Active --> Expired : [Finish Date Reached]
}

state "Archived" as Archived {
  Expired --> Archived : [One Year After Expiration]
}

Archived --> [*]

@enduml
