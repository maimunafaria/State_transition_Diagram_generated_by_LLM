@startuml
title UML State Machine Diagram - Online Quiz System

[*] --> Login

state "Login" as Login
Login : entry/User details
Login : do/Authenticate user
Login : exit/Authenticated

Login --> PostLoginChoice

state "Post-Login Choice (Teacher/Student)" as PostLoginChoice
PostLoginChoice : entry/Logged in user
PostLoginChoice : do/Choose role
PostLoginChoice : exit/Role selected

PostLoginChoice --> TeacherMainMenu
PostLoginChoice --> StudentMainMenu

state "Teacher Main Menu" as TeacherMainMenu
TeacherMainMenu : entry/Teacher logged in
TeacherMainMenu : do/Show options
TeacherMainMenu : exit/Options displayed

TeacherMainMenu --> CreateQuiz
TeacherMainMenu --> EditQuiz
TeacherMainMenu --> ViewResults

state "Create Quiz" as CreateQuiz
CreateQuiz : entry/Teacher chooses create
CreateQuiz : do/Create new quiz
CreateQuiz : exit/Quiz creation started

CreateQuiz --> SaveDraft
CreateQuiz --> PostQuiz

state "Edit Quiz" as EditQuiz
EditQuiz : entry/Teacher chooses edit
EditQuiz : do/Edit existing quiz
EditQuiz : exit/Editing started

EditQuiz --> SaveDraft
EditQuiz --> PostQuiz

state "Save Draft" as SaveDraft
SaveDraft : entry/Save action
SaveDraft : do/Save progress
SaveDraft : exit/Draft saved

SaveDraft --> TeacherMainMenu

state "Post Quiz" as PostQuiz
PostQuiz : entry/Post action
PostQuiz : do/Publish quiz
PostQuiz : exit/Quiz posted

PostQuiz --> ViewResults

state "View Results" as ViewResults
ViewResults : entry/Teacher views results
ViewResults : do/Display results
ViewResults : exit/Results viewed

ViewResults --> TeacherMainMenu

state "Student Main Menu" as StudentMainMenu
StudentMainMenu : entry/Student logged in
StudentMainMenu : do/Show options
StudentMainMenu : exit/Options displayed

StudentMainMenu --> SelectQuiz

state "Select Quiz" as SelectQuiz
SelectQuiz : entry/Student selects quiz
SelectQuiz : do/List available quizzes
SelectQuiz : exit/Quiz selected

SelectQuiz --> AnswerQuiz

state "Answer Quiz" as AnswerQuiz
AnswerQuiz : entry/Student starts answering
AnswerQuiz : do/Answer questions
Answer
@enduml
