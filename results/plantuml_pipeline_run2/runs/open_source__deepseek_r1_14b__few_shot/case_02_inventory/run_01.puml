@startuml
title Inventory Management System State Diagram

[*] --> MainMenu

state MainMenu {
  entry / Start inventory management system
}

state AddingGoods {
  do / Add new goods to inventory
}
AddingGoods --> MainMenu : Success

state UpdatingPrices {
  do / Update item prices
}
UpdatingPrices --> MainMenu : Success

state RemovingGoods {
  do / Remove unwanted items
}
RemovingGoods --> MainMenu : Success

state CheckingExpired {
  do / Check for expired goods
}
CheckingExpired --> ExpiredNotification : Found expired items
CheckingExpired --> MainMenu : No expired items

state ExpiredNotification {
  do / Notify user of expired items
}
ExpiredNotification --> RemovingGoods : Remove expired items
ExpiredNotification --> MainMenu : Proceed to other tasks

state PlacingOrder {
  do / Place order with supplier
}
PlacingOrder --> GeneratingInvoice : Order confirmed
PlacingOrder --> MainMenu : Order not placed

state GeneratingInvoice {
  do / Generate invoice for order
}
GeneratingInvoice --> MainMenu : Invoice generated

state SearchingInventory {
  do / Search inventory for items
}
SearchingInventory --> SelectingItems : Item found
SearchingInventory --> MainMenu : No item found

state SelectingItems {
  do / Select items for purchase
}
SelectingItems --> CalculatingTotals : Items selected
SelectingItems --> MainMenu : Cancel selection
@enduml
