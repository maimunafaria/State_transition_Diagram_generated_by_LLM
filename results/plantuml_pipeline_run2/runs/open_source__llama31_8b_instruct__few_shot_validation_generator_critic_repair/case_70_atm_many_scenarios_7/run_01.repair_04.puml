@startuml
title ATM Control - Validate PIN and Process Request

state "idle" as Idle
Idle : entry / Display Welcome
Idle --> WaitingForPIN : card inserted

state "Waiting for PIN" as WaitingForPIN
WaitingForPIN : entry / card inserted
WaitingForPIN --> ValidatingPIN : PIN entered

state "Validating PIN" as ValidatingPIN
ValidatingPIN : entry / invalid PIN
ValidatingPIN : do / count attempts
ValidatingPIN --> DisplayingOptions [valid] : valid PIN
ValidatingPIN --> ConfiscatingCard [max attempts exceeded] : max attempts exceeded

state "Displaying options" as DisplayingOptions
DisplayingOptions : entry / correct PIN
DisplayingOptions : do / display menu
DisplayingOptions --> ProcessingRequest : user selects option

state "Processing request" as ProcessingRequest
ProcessingRequest : entry / user selects option
ProcessingRequest : do / process request
ProcessingRequest --> Idle : request completed

state "Confiscating card" as ConfiscatingCard
ConfiscatingCard : entry / max attempts exceeded
ConfiscatingCard : do / confiscate card
ConfiscatingCard --> Idle : card confiscated

Idle --> ValidatingPIN : card inserted
[*] --> ValidatingPIN : card inserted

@enduml
