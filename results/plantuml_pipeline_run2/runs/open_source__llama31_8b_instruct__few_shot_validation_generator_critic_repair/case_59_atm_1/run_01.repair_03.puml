@startuml
title ATM State Machine

[*] --> ChooseAmount

state "ChooseAmount" as ChooseAmount {
  state "SelectPredefinedAmount" as SelectPredefinedAmount
  state "InputCustomAmount" as InputCustomAmount
  state "CancelTransaction" as CancelTransaction

  SelectPredefinedAmount --> [*] : predefined amount selected
  InputCustomAmount --> [*] : custom amount entered
  CancelTransaction --> ReturnCard : transaction cancelled

  ChooseAmount --> SelectPredefinedAmount : select predefined amount
  SelectPredefinedAmount --> InputCustomAmount : no predefined amount selected
  InputCustomAmount --> VerifyTransaction : valid custom amount entered
}

state OutOfService
state "VerifyTransaction <<final>>" as VerifyTransaction

ChooseAmount --> InputCustomAmount : invalid custom amount entered
InputCustomAmount --> ChooseAmount : invalid custom amount entered
CancelTransaction --> ReturnCard : transaction cancelled

VerifyTransaction --> OutOfService : out of service / <<final>>
ReturnCard --> [*] : card returned

@enduml
