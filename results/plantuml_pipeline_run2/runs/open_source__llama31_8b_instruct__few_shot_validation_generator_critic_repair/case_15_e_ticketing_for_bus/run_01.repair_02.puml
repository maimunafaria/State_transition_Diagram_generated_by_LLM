@startuml
title UML State Machine Diagram - E Ticketing System

[*] --> CreateAccount

state "Create account" as CreateAccount
state "Validate registration" as ValidateRegistration
state "Login" as Login
state "Check ticket status" as CheckTicketStatus
state "Book ticket" as BookTicket
state Logout

CreateAccount --> ValidateRegistration
ValidateRegistration --> ManageAccountDetails
ManageAccountDetails --> CreateAccount
ValidateRegistration --> Login
Login --> Logout
Logout --> [*]

Login --> CheckTicketStatus
CheckTicketStatus --> BookTicket
BookTicket --> Payment
Payment --> Logout
Logout --> [*]

@enduml
