@startuml
title UML State Machine Diagram - Weather Monitoring System

state "Registration" as Registration {
  [*] --> RegEnterDetails

  state "Enter Details" as RegEnterDetails
  state "Get Account Created" as GetAccountCreated
  state "Failed Registration" as FailedRegistration

  RegEnterDetails --> GetAccountCreated : [Valid]
  RegEnterDetails --> FailedRegistration : [Invalid]
}

state "Authentication" as Authentication {
  [*] --> AuthEnterMemberID

  state "Enter Member_ID" as AuthEnterMemberID
  state "Enter Password" as EnterPassword
  state "Successful Login" as SuccessfulLogin
  state "Invalid Member_ID or Password" as InvalidCreds

  AuthEnterMemberID --> EnterPassword
  EnterPassword --> SuccessfulLogin : [Valid]
  EnterPassword --> InvalidCreds : [Invalid]
}

state "Check Weather" as CheckWeather {
  [*] --> EnterLocation

  state "Enter Location" as EnterLocation
  state "Get Weather Info" as GetWeatherInfo
  state "Invalid Location" as InvalidLocation

  EnterLocation --> GetWeatherInfo : [Valid]
  EnterLocation --> InvalidLocation : [Not Valid]
}

state "Select Weather Option" as SelectWeatherOption {
  [*] --> SelectOption

  state "Select Option" as SelectOption
  state "Get Selected Info" as GetSelectedInfo

  SelectOption --> GetSelectedInfo : [Valid]
}

state "View Additional Details" as ViewAdditionalDetails {
  [*] --> ChooseDetail

  state "Choose Detail" as ChooseDetail
  state "Get Additional Info" as GetAdditionalInfo

  ChooseDetail --> GetAdditionalInfo : [Valid]
}

state "Logout" as Logout {
  [*] --> LogOut

  state "Log Out" as LogOut
  state End <<choice>>

  LogOut --> End
}

state StartJoin <<choice>>

[*] --> StartJoin
StartJoin --> Registration
StartJoin --> Authentication
StartJoin --> CheckWeather
StartJoin --> SelectWeatherOption
StartJoin --> ViewAdditionalDetails
StartJoin --> Logout

SuccessfulLogin --> EnterLocation
GetAccountCreated --> AuthEnterMemberID
InvalidCreds --> FailedRegistration
InvalidLocation --> End
End --> [*]

@enduml
