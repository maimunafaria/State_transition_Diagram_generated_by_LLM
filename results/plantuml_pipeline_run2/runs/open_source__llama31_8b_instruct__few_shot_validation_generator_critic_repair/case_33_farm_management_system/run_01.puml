@startuml
title UML State Machine Diagram - Farm Management System

[*] --> Login : initialTransition()

state "Login" as Login
state "Main Area" as MainArea
state "Market Conditions" as MarketConditions
state "Market Report" as MarketReport
state "Pest Control Help" as PestControlHelp
state "Pest Control Techniques" as PestControlTechniques
state "Soil Information" as SoilInformation
state "Weather Insights" as WeatherInsights
state "Labour Availability" as LabourAvailability

Login --> MainArea : successfulLogin()

MainArea --> MarketConditions : selectMarketConditions()
MarketConditions --> MarketReport : selectMarketReport()

PestControlHelp --> PestControlTechniques : providePhoto()
PestControlTechniques --> MainArea : selectPestControlHelp()

SoilInformation --> WeatherInsights : receiveSoilInfo()
WeatherInsights --> LabourAvailability : receiveLocation()

LabourAvailability --> MainArea : viewResults()

MainArea --> Logout : logout()

Logout --> [*] : sessionEnded()

Login --> PestControlHelp : choosePestControlHelp()  // added transition
Login --> SoilInformation : provideSoilInfo()  // added transition

@enduml
