@startuml
title State machine for Alarm Clock

state Off
state Activated
state Ringing

[*] --> Off : /initial state/

Off --> Activated : setAlarm(alarmTime)

Activated --> Ringing : alarmTimeReached(currentTime)
Ringing --> Off : stopAlarm()

Off --> [*] : /final state/
Activated --> [*] : deactivateAlarm()
Ringing --> [*] : stopAlarm()

[*] --> Activated : [next scheduled alarm time]

@enduml
