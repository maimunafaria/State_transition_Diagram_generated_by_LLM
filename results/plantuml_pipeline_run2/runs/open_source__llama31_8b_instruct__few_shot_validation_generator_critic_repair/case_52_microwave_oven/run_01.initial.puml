@startuml
title Microwave Oven State Machine

state "Idle" as Idle
state "Cooking" as Cooking
state "Stopped" as Stopped

[*] --> Idle

Idle --> Cooking : startButtonPressed()
Cooking --> Cooking : cookingTimeEntered()
Cooking --> Stopped : doorOpened()

Idle --> Cooking : powerLevelSelected(full)
Idle --> Cooking : powerLevelSelected(half)

Cooking --> Stopped : cancelPressed()

Stopped --> Idle : resetPressed()
Stopped --> Idle : timerExpired()

Idle --> Idle : timeUpdated()

@enduml
