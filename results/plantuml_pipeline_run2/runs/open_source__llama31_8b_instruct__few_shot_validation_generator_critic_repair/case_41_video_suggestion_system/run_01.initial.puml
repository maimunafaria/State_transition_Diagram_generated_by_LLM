@startuml
title UML State Machine Diagram (Video Suggestion System)

state "Idle" as Idle {
  [*] --> ReceiveRequest
}

state "Receiving Request" as ReceivingRequest {
  state "Receive Request" as ReceiveRequest
  state "Identify User" as IdentifyUser

  ReceiveRequest --> IdentifyUser : [Valid]
  IdentifyUser --> GatherVideos : [Valid]
}

state "Gathering Videos" as GatheringVideos {
  state "Gather Different Types of Videos" as GatherDifferentTypesOfVideos
  state "Add Additional Details" as AddAdditionalDetails

  GatherDifferentTypesOfVideos --> AddAdditionalDetails : [Valid]
  AddAdditionalDetails --> SendSuggestions : [Valid]
}

state "Sending Suggestions" as SendingSuggestions {
  state "Send Suggested Videos" as SendSuggestedVideos

  SendSuggestedVideos --> [*] : [Successful]
}

Idle --> ReceiveRequest
ReceiveRequest --> ReceivingRequest
ReceivingRequest --> GatheringVideos
GatheringVideos --> SendingSuggestions
SendingSuggestions --> Idle : [Successful]

@enduml
