@startuml
title UML State Machine Diagram - Green Rides


[*] --> Login : [Valid Login]

state "Login" as Login
Login : entry / User logs in
Login : do / Validate user credentials
Login : exit / Successful login or invalid credentials

Login --> JourneyDetails : [Valid Login]
Login --> [*] : [Invalid Credentials]

state "Journey Details" as JourneyDetails
JourneyDetails : entry / Display journey details
JourneyDetails : do / Show driving mode options
JourneyDetails : exit / User selects an option

JourneyDetails --> DrivingMode : [Select driving mode]
JourneyDetails --> OtherOptions : [Choose other options]

state "Driving Mode" as DrivingMode
DrivingMode : entry / Activate driving mode
DrivingMode : do / Send notifications during driving
DrivingMode : exit / End of journey or accident

DrivingMode --> Accident : [Accident Occurs]
DrivingMode --> [*] : [End of Journey]

state "Accident" as Accident
Accident : entry / Inform relevant authorities
Accident : do / Send notifications to user and authorities
Accident : exit / User provides feedback

Accident --> Feedback : [User Provides Feedback]

state "Other Options" as OtherOptions
OtherOptions : entry / Show place to eat options
OtherOptions : do / Select a place to eat, view menu, and order food
OtherOptions : exit / End of journey or accident

OtherOptions --> PlaceToEat : [Select Place To Eat]
PlaceToEat --> Menu : [View Menu]
Menu --> OrderFood : [Place An Order]

OrderFood --> [*] : [End Of Journey Or Accident]

state "Feedback" as Feedback
Feedback : entry / User provides feedback
Feedback : do / Store user feedback
Feedback : exit / End of journey

JourneyDetails --> Feedback : [User Selects Other Options]
OtherOptions --> Feedback : [User Selects Other Options]
DrivingMode --> Feedback : [End Of Journey Or Accident]
Accident --> Feedback : [User Provides Feedback]

Feedback --> [*] : [End Of Journey]


@enduml
