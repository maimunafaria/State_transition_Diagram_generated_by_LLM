@startuml
title E Visa Processing And Follow Up System - UML State Machine Diagram

state Start
state LoggedIn
state Applying
state PaymentMade
state ApplicationAccepted
state ViewStatus
state CheckStatus
state CancelApplication
state ModifyDetails
state ViewDetails
state PurposeView
state Feedback
state Logout

Start --> LoggedIn [*]
LoggedIn --> Applying
Applying --> PaymentMade
PaymentMade --> ApplicationAccepted
ApplicationAccepted --> ViewStatus
ViewStatus --> CheckStatus
CheckStatus --> Feedback
Feedback --> Logout
CheckStatus --> CancelApplication
CancelApplication --> ModifyDetails
ModifyDetails --> ViewDetails
ViewDetails --> PurposeView
PurposeView --> Logout
LoggedIn --> Logout
@enduml
