@startuml
title ATM Control - Validate PIN and Withdraw Funds

[*] --> Idle

state Idle {
  state UploadRequest
  state SaveProjectDetails
  state SearchProjectCategory
  state AcceptDeclineRequest
  state ProceedRejectProject
  state UpdateProjectStatus
  state TrackProjectProgress
  state UpdateProject
  state UploadFinalProject
  state QualityCheck
  state RestartProcess
  state MakePayment
}

Idle --> UploadRequest : uploadNewRequest
UploadRequest --> SaveProjectDetails
SaveProjectDetails --> SearchProjectCategory
SearchProjectCategory --> AcceptDeclineRequest
AcceptDeclineRequest --> ProceedRejectProject
ProceedRejectProject --> UpdateProjectStatus
UpdateProjectStatus --> TrackProjectProgress
TrackProjectProgress --> UpdateProject
UpdateProject --> UploadFinalProject
UploadFinalProject --> QualityCheck
QualityCheck --> [*] : qualityApproved
QualityCheck --> RestartProcess : qualityRejected
RestartProcess --> Idle

Idle --> MakePayment : satisfiedWithProject
MakePayment --> [*] : paymentMade
@enduml
