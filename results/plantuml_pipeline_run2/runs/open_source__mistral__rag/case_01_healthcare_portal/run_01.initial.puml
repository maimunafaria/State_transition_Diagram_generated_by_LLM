@startuml
title UML State Machine Diagram - Healthcare Portal

state StartChoice <<choice>>
state RegistrationChoice <<choice>>
state SignInChoice <<choice>>
state FacilityAccessChoice <<choice>>
state NewsContentChoice <<choice>>
state HealthInfoChoice <<choice>>
state ResultChoice <<choice>>
state InsuranceProcessingChoice <<choice>>
state PaymentMethodChoice <<choice>>
state CashPaymentDetailsChoice <<choice>>
state InsurancePaymentChoice <<choice>>
state FeedbackCollectionChoice <<choice>>
state LogoutChoice <<choice>>

[*] --> RegistrationChoice

RegistrationChoice : entry / getUserDetails
RegistrationChoice : do / registerUser
RegistrationChoice : exit / registrationSuccess
RegistrationChoice : exit / registrationFailed

SignInChoice : entry / getCredentials
SignInChoice : do / validateCredentials
SignInChoice : exit / signInSuccess
SignInChoice : exit / signInFailed

FacilityAccessChoice : entry / checkLogin
FacilityAccessChoice : do / provideAccess

NewsContentChoice : entry / readNews
NewsContentChoice : do / browseContent

HealthInfoChoice : entry / checkSymptoms
HealthInfoChoice : do / fitnessChecking

ResultChoice : entry / viewResult
ResultChoice : do / continueSession
ResultChoice : do / endSession

InsuranceProcessingChoice : entry / processInsurance
InsuranceProcessingChoice : do / validateInsurance
InsuranceProcessingChoice : exit / insuranceValidated
InsuranceProcessingChoice : exit / insuranceInvalidated

PaymentMethodChoice : entry / selectPaymentMethod
PaymentMethodChoice : do / chooseCashOrInsurance

CashPaymentDetailsChoice : entry / provideCashDetails

InsurancePaymentChoice : entry / processInsurancePayment

FeedbackCollectionChoice : entry / collectFeedback
FeedbackCollectionChoice : do / saveFeedback

LogoutChoice : entry / logout
@enduml
