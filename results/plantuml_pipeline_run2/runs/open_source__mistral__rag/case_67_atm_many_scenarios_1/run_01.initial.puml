@startuml
title ATM Control - Combined Scenarios

[*] --> Idle

state Idle
Idle : entry / Display Welcome

state "Enter PIN"
"Enter PIN" : enterPin(pin)
"Enter PIN" : verifyPin(pin, storedPIN)
"Enter PIN" : checkPinLimit(incorrectEntries)
"Enter PIN" : checkCardValidity(cardStatus)

state "Processing Transaction" as ProcessingTransaction {
  state "Processing Transfer" as ProcessingTransfer
  state "Processing Query" as ProcessingQuery
  state "Withdrawal"

  "Processing Transaction" : chooseOption()
  "Processing Transaction" : processRequest(request)
  "Processing Transaction" : checkApproval(approved)
  "Processing Transaction" : printReceipt(receipt)
  "Processing Transaction" : dispenseCash(cash)
  "Processing Transaction" : returnCard()
  "Processing Transaction" : cancelOperation(message)
  "Processing Transaction" : shutdown()
}

state "Invalid Card or PIN Limit Reached" {
  state "Retaining Card" as RetainingCard
  "Invalid Card or PIN Limit Reached" : retainCard()
  "Invalid Card or PIN Limit Reached" : returnMessage(message)
}

state "Transfer" {
  "Transfer" : transferMoney(amount)
}

state "Query" {
  "Query" : processQuery(query)
}

Idle --> "Enter PIN"
"Enter PIN" --> "Processing Transaction"
"Processing Transaction" -->|approved| "Print Receipt"
"Processing Transaction" -->|rejected| "Cancel Operation"
"Invalid Card or PIN Limit Reached" --> "Retaining Card"
"Retaining Card" --> "Return Message"
"Transfer" --> "Dispense Cash"
"Query" --> "Print Receipt"
@enduml
