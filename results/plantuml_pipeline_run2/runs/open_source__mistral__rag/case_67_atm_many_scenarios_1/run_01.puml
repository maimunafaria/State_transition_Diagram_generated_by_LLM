@startuml
title ATM Control - Combined Scenarios

[*] --> Idle

state Idle
Idle : entry / Display Welcome

state "Entering PIN"
"Entering PIN" : enterPin(pin)
"Entering PIN" : verifyPin(pin, storedPIN)
"Entering PIN" : checkCardValidity()
"Entering PIN" : checkIncorrectPins()

state "Processing Transaction" as ProcessingTransaction {
  state "Processing Withdrawal" {
    state "Checking Validity" as CheckingValidity
    "Checking Validity" : checkWithdrawalRequest(withdrawalAmount)
    "Checking Validity" : checkSufficientCash()
    "Checking Validity" : checkCardSecurity()
    "Processing Withdrawal" : dispenseCash(withdrawalAmount)
    "Processing Withdrawal" : printReceipt()
    "Processing Withdrawal" : returnCard()
  }

  state "Processing Transfer" {
    state "Checking Validity" as CheckingValidity
    "Checking Validity" : checkTransferRequest(transferAmount)
    "Checking Validity" : checkSufficientCash()
    "Processing Transfer" : transferFunds(transferAmount)
    "Processing Transfer" : printReceipt()
  }

  state "Processing Query" {
    state "Checking Validity" as CheckingValidity
    "Checking Validity" : checkQueryRequest()
    "Processing Query" : processQuery()
    "Processing Query" : printReceipt()
  }
}

state "Returning Card and Ending Session" {
  state "Returning Card" as ReturningCard
  "Returning Card" : returnCard()
  state "Ending Session" as EndingSession
  "Ending Session" : shortEndingPhase()
  "Ending Session" : resetATM()
}
@enduml
