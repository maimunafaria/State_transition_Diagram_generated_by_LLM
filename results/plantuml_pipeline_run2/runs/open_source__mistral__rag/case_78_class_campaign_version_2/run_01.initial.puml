@startuml
title State machine for Campaign

state Commissioned
state Active
state Paused
state Adjusting
state Completed
state Paid

[*] --> Commissioned : /assignManager;\nassignStaff\n/approvalReceived

Commissioned --> Active : ContractSigned
Active --> Paused : /pauseCampaign
Paused --> Active : /resumeCampaign
Active --> Adjusting : /extendDuration;\n/changeBudget
Adjusting --> Active : /applyAdjustments
Active --> Completed : /allWorkFinished
Completed --> Paid : /calculateCosts;\n/generateFinalStatement
Paid --> Archived : /markCampaignAsPaid;\n/archiveCampaign

@enduml
