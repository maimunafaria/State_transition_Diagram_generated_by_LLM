@startuml
title State machine for Campaign

state Commissioned
state Active
state Adjusting
state Paused
state Resuming
state Completed
state Paid
state Cancelled

[*] --> Commissioned : /assignManager;\nassignStaff\n/approveContract

Commissioned --> Active : Authorized(authorizationCode)\n[contract signed]\n/setCampaignActive

Active --> Adjusting : ExtendDuration(duration)\nChangeBudget(budget)
Adjusting --> Active : /approveChanges

Active --> Paused : /pauseCampaign
Paused --> Resuming : /resumeCampaign

Active --> Completed : /runAdverts\n/evaluateSurveys\n/finishWork
Completed --> Cancelled : /cancelCampaign
Completed --> Paid : /prepareFinalStatement\n/handlePayment\n/generateRefund\n/markAsPaid

@enduml
