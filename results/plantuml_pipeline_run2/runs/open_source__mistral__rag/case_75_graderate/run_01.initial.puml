@startuml
title Rate Management System State Diagram

[*] --> StartDate
StartDate -|> WaitingState

state WaitingState
state ActiveState
state ExpiredState
state ArchivedState

ActiveState -|> ValidityPeriod
ExpiredState -|> OneYearLater

state FinishDate
FinishDate -|> ExpiredState

ArchivedState -|> End

@enduml
