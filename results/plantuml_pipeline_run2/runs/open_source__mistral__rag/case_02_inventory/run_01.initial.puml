@startuml
title UML State Chart Diagram

[*] --> CustomerRegistration
CustomerRegistration : entry / createAccount
CustomerRegistration : do / fillDetails
CustomerRegistration : exit / accountCreated

state SellerRegistration
SellerRegistration : entry / joinAsSeller
SellerRegistration : do / provideDetails
SellerRegistration : exit / registrationCompleted

state Login
Login : entry / submitCredentials
Login : do / verifyData
Login : exit / verified

state CustomerWorkspace
CustomerWorkspace : entry / accessDashboard
CustomerWorkspace : do / exploreProducts
CustomerWorkspace : exit / browsing

state PurchaseDecision <<choice>>
CustomerWorkspace --> PurchaseDecision

state OrderPlacement
OrderPlacement : entry / selectItems
OrderPlacement : do / addToOrder
OrderPlacement : exit / orderPlaced

state PaymentSelection
PaymentSelection : entry / chooseMethod
PaymentSelection : do / processPayment
PaymentSelection : exit / paymentSuccessful

state OrderProcessing
OrderProcessing : entry / prepareBillingDetails
OrderProcessing : do / deliverOrder
OrderProcessing : exit / deliveryCompleted

state InventoryManagement
InventoryManagement : entry / addGoods
InventoryManagement : do / updatePrice
InventoryManagement : exit / priceUpdated
InventoryManagement : entry / removeGoods
InventoryManagement : do / identifyExpired
InventoryManagement : exit / expiredGoodsRemoved
InventoryManagement : entry / orderSupplier
InvoiceGeneration : entry / generateInvoice
ReceiptGeneration : entry / generateReceipt
ReceiptModification : entry / replaceItemOrCancel
CustomerRequestLogging : entry / recordRequests
TransactionSummaryReporting : entry / viewTransactions
@enduml
