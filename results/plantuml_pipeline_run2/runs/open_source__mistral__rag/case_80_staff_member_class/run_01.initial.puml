@startuml
title Staff Member State Machine

state Unemployed
state Assigned
state Working

[*] --> Assigned : assignToClient\norassignToCampaign

Assigned --> Working : switchAssignment

Working --> Unemployed : leaveJob

Assigned --> Unemployed : removeAssignment


title Campaign State Machine

state Inactive
state Active
state Completed
state Paid

[*] --> Active : startCampaign

Active --> Completed : finishWork

Completed --> Paid : prepareFinalStatement

Paid --> Paid : correctPaymentReceived

Paid --> Paid : paymentAdjusted

Inactive --> Active : assignManager\nassignStaff\napproveContract\n[contract signed]

title Advocate Diary State Machine

state Unregistered
state Registered
state LoggedIn
state AddingCase
state ReminderSet
state CaseClosed

[*] --> Registered : createAccount

Registered --> LoggedIn : verifyDetails\ncheckPassword

LoggedIn --> AddingCase : addNewCase

AddingCase --> ReminderSet : setReminders

ReminderSet --> CaseClosed : closeCase
@enduml
