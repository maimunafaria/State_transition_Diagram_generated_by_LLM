@startuml
title Staff Member State Machine

state Unemployed
state Assigned
state Working

[*] --> Assigned : assignToClientOrCampaign

Assigned --> Working : switchAssignment

Working --> Unemployed : leaveJob


title Campaign State Machine

state Inactive
state Active
state Completed
state Paid

[*] --> Inactive : assignManager\nassignStaff\napprove\nsignContract

Inactive --> Active : Authorized(authorizationCode)\n/setCampaignActive

Active --> Completed : finishWork

Completed --> Paid : prepareFinalStatement

Paid --> Completed : handlePayment

@enduml
