@startuml
title Safehome Security Function - State Machine Diagram

[*] --> PowerOn

state PowerOn {
  state CheckWorking {
    state EverythingFine {
      state ReadyToUse {
        state Activate {
          state Monitoring {
            state SensorTriggered {
              state AlarmActivated {
                state SendAlerts {
                  state FalseAlarmOrTimeEnds {
                    state ContinueMonitoring
                  }
                }
              }
            }
            state NoSensorTriggered {
              state ContinueMonitoring
            }
          }
        }
        state Reset {
          state EnterPassword {
            state PasswordCorrect {
              state OptionsDisplayed
            }
            state PasswordIncorrect {
              state AskForPINAgain
            }
          }
        }
        state TurnOff
      }
    }
    state ProblemDuringStartup {
      state Stop
    }
  }
}
@enduml
