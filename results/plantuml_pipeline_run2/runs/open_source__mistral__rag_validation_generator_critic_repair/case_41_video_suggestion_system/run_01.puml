@startuml
title Video Suggestion System UML State Machine Diagram

state UserRequestChoice <<choice>>
state IdentifyUserChoice <<choice>>
state GatherVideosChoice <<choice>>
state AddDetailsChoice <<choice>>
state SendSuggestionsChoice1 <<choice>>
state SendSuggestionsChoice2 <<choice>>
state EndState <<final>>

[*] --> UserRequestChoice

UserRequestChoice --> IdentifyUserChoice : [receive video suggestion request]
IdentifyUserChoice --> GatherVideosChoice : [identify user]
GatherVideosChoice --> AddDetailsChoice : [gather videos and add details]
AddDetailsChoice --> SendSuggestionsChoice1 : [valid]
AddDetailsChoice --> SendSuggestionsChoice2 : [invalid]
SendSuggestionsChoice1 --> EndState : [send suggested videos to user]
SendSuggestionsChoice2 --> EndState : [handle invalid case, e.g., system error]
EndState --> [*]
@enduml
