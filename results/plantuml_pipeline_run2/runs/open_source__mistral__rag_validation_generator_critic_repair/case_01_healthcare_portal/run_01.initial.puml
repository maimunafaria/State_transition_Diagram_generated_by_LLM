@startuml
title UML State Machine Diagram - Healthcare Portal

state StartChoice <<choice>>
state RegistrationChoice <<choice>>
state SignInChoice <<choice>>
state FacilityAccessChoice <<choice>>
state NewsContentChoice <<choice>>
state HealthInfoChoice <<choice>>
state ResultChoice <<choice>>
state InsuranceCheckChoice <<choice>>
state PaymentChoice <<choice>>
state FeedbackChoice <<choice>>
state LogoutChoice <<choice>>

[*] --> RegistrationChoice

RegistrationChoice : entry / getUserDetails
RegistrationChoice : do / registerUser
RegistrationChoice : exit / registrationSuccess
RegistrationChoice : exit / registrationFailed

SignInChoice : entry / getCredentials
SignInChoice : do / validateCredentials
SignInChoice : exit / signInSuccess
SignInChoice : exit / signInFailed

FacilityAccessChoice : entry / checkLogin
FacilityAccessChoice : do / provideAccess

NewsContentChoice : entry / readContent

HealthInfoChoice : entry / checkSymptoms
HealthInfoChoice : entry / fitnessChecking

ResultChoice : entry / viewResult
ResultChoice : do / continueOrFinishSession

InsuranceCheckChoice : entry / processInsurance
InsuranceCheckChoice : do / validatePaymentWithInsurance

PaymentChoice : entry / selectPaymentMethod
PaymentChoice : do / completePayment

FeedbackChoice : entry / provideFeedback

LogoutChoice : entry / logOut

@enduml
