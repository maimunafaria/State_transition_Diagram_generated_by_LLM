@startuml
title Weather Monitoring System - User Authentication and Location Selection

[*] --> Login

state Login <<choice>>
Login --> RegisteredUser : [Registered user]
Login --> NewUser : [New user]

state RegisteredUser
state NewUser

RegisteredUser --> CheckLocation : [Logged in]
RegisteredUser --> Logout : [Log out]

NewUser --> Registration : [Enter details]
NewUser --> EndRegistration : [Details invalid]
NewUser --> SaveInfo : [Successful registration]

CheckLocation --> ValidLocation : [Valid location]
CheckLocation --> InvalidLocation : [Invalid location]

ValidLocation --> WeatherSelection : [Choose what to check]
ValidLocation --> DetailsView : [View additional details]
ValidLocation --> Logout : [Log out]

InvalidLocation --> EndProcess : [Not valid location]

WeatherSelection --> Temperature : [Temperature]
WeatherSelection --> Humidity : [Humidity]
WeatherSelection --> Rainfall : [Rainfall]
WeatherSelection --> Pressure : [Pressure]
WeatherSelection --> DewPoint : [Dew Point]

EndProcess --> EndSession : [Registration not successful]
Logout --> EndSession : [Logged out]
@enduml
