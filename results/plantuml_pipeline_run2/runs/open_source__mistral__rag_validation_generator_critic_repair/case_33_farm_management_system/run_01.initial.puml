@startuml
title UML state machine diagram - Farm Management System

[*] --> SignIn
state SignIn <<choice>>
SignIn --> MainArea : [Correct credentials]
SignIn --> Error : [Invalid credentials]

MainArea --> MarketConditions : [Select market conditions]
MainArea --> PestControlHelp : [Select pest control help]
MainArea --> SoilInfo : [Provide soil information]
MainArea --> WeatherInsights : [Select weather insights]
MainArea --> LabourAvailability : [Select labour availability]

MarketConditions --> MarketReport : []
PestControlHelp --> PestControlTechniques : []
SoilInfo --> CropSuggestions : []
WeatherInsights --> WeatherDetails : []
LabourAvailability --> LabourDetails : []

MainArea --> Continue : [Continue using service]
SignOut --> EndSession : [Log out]
@enduml
