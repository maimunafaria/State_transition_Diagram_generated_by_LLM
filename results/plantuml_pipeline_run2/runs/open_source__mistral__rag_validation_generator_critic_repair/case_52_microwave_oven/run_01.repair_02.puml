@startuml
Microwave Oven Operation and Control

state MicrowaveOven {
  state Checking
  Checking : do / Check Status

  state Cook
  Cook : do / Run Generator

  state Alarm
  Alarm : do / Display Event

  state Done
  Done : do / Buzzer On for 5 Secs.

  [*] --> Checking

  Checking --> Cook : OK
  Checking --> Alarm : Turntable Fault
  Checking --> Alarm : Emitter Fault

  Cook --> Done : Timeout
  Cook --> Cook : Time

  MicrowaveOven --> Disabled : Door Open
  MicrowaveOven --> Waiting : Cancel

  MicrowaveOven --> Oven : Door Closed and Ready

  state Oven {
    state DoorShut
    DoorShut --> DoorOpen : Door Opened
    DoorOpen --> DoorShut : Door Closed

    state DoorOpenItem
    DoorOpenItem --> DoorShutItem : Food Placed
    DoorShutItem --> ReadyToCook : Door Closed

    state ReadyToCook
    ReadyToCook --> Cooking

    state Cooking
    Cooking --> Done : Time Ended
    Cooking --> Cooking : Continue Cooking

    state Done
    Done --> DoorOpen : Food Removed
  }

  Alarm --> Disabled
}

state Disabled
state Waiting

state ATM {
  state Idle
  Idle --> PINEntry : User Interaction

  state PINEntryIncorrect
  PINEntryIncorrect : do / Ask for PIN again
  PINEntryIncorrect --> Idle : Correct PIN Entered
  PINEntryIncorrect --> CardRetained : Incorrect PIN or Invalid Card

  state Options
  Options : do / Display Options
  Options --> WithdrawalRequest : User Interaction

  state WithdrawalRequestRejected
  WithdrawalRequestRejected : do / Cancel Transaction and Return Card

  state WithdrawalRequestApproved
  WithdrawalRequestApproved : do / Dispense Cash, Print Receipt, and Return Card

  state OutOfCash
  OutOfCash : do / Stop Operation and Reset

  Idle --> OutOfCash : Run out of cash during process
}
@enduml
