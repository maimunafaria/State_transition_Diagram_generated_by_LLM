@startuml
Microwave Oven Operation and Control

state MicrowaveOven {
  state Checking
  Checking : do / Check Status

  state Cook
  Cook : do / Run Generator

  state Alarm
  Alarm : do / Display Event

  state Done
  Done : do / Buzzer On for 5 Secs.

  [*] --> Checking

  Checking --> Cook : OK
  Checking --> Alarm : Turntable Fault
  Checking --> Alarm : Emitter Fault

  Cook --> Done : Timeout
  Cook --> Cook : Time

  MicrowaveOven --> Disabled : Door Open
  MicrowaveOven --> Waiting : Cancel

  MicrowaveOven --> Oven : Door Closed and Ready
  Oven : do / Check if Food Placed
  Oven --> Cooking : Yes
  Oven --> Waiting : No

  Cooking --> Done : Time Ended
  Cooking --> Cooking : Continue Cooking

  Done --> MicrowaveOven : Food Removed
}

state Disabled
state Waiting

state Oven {
  state DoorShut
  DoorShut --> DoorOpen : Door Opened
  DoorOpen --> DoorShut : Door Closed

  state DoorOpenItem
  DoorOpenItem --> DoorShutItem : Food Placed
  DoorShutItem --> ReadyToCook : Door Closed

  state ReadyToCook
  ReadyToCook --> Cooking

  state Cooking
  Cooking --> Done : Time Ended
  Cooking --> Cooking : Continue Cooking

  state Done
  Done --> DoorOpen : Food Removed
}
@enduml
