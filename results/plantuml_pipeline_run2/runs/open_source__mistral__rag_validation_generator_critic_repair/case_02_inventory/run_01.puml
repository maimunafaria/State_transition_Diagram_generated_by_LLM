@startuml
title UML State Chart Diagram

[*] --> CustomerRegistration
CustomerRegistration : entry / provideDetails
CustomerRegistration : do / createAccount
CustomerRegistration : exit / accountCreated

state CustomerDashboard
CustomerDashboard : entry / login
CustomerDashboard : do / verifyCredentials
CustomerDashboard : exit / invalidCredentials
CustomerDashboard : entry / validCredentials
CustomerDashboard : exit / customerDashboard
[*] --> CustomerDashboard

state InventoryManagement
InventoryManagement : entry / customerDashboard
InventoryManagement : do / addGoods
InventoryManagement : do / updatePrice
InventoryManagement : do / removeGoods
InventoryManagement : do / identifyExpiredGoods
InventoryManagement : do / placeOrderToSupplier
InventoryManagement : do / generateInvoice
InventoryManagement : do / searchItems
InventoryManagement : do / calculateDiscountAndTax
InventoryManagement : do / generateReceipt
InventoryManagement : do / replaceItemOrCancelReceipt
InventoryManagement : do / recordCustomerRequest
InventoryManagement : do / viewTransactionSummary
InventoryManagement : exit / inventoryManagement
[*] --> InventoryManagement

state OrderManagement
OrderManagement : entry / customerDashboard
OrderManagement : do / placeOrder
OrderManagement : do / sendSampleMaterials
OrderManagement : do / checkStock
OrderManagement : do / purchaseRawMaterials
OrderManagement : do / processRawMaterials
OrderManagement : do / beginGarmentProduction
OrderManagement : do / conductDefectCheck
OrderManagement : do / deliverGarments
OrderManagement : do / completeBillingAndPayment
OrderManagement : do / generateReport
OrderManagement : exit / orderManagement
[*] --> OrderManagement

state PaymentProcessing
PaymentProcessing : entry / choosePaymentMethod
PaymentProcessing : do / processPayment
PaymentProcessing : exit / paymentSuccessful
PaymentProcessing : exit / paymentFailed
[*] --> PaymentProcessing

CustomerDashboard : exit / LoggedOut --> [*]
InventoryManagement : exit / AccessEnded --> [*]
OrderManagement : exit / OrderCompleted --> [*]
PaymentProcessing : exit / PaymentProcessEnded --> [*]
@enduml
