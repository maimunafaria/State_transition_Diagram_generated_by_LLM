@startuml
title UML State Machine Diagram (BPO Management System)

[*] --> UserType
UserType --> Registration : [New user]
UserType --> Login : [Registered user]

state UserType <<choice>>

state "Registration" as Registration {
    Registration : entry / Start registration
    Registration : validateDetails / Validate details
    Registration : saveDetails : [details valid]
    Registration : exit : [details invalid]
}

state "Login" as Login {
    Login : enterCredentials / Enter username and password
    Login : validateCredentials / Validate credentials
    Login : loginSuccess : [successful login]
    Login : loginFailed : [unsuccessful login]
}

state User as User {
    User : logout / Logout
    User : manageProfile / Manage profile
    User : searchUsers : [search users]
    User : viewDeals : [view current deals]
    User : ChangePassword : [change password]
}

state ChangePassword as ChangePassword {
    state "Enter old password" as EnterOldPassword {
        EnterOldPassword : enterOldPassword / Enter old password
        EnterOldPassword : validateOldPassword / Validate old password
    }
    state "Enter new password" as EnterNewPassword {
        EnterNewPassword : enterNewPassword / Enter new password
        EnterNewPassword : validateNewPassword / Validate new password
    }
    ChangePassword : saveChanges : [save changes]
}

state User as User {
    User : LoggedOut : [logout]
}

state Project as Project {
    Project : uploadRequest / Upload request
    Project : saveProjectDetails : [save project details]
    Project : searchCategory : [search for suitable project category]
    Project : acceptDeclineRequest : [accept or decline a request]
    Project : proceedReject : [decide whether to proceed with an accepted project or reject it]
    Project : updateStatus : [update the project status]
    Project : trackProgress : [track the progress of a project]
    Project : updateProgress : [update the progress of a project]
    Project : uploadFinalProject : [upload a final project]
    Project : qualityCheck : [perform a quality check on the final project]
    Project : restartProcess : [restart the process if a client is unsatisfied with the final project]
    Project : makePayment : [make payment if the client is satisfied with the final project]
}
@enduml
