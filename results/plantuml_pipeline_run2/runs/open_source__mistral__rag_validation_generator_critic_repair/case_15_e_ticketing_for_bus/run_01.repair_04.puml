@startuml
title E Ticketing For Bus — Polished Requirement Specification

state StartChoice <<choice>>
state RegistrationChoice
state LoginChoice
state LoggedInChoice
state TicketStatusChoice
state BookTicketChoice
state AccountManagementChoice
state LogoutChoice
state LoggedOut <<final>>

[*] --> StartChoice : [create account or log in]
StartChoice --> RegistrationChoice [valid]
RegistrationChoice --> ValidationChoice
ValidationChoice --> SuccessfulRegistrationChoice
SuccessfulRegistrationChoice --> LoginChoice [valid]
LoginChoice --> SuccessfulLoginChoice
SuccessfulLoginChoice --> LoggedInChoice
LoggedInChoice --> TicketStatusChoice
TicketStatusChoice --> CheckTicketStatusChoice
CheckTicketStatusChoice --> [continue]

LoggedInChoice --> BookTicketChoice
BookTicketChoice --> ConfirmationChoice
ConfirmationChoice --> PaymentChoice
PaymentChoice --> SuccessfulPaymentChoice
SuccessfulPaymentChoice --> LogoutChoice [valid]

LoggedInChoice --> AccountManagementChoice
AccountManagementChoice --> EditOrDeleteAccountChoice
EditOrDeleteAccountChoice --> [continue]

LogoutChoice --> LoggedOut
LoggedOut --> [*]

@enduml
