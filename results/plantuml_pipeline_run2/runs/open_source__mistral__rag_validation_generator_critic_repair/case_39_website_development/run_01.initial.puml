@startuml
title UML state machine diagram

[*] --> Homepage
Homepage --> NavigationBar
NavigationBar --> Projects
Projects --> Photos
Projects --> Videos
Projects --> CareerOpportunities
CareerOpportunities --> Updates
CareerOpportunities --> ApplicationForm
ApplicationForm --> Submitted : [check submitted]

[*] --> BlogsAndNewsUpdates
BlogsAndNewsUpdates --> AccountCreation
AccountCreation --> DetailsCheck
DetailsCheck --> IncorrectDetails : [provided details are incorrect]
AccountCreation --> CompletedRegistration : [details are correct]
CompletedRegistration --> SignIn
SignIn --> PasswordCheck

[*] --> PatientDashboard
PatientDashboard --> MedicalInformation
HealthWorkerDashboard --> Analysis
Analysis --> Alerts
Alerts --> Patient : [alert sent to patient]
Alerts --> HealthWorker : [alert sent to health worker]
PlannedActivities --> HealthWorker
HealthPlanningResults --> GovernmentOfficial
Logout --> LoggedOut
@enduml
