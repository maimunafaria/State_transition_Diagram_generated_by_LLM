@startuml
title ATM Withdrawal State Machine

state "Idle" as Idle
state "Waiting for Selection" as WaitingSelection
state "Dispensing Cash" as DispensingCash
state "Waiting for Custom Amount" as WaitingCustomAmount

[*] --> Idle

Idle --> WaitingSelection : insert card

WaitingSelection --> DispensingCash : select predefined amount
WaitingSelection --> WaitingCustomAmount : enter custom amount

DispensingCash --> Idle : dispense cash
DispensingCash --> [*] : end

WaitingCustomAmount --> DispensingCash : enter custom amount

WaitingSelection --> Idle : cancel
DispensingCash --> Idle : cancel
WaitingCustomAmount --> Idle : cancel

@enduml
