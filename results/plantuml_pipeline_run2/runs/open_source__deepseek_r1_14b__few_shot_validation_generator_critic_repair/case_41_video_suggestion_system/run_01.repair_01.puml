@startuml
title Video Suggestion System State Diagram

[*] --> Idle

state "Idle" as Idle
state "Processing Request" as ProcessingRequest
state "Gathering Suggestions" as GatheringSuggestions
state "Adding Details" as AddingDetails
state "Sending Suggestions" as SendingSuggestions

Idle --> ProcessingRequest : receive request
ProcessingRequest --> GatheringSuggestions : identify user
GatheringSuggestions --> AddingDetails : gather suggestions
AddingDetails --> SendingSuggestions : add details
SendingSuggestions --> [*] : send videos

@enduml
