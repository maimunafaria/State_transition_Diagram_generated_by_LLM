@startuml
title ATM State Machine

state "Ready" as Ready
state CardInserted
state PINEntered
state PINVerified
state ProcessingWithdrawal
state DispensingCash
state CardReturned
state TransactionComplete

[*] --> Ready : Start

Ready --> CardInserted : Insert Card

CardInserted --> PINEntered : Enter PIN

PINEntered --> PINVerified : Verify PIN

PINVerified --> ProcessingWithdrawal : Select Withdrawal

ProcessingWithdrawal --> DispensingCash : Process Withdrawal

DispensingCash --> CardReturned : Dispense Cash and Print Receipt

CardReturned --> TransactionComplete : Return Card

TransactionComplete --> [*] : End
@enduml
