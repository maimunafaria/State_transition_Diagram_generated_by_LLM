@startuml
title Ott Based System Mini Reel State Diagram

[*] --> InitialState

state InitialState {
  [*] --> CreateAccount : createAccount
  [*] --> Login : login
}

state CreateAccount {
  [*] --> AccountCreated : accountCreated / advance
}

state AccountCreated {
  [*] --> LoggedIn :loggedIn / advance
}

state LoggedIn {
  [*] --> WatchingVideo : watchVideo
  [*] --> UploadingVideo : uploadVideo
  [*] --> LikesList : viewLikes
  [*] --> DiscussionOption : enterDiscussion
}

state WatchingVideo {
  [*] --> ContinueWatching : continueWatching
  [*] --> PauseVideo : pauseVideo
  [*] --> AddToLikes : addToLikes / advance
  [*] --> BackToMenu : backToMenu
}

state UploadingVideo {
  [*] --> UploadComplete : uploadComplete / advance
  [*] --> UploadFailed : uploadFailed / rollback
}

state LikesList {
  [*] --> ViewVideo : viewVideo / advance
  [*] --> RemoveFromLikes : removeFromLikes / advance
  [*] --> BackToListMenu : backToListMenu
}

state DiscussionOption {
  [*] --> PostComment : postComment / advance
  [*] --> ViewComments : viewComments / advance
  [*] --> ExitDiscussion : exitDiscussion / advance
}

[state.gif?text=FinalState]

LoggedIn --> FinalState : logout

WatchingVideo --> FinalState : logout

UploadingVideo --> FinalState : logout

LikesList --> FinalState : logout

DiscussionOption --> FinalState : logout

@enduml
