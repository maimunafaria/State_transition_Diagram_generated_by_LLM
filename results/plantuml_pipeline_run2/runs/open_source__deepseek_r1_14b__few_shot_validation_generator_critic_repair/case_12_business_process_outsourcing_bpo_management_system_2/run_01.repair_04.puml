@startuml
title UML State Transition Diagram - BPO Management System

[*] --> Start

state "Start" as StartState
StartState : entry / system starts

choice
    StartState --> SearchByCategory : [select category]
    StartState --> SearchByPriceRange : [select price range]

state SearchByCategory
SearchByCategory : entry / select category filter
SearchByCategory : do / search by category
SearchByCategory : exit / results displayed

state SearchByPriceRange
SearchByPriceRange : entry / select price range filter
SearchByPriceRange : do / search by price range
SearchByPriceRange : exit / results displayed

state DisplayMatchingUsers
DisplayMatchingUsers : entry / show matching users
DisplayMatchingUsers : do / display results
DisplayMatchingUsers : exit / process ends

SearchByCategory --> DisplayMatchingUsers
SearchByPriceRange --> DisplayMatchingUsers

DisplayMatchingUsers --> EndState

state "End" as EndState
EndState : exit / process ends

@enduml
