@startuml
title UML State Transition Diagram - BPO Management System

[*] --> InitialState

state "Initial" as InitialState
InitialState : entry / system starts

choice
    InitialState --> SearchByCategory : [select category]
    InitialState --> SearchByPriceRange : [select price range]

SearchByCategory --> DisplayMatchingUsers
SearchByPriceRange --> DisplayMatchingUsers

DisplayMatchingUsers --> [*] : [process ends]
@enduml
