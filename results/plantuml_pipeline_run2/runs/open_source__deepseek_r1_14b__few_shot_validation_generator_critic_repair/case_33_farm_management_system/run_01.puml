@startuml
title Farm Management System State Diagram

[*] --> Start

state Start
Start --> Login : login attempt

state Login
Login --> MainMenu : successful login

state MainMenu
MainMenu --> MarketConditions : select market conditions
MainMenu --> PestControlPhoto : select pest control
MainMenu --> SoilInfo : select soil info
MainMenu --> WeatherInsights : select weather
MainMenu --> LabourAvailability : select labour availability

state MarketConditions
MarketConditions --> MainMenu : continue
MarketConditions --> EndSession : logout

state PestControlPhoto
PestControlPhoto --> PestControlTechniques : upload photo

state PestControlTechniques
PestControlTechniques --> MainMenu : continue

state SoilInfo
SoilInfo --> MainMenu : continue

state WeatherInsights
WeatherInsights --> MainMenu : continue

state LabourAvailability
LabourAvailability --> MainMenu : continue

state EndSession
EndSession --> [*]

@enduml
