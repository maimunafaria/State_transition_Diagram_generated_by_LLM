@startuml
[*] --> Unauthenticated
Unauthenticated -> Registered : register (success)
Unauthenticated -> AccessDenied : register (failure)
Registered -> LoggedIn : sign in
LoggedIn -> ServicesMenu : access services
ServicesMenu -> symptomCheck : check symptoms
symptomCheck --> ServicesMenu : continue or finish viewing result
ServicesMenu -> PaymentOptions : select payment method
PaymentOptions -> CashPayment : cash
CashPayment --> ServicesMenu : payment completed (cash)
PaymentOptions -> InsurancePayment : insurance
InsurancePayment --> ServicesMenu : payment processed (insurance)
ServicesMenu -> Logout : log out
Logout --> [*] : session ended
AccessDenied --> [*] : access denied
@enduml
