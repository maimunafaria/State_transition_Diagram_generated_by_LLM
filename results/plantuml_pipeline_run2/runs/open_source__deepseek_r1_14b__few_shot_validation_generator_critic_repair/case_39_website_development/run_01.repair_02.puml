@startuml
[*] --> Homepage
Homepage:
    transition "Navbar/Footer" to ProjectsList
    transition "Career" to CareerOptions

ProjectsList:
    transition "Project" to ProjectViewing
    transition "Back" to Homepage

ProjectViewing:
    choice
        [valid] --> PhotosViewing
        [invalid] --> VideosViewing

PhotosViewing:
    transition "Back" to ProjectsList

VideosViewing:
    transition "Back" to ProjectsList

CareerOptions:
    choice
        [view updates] --> CareerUpdates
        [apply] --> ApplicationForm

CareerUpdates:
    transition "Back" to CareerOptions

ApplicationForm:
    transition "Submit" to ApplicationSubmitted

ApplicationSubmitted:
    transition "Check Status" to JobApplicationCheck
    transition "Back" to Homepage

JobApplicationCheck:
    transition "Back" to ApplicationSubmitted

ApplicationSubmitted --> [*]
@enduml
