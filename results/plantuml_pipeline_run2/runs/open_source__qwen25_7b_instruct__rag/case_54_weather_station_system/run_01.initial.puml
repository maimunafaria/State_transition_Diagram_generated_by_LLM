@startuml
title Weather Station System States

[*] --> RestartRunning : [restart]

state "Restart Running" as RestartRunning
state "Configuration Mode" as ConfigurationMode
state "Data Collection" as DataCollection
state "Summary Preparation" as SummaryPreparation
state "Status Checking" as StatusChecking
state "Controlled Mode" as ControlledMode
state "Shutdown" as Shutdown

RestartRunning --> ConfigurationMode : [changes or power-saving settings]
ConfigurationMode --> RestartRunning : [configuration completed]
DataCollection --> RestartRunning : [activity performed]
SummaryPreparation --> RestartRunning : [activity performed]
StatusChecking --> RestartRunning : [activity performed]
ControlledMode --> RestartRunning : [remote control]
Shutdown --> [*] : [shutdown command]

@enduml
