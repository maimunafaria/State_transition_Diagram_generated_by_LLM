@startuml
title ATM Control - Validate PIN and Withdraw Funds

[*] --> Idle

state Idle

state Idle : entry / Display Welcome

state "Checking PIN" as CheckingPIN {
  state "Correct PIN" as CorrectPIN
  state "Incorrect PIN" as IncorrectPIN
}

state CorrectPIN : entry / Verify PIN, Provide Options

state CorrectPIN --> ProcessingTransaction

state IncorrectPIN : entry / Prompt for PIN Again

state IncorrectPIN --> Idle : entry / Display Welcome

state "Card Held" as CardHeld {
  state "User Cancels" as UserCancels
}

state CardHeld : entry / Keep Card, Display Message

state CardHeld --> Idle : entry / Display Welcome

state ProcessingTransaction : entry / Process Withdrawal Request

state ProcessingTransaction : exit / Dispense Cash, Print Receipt, Return Card

state ProcessingTransaction --> Idle : entry / Display Welcome

state Idle : exit / Reset System

@enduml
