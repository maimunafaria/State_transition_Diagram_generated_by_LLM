@startuml
title Microwave Oven Operation

[*] --> DoorShut

state "Door Shut" as DoorShut
state "Door Open" as DoorOpen

DoorShut --> Checking : Check Status
Checking --> Cook : OK
Checking --> Alarm : Turntable Fault
Checking --> Alarm : Emitter Fault

Cook --> Done : Timeout
Cook --> Cook : Time
Cook --> DoorOpen : Door Opened

Alarm --> Disabled

Done --> Waiting : Door Closed

state "Waiting" as Waiting
state "Disabled" as Disabled

DoorOpen --> Disabled : Door Open
Cook --> Disabled : Door Open
Operation --> Disabled : Cancel

@enduml
