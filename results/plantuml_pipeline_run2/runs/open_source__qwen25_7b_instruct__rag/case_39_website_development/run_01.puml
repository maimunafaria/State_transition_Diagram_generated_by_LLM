@startuml
title UML state machine diagram

[*] --> HomePage

state HomePage <<choice>>
HomePage --> Projects : [Select projects]
HomePage --> CareerOpportunities : [Select career opportunities]

state Projects <<choice>>
Projects --> ViewPhotos : [Choose photos]
Projects --> WatchVideos : [Choose videos]

state CareerOpportunities <<choice>>
CareerOpportunities --> ViewUpdates : [Choose updates]
CareerOpportunities --> ApplicationForm : [Open application form]

state ViewUpdates <<choice>>
ViewUpdates --> CheckSubmissions : [Check submitted applications]

@enduml
