@startuml
title UML State Machine Diagram (Weather Monitoring System)

[*] --> RegistrationOrLogin

state RegistrationOrLogin <<choice>>
RegistrationOrLogin --> CreateAccount : [New user]
RegistrationOrLogin --> LoginExisting : [Registered user]

state CreateAccount
CreateAccount --> Success : [Successful registration]
CreateAccount --> Failure : [Failed registration]

state LoginExisting
LoginExisting --> LoggedIn : [Valid login]
LoginExisting --> InvalidLogin : [Invalid login]

state LoggedIn
LoggedIn --> CheckWeather : [Check weather]
LoggedIn --> ViewDetails : [View details]

state CheckWeather
CheckWeather --> ValidLocation : [Valid location]
CheckWeather --> InvalidLocation : [Invalid location]

state ValidLocation
ValidLocation --> SelectInfo : [Select info to check]

state SelectInfo
SelectInfo --> ShowInfo : [Show selected info]

state ViewDetails
ViewDetails --> Logout : [Logout]

@enduml
