@startuml
title UML State Machine Diagram

state StartChoice <<choice>>
state LoginChoice <<choice>>
state ApplyChoice <<choice>>
state ViewStatusChoice <<choice>>
state CancelApplicationChoice <<choice>>
state ModifyDetailsChoice <<choice>>
state ViewDetailsChoice <<choice>>
state CheckStatusChoice <<choice>>
state FeedbackChoice <<choice>>
state LogoutChoice <<choice>>

[*] --> CreateAccount
CreateAccount --> LoggedIn : "User creates an account"
LoggedIn --> Login : "User logs in after creating an account"
LoggedIn --> ApplyForVisa : "User applies for a visa, makes payment and application is accepted"
ApplyForVisa --> ViewStatus : "User views the status of their application"
ViewStatus --> CheckStatus : "User checks the status again"
CheckStatus --> CancelApplication : "User cancels the application after logging in"
LoggedIn --> ModifyDetails : "User modifies their details"
ModifyDetails --> ViewDetails : "User views their details"
ViewDetails --> CheckStatusChoice : "User checks the status based on document check, visa is approved or rejected and then status is updated"
CheckStatusChoice --> Feedback : "User gives feedback after checking the status"
Feedback --> LogoutChoice : "User logs out after modifying details, viewing details, giving feedback, or completing a status update"

@enduml
