@startuml
title UML State Machine Diagram

[*] --> Registration

state Registration
Registration : entry / startRegistration
Registration : exit / registrationComplete

state RegistrationDecision <<choice>>
Registration --> RegistrationDecision

state SignIn
SignIn : entry / verifyUser
SignIn : exit / accessGranted

state AccessAvailableFacilities
AccessAvailableFacilities : entry / grantAccess
AccessAvailableFacilities : exit / sessionEnd

state ReadContent
ReadContent : entry / readNewsOrExpertContent
ReadContent : exit / continueSession

state CheckSymptoms
CheckSymptoms : entry / checkSymptomsOrFitnessOptions
CheckSymptoms : exit / finishSession

state ProcessInsurance
ProcessInsurance : entry / processAndValidateInsurance
ProcessInsurance : exit / paymentComplete

state PaymentMethods
PaymentMethods : entry / selectPaymentMethod
PaymentMethods : exit / completePayment

state FeedbackCollection
FeedbackCollection : entry / collectUserFeedback
FeedbackCollection : exit / sessionEnd

state Logout
Logout : entry / logOutUser
Logout : exit / sessionEnd

@enduml
