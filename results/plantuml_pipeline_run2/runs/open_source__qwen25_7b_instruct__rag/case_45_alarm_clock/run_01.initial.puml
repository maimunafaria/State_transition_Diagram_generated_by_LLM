@startuml
title Alarm Clock State Machine

[*] --> Off

state "Off" as Off {
    [*] --> SetAlarm : set alarm time
}

state "SetAlarm" {
    SetAlarm --> Activate : current time matches alarm time
}

state "Activate" {
    [*] --> Ringing : start ringing
}

state "Ringing" {
    [*] --> Stop : stop alarm
}

Stop --> Off : turn off

Off --> Off : next scheduled alarm time
@enduml
