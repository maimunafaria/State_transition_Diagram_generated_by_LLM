@startuml
title UML State Machine Diagram (Search by Filter)

[*] --> SearchByFilter

state "Search By Filter" as SearchByFilter {
    SearchByFilter : entry / Start search
    SearchByFilter : do / Apply filters
    SearchByFilter : exit / Display results
}

state "Apply Filters" as ApplyFilters <<choice>>

ApplyFilters --> CategoryFilter : [Select category]
ApplyFilters --> PriceRangeFilter : [Select price range]

state "Category Filter" as CategoryFilter {
    CategoryFilter : entry / Select category
    CategoryFilter : do / Apply filter
    CategoryFilter : exit / Display results
}

state "Price Range Filter" as PriceRangeFilter {
    PriceRangeFilter : entry / Select price range
    PriceRangeFilter : do / Apply filter
    PriceRangeFilter : exit / Display results
}

@enduml
