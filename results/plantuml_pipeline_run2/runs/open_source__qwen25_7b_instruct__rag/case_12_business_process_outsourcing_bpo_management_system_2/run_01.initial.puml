@startuml
title UML State Machine Diagram (Search by Filter)

[*] --> SearchByFilter

state "Search by Filter" as SearchByFilter {

    SearchByFilter : entry / Start search
    SearchByFilter : do / Select filter category
    SearchByFilter : exit / Filters selected

    state Choice1 <<choice>>

    Choice1 --> PriceRange : [Select price range]
    Choice1 --> Category : [Select filter category]

    state "Price Range" as PriceRange {
        PriceRange : entry / Start price range selection
        PriceRange : do / Set price range
        PriceRange : exit / Price range set
    }

    state "Category" as Category {
        Category : entry / Start category selection
        Category : do / Select filter category
        Category : exit / Filter category selected
    }
}

state "Display Matching Users" as DisplayMatchingUsers {
    DisplayMatchingUsers : entry / Display results
}

SearchByFilter --> DisplayMatchingUsers : [Submit]
@enduml
