@startuml

[*] --> UserRegistration

state UserRegistration
UserRegistration : entry / start
UserRegistration : exit / completed

state UserLogin
UserLogin : entry / start
UserLogin : do / verifyData
UserLogin : exit / verified

state InventoryManagement
InventoryManagement : entry / start
InventoryManagement : do / addGoods
InventoryManagement : do / updatePrice
InventoryManagement : do / removeGoods
InventoryManagement : do / identifyExpired
InventoryManagement : do / placeOrder
InventoryManagement : do / generateInvoice
InventoryManagement : do / searchItems
InventoryManagement : do / calculateDiscountTax
InventoryManagement : do / generateReceipt
InventoryManagement : do / replaceOrCancel
InventoryManagement : exit / completed

state CustomerSearch
CustomerSearch : entry / start
CustomerSearch : do / selectItems
CustomerSearch : exit / selected

state TransactionSummary
TransactionSummary : entry / start
TransactionSummary : do / viewTransactions
TransactionSummary : exit / viewed

@enduml
