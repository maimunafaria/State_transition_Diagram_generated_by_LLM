@startuml

[*] --> Order

state Order
Order : entry / placePlane
Order : exit / delivered

state Arrival
Arrival : entry / planeArrived
Arrival : exit / transitionPreparation

state Preparation
Preparation : entry / assignCondition
Preparation : exit / readyForOperationsOrMaintenance

state Operations
Operations : entry / hasScheduledFlights
Operations : exit / noMoreScheduledFlights

state Maintenance
Maintenance : entry / checkAndService
Maintenance : exit / readyForPreparation

state OutOfService
OutOfService : entry / planeUnavailable
OutOfService : exit / removedFromOperations

state RemovedFromOperations
RemovedFromOperations : entry / permanentWithdrawal

state TransitionPreparation
TransitionPreparation : entry / transitionToPreparation
TransitionPreparation : exit / preparationComplete

@enduml
