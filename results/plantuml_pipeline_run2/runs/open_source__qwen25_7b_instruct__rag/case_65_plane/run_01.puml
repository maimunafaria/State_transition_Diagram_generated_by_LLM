@startuml

[*] --> Order

state Order
Order : entry / placePlane
Order : exit / delivered

state Arrival
Arrival : entry / planeArrived
Arrival : exit / transitionPreparation

state Preparation
Preparation : entry / assignPlane
Preparation : exit / readyForOperationsOrMaintenance

state Operations
Operations : entry / hasScheduledFlights
Operations : exit / noMoreScheduledFlights

state Maintenance
Maintenance : entry / checkAndService
Maintenance : exit / readyForPreparation

state OutOfService
OutOfService : entry / planeNotAvailable
OutOfService : exit / transitionToPreparationOrOrder

state WithdrawnFromService
WithdrawnFromService : entry / permanentlyWithdrawn

state Preparation --> Operations : [hasScheduledFlights]
state Maintenance --> Operations : [noMoreScheduledFlightsOrMaintenanceRequired]

@enduml
