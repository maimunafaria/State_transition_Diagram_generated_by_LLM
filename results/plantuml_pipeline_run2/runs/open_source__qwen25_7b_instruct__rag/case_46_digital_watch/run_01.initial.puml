@startuml
title Digital Watch UML State Machine Diagram

state "Initial" as init [*]
init --> timeView : View Time
timeView --> hourChange : Change Hour
hourChange --> minuteChange : Change Minute
minuteChange --> alarmHourChange : Change Alarm Hour
alarmHourChange --> alarmMinuteChange : Change Alarm Minute
alarmMinuteChange --> increaseValues : Increase Values
increaseValues --> timeView : Done Adjusting
increaseValues --> alarmOnOff : Turn On/Off Alarm
alarmOnOff --> alarmTimeMatch : Alarm Time Matches Current Time
alarmTimeMatch --> alarmRings : Ring Alarm
alarmRings --> stopAlarm : Stop Alarm
stopAlarm --> timeView : Back to Time View
timeView --> lightOn : Toggle Light On
lightOn --> init : Button Released

@enduml
