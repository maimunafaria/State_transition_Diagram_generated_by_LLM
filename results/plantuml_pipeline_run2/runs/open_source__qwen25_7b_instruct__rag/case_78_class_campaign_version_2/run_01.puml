@startuml
title State machine for Campaign Version 2

state Commissioned
state Active
state Adjusted
state Completed
state Paid
state Archived

[*] --> Commissioned : /assignManager;\nassignStaff

Commissioned --> Active : authorize(authorizationCode)\n[contract signed]\n/setCampaignActive

Active --> Adjusted : extendOrAdjustCampaign

Adjusted --> Active : resumeCampaign

Active --> Completed : [all adverts finished]\n/prepareFinalStatement

Completed --> Paid : [final statement prepared]\n/handlePayment

Paid --> Archived : markAsPaid\n/archiveCampaign

@enduml
