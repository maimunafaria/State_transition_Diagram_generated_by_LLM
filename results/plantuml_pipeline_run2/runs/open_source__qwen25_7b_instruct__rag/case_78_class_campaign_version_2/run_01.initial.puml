@startuml
title State machine for Campaign Version 2

state Commissioned
state Active
state Adjusted
state Completed
state Paid
state Archived

[*] --> Commissioned : /assignManager;\nassignStaff

Commissioned --> Active : authorize(authorizationCode)\n[contract signed]\n/setCampaignActive

Active --> Adjusted : extendCampaign\nadjustBudget

Adjusted --> Active : resumeCampaign

Active --> Completed : finalizeCampaign

Completed --> Paid : prepareFinalStatement

Paid --> Archived : markAsPaid

Archived : releaseStaffAndManagers

@enduml
