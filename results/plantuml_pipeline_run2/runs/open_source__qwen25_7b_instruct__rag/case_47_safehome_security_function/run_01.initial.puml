@startuml
title Safehome Security System State Machine

[*] --> PowerOnCheck

state PowerOnCheck {
    [*] --> StartupProblem : problem detected
    [*] --> StartupReady : everything is fine
}

state StartupProblem {
    StartupProblem --> ReadyToUse : reset
}

state StartupReady {
    [*] --> ReadyToUse : user action
}

state ReadyToUse {
    ReadyToUse --> Activated : activate
    ReadyToUse --> Off : turn off
    Activated --> Monitoring : start monitoring
}

state Monitoring {
    Monitoring --> AlarmActivated : sensor triggered
    Monitoring --> ContinueMonitoring : false alarm or time ends
}

state AlarmActivated {
    AlarmActivated --> AlertsSent : send alerts
    AlarmActivated --> NormalState : password entered
}

state Off {
    Off --> ReadyToUse : turn on
}
@enduml
