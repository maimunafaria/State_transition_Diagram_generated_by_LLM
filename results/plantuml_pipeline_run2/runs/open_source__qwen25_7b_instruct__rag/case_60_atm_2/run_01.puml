@startuml
title ATM Withdrawal Process

[*] --> VerifyCard

state "VerifyCard <<final>>" as VerifyCard

state ReadAmount {
  [*] --> SelectAmount
  state SelectAmount
  SelectAmount --> EnterCustomValue : custom
  EnterCustomValue --> [*] : amount
}

state OutOfService
state "VerifyTransaction <<final>>" as VerifyTransaction
state ReleaseCard

VerifyCard --> ReadAmount : acceptCard
ReadAmount --> VerifyTransaction
VerifyTransaction --> ReleaseCard : verifySuccess / <<final>>

@enduml
