@startuml
title ATM State Machine

[*] --> VerifyCard

state "VerifyCard <<final>>" as VerifyCard

state ReadAmount {
  [*] --> SelectAmount
  state SelectAmount
  SelectAmount --> EnterCustomValue : custom
  EnterCustomValue --> VerifyTransaction : amount
}

state OutOfService
state "VerifyTransaction <<final>>" as VerifyTransaction
state ReEnterAmount

VerifyCard --> ReadAmount : acceptCard
ReadAmount --> OutOfService : outOfService
ReadAmount --> VerifyTransaction
VerifyTransaction --> ReEnterAmount : rejectTransaction
ReEnterAmount --> ReadAmount : amount

@enduml
