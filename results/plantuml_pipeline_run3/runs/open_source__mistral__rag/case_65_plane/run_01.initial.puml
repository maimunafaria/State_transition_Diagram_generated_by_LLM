@startuml

plane_state_machine

state Order
Order : entry / acquirePlane
Order : do / checkAvailability
Order : exit / deliverPlane

state Arrival
Arrival : entry / planeArrives
Arrival : do / checkConditionAndSchedule
Arrival : exit / transitionToPreparation

state Preparation
Preparation : entry / preparePlane
Preparation : do / assignState
Preparation : exit / exitState

state Operations
Operations : entry / scheduledFlights
Operations : do / checkAvailability
Operations : exit / continueOperations

state Maintenance
Maintenance : entry / noMoreScheduledFlightsOrMaintenanceRequired
Maintenance : do / servicePlane
Maintenance : exit / transitionToPreparation

state OutOfService
OutOfService : entry / planeUnavailable
OutOfService : do / removeFromOperations
OutOfService : exit / endProcess

state RemovedFromService
RemovedFromService : entry / permanentlyWithdrawn
RemovedFromService : do / removeFromService
RemovedFromService : exit / endProcess

[*] --> Order

plane_state_machine @enduml
@enduml
