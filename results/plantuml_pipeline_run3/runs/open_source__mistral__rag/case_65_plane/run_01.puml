@startuml

plane_state_machine
title UML State Machine Diagram for Plane

[*] --> Order

state Order
Order : entry / acquirePlane

state Arrival
Arrival : entry / arrivePlane
Arrival : do / checkAvailability
Arrival : exit / isAvailable

state Preparation
Preparation : entry / preparePlane
Preparation : choice / conditionAndSchedule(plane)
Preparation --> Operations[Operations] / scheduleExists
Preparation --> Maintenance[Maintenance] / noScheduleOrMaintenanceRequired

state Operations
Operations : entry / assignToOperations
Operations : do / checkScheduledFlights
Operations : exit / hasScheduledFlights

state Maintenance
Maintenance : entry / assignToMaintenance
Maintenance : choice / maintenanceRequired(plane)
Maintenance --> Preparation[Preparation] / noMaintenanceRequired
Maintenance --> OutOfService[OutOfService] / outOfService

state MaintenanceCheck
MaintenanceCheck : entry / checkAndServicePlane
MaintenanceCheck : do / serviceUntilReady
MaintenanceCheck : exit / readyForOperations

state OutOfService
OutOfService : entry / takeOutOfService
OutOfService : do / removeFromOperations

state PreparationAfterMaintenance
PreparationAfterMaintenance : entry / preparePlaneAfterMaintenance
PreparationAfterMaintenance --> Operations[Operations] / readyForOperations

@enduml
