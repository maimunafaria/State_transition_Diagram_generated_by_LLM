@startuml
title UML State Machine Diagram (BPO Management System)

[*] --> UserLogin

state UserLogin {
    UserLogin : entry / Start
    UserLogin : do / Login or Register
    UserLogin : exit / End
}

UserLogin --> Registration : [New user]
UserLogin --> Login : [Registered user]

state Registration {
    Registration : entry / Start registration
    Registration : do / Enter details
    Registration : exit / Save or Fail

    state DetailsEntry {
        [*] --> Validation

        state Validation {
            Validation : entry / Validate details
            Validation : do / Check details
            Validation : exit / Save or Fail
        }
    }
}

state Login {
    Login : entry / Start login
    Login : do / Enter credentials
    Login : exit / Success or Fail
}

Login --> ProfileManagement : [Successful login]
Login --> Error : [Invalid credentials]

state ProfileManagement {
    ProfileManagement : entry / Start profile management
    ProfileManagement : do / Manage profile
    ProfileManagement : exit / Logout

    state ManageProfile {
        [*] --> ChangePassword
        [*] --> EditDetails

        state ChangePassword {
            ChangePassword : entry / Start change password
            ChangePassword : do / Enter old and new passwords
            ChangePassword : exit / Validate or Fail

            state Validation {
                Validation : entry / Validate details
                Validation : do / Check details
                Validation : exit / Save or Fail
            }
        }

        state EditDetails {
            EditDetails : entry / Start edit details
            EditDetails : do / Enter new details
            EditDetails : exit / Validate or Fail

            state Validation {
                Validation : entry / Validate details
                Validation : do / Check details
                Validation : exit / Save or Fail
            }
        }
    }
}
@enduml
