@startuml
title State machine for Campaign

state Commissioned
state Active
state Paused
state Adjusting
state Completed
state Paid
state Archived

[*] --> Commissioned : /assignManager;\nassignStaff\n/approveContract

Commissioned --> Active : Authorized(authorizationCode)\n[contract signed]\n/setCampaignActive

Active --> Paused : /pauseCampaign
Active --> Adjusting : /extendDuration\n/changeBudget

Adjusting --> Active : /resumeCampaign

Active --> Completed : /finishWork

Completed --> Paid : /calculateCosts\n/prepareFinalStatement\n/handlePayment\n[payment matches due]\n/markAsPaid

Paid --> Archived : /archiveCampaign\n/releaseStaffAndManager

Active --> Completed : /runAdverts

Completed --> Paid : /calculateCosts\n/prepareFinalStatement\n/handlePayment\n[payment does not match due]\n/makeAdjustments\n/markAsPaid

@enduml
