InventoryManagement : do / identifyExpiredGoods
InventoryManagement : do / placeOrderToSupplier
InventoryManagement : do / generateInvoice
InventoryManagement : do / searchItems
InventoryManagement : do / calculateDiscountAndTax
InventoryManagement : do / generateReceipt
InventoryManagement : do / replaceItemOrCancelReceipt
InventoryManagement : do / recordCustomerRequest
InventoryManagement : do / viewTransactionsReport

state MarketplaceManagement
MarketplaceManagement : entry / sellerRegistration
MarketplaceManagement : do / addProducts
MarketplaceManagement : do / promoteProducts
MarketplaceManagement : do / communicateWithCustomers
MarketplaceManagement : do / logout

state TextileProduction
TextileProduction : entry / customerLogin
TextileProduction : do / placeOrder
TextileProduction : do / sendSampleMaterials
