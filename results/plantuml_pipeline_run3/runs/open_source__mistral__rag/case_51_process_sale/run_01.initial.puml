@startuml
title State diagram of the "Process Sale"

[*] --> WaitingCustomer

state "Waiting for customer" as WaitingCustomer
state "Record items" as RecordItems
state "Waiting for payment" as WaitingPayment
state "Completed sale" as CompletedSale

WaitingCustomer --> RecordItems : enter item
RecordItems --> RecordItems : enter item
RecordItems --> WaitingPayment : end of sale
WaitingPayment --> CashPayment : cash payment
WaitingPayment --> CardCheck : card or check payment
CardCheck --> PaymentApproved : approved payment
CardCheck --> PaymentRejected : rejected payment
WaitingPayment --> CompletedSale : completed sale
CashPayment --> CompletedSale : cash payment
CompletedSale --> WaitingCustomer : next customer
@enduml
