@startuml
title Video Suggestion System - UML State Machine Diagram

state StartChoice <<choice>>
state UserRequestVideo
state IdentifyUser
state GatherVideos
state AddDetails
state SendSuggestedVideos

[*] --> StartChoice
StartChoice --> UserRequestVideo : user requests video
UserRequestVideo --> IdentifyUser
IdentifyUser --> IdentifiedUser
IdentifiedUser --> GatherVideos
GatherVideos --> AddDetails
AddDetails --> SendSuggestedVideos
SendSuggestedVideos --> End
@enduml
