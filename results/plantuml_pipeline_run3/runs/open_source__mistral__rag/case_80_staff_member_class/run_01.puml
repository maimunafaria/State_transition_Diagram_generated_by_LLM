@startuml
title Staff Member State Machine

state Unemployed
state AssignedToClient
state AssignedToCampaign
state SwitchingAssignments

[*] --> Unemployed : /leaveJob/

Unemployed --> AssignedToClient : Hired(hiringDetails)
Unemployed --> AssignedToCampaign : CampaignActivated(campaignId)

AssignedToClient --> AssignedToCampaign : SwitchAssignment(assignmentId)
AssignedToCampaign --> SwitchingAssignments : SwitchAssignment(assignmentId)
SwitchingAssignments --> AssignedToClient : SwitchAssignment(assignmentId)
SwitchingAssignments --> AssignedToCampaign : SwitchAssignment(assignmentId)

AssignedToClient --> Unemployed : /leaveJob/
AssignedToCampaign --> Unemployed : /leaveJob/


title Campaign State Machine

state Inactive
state Active
state Completed
state Paid

[*] --> Inactive : /assignManager;\nassignStaff\n/approveContract

Inactive --> Active : ContractSigned(contractId)
Active --> Completed : FinishedWork(workDetails)
Completed --> Paid : PaymentReceived(paymentDetails)
Paid --> Archived : TimePassed(timePeriod)

title Advocate Diary State Machine

state NotRegistered
state Registered
state LoggedIn
state AddingCase
state CaseCreated
state ReminderSet
state DocumentUploaded

[*] --> NotRegistered : /exploreBlogsAndNews/

NotRegistered --> Registered : CreateAccount(accountDetails)
Registered --> LoggedIn : SignIn(signInDetails)
LoggedIn --> AddingCase : NewCaseSelected
AddingCase --> CaseCreated : CategorySelected(category)
CaseCreated --> ReminderSet : SetReminder(reminderDetails)
ReminderSet --> DocumentUploaded : UploadDocument(document)
DocumentUploaded --> LoggedIn : /logout/
@enduml
