@startuml
title ATM Control - Combined Scenarios

[*] --> Idle

state Idle
Idle : entry / Display Welcome

state "Enter PIN"
"Enter PIN" : enterPin(pin)
"Enter PIN" : verifyPin(pin, storedPIN)
"Enter PIN" : checkPinValidity(pin, maxInvalidAttempts)
"Enter PIN" : keepCard(pin, maxInvalidAttempts)
"Enter PIN" --> "Check Card Validity"
"Enter PIN" : returnCard(userCancels)
"Enter PIN" : displayOptions(pinIsCorrect)
"Enter PIN" : processWithdrawalRequest(approved, cashDispensed, receiptPrinted)
"Enter PIN" : checkTransactionApproval(withdrawalRequest)
"Enter PIN" : cancelOperation(rejected)
"Enter PIN" --> "Process Transaction"

state "Processing Transaction" {
  state "Processing Transfer" {
    state "Processing Transfer" : processTransfer(approved, receiptPrinted)
  }

  state "Processing Query" {
    state "Processing Query" : processQuery(approved, receiptPrinted)
  }

  state "Processing Withdrawal" {
    state "Processing Withdrawal" : checkCashAvailability(withdrawalRequest)
    state "Processing Withdrawal" : dispenseCash(cashDispensed)
    state "Processing Withdrawal" : printReceipt(receiptPrinted)
    state "Processing Withdrawal" --> "Return Card"
  }
}

state "Return Card"
"Return Card" : ejectCard()
"Return Card" : resetSystem()
@enduml
