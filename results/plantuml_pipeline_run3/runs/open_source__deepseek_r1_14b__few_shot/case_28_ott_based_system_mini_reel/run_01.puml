@startuml
title UML State Chart Diagram

[*] --> StartChoice <<choice>>

StartChoice --> CreateAccount
StartChoice --> Login

state "Create Account" as CreateUser {
  [*] --> EnterDetails

  state "Enter Details" as EnterDetails
  state "Account Created" as AccountCreated

  EnterDetails --> AccountCreated : [Valid]
}

state "Login" as LoginUser {
  [*] --> EnterUsername

  state "Enter Username" as EnterUsername
  state "Enter Password" as EnterPassword
  state "Successful Login" as SuccessfulLogin
  state "Invalid Credentials" as InvalidCreds

  EnterUsername --> EnterPassword
  EnterPassword --> SuccessfulLogin : [Valid]
  EnterPassword --> InvalidCreds : [Invalid]
}

state "LoggedIn" as LoggedIn {
  [*] --> StartMainMenu

  state "Main Menu" as MainMenu <<choice>>

  MainMenu --> WatchVideo
  MainMenu --> UploadVideo
  MainMenu --> ViewLikes
@enduml
