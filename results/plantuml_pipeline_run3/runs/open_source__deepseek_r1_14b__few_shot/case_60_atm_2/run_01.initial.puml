@startuml
title UML State Chart Diagram - ATM Transaction

[*] --> Initial

state Initial
Initial --> SelectAmount : Start transaction

state "Select amount" as SelectAmount
SelectAmount --> VerifyTransaction : [Predefined amount]
SelectAmount --> EnterCustomAmount : Custom amount

state "Enter custom amount" as EnterCustomAmount
EnterCustomAmount --> VerifyTransaction : [Entered]

state "Verify transaction" as VerifyTransaction
VerifyTransaction --> FinalState : [Approved]
VerifyTransaction --> RejectedState : [Rejected]

state "Rejected state" as RejectedState
RejectedState --> SelectAmount : [Retry]
RejectedState --> [*] : [Exit]

state "Final state" as FinalState
FinalState --> [*] : Complete

@enduml
