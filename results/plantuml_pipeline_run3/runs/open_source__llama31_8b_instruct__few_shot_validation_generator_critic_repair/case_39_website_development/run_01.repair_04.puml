@startuml
title Website State Machine Diagram

state "Homepage" as Homepage
state "Project View" as ProjectView
state "Photo View" as PhotoView
state "Video View" as VideoView
state "Career Opportunities" as CareerOpportunities
state "Update View" as UpdateView
state "Application Form" as ApplicationForm
state "Job Applications" as JobApplications

Homepage --> ProjectView : selectProject
ProjectView --> PhotoView : viewPhotos
ProjectView --> VideoView : viewVideos
PhotoView --> Homepage : returnToHome
VideoView --> Homepage : returnToHome

CareerOpportunities --> UpdateView : viewUpdates
UpdateView --> CareerOpportunities : returnToUpdate
ApplicationForm --> JobApplications : submitApplication

JobApplications --> [*] : applicationSubmitted

Homepage --> CareerOpportunities : selectCareerOpportunities
[*] --> Homepage : initial state

@enduml
