@startuml
title UML State Machine Diagram (Farm Management System)

[*] --> Login

state UserType <<choice>>
UserType --> Login : [New user]
UserType --> Login : [Registered user]

state "Login" as Login {
    [*] --> GettingDetails

    state GettingDetails
    state ChoiceReg <<choice>>
    state "Update Database" as UpdateDB
    state EndInvalid <<choice>>

    GettingDetails --> ChoiceReg : [Registration verification]
    ChoiceReg --> UpdateDB : [valid]
    ChoiceReg --> EndInvalid : [invalid]

    EndInvalid --> Login

    Login : entry / User login
    Login : do / Login process

    UpdateDB --> MainArea : [verified]

    state "Main Area" as MainArea {
        [*] --> ChoiceUser


        state ChoiceUser <<choice>>
        ChoiceUser --> MarketConditions : [Market conditions]
        ChoiceUser --> PestControlHelp : [Pest control help]
        ChoiceUser --> SoilSuggestions : [Soil suggestions]
        ChoiceUser --> WeatherInsights : [Weather insights]
        ChoiceUser --> LabourAvailability : [Labour availability]

        state "Show market conditions" as MarketConditions
        MarketConditions --> MainArea

        state "Show pest control techniques" as PestControlHelp
        PestControlHelp --> MainArea

        state "Provide soil-related suggestions" as SoilSuggestions
        SoilSuggestions --> MainArea

        state "Offer weather insights" as WeatherInsights
        WeatherInsights --> MainArea

        state "Display labour availability details" as LabourAvailability
        LabourAvailability --> MainArea
    }

    MainArea : entry / Main area
    MainArea : do / View results

        ChoiceUser --> Logout : [Logout]

    state Logout {
        [*] --> EndSession

        EndSession --> [*]
    }
}

@enduml
