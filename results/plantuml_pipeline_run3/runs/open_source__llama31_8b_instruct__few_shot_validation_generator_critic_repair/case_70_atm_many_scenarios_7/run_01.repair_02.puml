@startuml
title ATM State Machine Diagram

[*] --> Greeting

state Greeting {
  state "Greet User" as GreetUser
}

GreetUser --> InsertCard : Card Inserted

state InsertCard {
  state "Check PIN" as CheckPIN
}

CheckPIN --> ValidatePIN : PIN Entered / Validate PIN

state ValidatePIN {
  state "Invalid PIN" as InvalidPIN
  state "Valid PIN" as ValidPIN
}

InvalidPIN --> Confiscate : Third Invalid PIN, Card Stolen, Card Expired
Confiscate --> [*] : Card Confiscated

ValidPIN --> DisplayOptions : Correct PIN / Display Options

state DisplayOptions {
  state "Withdraw Money" as WithdrawMoney
  state "Check Information" as CheckInformation
  state "Make Transfer" as MakeTransfer
}

DisplayOptions --> ProcessRequest : User Selected Option

state ProcessRequest {
  state "Process Request" as ProcessRequest
}

ProcessRequest --> [*] : Operation Completed

GreetUser --> Cancel : User Cancels Operation

Cancel --> ReturnCard : Card Returned to User

CheckInformation --> DisplayOptions : User Chooses Check Information
MakeTransfer --> DisplayOptions : User Chooses Make Transfer
WithdrawMoney --> DisplayOptions : User Chooses Withdraw Money

DisplayOptions --> ProcessRequest : User Selected Option

GreetUser --> InsertCard : Card Inserted
InsertCard --> ValidatePIN : PIN Entered / Validate PIN
ValidatePIN --> InvalidPIN : Invalid PIN / Invalid PIN
InvalidPIN --> Confiscate : Third Invalid PIN, Card Stolen, Card Expired
Confiscate --> [*] : Card Confiscated

CheckInformation --> DisplayOptions : User Chooses Check Information
MakeTransfer --> DisplayOptions : User Chooses Make Transfer
WithdrawMoney --> DisplayOptions : User Chooses Withdraw Money

InvalidPIN --> ValidPIN : Correct PIN / Correct PIN
ValidPIN --> DisplayOptions : Correct PIN / Display Options

ProcessRequest --> [*] : Operation Completed

ReturnCard --> [*] : Card Returned to User

@enduml
