@startuml
title E-Ticketing System State Machine

[*] --> CreateAccount

state "Create Account" as CreateAccount
state "Validate Registration" as ValidateRegistration
state "Login" as Login
state "Check Ticket Status" as CheckTicketStatus
state "Book Ticket" as BookTicket
state "Manage Account" as ManageAccount
state "Logout" as Logout
state "Payment" as Payment

CreateAccount --> ValidateRegistration : submit registration form
ValidateRegistration --> Login : successful registration
Login --> CheckTicketStatus : logged in
CheckTicketStatus --> Login : back to login page
Login --> BookTicket : select ticket option
BookTicket --> Payment : confirm payment / <<final>>
Payment --> Login : payment completed

ManageAccount --> Logout : edit or delete account details
Logout --> [*] : logout from system

CreateAccount --> Login : create new account
Login --> ValidateRegistration : log in to validate registration
ValidateRegistration --> CreateAccount : go back to create account
BookTicket --> CheckTicketStatus : book ticket and check status
CheckTicketStatus --> BookTicket : check status after booking ticket
Payment --> ManageAccount : payment completed, manage account

@enduml
