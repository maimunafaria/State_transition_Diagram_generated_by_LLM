@startuml
title State Machine for ATM Scenario 2

state Initial
state SelectAmount
state EnterCustomValue
state VerifyTransaction
state ReEnterAmount
state Final

[*] --> SelectAmount : /selectAmountOption

SelectAmount --> EnterCustomValue : [customValue]
EnterCustomValue --> VerifyTransaction : [verifyTransaction]

VerifyTransaction --> SelectAmount : [transactionRejected]
VerifyTransaction --> Final : [transactionApproved]

ReEnterAmount --> SelectAmount : [reEnterAmount]
SelectAmount --> ReEnterAmount : [reEnterAmount]  // added transition

Final --> [*] : /endSession
@enduml
