@startuml
title UML State Chart Diagram

[*] --> Startup

state "Startup" as Startup {
  [*] --> CheckEverythingWorking
}

state "Check everything working" as CheckEverythingWorking
state "Problem during startup" as ProblemDuringStartup
state "Ready to use" as ReadyToUse

CheckEverythingWorking --> ReadyToUse : Everything is fine
CheckEverythingWorking --> ProblemDuringStartup : Problem found

ProblemDuringStartup --> [*] : Abnormal termination

ReadyToUse {
  state "Reset" as Reset
  state "Activate" as Activate
  state "Turn off" as TurnOff

  ReadyToUse --> Reset : User initiated reset
  ReadyToUse --> Activate : User initiated activation
  ReadyToUse --> TurnOff : User initiated turn off

  state "Monitoring" as Monitoring {
    state "Sensor triggered" as SensorTriggered
    state "False alarm or time ends" as FalseAlarmOrTimeEnds

    Monitoring --> SensorTriggered : Sensor triggered during monitoring
    Monitoring --> FalseAlarmOrTimeEnds : False alarm or time ends

    state "Alarm and alerts sent" as AlarmAndAlertsSent {
      SensorTriggered --> AlarmAndAlertsSent : Send alarm and alerts
    }

    FalseAlarmOrTimeEnds --> ReadyToUse : Continue monitoring
  }

  ReadyToUse --> Monitoring : User initiated activation

  state "Password entered" as PasswordEntered {
    ReadyToUse --> PasswordEntered : User enters password at any time
  }

  PasswordEntered --> [*] : Abnormal termination
}

@enduml
