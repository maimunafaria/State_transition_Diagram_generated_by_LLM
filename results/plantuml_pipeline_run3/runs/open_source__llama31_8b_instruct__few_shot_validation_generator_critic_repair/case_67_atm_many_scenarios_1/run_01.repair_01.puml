@startuml
title ATM State Machine Diagram

[*] --> CI : newCardInserted()

state "Card Inserted" as CI {
  CI --> PE : cardInserted()
}

state "PIN Entry" as PE {
  PE --> PV : pinEntered()
}

state "PIN Verification" as PV {
  PV --> Suc : pinVerified()
  state "Failed" as Failed

  Failed --> RT : invalidPinEntered()

  state "Retry" as RT {
    RT --> PE : retryPinEntry()
  }
}

state "Successful" as Suc {
  Suc --> Opt : successfulVerification()
  state "Options" as Opt {
    Opt --> WD : withdrawalOptionSelected()
    state "Withdrawal" as WD

    WD --> CI : cashDispensed()
    WD --> RC : transactionCompleted()
  }

  state "Return Card" as RC {
    RC --> RA : cardReturned()
  }
}

state "Reset ATM" as RA {
  RA --> RFN : resetATM()
}

ReadyForNextUser --> CI : newCardInserted()

@enduml
