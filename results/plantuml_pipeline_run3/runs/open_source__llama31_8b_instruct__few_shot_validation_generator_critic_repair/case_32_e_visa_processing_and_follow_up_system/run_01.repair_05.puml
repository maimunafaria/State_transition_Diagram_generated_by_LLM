@startuml
title E-Visa Processing and Follow-up System State Diagram

[*] --> Login : User creates account

state CreateAccount as Login {
  state ApplyForVisa as ApplyForVisa
  state ViewStatus as ViewStatus
  state CancelApplication as CancelApplication
  state ModifyDetails as ModifyDetails
  state ViewDetails as ViewDetails
  state ViewPurpose as ViewPurpose
  state GiveFeedback as GiveFeedback
}

state ApplyForVisa as ApplyForVisa {
  state PaymentMade as PaymentMade
  state ApplicationAccepted as ApplicationAccepted
}

state ViewStatus as ViewStatus {
  state CheckStatus as CheckStatus
}

state CancelApplication as CancelApplication {
  state ApplicationCancelled as ApplicationCancelled
}

state ModifyDetails as ModifyDetails {
  state DetailsModified as DetailsModified
}

state ViewDetails as ViewDetails {
  state DetailsViewed as DetailsViewed
}

state ViewPurpose as ViewPurpose {
  state PurposeViewed as PurposeViewed
}

state GiveFeedback as GiveFeedback {
  state FeedbackGiven as FeedbackGiven
}

Login --> ApplyForVisa : User applies for visa
ApplyForVisa --> PaymentMade : Payment made
PaymentMade --> ApplicationAccepted : Application accepted
ApplicationAccepted --> ViewStatus : Status updated

ViewStatus --> CheckStatus : User checks status
CheckStatus --> GiveFeedback : User gives feedback
GiveFeedback --> Login : User logs out after giving feedback

Login --> CancelApplication : User cancels application
CancelApplication --> ApplicationCancelled : Application cancelled
ApplicationCancelled --> Login : User logs out after cancelling application

Login --> ModifyDetails : User modifies details
ModifyDetails --> DetailsModified : Details modified
DetailsModified --> ViewDetails : User views details
ViewDetails --> DetailsViewed : Details viewed
DetailsViewed --> Login : User logs out after viewing details

Login --> ViewPurpose : User views purpose of application
ViewPurpose --> PurposeViewed : Purpose viewed
PurposeViewed --> Login : User logs out after viewing purpose

ApplicationAccepted --> [*] : Visa approved
ApplicationCancelled --> [*] : Application cancelled
DetailsModified --> [*] : Details modified
DetailsViewed --> [*] : Details viewed
FeedbackGiven --> [*] : Feedback given
GiveFeedback --> [*] : Status updated
Login --> [*] : User logs out
ModifyDetails --> [*] : User modifies details
PaymentMade --> [*] : Payment made
PurposeViewed --> [*] : Purpose viewed
ViewDetails --> [*] : Details viewed
ViewPurpose --> [*] : Purpose viewed

[*] --> Login : Initial transition

Login --> End : Final transition

@enduml
