@startuml
title UML state machine diagram

[*] --> Search

state "Search" as Search {
  state "Select Filter Category" as SelectFilterCategory
  SelectFilterCategory : entry/when user selects filter category
  SelectFilterCategory : do/display matching users based on chosen criteria
  SelectFilterCategory : exit/after search is completed

  state "Select Price Range" as SelectPriceRange
  SelectPriceRange : entry/when user selects price range
  SelectPriceRange : do/display matching users based on chosen criteria
  SelectPriceRange : exit/after search is completed
}

Search --> [*]

@enduml
