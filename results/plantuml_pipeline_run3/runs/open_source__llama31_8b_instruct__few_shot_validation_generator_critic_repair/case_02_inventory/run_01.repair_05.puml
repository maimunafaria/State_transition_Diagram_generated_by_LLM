@startuml
title Inventory System State Machine

[*] --> AddGoods

state "Add Goods" as AddGoods {
  AddGoods --> UpdatePrice : addGoodsSelected()
  state "Update Price" as UpdatePrice

  UpdatePrice --> RemoveGoods : removeGoodsSelected()

  RemoveGoods --> IdentifyExpiredGoods : identifyExpiredGoods()
  state "Identify Expired Goods" as IdentifyExpiredGoods

  IdentifyExpiredGoods --> NotifyUser : notifyUserAboutRemoval()
  state "Notify User" as NotifyUser

  NotifyUser --> PlaceOrder : placeOrderSelected()
  state "Place Order" as PlaceOrder

  PlaceOrder --> GenerateInvoice : generateInvoiceForOrder()

  GenerateInvoice --> SearchItems : searchItemsSelected()
  state "Search Items" as SearchItems

  SearchItems --> SelectItemsForPurchase : selectItemsForPurchase()

  SelectItemsForPurchase --> CalculateDiscountAndTax : calculateDiscountAndTax()
  state "Calculate Discount and Tax" as CalculateDiscountAndTax

  CalculateDiscountAndTax --> GenerateReceipt : generateReceiptForCustomer()

  GenerateReceipt --> ReplaceItemOrCancelReceipt : replaceItemOrCancelReceiptSelected()
  state "Replace Item or Cancel Receipt" as ReplaceItemOrCancelReceipt

  ReplaceItemOrCancelReceipt --> RecordCustomerRequest : recordCustomerRequest()

  RecordCustomerRequest --> ViewSummaryReport : viewSummaryReport()
  state "View Summary Report" as ViewSummaryReport

  ViewSummaryReport --> [*]
}

RemoveGoods --> NotifyUser
PlaceOrder --> GenerateInvoice
SearchItems --> SelectItemsForPurchase
CalculateDiscountAndTax --> GenerateReceipt
ReplaceItemOrCancelReceipt --> RecordCustomerRequest

@enduml
