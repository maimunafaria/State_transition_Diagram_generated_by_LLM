@startuml
title Microwave Oven Operation

[*] --> DoorShut

state "Door Shut" as DoorShut
state "Door Open" as DoorOpen

DoorShut --> DoorOpen : Door Opened
DoorOpen --> DoorShut : Door Closed

state Waiting {
  state DisplayTime
  state PowerSelection
  state TimeEntry
  state Cooking
}

Waiting --> DisplayTime : Initial State
DisplayTime --> PowerSelection : User Input
PowerSelection --> TimeEntry : Set Power
TimeEntry --> Cooking : Set Time

Cooking --> Cooking : Run for Set Time
Cooking --> Stop : Door Opened
Stop --> Waiting : Operation Stopped

@enduml
