@startuml
title Microwave Oven Operation

[*] --> DoorShut

state "Door Shut" as DoorShut
state "Door Open" as DoorOpen

DoorShut --> DoorOpen : Door Opened
DoorOpen --> DoorShut : Door Closed

state Waiting {
  [*] --> TimeSet
  TimeSet : do / Set Cooking Time
  TimeSet --> PowerSelect : Select Power Level
  PowerSelect : do / Choose Power Level
  PowerSelect --> Cook : Full Power
  PowerSelect --> Cook : Half Power
}

Cook {
  state "Cooking" as Cooking
  state "Stopped" as Stopped

  DoorOpen --> Stopped : Door Opened
  Stopped : do / Stop Operation
  Stopped --> Waiting : Cancel
  Stopped --> TimeSet : Resume
}

DoorShut --> TimeSet : Door Closed

@enduml
