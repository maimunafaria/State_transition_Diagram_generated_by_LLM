@startuml
title Safehome Security System State Machine

[*] --> PowerOnCheck

state PowerOnCheck {
    [*] --> StartupProblem : problem detected
    [*] --> StartupReady : everything is fine
}

state StartupProblem {
    StartupProblem --> ReadyToUse : reset
}

state StartupReady {
    [*] --> ResetAllowed : reset allowed
    [*] --> ActivateAllowed : activate allowed
    [*] --> TurnOffAllowed : turn off allowed
    ActivateAllowed --> MonitoringStart : activated
}

state MonitoringStart {
    MonitoringStart --> AlarmTriggered : sensor triggered
    MonitoringStart --> ContinueMonitoring : false alarm or time ends
}

state AlarmTriggered {
    AlarmTriggered --> SendAlerts : send alerts
    SendAlerts --> ContinueMonitoring : continue monitoring
}

state ContinueMonitoring {
    [*] --> TurnOffAllowed : turn off allowed
}

state ReadyToUse

@enduml
