@startuml
title UML State Machine Diagram

[*] --> R1 : [create account]

state R1 <<choice>>
state R2 <<choice>>

R1 --> R2 : [validate registration]
R2 --> L1 : [log in]

state L1 <<choice>>
state L2 <<choice>>

L1 --> L2 : [check ticket status]
L2 --> B1 : [book ticket]

state B1 <<choice>>
state P1 <<choice>>

B1 --> P1 : [confirm and make payment]
P1 --> A1 : [manage account details]
A1 --> L3 : [log out]

state L3 <<choice>>

@enduml
