@startuml
title UML state machine diagram

[*] --> Login

state Login <<choice>>
Login --> MarketConditions : [Select market condition]
Login --> PestControlHelp : [Select pest control help]
Login --> SoilSuggestions : [Provide soil information]
Login --> WeatherInsights : [Enter location for weather insights]
Login --> LabourAvailability : [Enter location for labour availability]

state MarketConditions
MarketConditions --> DisplayMarketReport

state PestControlHelp
PestControlHelp --> ProvidePhoto : [Require photo]
ProvidePhoto --> ShowTechniques : [Select pest control help]

state SoilSuggestions
SoilSuggestions --> ShowSuggestions

state WeatherInsights
WeatherInsights --> ShowInsights

state LabourAvailability
LabourAvailability --> DisplayDetails

Login --> LoginSuccess : [Sign in successfully]

state LoginSuccess <<choice>>
LoginSuccess --> Continue : [Continue using the service]
LoginSuccess --> Logout : [Log out]

@enduml
