@startuml
title UML State Machine Diagram

state StartLogin <<choice>>
state TeacherChoice <<choice>>
state StudentChoice <<choice>>
state QuizSelection <<choice>>
state AnsweringQuiz <<choice>>
state SubmittingQuiz <<choice>>
state ViewingResults <<choice>>

[*] --> StartLogin

StartLogin --> TeacherChoice : "Log in as teacher"
StartLogin --> StudentChoice : "Log in as student"

TeacherChoice --> CreateQuiz
TeacherChoice --> EditQuiz
TeacherChoice --> SaveDraftOrPost : "Save as draft or post quiz"

StudentChoice --> SelectQuiz
StudentChoice --> AnswerQuiz
StudentChoice --> SubmitQuiz
StudentChoice --> ViewResults

CreateQuiz --> EditQuiz
EditQuiz --> SaveDraftOrPost

ViewingResults

@enduml
