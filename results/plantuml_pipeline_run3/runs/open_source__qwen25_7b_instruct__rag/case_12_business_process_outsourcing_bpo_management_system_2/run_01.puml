@startuml
title UML State Machine Diagram (Search Filter)

[*] --> SearchCriteria

state "SearchCriteria" as SearchCriteria {
    SearchCriteria --> FilterCategory : [Select filter category]
    SearchCriteria --> PriceRange : [Select price range]
}

state "FilterCategory" as FilterCategory {
    FilterCategory --> MatchingUsers : [Display matching users based on chosen criteria]
}

state "PriceRange" as PriceRange {
    PriceRange --> MatchingUsers : [Display matching users based on chosen criteria]
}

state "MatchingUsers" as MatchingUsers {
    MatchingUsers --> SearchCriteria : [Back to search criteria]
}
@enduml
