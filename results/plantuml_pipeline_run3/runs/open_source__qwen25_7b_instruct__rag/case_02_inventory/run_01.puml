@startuml

[*] --> UserRegistration

state UserRegistration
UserRegistration : entry / start
UserRegistration : exit / complete

state UserLogin
UserLogin : entry / verifyCredentials
UserLogin : do / checkCredentials
UserLoginDecision <<choice>>
UserLogin --> UserLoginDecision

state InventoryManagement
InventoryManagement : entry / initialize
InventoryManagement : addGoods / addNewGoods
InventoryManagement : updatePrice / updateExistingItems
InventoryManagement : removeGoods / removeUnnecessaryItems
InventoryManagement : identifyExpired / detectExpiredItems
InventoryManagement : placeOrder / requestSuppliersForMoreStock
InventoryManagement : generateInvoice / createInvoiceForOrder

state OrderPlacement
OrderPlacement : entry / startOrderProcess
OrderPlacement : searchItems / findAvailableItems
OrderPlacement : selectItems / chooseItemsForPurchase
OrderPlacement : calculateDiscountAndTax / applyDiscountsAndTaxes
OrderPlacement : generateReceipt / issueCustomerReceipt

state TransactionSummary
TransactionSummary : entry / displayTransactions
TransactionSummary : exit / showSummaryReport

@enduml
