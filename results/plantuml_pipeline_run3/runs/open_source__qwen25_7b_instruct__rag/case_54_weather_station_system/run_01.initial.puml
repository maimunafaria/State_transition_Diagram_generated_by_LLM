@startuml
title Weather Station System States

[*] --> Restart : [restart]

state "Restart" as Restart
state "Running" as Running
state "Configuring" as Configuring
state "SummaryPreparation" as SummaryPreparation
state "StatusChecking" as StatusChecking
state "ControlledMode" as ControlledMode
state "Shutdown" as Shutdown

Restart --> Running : [start running]
Running --> Configuring : [configuration required]
Configuring --> Running : [configuration completed]
Running --> SummaryPreparation : [request summary]
SummaryPreparation --> Running : [summary prepared]
Running --> StatusChecking : [request status]
StatusChecking --> Running : [status checked]
Running --> ControlledMode : [remote control]
ControlledMode --> Shutdown : [shutdown command]

Shutdown --> [*] : [power off]

@enduml
