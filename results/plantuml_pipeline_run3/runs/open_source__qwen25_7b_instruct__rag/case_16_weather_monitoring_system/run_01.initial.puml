@startuml
title UML State Machine Diagram (Weather Monitoring System)

[*] --> RegistrationOrLogin

state RegistrationOrLogin <<choice>>
RegistrationOrLogin --> CreateAccount : [New user]
RegistrationOrLogin --> ExistingUser : [Registered user]

state CreateAccount
CreateAccount --> AccountCreated : [successful registration]
CreateAccount --> RegistrationFailed : [invalid details]

state AccountCreated
AccountCreated --> Login : [log in]

state ExistingUser
ExistingUser --> LoginSuccess : [valid login]
ExistingUser --> LoginFailed : [invalid login]

state LoginSuccess
LoginSuccess --> CheckWeather : [check weather]

state CheckWeather
CheckWeather --> LocationValid : [valid location]
CheckWeather --> LocationInvalid : [invalid location]

state LocationValid
LocationValid --> WeatherChoice : [choose what to check]

state WeatherChoice
WeatherChoice --> WeatherInfo : [selected info]
WeatherChoice --> AdditionalDetails : [view details]

state WeatherInfo
WeatherInfo --> ShowInfo : [update and show selected weather information]

state AdditionalDetails
AdditionalDetails --> Alerts : [alerts]
AdditionalDetails --> WeeklyAnalysis : [weekly analysis]
AdditionalDetails --> FuturePrediction : [future prediction]
AdditionalDetails --> Graph : [graph]

state ShowInfo
ShowInfo --> Logout : [log out]

state LocationInvalid
LocationInvalid --> RegistrationOrLogin

@enduml
