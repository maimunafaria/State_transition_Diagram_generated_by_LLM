@startuml
title UML State Machine Diagram (Weather Monitoring System)

[*] --> RegistrationOrLogin

state RegistrationOrLogin <<choice>>
RegistrationOrLogin --> CreateAccount : [New user]
RegistrationOrLogin --> LoginExisting : [Registered user]

state CreateAccount
CreateAccount --> Success : [registration successful]
CreateAccount --> EndProcess : [registration not successful]

state LoginExisting
LoginExisting --> LoggedIn : [login successful]
LoginExisting --> EndProcess : [login failed]

state LoggedIn
LoggedIn --> CheckWeatherCurrent : [check current location]
LoggedIn --> CheckWeatherAnother : [check another location]

state CheckWeatherCurrent
CheckWeatherCurrent --> ValidLocation : [location valid]
CheckWeatherCurrent --> InvalidLocation : [location invalid]

state CheckWeatherAnother
CheckWeatherAnother --> ValidLocation : [location valid]
CheckWeatherAnother --> InvalidLocation : [location invalid]

state ValidLocation
ValidLocation --> ChooseInfoType : [choose info type]

state ChooseInfoType
ChooseInfoType --> ShowInfo : [show selected info]
ChooseInfoType --> EndSession : [end session]

state InvalidLocation
InvalidLocation --> EndProcess : [process ended]

state ShowInfo
ShowInfo --> ViewDetails : [view details]

state ViewDetails
ViewDetails --> EndSession : [end session]

@enduml
