@startuml
title UML State Chart Diagram


[*] --> Login

state Login
Login : entry / display journey details
Login : do / view journey details
Login : exit / user selects action

state "User Action" as UserAction <<choice>>
Login --> UserAction

state "Activate Driving Mode" as ActivateDrivingMode
UserAction --> ActivateDrivingMode

state "Select Place to Eat" as SelectPlaceToEat
UserAction --> SelectPlaceToEat

state AccidentNotification
UserAction --> AccidentNotification : inform authorities in case of accident

state Notification
UserAction --> Notification : send notifications during driving or in case of an accident

state Feedback
UserAction --> Feedback : provide feedback upon journey completion


@enduml
