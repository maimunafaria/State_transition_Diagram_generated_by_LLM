@startuml
title UML State Machine Diagram

[*] --> Registration

state Registration
Registration : entry / startRegistration
Registration : exit / registrationComplete

state RegistrationDecision <<choice>>
Registration --> RegistrationDecision

state SignIn
SignIn : entry / verifyCredentials
SignIn : exit / signInSuccess

state AccessFacilities
AccessFacilities : entry / grantAccess
AccessFacilities : exit / sessionEnd

state ReadContent
ReadContent : entry / readNewsOrExpertContent
ReadContent : exit / continueSession

state CheckSymptoms
CheckSymptoms : entry / checkSymptomsOrFitnessOptions
CheckSymptoms : exit / endSession

state InsuranceProcessing
InsuranceProcessing : entry / processAndValidateInsurance
InsuranceProcessing : exit / paymentComplete

state PaymentSelection
PaymentSelection : entry / selectPaymentMethod
PaymentSelection : exit / completePayment

state FeedbackCollection
FeedbackCollection : entry / collectUserFeedback
FeedbackCollection : exit / sessionEnd

state Logout
Logout : entry / logOutUser
Logout : exit / sessionEnd

@enduml
