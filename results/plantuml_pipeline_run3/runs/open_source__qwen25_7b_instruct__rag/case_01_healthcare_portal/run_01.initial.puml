@startuml
title UML State Machine Diagram

[*] --> Registration

state Registration
Registration : entry / startRegistration
Registration : exit / registrationComplete

state RegistrationFailure <<choice>>
Registration --> RegistrationFailure

state SignIn
SignIn : entry / verifyCredentials
SignIn : exit / signInSuccess

state FacilityAccess
FacilityAccess : entry / grantAccess
FacilityAccess : exit / sessionEnd

state NewsAndContent
NewsAndContent : entry / readContent
NewsAndContent : exit / continueSession

state SymptomCheck
SymptomCheck : entry / checkSymptoms
SymptomCheck : exit / finishSession

state InsuranceProcessing
InsuranceProcessing : entry / processInsurance
InsuranceProcessing : exit / paymentComplete

state PaymentSelection
PaymentSelection : entry / selectPaymentMethod
PaymentSelection : exit / completePayment

state FeedbackCollection
FeedbackCollection : entry / collectFeedback
FeedbackCollection : exit / sessionEnd

state Logout
Logout : entry / logOutUser
Logout : exit / sessionEnd

@enduml
