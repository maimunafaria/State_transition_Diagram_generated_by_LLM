@startuml
title Alarm Clock State Machine

[*] --> Off

state "Off" as Off {
    [*] --> SetAlarmTime : set alarm time
}

state "SetAlarmTime" as SetAlarmTime {
    SetAlarmTime --> Activated : activate
}

state "Activated" as Activated {
    Activated --> Ringing : current time matches alarm time
}

state "Ringing" as Ringing {
    [*] --> Stopped : stop ringing
}

Stopped --> Off : next scheduled alarm

@enduml
