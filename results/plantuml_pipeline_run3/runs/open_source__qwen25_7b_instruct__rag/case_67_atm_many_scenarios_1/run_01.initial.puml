@startuml
title ATM Control - Validate PIN and Withdraw Funds

[*] --> Idle

state Idle

state "Checking PIN" as CheckingPIN {
  state "Correct PIN" as CorrectPIN
  state "Incorrect PIN" as IncorrectPIN
}

state "Processing Transaction" as ProcessingTransaction

state "Dispensing Cash" as DispensingCash

state "Printing Receipt" as PrintingReceipt

state "Returning Card" as ReturningCard

state Idle : entry / Display Welcome

CheckingPIN --> CorrectPIN : Verify PIN
CorrectPIN --> ProcessingTransaction : Provide Options
ProcessingTransaction --> DispensingCash : Process Withdrawal Request
DispensingCash --> PrintingReceipt : Print Receipt
PrintingReceipt --> ReturningCard : Return Card
ReturningCard --> Idle : Reset System

state "Incorrect PIN" : entry / Keep Card for Security
IncorrectPIN --> Idle : User Cancels or Card Invalid

state "Transaction Rejected" as TransactionRejected {
  state "Cancel Operation" as CancelOperation
}

ProcessingTransaction --> TransactionRejected : Request Rejected
TransactionRejected --> ReturningCard : Return Card with Message

state "Out of Cash" as OutOfCash
OutOfCash --> Idle : Stop Operation

@enduml
