@startuml
title ATM Control - Validate PIN and Withdraw Funds

[*] --> Idle

state Idle

state "Checking PIN" as CheckingPIN {
  state "Correct PIN" as CorrectPIN
  state "Incorrect PIN" as IncorrectPIN
}

state "Processing Transaction" as ProcessingTransaction

state "Dispensing Cash" as DispensingCash

state "Printing Receipt" as PrintingReceipt

state "Returning Card" as ReturningCard

state "Resetting System" as ResettingSystem

Idle --> CheckingPIN : Insert Card

CheckingPIN --> CorrectPIN : Verify PIN

CorrectPIN --> ProcessingTransaction : Provide Options

ProcessingTransaction --> DispensingCash : User Approves Withdrawal

DispensingCash --> PrintingReceipt : Dispense Cash

PrintingReceipt --> ReturningCard : Print Receipt

ReturningCard --> ResettingSystem : Return Card

ResettingSystem --> Idle : System Resets

CheckingPIN --> IncorrectPIN : PIN Incorrect

IncorrectPIN --> CheckingPIN : Ask for PIN Again

IncorrectPIN --> ReturningCard : Keep Card Secure, User Cancels

@enduml
