@startuml
title UML state machine diagram

[*] --> HomePage

state HomePage <<choice>>
HomePage --> Projects : [Select projects]
HomePage --> CareerOpportunities : [Select career opportunities]

state Projects <<choice>>
Projects --> Photos : [View photos]
Projects --> Videos : [Watch videos]
Photos --> ProjectInfo : [Display info]
Videos --> ProjectInfo : [Display info]

state CareerOpportunities <<choice>>
CareerOpportunities --> Updates : [View updates]
CareerOpportunities --> ApplicationForm : [Open application form]
Updates --> CareerInfo : [Display info]
ApplicationForm --> JobApplications : [Submit applications]
JobApplications --> CheckSubmissions : [Check submitted job applications]

@enduml
