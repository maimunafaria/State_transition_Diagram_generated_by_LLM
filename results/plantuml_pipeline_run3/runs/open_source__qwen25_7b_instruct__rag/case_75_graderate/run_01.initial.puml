@startuml
title State diagram for Graderate

[*] --> WaitingStart

state WaitingStart as ws
state Active as a
state Expired as e
state Archived as ar

ws --> ws : "Current Date < Start Date"
ws --> a  : "Current Date >= Start Date && Current Date <= End Date"
a --> a   : "Current Date <= End Date"
e --> ar  : "Current Date > End Date + 1 Year"

@enduml
