@startuml
title Farm Management System State Machine

[*] --> Start

state "Start" as Start

state LoginState
LoginState : entry / enter credentials
LoginState : do / validate user
LoginState : exit / proceed to main menu

state MainMenu
MainMenu : entry / display options
MainMenu : do / select option
MainMenu : exit / transition based on selection

state MarketCondition
MarketCondition : entry / check market conditions
MarketCondition : do / show report
MarketCondition : exit / return to main menu

state PestControl
PestControl : entry / request photo
PestControl : do / upload photo
PestControl : do / show techniques
PestControl : exit / return to main menu

state SoilAnalysis
SoilAnalysis : entry / request soil info
SoilAnalysis : do / receive info
SoilAnalysis : do / suggest crops
SoilAnalysis : exit / return to main menu

state WeatherReport
WeatherReport : entry / request location
WeatherReport : do / provide weather data
WeatherReport : exit / return to main menu

state LabourAvailability
LabourAvailability : entry / request location
LabourAvailability : do / show availability
LabourAvailability : exit / return to main menu

state EndSession
EndSession : entry / log out
EndSession : do / terminate session
EndSession : exit / back to start

Start --> LoginState
LoginState --> MainMenu

MainMenu --> MarketCondition : select market conditions
MainMenu --> PestControl : select pest control
MainMenu --> SoilAnalysis : select soil analysis
MainMenu --> WeatherReport : select weather report
MainMenu --> LabourAvailability : select labour availability

MarketCondition --> MainMenu : view report
PestControl --> MainMenu : done with techniques
SoilAnalysis --> MainMenu : viewed suggestions
WeatherReport --> MainMenu : viewed weather data
LabourAvailability --> MainMenu : viewed availability

LoginState --> MainMenu : successful login

MainMenu --> EndSession : log out

EndSession --> [*]
@enduml
