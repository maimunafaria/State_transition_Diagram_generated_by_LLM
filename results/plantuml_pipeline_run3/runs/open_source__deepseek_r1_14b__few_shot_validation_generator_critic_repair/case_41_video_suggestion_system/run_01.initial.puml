@startuml
title Video Suggestion System State Machine

state "Initial" as Initial
state "User Identification" as UserIdentification
state "Video Gathering" as VideoGathering
state "Adding Details" as AddingDetails
state "Videos Sent" as VideosSent

[*] --> Initial : start

Initial --> UserIdentification : videoSuggestionRequest()

UserIdentification --> VideoGathering : gatherVideosBasedOnProfile()

VideoGathering --> AddingDetails : addVideoDetails()

AddingDetails --> VideosSent : sendSuggestedVideos()

VideosSent --> [*] : processComplete()
@enduml
