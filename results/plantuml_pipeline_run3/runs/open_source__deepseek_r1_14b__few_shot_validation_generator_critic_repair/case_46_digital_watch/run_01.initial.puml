@startuml
title UML State Machine Diagram - Digital Watch

[*] --> NormalMode

state "Normal Mode" as NormalMode
state "Adjusting Time" as AdjustingTime
state "Setting Alarm" as SettingAlarm
state "Alarm On" as AlarmOn
state "Alarm Ringing" as AlarmRinging
state "Light On" as LightOn

NormalMode --> AdjustingTime : [Press button to adjust time]
NormalMode --> SettingAlarm : [Press button to set alarm]
NormalMode --> LightOn : [Press light button]

AdjustingTime --> NormalMode : [Done adjusting]
SettingAlarm --> NormalMode : [Done setting]

AlarmOn --> AlarmRinging : [Current time matches alarm time]
AlarmRinging --> NormalMode : [Alarm stopped by user]

LightOn --> NormalMode : [Light button released]

@enduml
