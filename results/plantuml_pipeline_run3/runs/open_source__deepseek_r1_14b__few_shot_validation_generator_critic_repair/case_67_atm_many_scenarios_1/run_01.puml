@startuml
title ATM State Transition Diagram

[*] --> Ready

state "Ready" as Ready
state "Waiting for PIN" as WaitingForPIN
state "PIN Verified" as PINVerified
state "User Options" as UserOptions
state "Processing Withdrawal" as ProcessingWithdrawal
state "Dispensing Cash" as DispensingCash
state "Printing Receipt" as PrintingReceipt
state "Returning Card" as ReturningCard
state "Resetting" as Resetting

Ready --> WaitingForPIN : Insert card
WaitingForPIN --> PINVerified : Enter PIN
PINVerified --> UserOptions : Options provided
UserOptions --> ProcessingWithdrawal : Approve withdrawal
ProcessingWithdrawal --> DispensingCash : Process completed
DispensingCash --> PrintingReceipt : Cash dispensed
PrintingReceipt --> ReturningCard : Receipt printed
ReturningCard --> Resetting : Card returned
Resetting --> [*] : System reset

@enduml
