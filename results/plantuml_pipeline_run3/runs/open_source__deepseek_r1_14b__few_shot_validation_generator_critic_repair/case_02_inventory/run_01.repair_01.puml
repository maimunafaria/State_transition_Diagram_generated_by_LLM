@startuml
title Inventory Management State Diagram

[*] --> Start : System initialization

state Start {
  entry / system ready for input
  do / display main menu
}

state AddNewItem {
  entry / user selects add new item
  do / add new goods to inventory
  exit / return to main menu
}

state UpdatePrice {
  entry / user selects update price
  do / modify existing item price
  exit / return to main menu
}

state RemoveItem {
  entry / user selects remove item
  do / delete unwanted items
  exit / return to main menu
}

state SearchInventory {
  entry / user selects search items
  do / find available goods
  exit / display results or return to menu
}

state PlaceOrder {
  entry / user places order request
  do / send order to supplier
  exit / generate invoice
}

state GenerateInvoice {
  entry / order processing complete
  do / create and display invoice
  exit / return to main menu
}

state PurchaseSelectedItem {
  entry / user selects purchase option
  do / select items for buying
  exit / proceed to billing
}

state CalculateDiscountTax {
  entry / billing process starts
  do / compute discounts and taxes
  exit / show total amount
}

state GenerateReceipt {
  entry / transaction completed
  do / create receipt for customer
  exit / return to main menu
}

state ReplaceOrCancelReceipt {
  entry / user requests modification
  do / adjust or cancel receipt
  exit / update inventory accordingly
}

state RecordRequest {
  entry / item not available
  do / log request for unavailable item
  exit / notify user and return
}

state ViewReport {
  entry / user selects report option
  do / display transaction summary
  exit / return to main menu
}

Start --> AddNewItem : add new goods
Start --> UpdatePrice : update price
Start --> RemoveItem : remove items
Start --> SearchInventory : search inventory
Start --> PlaceOrder : place order
Start --> PurchaseSelectedItem : purchase item
Start --> CalculateDiscountTax : calculate discount/tax
Start --> GenerateReceipt : generate receipt
Start --> ReplaceOrCancelReceipt : replace/cancel receipt
Start --> RecordRequest : record request
Start --> ViewReport : view report

AddNewItem --> Start : back to menu
UpdatePrice --> Start : back to menu
RemoveItem --> Start : back to menu
SearchInventory --> Start : back to menu
PlaceOrder --> GenerateInvoice : order processed
GenerateInvoice --> Start : back to menu
PurchaseSelectedItem --> CalculateDiscountTax : proceed to billing
CalculateDiscountTax --> GenerateReceipt : show receipt
GenerateReceipt --> Start : back to menu
ReplaceOrCancelReceipt --> Start : back to menu
RecordRequest --> Start : back to menu
ViewReport --> Start : back to menu

GenerateReceipt --> End : system shutdown
End --> [*] : completion
Start --> End : exit application
@enduml
