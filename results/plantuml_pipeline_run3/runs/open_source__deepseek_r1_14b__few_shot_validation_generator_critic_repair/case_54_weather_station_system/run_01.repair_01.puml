@startuml
[*] --> Running

Running:
    when shutdown command -> Shutdown
    when configuration needed -> ConfigurationMode
    when remote control -> ControlledMode
    when request for status or summary -> Activity(Running.activity)

ConfigurationMode:
    after configuration completed -> Running

ControlledMode:
    when done with control -> Running

Shutdown:
    --> [*]

Activity(Running.activity):
    after activity completed -> Running

@enduml
