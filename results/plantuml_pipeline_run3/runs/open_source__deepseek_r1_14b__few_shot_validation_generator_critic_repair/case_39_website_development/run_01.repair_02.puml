@startuml
title UML State Chart Diagram

[*] --> Homepage

state "Homepage" as Homepage {
  Homepage --> NavigateToMenu : [Select Projects/Career]

  state "Navigate to Menu" as NavigateToMenu
  state "Project Information" as ProjectInformation
  state "Career Opportunities" as CareerOpportunities
}

state "Project Information" as ProjectInformation {
  ProjectInformation --> ViewProjects

  state "View Projects" as ViewProjects
  state "Photos" as Photos
  state "Videos" as Videos
}

state "Career Opportunities" as CareerOpportunities {
  CareerOpportunities --> ViewCareers

  state "View Careers" as ViewCareers
  state "Updates" as Updates
  state "Application Form" as ApplicationForm
}

state "Submit Application" as SubmitApplication {
  SubmitApplication --> CheckApplication

  state "Check Application" as Check
@enduml
