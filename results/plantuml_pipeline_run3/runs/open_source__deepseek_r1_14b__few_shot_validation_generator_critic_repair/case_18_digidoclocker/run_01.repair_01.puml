@startuml
title Digidoclocker State Transition Diagram

[*] --> Initial

state Initial <<choice>>
Initial --> Citizen : Identify as citizen [Citizen]
Initial --> Registrar : Identify as registrar [Registrar]

state Citizen
Citizen --> Register : Not registered
Citizen --> Login : Already registered

state Registrar
Registrar --> Login : Proceed to login

state Register
Register --> Login : Registration successful

state Login
Login --> MainMenu : Login successful

state MainMenu <<choice>>
MainMenu --> UploadDocuments : Upload documents [Upload]
MainMenu --> ViewProfile : View profile [View]
MainMenu --> ApplyCertificate : Apply for certificate [Apply]
MainMenu --> ContinueActions : Continue previous action [Continue]
MainMenu --> EndSession : Logout [Logout]

state UploadDocuments
UploadDocuments --> MainMenu : Back to main menu
UploadDocuments --> ContinueUploading : Continue uploading

state ContinueUploading <<choice>>
ContinueUploading --> UploadDocuments : More documents to upload [More]
ContinueUploading --> MainMenu : Done uploading [Done]

state ViewProfile
ViewProfile --> MainMenu : Back to main menu

state ApplyCertificate
ApplyCertificate --> RequestSent : Certificate request sent

state RequestSent <<choice>>
RequestSent --> MainMenu : Back to main menu [Back]
RequestSent --> Reapply : Reapply for certificate [Reapply]

state Reapply
Reapply --> RequestVerification : Verify request details

state RequestVerification
RequestVerification --> MainMenu : Back to main menu [MainMenu]
RequestVerification --> RequestMore : Request additional certificates [More]

state RequestMore <<choice>>
RequestMore --> ApplyCertificate : Apply new certificate [Apply]
RequestMore --> MainMenu : Return to main menu [Back]

state ContinueActions <<choice>>
ContinueActions --> UploadDocuments : Continue uploading [Upload]
ContinueActions --> ViewProfile : Continue viewing profile [View]
ContinueActions --> ApplyCertificate : Continue applying [Apply]
ContinueActions --> EndSession : Logout [Logout]

state EndSession
EndSession --> [*] : Session ended

@enduml
