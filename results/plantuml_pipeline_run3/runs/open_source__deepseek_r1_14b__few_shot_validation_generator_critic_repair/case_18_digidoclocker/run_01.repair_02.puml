@startuml
title Digidoclocker State Transition Diagram

[*] --> Initial

state Initial <<choice>>
Initial --> Citizen : [isCitizen]
Initial --> Registrar : [isRegistrar]

state Citizen
Citizen --> Register : Not registered
Citizen --> Login : Already registered

state Registrar
Registrar --> Login : Proceed to login

state Register
Register --> Login : Registration successful

state Login
Login --> MainMenu : Login successful

state MainMenu <<choice>>
MainMenu --> UploadDocuments : [upload]
MainMenu --> ViewProfile : [viewProfile]
MainMenu --> ApplyCertificate : [apply]
MainMenu --> ContinueActions : [continue]
MainMenu --> EndSession : [logout]

state UploadDocuments
UploadDocuments --> MainMenu : Back to main menu
UploadDocuments --> ContinueUploading : Continue uploading

state ContinueUploading
ContinueUploading --> UploadDocuments : More documents to upload
ContinueUploading --> MainMenu : Done uploading

state ViewProfile
ViewProfile --> MainMenu : Back to main menu

state ApplyCertificate
ApplyCertificate --> RequestSent : Certificate request sent

state RequestSent <<choice>>
RequestSent --> MainMenu : [back]
RequestSent --> Reapply : [reapply]
RequestSent --> RequestVerification : [verify]

state Reapply
Reapply --> MainMenu : Back to main menu

state RequestVerification
RequestVerification --> MainMenu : [back]
RequestVerification --> RequestMore : [more]

state RequestMore
RequestMore --> MainMenu : Back to main menu

state ContinueActions <<choice>>
ContinueActions --> UploadDocuments : [upload]
ContinueActions --> ViewProfile : [view]
ContinueActions --> ApplyCertificate : [apply]
ContinueActions --> EndSession : [logout]

state EndSession
EndSession --> [*] : Session ended

stateMainMenu
end state

@enduml
