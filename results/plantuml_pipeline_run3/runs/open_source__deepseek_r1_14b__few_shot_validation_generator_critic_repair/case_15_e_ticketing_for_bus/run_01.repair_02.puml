@startuml
title E-Ticketing System State Machine

[*] --> Unregistered

state Unregistered {
  Register --> Registered : createAccount()
}

state Registered {
  login() --> LoggedIn
}

state LoggedIn {
  checkTicketStatus() --> CheckTicketStatus
  bookTicket() --> BookTicket
  manageAccount() --> ManageAccount
  logout() --> Logout
}

state CheckTicketStatus {
  back() --> LoggedIn
}

state BookTicket {
  confirmBooking() --> Confirmation
}

state Confirmation {
  makePayment() --> Payment
}

state Payment {
  paymentSuccess() --> BackToLoggedIn
}

state BackToLoggedIn {
  --> LoggedIn
}

state ManageAccount {
  edit() --> EditingDetails
}

state EditingDetails {
  save() --> SaveChanges
  delete() --> DeleteAccount
}

state SaveChanges {
  changesSaved() --> BackToLoggedIn
}

state DeleteAccount {
  accountDeleted() --> Logout
}

state Logout {
  --> finallyLoggedOut
}

state finallyLoggedOut {
  --> [*]
}
@enduml
