@startuml

[*] --> Order

state Order
Order : entry / placePlane
Order : exit / delivered

state Arrival
Arrival : entry / planeArrived
Arrival : exit / transitionPreparation
Order --> Arrival : deliverPlane

state Preparation
Preparation : entry / assignCondition
Preparation : exit / readyForOperationsOrMaintenance
Arrival --> Preparation : planeArrived

state Operations
Operations : entry / hasScheduledFlights
Operations : exit / noMoreScheduledFlights
Preparation --> Operations : readyForOperations
Operations --> Maintenance : noMoreScheduledFlights

state Maintenance
Maintenance : entry / checkAndService
Maintenance : exit / readyForPreparation
Operations --> Maintenance : noMoreScheduledFlightsOrMaintenanceRequired
Maintenance --> Preparation : readyForPreparation

state OutOfService
OutOfService : entry / planeNotAvailable
Maintenance --> OutOfService : planeNotAvailable

Maintenance --> [*] : planeRemovedFromService

@enduml
