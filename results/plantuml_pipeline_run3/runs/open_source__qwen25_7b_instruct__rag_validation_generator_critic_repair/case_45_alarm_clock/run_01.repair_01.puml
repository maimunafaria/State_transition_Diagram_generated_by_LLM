@startuml
title Alarm Clock State Machine

[*] --> Off

state "Off" as Off {
    Off --> SetAlarm : set alarm time
}

state "Set" as Set {
    Set --> Activate : current time matches alarm time
}

state "Activated" as Activated {
    Activate --> Ringing : current time matches alarm time
    Ringing --> Stop : stop alarm
}

state "Ringing" as Ringing {
    Ringing --> Off : alarm stopped
}

@enduml
