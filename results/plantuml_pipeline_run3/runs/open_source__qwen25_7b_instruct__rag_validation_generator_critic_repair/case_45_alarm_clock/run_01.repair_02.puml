@startuml
title Alarm Clock State Machine

[*] --> Off

state "Off" as Off {
    Off --> SetAlarm : set alarm time
}

state "Set" as Set {
    Set --> Activate : current time matches alarm time
}

state "Activated" as Activated {
    [*] --> Stop : stop alarm
}

Activated --> Off : alarm stopped

Off --> [*]

@enduml
