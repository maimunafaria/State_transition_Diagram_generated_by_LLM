CalculateDiscountTax : exit / discountAndTaxCalculated

state GenerateReceipt
GenerateReceipt : entry / generateReceipt
GenerateReceipt : exit / receiptGenerated

state ReplaceOrCancel
ReplaceOrCancel : entry / replaceOrCancel
