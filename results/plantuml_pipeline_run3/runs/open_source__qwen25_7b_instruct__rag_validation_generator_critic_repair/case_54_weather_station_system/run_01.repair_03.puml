@startuml
title Weather Station System States

[*] --> Restart : [power-up or command]

state "Restart" as Restart
state "Running" as Running
state "Configuration Mode" as ConfigurationMode
state "Data Collection" as DataCollection
state "Summary Preparation" as SummaryPreparation
state "Status Checking" as StatusChecking
state "Controlled Mode" as ControlledMode
state "Shutdown" as Shutdown

Restart --> Running : [power-up or command]
Running --> ConfigurationMode : [settings change or power-saving required]
ConfigurationMode --> Running : [configuration completed]
Running --> DataCollection : [clock trigger]
DataCollection --> Running : [activity complete]
SummaryPreparation --> Running : [activity complete]
StatusChecking --> Running : [activity complete]
Running --> ControlledMode : [remote control command]
ControlledMode --> Shutdown : [shutdown command]
Shutdown --> [*] : [system shutdown]

@enduml
