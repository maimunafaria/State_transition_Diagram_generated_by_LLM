@startuml
title UML state machine diagram

[*] --> Login : [check user]
state Login <<choice>>
Login --> MainArea : [signed in]
MainArea --> MarketConditions : [select market condition]
MarketConditions --> MarketReport : [display report]
MainArea --> PestControlHelp : [select pest control help]
PestControlHelp --> PhotoRequired : [require photo]
PhotoRequired --> TechniquesShown : [show techniques]
MainArea --> SoilSuggestions : [provide suggestions]
SoilSuggestions --> WeatherInsights : [offer insights]
WeatherInsights --> LabourDetails : [display details]
LabourDetails --> ContinueService : [continue using service]
ContinueService --> Logout : [log out]
Logout --> [*] : [end session]

@enduml
