@startuml
title UML State Machine Diagram (Weather Monitoring System)

[*] --> RegistrationOrLogin

state RegistrationOrLogin <<choice>>
RegistrationOrLogin --> CreateAccount : [New user]
RegistrationOrLogin --> ExistingUser : [Registered user]

state CreateAccount
CreateAccount --> AccountCreated : [Successful registration]
CreateAccount --> EndProcess : [Not successful]

state ExistingUser
ExistingUser --> LoginSuccess : [Valid login credentials]
ExistingUser --> EndProcess : [Invalid login credentials]

state LoginSuccess
LoginSuccess --> CheckWeather : [Check weather]
LoginSuccess --> AdditionalDetails : [View additional details]

state CheckWeather
CheckWeather --> ValidLocation : [Valid location entered]
CheckWeather --> InvalidLocation : [Invalid location entered]

state ValidLocation
ValidLocation --> SelectInfoType : [Choose info type]
SelectInfoType --> ShowInfo : [Show selected weather information]
SelectInfoType --> EndSession : [Logout]

state InvalidLocation
InvalidLocation --> EndProcess : [End process]

state LoggedOut
LoggedOut --> [*] : [Logged out]

@enduml
