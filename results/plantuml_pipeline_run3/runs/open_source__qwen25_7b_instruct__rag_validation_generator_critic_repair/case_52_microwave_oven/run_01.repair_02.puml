@startuml
title Microwave Oven Operation

[*] --> DoorShut

state "Door Shut" as DoorShut
state "Door Open" as DoorOpen

DoorShut --> DoorOpen : Door Opened
DoorOpen --> DoorShut : Door Closed

state Waiting {
  [*] --> TimeSet
  TimeSet : do / Set Cooking Time
  TimeSet --> PowerSelect : Select Power Level
  PowerSelect : do / Choose Power Level
  PowerSelect --> Cooking : Start Cooking
}

Cooking {
  [*] --> Checking
  Checking : do / Check Status
  Checking --> Cook : OK
  Checking --> Alarm : Turntable Fault [invalid]
  Checking --> Alarm : Emitter Fault [invalid]

  Cook --> Done : Timeout
  Cook --> DoorOpen : Door Opened
  Cook --> Cooking : Time
}

state "Alarm" as Alarm {
  [*] --> Disabled
  Disabled : do / Deactivate System
}

Done {
  [*] --> Waiting
}

DoorOpen --> Disabled : Door Opened

state "TimeSet" as TimeSet {
  [*] --> PowerSelect
}

state "Checking" as Checking {
  [*] --> Cook [OK]
  [*] --> Alarm [Turntable Fault | Emitter Fault]
}

state "Cook" as Cook {
  [*] --> Done [Timeout]
  [*] --> DoorOpen [Door Opened]
  [*] --> Cooking [Time]
}

state "PowerSelect" as PowerSelect {
  [*] --> Cooking
}

state "Alarm" as Alarm {
  [*] --> Disabled
}

state "Disabled" as Disabled {
  [*] --> Waiting
}

@enduml
