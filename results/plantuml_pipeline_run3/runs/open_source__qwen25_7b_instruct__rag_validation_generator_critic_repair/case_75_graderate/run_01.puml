@startuml
title State Machine Diagram for Graderate

[*] --> WaitingStart

state "WaitingStart" as WaitingStart
state Active as Active
state Expired as Expired
state Removed as Removed

WaitingStart --> Active : current date >= start date
Active --> Expired : current date >= end date
Expired --> Removed : 1 year from expiration date
Removed --> [*] : 1 year from expiration date

@enduml
