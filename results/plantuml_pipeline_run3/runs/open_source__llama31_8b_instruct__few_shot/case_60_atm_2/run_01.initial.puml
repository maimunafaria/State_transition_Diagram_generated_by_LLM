@startuml
title State machine for Atm Scenario 2

state Idle
state SelectAmount
state EnterCustomValue
state VerifyTransaction
state ReEnterAmount

[*] --> SelectAmount : /selectAmountOption

SelectAmount --> Idle : amountSelected
SelectAmount --> EnterCustomValue : customValueEntered

EnterCustomValue --> VerifyTransaction : verifyTransaction

VerifyTransaction --> Idle : transactionSuccessful
VerifyTransaction --> ReEnterAmount : transactionRejected

ReEnterAmount --> SelectAmount : reEnterAmount

@enduml
