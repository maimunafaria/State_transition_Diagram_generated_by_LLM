@startuml
title UML State Machine Diagram

state Off as "Off"
state Activated as "Activated"
state Ringing as "Ringing"

[*] --> Off : /initial state/

Off --> Activated : setAlarmTime(alarmTime) /activate alarm/

Activated --> Off : turnOffAlarm() /deactivate alarm/

Activated --> Ringing : currentTimeMatches(alarmTime) /alarm ringing/

Ringing --> Off : stopAlarm() /stop alarm/

Ringing --> Activated : nextScheduledAlarmTime() /next scheduled alarm time/

Off --> [*] : /final state/
@enduml
