@startuml
title UML State Machine Diagram

state Off as Off
state Activated as Activated
state Ringing as Ringing

[*] --> Off : /initial state/

Off --> Activated : setAlarmTime(alarmTime)

Activated --> Off : turnOffAlarm()

ActivatedRoute --> Ringing : currentTimeMatches(alarmTime)

Ringing --> Off : stopAlarm()

Ringing --> Activated : nextScheduledAlarmTime()

Off --> [*]

@enduml
