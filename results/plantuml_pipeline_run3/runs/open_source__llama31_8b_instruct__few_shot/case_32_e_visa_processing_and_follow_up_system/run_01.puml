@startuml
title E Visa Processing And Follow Up System State Diagram

[*] --> CreateAccount : User creates account

state "Create Account" as CreateAccount {
  state "Login" as Login
}

state "Login" as Login {
  state "Apply for Visa" as ApplyForVisa
  state "View Status" as ViewStatus
  state "Cancel Application" as CancelApplication
  state "Modify Details" as ModifyDetails
  state "View Details" as ViewDetails
  state "Check Status" as CheckStatus
  state "Give Feedback" as GiveFeedback
}

state "Apply for Visa" as ApplyForVisa {
  state "Payment Made" as PaymentMade
  state "Application Accepted" as ApplicationAccepted
}

state "Payment Made" as PaymentMade : Payment made

state "Application Accepted" as ApplicationAccepted : Application accepted

state "View Status" as ViewStatus {
  state "Check Status" as CheckStatus
}

state "Cancel Application" as CancelApplication : Cancel application

state "Modify Details" as ModifyDetails : Modify details

state "View Details" as ViewDetails : View details

state "Check Status" as CheckStatus : Check status

state "Give Feedback" as GiveFeedback : Give feedback

CreateAccount --> Login : Account created
Login --> ApplyForVisa : User logged in
ApplyForVisa --> PaymentMade : Application submitted for payment
PaymentMade --> ApplicationAccepted : Payment made and application accepted
ApplicationAccepted --> ViewStatus : Application status updated
ViewStatus --> CheckStatus : Status checked
CheckStatus --> GiveFeedback : Feedback given
GiveFeedback --> Login : Logout after feedback
Login --> CancelApplication : User logged in to cancel application
CancelApplication --> Login : Cancelled application
Login --> ModifyDetails : User logged in to modify details
ModifyDetails --> ViewDetails : Details modified and viewed
ViewDetails --> Login : Logout after viewing details

@enduml
