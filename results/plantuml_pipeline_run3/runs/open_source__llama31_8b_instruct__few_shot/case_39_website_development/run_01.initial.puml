@startuml
title Website Development State Machine Diagram

state "Homepage" as Homepage
state "Project View" as ProjectView
state "Career Opportunities" as CareerOpportunities
state "Application Form" as ApplicationForm
state "Job Applications" as JobApplications

[*] --> Homepage

Homepage --> ProjectView : select project from navigation bar
ProjectView --> Homepage : return to homepage
ProjectView --> CareerOpportunities : select career opportunities from navigation bar

CareerOpportunities --> ApplicationForm : view updates
ApplicationForm --> CareerOpportunities : open application form for employment or internship

ApplicationForm --> JobApplications : submit job application
JobApplications --> ApplicationForm : check submitted job applications

@enduml
