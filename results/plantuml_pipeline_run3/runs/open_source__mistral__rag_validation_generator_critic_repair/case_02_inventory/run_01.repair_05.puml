@startuml
title UML State Chart Diagram

[*] --> CustomerRegistration
CustomerRegistration : entry / register
CustomerRegistration : do / createAccount
CustomerRegistration : exit / accountCreated
CustomerRegistration : exit / cancelRegistration

state CustomerDashboard
CustomerDashboard : entry / login
CustomerDashboard : do / checkCredentials
CustomerDashboard : exit / incorrectCredentials
CustomerDashboard : exit / successfulLogin
CustomerDashboard : exit / logout

state InventoryManagement
InventoryManagement : entry / successfulLogin
InventoryManagement : do / addGoods
InventoryManagement : do / updatePrice
InventoryManagement : do / removeGoods
InventoryManagement : do / identifyExpiredGoods
InventoryManagement : exit / anyAction
InventoryManagement : exit / logout

state MarketplaceManagement
MarketplaceManagement : entry / successfulLogin
MarketplaceManagement : do / addProducts
MarketplaceManagement : do / promoteProducts
MarketplaceManagement : do / communicateWithCustomers
MarketplaceManagement : do / logout
MarketplaceManagement : exit / anyAction
MarketplaceManagement : exit / logout

state TextileProduction
TextileProduction : entry / placeOrder
TextileProduction : do / sendSampleMaterials
TextileProduction : do / checkStock
TextileProduction : do / purchaseRawMaterials
TextileProduction : do / processRawMaterials
TextileProduction : do / defectCheck
TextileProduction : do / deliverGarments
TextileProduction : do / completeBillingAndPayment
TextileProduction : do / generateReport
TextileProduction : exit / anyAction
TextileProduction : exit / logout

state ArtGalleryManagement
ArtGalleryManagement : entry / login
ArtGalleryManagement : do / verifyLoginDetails
ArtGalleryManagement : do / viewProductsOrUpdateInfo
ArtGalleryManagement : do / selectItemsAndPlaceOrder
ArtGalleryManagement : do / addSelectedProductsToOrder
ArtGalleryManagement : do / choosePaymentMethod
ArtGalleryManagement : do / processOrder
ArtGalleryManagement : do / endProcessIfPaymentFails
ArtGalleryManagement : do / saveUpdatedInfo
ArtGalleryManagement : exit / anyAction
ArtGalleryManagement : exit / logout

state LoggedOut
LoggedOut : entry / logout
LoggedOut : exit / [*]
@enduml
