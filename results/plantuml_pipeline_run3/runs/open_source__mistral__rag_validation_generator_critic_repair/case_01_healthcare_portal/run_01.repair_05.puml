@startuml
title UML State Machine Diagram

state StartChoice <<choice>>
state RegistrationFailed <<state>>
state SignInFailed <<state>>
state RegisteredUser <<state>>
state FacilityAccess <<state>>
state NewsContent <<state>>
state HealthInfo <<state>>
state PaymentSelection <<state>>
state CashPaymentDetails <<state>>
state InsurancePayment <<state>>
state FeedbackCollection <<state>>
state Logout <<state>>

[*] --> StartChoice

StartChoice : entry / start
StartChoice : do / checkUserStatus
StartChoice : exit / newUser

newUser : entry / createAccount
newUser : do / register
newUser : exit / RegistrationFailed

RegistrationFailed : entry / showError
RegistrationFailed : do / waitForRetry
RegistrationFailed --> RegisteredUser : SUPPORTED_EVENT

SignInFailed : entry / showError
SignInFailed : do / waitForRetry
SignInFailed --> RegisteredUser : SUPPORTED_EVENT

RegisteredUser : entry / signIn
RegisteredUser : do / validateCredentials
RegisteredUser : exit / SignInFailed

RegisteredUser --> FacilityAccess : SUPPORTED_EVENT
RegisteredUser : exit / Logout

FacilityAccess : entry / accessFacilities
FacilityAccess : do / checkPermissions
FacilityAccess --> NewsContent : SUPPORTED_EVENT

NewsContent : entry / readNews
NewsContent : do / showContent
NewsContent --> HealthInfo : SUPPORTED_EVENT

HealthInfo : entry / checkSymptoms
HealthInfo : do / provideOptions
HealthInfo --> PaymentSelection : SUPPORTED_EVENT

PaymentSelection : entry / selectMethod
PaymentSelection : do / showMethods
PaymentSelection --> CashPaymentDetails : [cashSelected]
PaymentSelection --> InsurancePayment : [insuranceSelected]

CashPaymentDetails : entry / displayDetails
CashPaymentDetails : do / collectCash
CashPaymentDetails --> [*] : COMPLETION_EVENT

InsurancePayment : entry / processInsurance
InsurancePayment : do / checkCoverage
InsurancePayment --> PaymentCompleted : SUPPORTED_EVENT

FeedbackCollection : entry / collectFeedback
FeedbackCollection : do / saveFeedback
FeedbackCollection --> Logout : SUPPORTED_EVENT
Logout : exit / StartChoice

Logout : entry / logOut
Logout : do / endSession
Logout --> [*] : SUPPORTED_EVENT
@enduml
