@startuml
title Staff Member State Machine

state Unemployed
state Assigned
state Working

[*] --> Assigned : Hired(details)

Assigned --> Working : AssignClientOrCampaign(assignment)
Working --> Unemployed : LeftJob(reason)
Working --> Assigned : SwitchAssignment(newAssignment)

Assigned [*] : ReturnToUnemployed

title Campaign State Machine

state Inactive
state Active
state Completed
state Paid
Archived [*] : ArchiveFormerEmployee

[*] --> Active : Commissioned(manager, staff, approvalCode)

Active --> Completed : FinishedWork(finalStatement)
Completed --> Paid : PaymentReceived(payment)
Paid --> Archived : AllSettled(completion)
Inactive --> Active : Activated(contractSigned)

title Advocate Diary State Machine

state Unregistered
state Registered
state LoggedIn
state AddingCase
state WorkingOnCase
state CompletedCase

[*] --> Registered : CreateAccount(details)
Registered --> LoggedIn : VerifyDetails(password)
LoggedIn --> AddingCase : StartNewCase(category)
AddingCase --> WorkingOnCase : EnterCaseDetails(caseData)
WorkingOnCase --> CompletedCase : CaseCompleted(reminders, documents)
CompletedCase --> Unregistered : Logout
Registered [*] : LogoutAsUnemployed
@enduml
