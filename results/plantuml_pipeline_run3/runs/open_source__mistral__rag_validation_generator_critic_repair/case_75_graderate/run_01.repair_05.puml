@startuml
title Rate Management State Diagram

[*] --> Active
Active --> Expired [Finish Date >= Current Date + 1 year]

state Active {
    [Start Date <= Current Date] as StartDate
    [Current Date < End Date] as ValidityPeriod
}

state Expired {}
Expired --> Archived [Current Date > Expiration Date + 1 year]

title Traffic Management State Diagram
...

title Training Request State Diagram
[*] --> Creation
Creation --> Accepted [Request Sent For Approval]
Accepted --> Rejected <<final>>
Accepted --> Satisfied <<final>>
Accepted --> Cancelled <<final>>

title Book Bank Management System State Diagram
[*] --> Registration
Registration --> SearchBook
...
@enduml
