@startuml
title Rate Management State Diagram
[*] --> Active : StartDate
Active [Start Date <= Current Date] as StartDate
Active [Current Date < End Date] as ValidityPeriod
Active [Finish Date >= Current Date + 1 year] as ExpirationPeriod
Active Expired : ExpiredEvent
Expired --> [*] : CompletionEvent

title Traffic Management State Diagram
Monitoring --> [*] : TrafficConditionDetected

state Monitoring {
    StreetLightsControlled
    TrafficSignalsManaged
    VehicleNumberCaptured
    DriverDetailsChecked
    RuleBroken <<choice>>
    NoRuleBroken
    RuleBrokenContinue
}

state NoRuleBroken --> EndProcess

state RuleBroken {
    ViolationRecorded
    FineIssued
    PaidFine
    Completed
    UnpaidFine
    WarningSent
}

title Training Request State Diagram
[*] --> Creation : RequestAwaitingApproval
Creation Rejected : RejectionEvent
Creation Accepted SearchForSession

state Accepted {
    SearchForSession
    Enrolment
    Satisfied <<final>>
    Cancelled <<final>>
}

title Book Bank Management System State Diagram
[*] --> Registration : CorrectEntry
Registration IncorrectDetailsEntered Re_entryRequired
Registration Login MemberIDAndPasswordCorrect as CorrectLogin
Registration Login MemberIDAndPasswordIncorrect

state SearchBook {
    BookFound as FoundBook
    NoSuggestions
    AnotherOption
    GetBook
    MembershipActive as ActiveMembership
    FineAmountRequired
    PayFine
    GetBookConfirmed
}
@enduml
