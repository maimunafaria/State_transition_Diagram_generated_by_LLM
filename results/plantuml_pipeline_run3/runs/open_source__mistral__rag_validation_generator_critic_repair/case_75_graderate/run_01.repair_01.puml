@startuml
title Rate Management State Diagram
[*] --> InitialRate
InitialRate --> Active

state Active {
    [Start Date <= Current Date] as StartDate
    [Current Date < End Date] as ValidityPeriod
    [Finish Date >= Current Date + 1 year] as ExpirationPeriod
    Expired <<final>>
}

state Expired {}

title Traffic Management State Diagram
Monitoring --> InitialTraffic
InitialTraffic --> TrafficConditionDetected

state TrafficConditionDetected {
    StreetLightsControlled
    TrafficSignalsManaged
    VehicleNumberCaptured
    DriverDetailsChecked
    RuleBroken <<choice>>
    NoRuleBroken
    RuleBrokenContinue
}

state NoRuleBroken {
    EndProcess
}

state RuleBroken {
    ViolationRecorded
    FineIssued
    PaidFine
    Completed
    UnpaidFine
    WarningSent
}

title Training Request State Diagram
Creation --> InitialTrainingRequest
InitialTrainingRequest --> RequestAwaitingApproval

state RequestAwaitingApproval {
    Rejected <<final>>
}

state Accepted {
    SearchForSession
    Enrolment
    Satisfied <<final>>
    Cancelled <<final>>
}

title Book Bank Management System State Diagram
[*] --> InitialBookBank
InitialBookBank --> Registration

state Registration {
    CorrectDetailsEntered as CorrectEntry
    IncorrectDetailsEntered
    Re-entryRequired
    Login
    MemberIDAndPasswordCorrect as CorrectLogin
    MemberIDAndPasswordIncorrect
}

state SearchBook {
    BookFound as FoundBook
    NoSuggestions
    AnotherOption
    GetBook
    MembershipActive as ActiveMembership
    FineAmountRequired
    PayFine
    GetBookConfirmed
}
@enduml
