@startuml
title Video Suggestion System UML State Machine Diagram

state StartChoice <<choice>>
state UserRequestVideo
state IdentifyUser
state GatherVideos
state AddDetails
state SendSuggestions
state TrendingVideos
state SimilarTagVideos
state GenreVideos
state PromotedVideos
state ThumbnailsAndViewCounts

[*] --> StartChoice

StartChoice --> UserRequestVideo : User requests video
UserRequestVideo --> IdentifyUser
IdentifyUser --> UserIdentified

state UserIdentified
UserIdentified --> GatherVideos
GatherVideos --> TrendingVideos [Trending]
GatherVideos --> SimilarTagVideos [SimilarTags]
GatherVideos --> GenreVideos [Genre]
GatherVideos --> PromotedVideos [Promotion]
TrendingVideos --> ThumbnailsAndViewCounts
SimilarTagVideos --> ThumbnailsAndViewCounts
GenreVideos --> ThumbnailsAndViewCounts
PromotedVideos --> ThumbnailsAndViewCounts
ThumbnailsAndViewCounts --> SendSuggestions
SendSuggestions --> [*]
@enduml
