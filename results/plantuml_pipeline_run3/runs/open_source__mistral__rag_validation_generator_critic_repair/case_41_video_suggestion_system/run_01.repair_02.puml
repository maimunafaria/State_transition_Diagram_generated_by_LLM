@startuml
title Video Suggestion System UML State Machine Diagram

state StartChoice <<choice>>
state UserRequestVideo
state IdentifyUser
state GatherVideos
state AddDetails
state SendSuggestions
state EndChoice <<choice>>

[*] --> StartChoice : Initial Request
StartChoice --> [valid] UserRequestVideo
StartChoice --> [invalid] EndChoice

UserRequestVideo --> IdentifyUser
IdentifyUser --> UserIdentified

state UserIdentified
UserIdentified --> GatherVideos
GatherVideos --> AddDetails
AddDetails --> SendSuggestions
SendSuggestions --> EndChoice : Suggestions Sent
EndChoice --> [*]
@enduml
