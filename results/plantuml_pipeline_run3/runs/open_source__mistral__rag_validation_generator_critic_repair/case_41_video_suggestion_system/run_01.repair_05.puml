@startuml
title Video Suggestion System UML State Machine Diagram

state StartChoice <<choice>>
state UserRequestVideo
state IdentifyUser
state GatherVideos
state AddDetails
state SendSuggestions

[*] --> StartChoice : Request video
StartChoice --> UserRequestVideo [valid]
UserRequestVideo --> IdentifyUser
IdentifyUser --> UserIdentified

state UserIdentified
UserIdentified --> GatherVideos [valid]
GatherVideos --> AddDetails
AddDetails --> SendSuggestions
SendSuggestions --> [*] [invalid]
@enduml
