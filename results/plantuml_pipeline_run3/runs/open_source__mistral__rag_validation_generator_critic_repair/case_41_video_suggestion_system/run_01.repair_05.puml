@startuml
title Video Suggestion System UML State Machine Diagram

state StartChoice <<choice>>
state UserRequestVideo
state IdentifyUser
state GatherVideos
state AddDetails
state SendSuggestions
state TrendingVideos
state SimilarTagsVideos
state SimilarGenresVideos
state PromotedVideos

[*] --> StartChoice

StartChoice --> UserRequestVideo : User requests video
UserRequestVideo --> IdentifyUser
IdentifyUser --> UserIdentified

state UserIdentified
UserIdentified --> GatherVideos
GatherVideos --> TrendingVideos [trending]
GatherVideos --> SimilarTagsVideos [similar_tags]
GatherVideos --> SimilarGenresVideos [similar_genres]
GatherVideos --> PromotedVideos [promoted]
TrendingVideos --> AddDetails
SimilarTagsVideos --> AddDetails
SimilarGenresVideos --> AddDetails
PromotedVideos --> AddDetails
AddDetails --> SendSuggestions
SendSuggestions --> [*]
@enduml
