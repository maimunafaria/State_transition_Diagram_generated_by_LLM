@startuml
title Alarm Clock State Machine

[*] --> Off
Off --> ActiveAlarm : Set Alarm Time
ActiveAlarm --> RingingAlarm : Match Current Time with Alarm Time
RingingAlarm --> StoppedAlarm : Turn Off Alarm
StoppedAlarm --> ActiveAlarm : Next Scheduled Alarm Time
ActiveAlarm --> Idle : Activate Alarm [AlarmOn]
RingingAlarm --> Idle : Start Ringing Alarm [Ringing]
Idle --> [*] : User Interaction [CompletionEvent]

state ActiveAlarm {
    [*] --> AlarmOn
}

state RingingAlarm {
    [*] --> Ringing
}

state StoppedAlarm {
    [*] --> Idle
}
@enduml
