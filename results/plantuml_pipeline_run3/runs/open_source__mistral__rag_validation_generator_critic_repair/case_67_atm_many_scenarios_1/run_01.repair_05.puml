@startuml
title ATM Control - Combined Scenarios

[*] --> Idle

state Idle
Idle : entry / Display Welcome

state "Enter PIN"
"Enter PIN" : enterPin(pin)
"Enter PIN" : verifyPin(pin, storedPin)
"Enter PIN" : checkPinLimit(incorrectAttempts)
"Enter PIN" : keepCard(invalidCard, incorrectPin, incorrectAttempts > 3)
"Enter PIN" : returnCardWithMessage(cancelledOperation, rejectedRequest)
"Enter PIN" : displayOptions(correctPin)
"Enter PIN" : processWithdrawalRequest(requestAmount, availableBalance, approvedTransaction)
"Enter PIN" : checkCashAvailability(approvedTransaction, cashAvailable)
"Enter PIN" : dispenseCash(cashDispensed, rejectedRequest)
"Enter PIN" : printReceipt(receiptPrinted, rejectedRequest)
"Enter PIN" : returnCard(cardReturned, rejectedRequest)
"Enter PIN" : stopOperation(outOfCash)
"Enter PIN" : resetATM(finishedSession)
"Enter PIN" --> TerminatingTransaction : COMPLETION_EVENT
"Enter PIN" --> "Check Information" : CHECK_INFORMATION_EVENT
"Enter PIN" --> "Transfer Money" : TRANSFER_MONEY_EVENT
"Enter PIN" --> "Withdraw Cash" : WITHDRAW_CASH_EVENT

state Check Information
CheckInformation --> "Enter PIN" : CHECK_INFORMATION_EVENT
CheckInformation : chooseToCheckInfo(checkInfoOptionSelected)
CheckInformation : processQueryRequest(queryType, approvedQuery)
CheckInformation : printReceipt(receiptPrinted, rejectedQuery)
CheckInformation --> Idle : COMPLETION_EVENT

state Transfer Money
TransferMoney --> "Enter PIN" : TRANSFER_MONEY_EVENT
TransferMoney : chooseToTransfer(transferOptionSelected)
TransferMoney : processTransferRequest(transferAmount, approvedTransfer)
TransferMoney : printReceipt(receiptPrinted, rejectedTransfer)
TransferMoney --> Idle : COMPLETION_EVENT

state Withdraw Cash
WithdrawCash --> "Enter PIN" : WITHDRAW_CASH_EVENT
WithdrawCash : chooseToWithdraw(withdrawOptionSelected)
WithdrawCash : processWithdrawalRequest(requestAmount, availableBalance, approvedWithdrawal)
WithdrawCash : dispenseCash(cashDispensed, rejectedWithdrawal)
WithdrawCash : printReceipt(receiptPrinted, rejectedWithdrawal)
WithdrawCash : returnCard(cardReturned, rejectedWithdrawal)
WithdrawCash : cancelOperation(rejectedWithdrawal)
WithdrawCash : showMessage(insufficientFunds)
WithdrawCash : stopOperation(outOfCash)
WithdrawCash --> Idle : COMPLETION_EVENT

state TerminatingTransaction
TerminatingTransaction : ejectCard(cardEjected, finishedTransaction)
TerminatingTransaction : shortEndingPhase(shortEndingPhaseCompleted)
TerminingTransaction : returnToNormalCondition(normalConditionReached)
TerminatingTransaction : shutDown(shutdownOccured)
TerminatingTransaction --> [*] : COMPLETION_EVENT
@enduml
