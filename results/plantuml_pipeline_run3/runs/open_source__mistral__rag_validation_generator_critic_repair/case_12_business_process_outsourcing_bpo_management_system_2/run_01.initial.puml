@startuml
title UML State Machine Diagram (BPO Management System)

[*] --> UserLogin

state UserLogin {
    UserLogin : entry / Start
    UserLogin : choose / Login or Register
}

UserLogin --> Registration : [New user]
UserLogin --> Login : [Registered user]

state Registration {
    Registration : enterDetails / Enter details
    Registration : validateDetails / Validate details
    Registration : saveDetails / Save details
    Registration : success / Successful registration
    Registration : failure / Failed registration
}

Registration --> success : [Valid details]
Registration --> failure : [Invalid details]

state Login {
    Login : enterCredentials / Enter credentials
    Login : validateCredentials / Validate credentials
    Login : loginSuccess / Successful login
    Login : loginFailure / Failed login
}

Login --> loginSuccess : [Valid credentials]
Login --> loginFailure : [Invalid credentials]

state UserDashboard {
    UserDashboard : manageProfile / Manage profile
    UserDashboard : logout / Logout
}

UserDashboard --> manageProfile : [Manage profile]
UserDashboard --> logout : [Logout]

state ManageProfile {
    ManageProfile : changePassword / Change password
    ManageProfile : updateDetails / Update details
}

ManageProfile --> changePassword : [Change password]
ManageProfile --> updateDetails : [Update details]

state ChangePassword {
    ChangePassword : enterOldPassword / Enter old password
    ChangePassword : enterNewPassword / Enter new password
    ChangePassword : validateChanges / Validate changes
    ChangePassword : saveChanges / Save changes
}

ChangePassword --> validateChanges : [Valid changes]
ChangePassword --> saveChanges : [Save changes]

state UpdateDetails {
    UpdateDetails : enterNewDetails / Enter new details
    UpdateDetails : validateDetails / Validate details
    UpdateDetails : saveDetails / Save details
    UpdateDetails : success / Successful update
    UpdateDetails : failure / Failed update
}

UpdateDetails --> success : [Valid details]
UpdateDetails --> failure : [Invalid details]
@enduml
