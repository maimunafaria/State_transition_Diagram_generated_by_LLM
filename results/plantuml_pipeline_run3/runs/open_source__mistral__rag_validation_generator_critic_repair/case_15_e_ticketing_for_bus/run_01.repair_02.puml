@startuml
title E Ticketing For Bus — Polished Requirement Specification

state StartChoice <<choice>>
state RegisterUser <<choice>>
state ValidateRegistration <<choice>>
state LoginUser <<choice>>
state CheckTicketStatus <<choice>>
state BookTicket <<choice>>
state ConfirmBooking <<choice>>
state MakePayment <<choice>>
state ManageAccountDetails <<choice>>
state LogoutUser <<choice>>
state EndChoice <<choice>>

[*] --> StartChoice : [start]
StartChoice --> RegisterUser : [create account]
RegisterUser --> ValidateRegistration : [validate registration]
ValidateRegistration --> LoginUser : [successful registration]
LoginUser --> CheckTicketStatus : [check status]
CheckTicketStatus --> BookTicket : [book ticket]
BookTicket --> ConfirmBooking : [confirm booking]
ConfirmBooking --> MakePayment : [make payment]
MakePayment --> ManageAccountDetails : [manage account details]
ManageAccountDetails --> LogoutUser : [log out]
LogoutUser --> EndChoice : [logged out]
EndChoice --> [*] : COMPLETION_EVENT

state AccountManagement <<compositeState>>
RegisterUser --> AccountManagement : [create account]
ValidateRegistration --> AccountManagement : [validate registration]
LoginUser --> AccountManagement : [successful registration]
ManageAccountDetails --> AccountManagement : [manage account details]
LogoutUser --> AccountManagement : [log out]
AccountManagement --> EndChoice : [COMPLETION_EVENT]

state AccountManagement_Decision <<choice>>
AccountManagement --> AccountManagement_Decision : [*]
AccountManagement_Decision --> RegisterUser : [new user]
AccountManagement_Decision --> ManageAccountDetails : [existing user]
@enduml
