@startuml
title Safehome Security Function - State Machine Diagram

[*] --> Startup

state Startup
Startup : check_everything_working()

state Ready
Ready : become_ready_to_use() if Startup.check_everything_working()

state Reset
Reset : allow_user_reset() when Ready
Reset --> [*] : COMPLETION_EVENT

state Activate
Activate : allow_user_activate() when Ready
Activate --> Monitoring : USER_ACTIVATES_EVENT

state Off
Off : turn_off() when Ready
Off --> [*] : COMPLETION_EVENT

state Monitoring
Monitoring : start_monitoring()
Monitoring --> Alarm : SENSOR_TRIGGERED_EVENT
Monitoring --> FalseAlarm : SENSOR_NOT_TRIGGERED_EVENT

state Alarm
Alarm : start_alarm_and_send_alerts()
Alarm : user_enters_password at any time? if User.enters_password
    Alarm --> Normal : USER_ENTERS_PASSWORD_EVENT
    Alarm --> FalseAlarm : SUPPORTED_EVENT
Alarm : !user_enters_password at any time? if User.enters_password
    Alarm --> Monitoring : SUPPORTED_EVENT

state FalseAlarm
FalseAlarm : continue_monitoring()
FalseAlarm --> Monitoring : TIME_CONTINUES_EVENT

state Normal
Normal : stop_and_return_to(Startup) when User.enters_password at any time
Normal --> [*] : COMPLETION_EVENT
@enduml
